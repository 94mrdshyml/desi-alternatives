---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import CategoryFilter from '@/components/CategoryFilter.astro';
import ToolCard from '@/components/ToolCard.astro';
import Footer from '@/components/Footer.astro';
import { eq } from 'drizzle-orm';
import { categories, desiTools, globalTools, toolAlternatives } from '@/lib/server/db/schema';

const db = Astro.locals.db;
const activeCategory = Astro.url.searchParams.get('category') || 'all';

let allCategories: any[] = [];
let allTools: any[] = [];
let categoryCounts: Record<string, number> = {};

if (db) {
  try {
    // 1. Fetch categories
    allCategories = await db.select().from(categories).all();

    // 2. Fetch tools with categories
    const toolsQuery = db
      .select({
        id: desiTools.id,
        slug: desiTools.slug,
        name: desiTools.name,
        tagline: desiTools.tagline,
        description: desiTools.description,
        websiteUrl: desiTools.websiteUrl,
        logoUrl: desiTools.logoUrl,
        primaryColor: desiTools.primaryColor,
        categoryId: desiTools.categoryId,
        categorySlug: categories.slug,
        categoryName: categories.name,
        hasGstInvoice: desiTools.hasGstInvoice,
        hasIndianDataResidency: desiTools.hasIndianDataResidency,
        hasInrPricing: desiTools.hasInrPricing,
        hasUpiSupport: desiTools.hasUpiSupport,
        isOpenSource: desiTools.isOpenSource,
        hasIstSupport: desiTools.hasIstSupport,
        isSelfHostable: desiTools.isSelfHostable,
        hasFreeTier: desiTools.hasFreeTier,
        pricingModel: desiTools.pricingModel,
        startingPriceInr: desiTools.startingPriceInr,
      })
      .from(desiTools)
      .leftJoin(categories, eq(desiTools.categoryId, categories.id))
      .where(eq(desiTools.status, 'published'));

    const rawTools = await toolsQuery.all();

    // 3. Fetch alternatives for each tool
    const rawAlternatives = await db
      .select({
        desiToolId: toolAlternatives.desiToolId,
        globalName: globalTools.name,
        globalSlug: globalTools.slug,
      })
      .from(toolAlternatives)
      .leftJoin(globalTools, eq(toolAlternatives.globalToolId, globalTools.id))
      .all();

    const altMap: Record<string, Array<{ name: string; slug: string }>> = {};
    for (const alt of rawAlternatives) {
      if (alt.desiToolId && alt.globalName && alt.globalSlug) {
        if (!altMap[alt.desiToolId]) altMap[alt.desiToolId] = [];
        altMap[alt.desiToolId].push({ name: alt.globalName, slug: alt.globalSlug });
      }
    }

    // Map counts and tools
    allTools = rawTools.map((t) => {
      const catSlug = t.categorySlug || 'other';
      categoryCounts[catSlug] = (categoryCounts[catSlug] || 0) + 1;

      return {
        ...t,
        alternatives: altMap[t.id] || [],
      };
    });
  } catch (err) {
    console.error('Failed to load tools from DB:', err);
  }
}

// Filter tools if active category is selected
const displayedTools = activeCategory === 'all'
  ? allTools
  : allTools.filter((t) => t.categorySlug === activeCategory);

const categoryOptions = allCategories.map((c) => ({
  id: c.id,
  slug: c.slug,
  name: c.name,
  emoji: c.emoji,
  count: categoryCounts[c.slug] || 0,
}));
---

<BaseLayout>
  <Navbar />

  <main class="relative overflow-hidden">
    <!-- Ambient Background Mesh Glows -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[450px] bg-gradient-to-b from-amber-200/30 via-amber-100/10 to-transparent blur-3xl -z-10"></div>
    <div class="pointer-events-none absolute top-96 -left-32 w-96 h-96 bg-primary/5 rounded-full blur-3xl -z-10"></div>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-200/80 bg-amber-50/90 px-4 py-1.5 text-xs font-semibold text-amber-900 shadow-2xs backdrop-blur-xs">
          <span>🇮🇳 The Sovereign Tech Directory</span>
        </div>

        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl text-foreground leading-[1.18] max-w-4xl mx-auto">
          World-Class Products. <span class="font-serif-editorial italic font-bold text-primary">Built in Bharat,</span> Priced for You.
        </h1>

        <p class="mt-6 text-base leading-relaxed text-muted-foreground sm:text-lg max-w-2xl mx-auto">
          Replace your global stack without compromise. Switch to homegrown products built by Indians, for Indian workflows, and secured strictly inside Indian borders.
        </p>

        <!-- Sovereign Value Pillars Ribbon -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-semibold text-foreground/80">
          <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white/80 px-3 py-1 shadow-2xs">
            <span class="text-amber-600">🧾</span>
            <span>18% GST Input Credit</span>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white/80 px-3 py-1 shadow-2xs">
            <span class="text-emerald-600">💳</span>
            <span>Zero Forex Markups</span>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white/80 px-3 py-1 shadow-2xs">
            <span class="text-blue-600">🇮🇳</span>
            <span>India Data Residency</span>
          </div>
          <div class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white/80 px-3 py-1 shadow-2xs">
            <span class="text-purple-600">⚡</span>
            <span>Native INR &amp; UPI</span>
          </div>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="mt-14" id="categories">
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <span class="h-3 w-1 bg-primary rounded-full"></span>
            <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">Directory Catalog</h2>
          </div>
          <span class="text-xs text-muted-foreground">{displayedTools.length} tools indexed</span>
        </div>
        <CategoryFilter categories={categoryOptions} activeCategory={activeCategory} />
      </div>

      <!-- Tools Directory Grid -->
      <div class="mt-6">
        {displayedTools.length === 0 ? (
          <div class="rounded-3xl border border-dashed border-border py-16 text-center bg-slate-50/50">
            <p class="text-sm font-semibold text-foreground">No Indian tools found in this category yet.</p>
            <p class="mt-1 text-xs text-muted-foreground">Are you building something awesome in this vertical?</p>
            <a
              href="/submit"
              class="mt-4 inline-flex items-center rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
            >
              Submit Your Tool
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {displayedTools.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        )}
      </div>

      <!-- Founder & Maker Callout Banner -->
      <div class="mt-16 rounded-3xl border border-border bg-gradient-to-br from-slate-50 via-white to-amber-50/40 p-8 sm:p-10 shadow-xs flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left max-w-xl">
          <div class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 text-amber-900 px-2.5 py-0.5 text-[10px] font-bold">
            <span>🇮🇳</span>
            <span>For Founders &amp; Engineering Teams</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-foreground">
            Building software, dev tools, or hardware in India?
          </h3>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Get your product in front of thousands of Indian developers, CTOs, and founders actively looking for homegrown alternatives. Free forever listing.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full sm:w-auto">
          <a
            href="/submit"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
          >
            Submit Tool for Free
          </a>
          <a
            href="/about"
            class="w-full sm:w-auto inline-flex items-center justify-center rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
          >
            Read Manifesto
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
