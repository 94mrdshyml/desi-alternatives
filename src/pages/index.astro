---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight">
        <span>Desi</span>
        <span class="font-serif-editorial italic text-primary">Alternatives</span>
      </a>

      <div class="flex items-center gap-3">
        <button
          type="button"
          class="flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground shadow-sm transition hover:border-primary/40 hover:text-foreground"
        >
          <span>Quick Search</span>
          <kbd class="rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">⌘K</kbd>
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
        <span>🇮🇳 Sovereign Indian SaaS Directory</span>
      </div>

      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
        Discover <span class="font-serif-editorial italic font-normal text-primary">sovereign</span> Indian software for your stack
      </h1>

      <p class="mt-6 text-base leading-relaxed text-muted-foreground sm:text-lg">
        Replace expensive international subscriptions. Sovereign data residency, direct UPI/INR pricing, GST input tax credits, and responsive IST support.
      </p>
    </div>
  </main>
</BaseLayout>
