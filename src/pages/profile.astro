---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import { users, newsletterSubscribers, desiTools, toolReviews, userToolUsage } from '@/lib/server/db/schema';
import { eq, or, desc } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

if (!user) {
  return Astro.redirect('/login');
}

let dbUser: any = null;
let userSubscriber: any = null;
let userReviews: any[] = [];
let userToolsUsed: any[] = [];

if (db) {
  try {
    dbUser = await db.select().from(users).where(eq(users.id, user.id)).get();
    userSubscriber = await db
      .select()
      .from(newsletterSubscribers)
      .where(or(eq(newsletterSubscribers.userId, user.id), eq(newsletterSubscribers.email, user.email.toLowerCase())))
      .get();

    // 1. Fetch user reviews
    userReviews = await db
      .select({
        id: toolReviews.id,
        toolId: toolReviews.toolId,
        toolName: desiTools.name,
        toolSlug: desiTools.slug,
        toolLogoUrl: desiTools.logoUrl,
        rating: toolReviews.rating,
        title: toolReviews.title,
        content: toolReviews.content,
        helpfulCount: toolReviews.helpfulCount,
        createdAt: toolReviews.createdAt,
      })
      .from(toolReviews)
      .leftJoin(desiTools, eq(toolReviews.toolId, desiTools.id))
      .where(eq(toolReviews.userId, user.id))
      .orderBy(desc(toolReviews.createdAt))
      .all();

    // 2. Fetch user tools used
    userToolsUsed = await db
      .select({
        id: userToolUsage.id,
        toolId: userToolUsage.toolId,
        toolName: desiTools.name,
        toolSlug: desiTools.slug,
        toolLogoUrl: desiTools.logoUrl,
        toolTagline: desiTools.tagline,
        createdAt: userToolUsage.createdAt,
      })
      .from(userToolUsage)
      .leftJoin(desiTools, eq(userToolUsage.toolId, desiTools.id))
      .where(eq(userToolUsage.userId, user.id))
      .orderBy(desc(userToolUsage.createdAt))
      .all();
  } catch (e) {
    console.error('Failed to load user profile data:', e);
  }
}

const currentUser = dbUser || user;
const isSubscribed = userSubscriber?.status === 'subscribed';
const avatarUrl = currentUser.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(currentUser.name || 'Desi')}`;

// Unified chronological activity feed
type ActivityFeedItem = {
  id: string;
  type: 'review' | 'tool_used';
  toolName: string;
  toolSlug: string;
  toolLogoUrl: string;
  rating?: number;
  title?: string;
  content?: string;
  helpfulCount?: number;
  toolTagline?: string;
  createdAt: string;
};

const activityFeed: ActivityFeedItem[] = [
  ...userReviews.map((r) => ({
    id: r.id,
    type: 'review' as const,
    toolName: r.toolName || 'Indian Software',
    toolSlug: r.toolSlug || '',
    toolLogoUrl: r.toolLogoUrl || '',
    rating: r.rating,
    title: r.title,
    content: r.content,
    helpfulCount: r.helpfulCount || 0,
    createdAt: r.createdAt,
  })),
  ...userToolsUsed.map((u) => ({
    id: u.id,
    type: 'tool_used' as const,
    toolName: u.toolName || 'Indian Software',
    toolSlug: u.toolSlug || '',
    toolLogoUrl: u.toolLogoUrl || '',
    toolTagline: u.toolTagline || '',
    createdAt: u.createdAt,
  })),
].sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

const totalHelpfulReceived = userReviews.reduce((acc, r) => acc + (r.helpfulCount || 0), 0);
---

<BaseLayout title="My Profile & Builder Activity — Desi Alternatives">
  <Navbar />

  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="border-b border-border pb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Builder Dashboard</h1>
          {currentUser.role === 'admin' && (
            <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-bold text-amber-800 uppercase">
              Admin
            </span>
          )}
        </div>
        <p class="mt-1 text-xs sm:text-sm text-muted-foreground">
          Track your Indian tech stack, reviews, endorsements, and account preferences.
        </p>
      </div>

      <!-- Navigation Tabs -->
      <div class="flex items-center gap-2 bg-slate-100 p-1.5 rounded-2xl border border-border/80 self-start sm:self-auto">
        <button
          type="button"
          data-tab="activity"
          class="profile-tab-btn inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs transition cursor-pointer"
        >
          <span>🕒 Activity & Stack</span>
          <span class="rounded-full bg-primary-foreground/20 px-1.5 py-0.2 text-[10px] font-mono">
            {activityFeed.length}
          </span>
        </button>

        <button
          type="button"
          data-tab="settings"
          class="profile-tab-btn inline-flex items-center gap-2 rounded-xl border border-transparent bg-transparent px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition cursor-pointer"
        >
          <span>⚙️ Account Settings</span>
        </button>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Left Column: Avatar & Builder Summary Card -->
      <div class="space-y-6 md:col-span-1">
        <div class="rounded-2xl border border-border bg-white p-6 text-center shadow-xs sticky top-20">
          <div class="relative mx-auto h-28 w-28 overflow-hidden rounded-full border-4 border-amber-100 bg-amber-50 shadow-inner flex items-center justify-center p-3">
            <img
              id="avatar-preview"
              src={avatarUrl}
              alt={currentUser.name || 'User avatar'}
              class="h-full w-full object-contain"
            />
          </div>

          <h2 class="mt-4 text-base font-bold text-foreground">{currentUser.name}</h2>
          <p class="text-xs font-semibold text-primary">@{currentUser.username || 'username'}</p>
          <p class="mt-1 text-xs text-muted-foreground truncate">{currentUser.email}</p>

          <!-- Quick Stats Pills -->
          <div class="mt-5 grid grid-cols-3 gap-2 border-t border-border pt-4 text-center">
            <div class="rounded-xl bg-slate-50 p-2 border border-border/60">
              <span class="block text-xs font-bold text-foreground font-mono">{userReviews.length}</span>
              <span class="block text-[10px] text-muted-foreground">Reviews</span>
            </div>
            <div class="rounded-xl bg-emerald-50/60 p-2 border border-emerald-200/60">
              <span class="block text-xs font-bold text-emerald-800 font-mono">{userToolsUsed.length}</span>
              <span class="block text-[10px] text-emerald-700">Tools Used</span>
            </div>
            <div class="rounded-xl bg-amber-50/60 p-2 border border-amber-200/60">
              <span class="block text-xs font-bold text-amber-800 font-mono">{totalHelpfulReceived}</span>
              <span class="block text-[10px] text-amber-700">Helpful</span>
            </div>
          </div>

          <!-- Avatar Uploader -->
          <div class="mt-5 border-t border-border pt-4 text-left">
            <label class="block text-xs font-semibold text-foreground mb-1.5">Change Avatar</label>
            <div class="flex flex-col gap-2">
              <label class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-white px-3 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 cursor-pointer transition shadow-2xs">
                <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Upload Custom Photo</span>
                <input type="file" id="avatar-file-input" accept="image/*" class="hidden" />
              </label>

              <button
                type="button"
                id="dicebear-avatar-btn"
                class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-slate-50 px-3 py-2 text-xs font-semibold text-foreground/80 hover:bg-slate-100 transition cursor-pointer"
              >
                <span>🎲 Randomize Glyph Avatar</span>
              </button>
            </div>
            <span id="avatar-upload-status" class="mt-1.5 block text-[11px] text-muted-foreground"></span>
          </div>
        </div>
      </div>

      <!-- Right Column: Tab Panes -->
      <div class="space-y-6 md:col-span-2">
        <!-- ========================================== -->
        <!-- TAB 1: ACTIVITY & TIMELINE PANE -->
        <!-- ========================================== -->
        <div id="tab-pane-activity" class="profile-tab-pane space-y-6">
          <div class="rounded-2xl border border-border bg-white p-6 shadow-xs">
            <div class="flex items-center justify-between pb-4 border-b border-border">
              <div>
                <h2 class="text-base font-bold text-foreground flex items-center gap-2">
                  <span>🕒 Activity Timeline</span>
                  <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-700">
                    {activityFeed.length} {activityFeed.length === 1 ? 'Action' : 'Actions'}
                  </span>
                </h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                  Complete record of your reviews, ratings, and tools marked as actively used.
                </p>
              </div>

              <a
                href="/"
                class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:text-primary-hover"
              >
                <span>Browse Directory</span>
                <span>→</span>
              </a>
            </div>

            <!-- Activity List Feed -->
            <div class="mt-6">
              {activityFeed.length === 0 ? (
                <div class="rounded-xl border border-dashed border-border bg-slate-50/50 p-8 text-center">
                  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 text-xl mb-3">
                    🚀
                  </div>
                  <h3 class="text-sm font-bold text-foreground">No activity recorded yet</h3>
                  <p class="mt-1 text-xs text-muted-foreground max-w-sm mx-auto">
                    Start exploring Indian software, mark the tools in your active tech stack, or leave verified feedback!
                  </p>
                  <div class="mt-4 flex items-center justify-center gap-3">
                    <a
                      href="/"
                      class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
                    >
                      <span>🇮🇳 Explore Tools</span>
                    </a>
                  </div>
                </div>
              ) : (
                <div class="relative border-l-2 border-slate-200 ml-4 space-y-6 pb-2">
                  {activityFeed.map((item) => {
                    const dateObj = new Date(item.createdAt);
                    const formattedDate = dateObj.toLocaleDateString('en-IN', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    });
                    const formattedTime = dateObj.toLocaleTimeString('en-IN', {
                      hour: '2-digit',
                      minute: '2-digit',
                    });

                    return (
                      <div class="relative pl-6 group">
                        <!-- Timeline Bullet Node -->
                        <span class={`absolute -left-[9px] top-1 h-4 w-4 rounded-full border-2 border-white shadow-xs ${
                          item.type === 'review' ? 'bg-amber-500' : 'bg-emerald-500'
                        }`}></span>

                        <!-- Action Card -->
                        <div class="rounded-xl border border-border bg-white p-4 shadow-2xs hover:border-slate-300 transition">
                          <!-- Action Header -->
                          <div class="flex flex-wrap items-start justify-between gap-2">
                            <div class="flex items-center gap-2.5">
                              {item.toolLogoUrl && (
                                <img
                                  src={item.toolLogoUrl}
                                  alt={item.toolName}
                                  class="h-7 w-7 rounded-lg object-contain border border-border/60 bg-white p-0.5 shrink-0"
                                />
                              )}
                              <div>
                                <div class="flex items-center gap-1.5">
                                  <span class="text-xs font-bold text-foreground">
                                    {item.type === 'review' ? '✍️ Reviewed' : '⚡ Uses in Tech Stack:'}
                                  </span>
                                  <a
                                    href={`/tools/${item.toolSlug}`}
                                    class="text-xs font-bold text-primary hover:underline"
                                  >
                                    {item.toolName}
                                  </a>
                                </div>
                                <span class="text-[10px] text-muted-foreground">
                                  {formattedDate} at {formattedTime}
                                </span>
                              </div>
                            </div>

                            <!-- Badges / Rating -->
                            {item.type === 'review' ? (
                              <div class="flex items-center gap-1 text-amber-500 text-xs">
                                {Array.from({ length: Math.round(item.rating || 5) }).map(() => (
                                  <span>★</span>
                                ))}
                                <span class="text-[11px] font-bold text-foreground ml-1">{item.rating}.0</span>
                              </div>
                            ) : (
                              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-800 border border-emerald-200">
                                ✓ In Stack
                              </span>
                            )}
                          </div>

                          <!-- Review Content Snippet -->
                          {item.type === 'review' && (
                            <div class="mt-2.5 pt-2 border-t border-border/60 text-xs">
                              {item.title && <h4 class="font-bold text-foreground mb-0.5">{item.title}</h4>}
                              <p class="text-muted-foreground leading-relaxed">"{item.content}"</p>
                              {typeof item.helpfulCount === 'number' && item.helpfulCount > 0 && (
                                <span class="mt-2 inline-flex items-center gap-1 text-[10px] font-medium text-emerald-700 bg-emerald-50/80 px-2 py-0.5 rounded-md">
                                  👍 {item.helpfulCount} people found this helpful
                                </span>
                              )}
                            </div>
                          )}

                          <!-- Tool Used Tagline -->
                          {item.type === 'tool_used' && item.toolTagline && (
                            <p class="mt-2 text-xs text-muted-foreground">
                              {item.toolTagline}
                            </p>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: ACCOUNT SETTINGS PANE -->
        <!-- ========================================== -->
        <div id="tab-pane-settings" class="profile-tab-pane space-y-6 hidden">
          <!-- 1. Personal Information Form -->
          <section class="rounded-2xl border border-border bg-white p-6 sm:p-7 shadow-xs">
            <h2 class="text-base font-bold text-foreground">Personal Information</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Update your identity and display username</p>

            <form id="profile-info-form" class="mt-5 space-y-4">
              <input type="hidden" id="avatar-url-hidden" name="image" value={currentUser.image || ''} />

              <!-- First Name & Last Name -->
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="firstName" class="block text-xs font-semibold text-foreground">First Name *</label>
                  <input
                    type="text"
                    id="firstName"
                    name="firstName"
                    required
                    value={currentUser.firstName || currentUser.name?.split(' ')[0] || ''}
                    class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>

                <div>
                  <label for="lastName" class="block text-xs font-semibold text-foreground">Last Name</label>
                  <input
                    type="text"
                    id="lastName"
                    name="lastName"
                    value={currentUser.lastName || currentUser.name?.split(' ').slice(1).join(' ') || ''}
                    class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
              </div>

              <!-- Username with Funny Generator -->
              <div>
                <div class="flex items-center justify-between">
                  <label for="username" class="block text-xs font-semibold text-foreground">Username *</label>
                  <button
                    type="button"
                    id="generate-username-btn"
                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-primary hover:text-primary-hover cursor-pointer"
                  >
                    <span>🎲 Generate Funny Username</span>
                  </button>
                </div>
                <div class="mt-1 flex rounded-xl border border-border bg-slate-50 focus-within:border-primary">
                  <span class="inline-flex items-center pl-3 text-xs text-muted-foreground font-mono">@</span>
                  <input
                    type="text"
                    id="username-input"
                    name="username"
                    required
                    value={currentUser.username || ''}
                    placeholder="cosmic-samosa-42"
                    class="w-full bg-transparent px-2 py-2 text-xs text-foreground font-mono focus:outline-none"
                  />
                </div>
                <p class="mt-1 text-[11px] text-muted-foreground">Unique handle for community submissions and comments.</p>
              </div>

              <!-- Email (Read Only) -->
              <div>
                <label class="block text-xs font-semibold text-foreground">Email Address</label>
                <input
                  type="email"
                  disabled
                  value={currentUser.email}
                  class="mt-1 w-full rounded-xl border border-border bg-slate-100 px-3.5 py-2 text-xs text-muted-foreground cursor-not-allowed"
                />
              </div>

              <div id="profile-status" class="hidden rounded-xl p-3 text-xs font-medium"></div>

              <button
                type="submit"
                id="save-profile-btn"
                class="rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
              >
                Save Profile Changes
              </button>
            </form>
          </section>

          <!-- 2. Change Password Form -->
          <section class="rounded-2xl border border-border bg-white p-6 sm:p-7 shadow-xs">
            <h2 class="text-base font-bold text-foreground">Security & Password</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Update your password to keep your account secure</p>

            <form id="change-password-form" class="mt-5 space-y-4">
              <div>
                <label for="currentPassword" class="block text-xs font-semibold text-foreground">Current Password *</label>
                <input
                  type="password"
                  id="currentPassword"
                  name="currentPassword"
                  required
                  autocomplete="current-password"
                  class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                />
              </div>

              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <div>
                  <label for="newPassword" class="block text-xs font-semibold text-foreground">New Password *</label>
                  <input
                    type="password"
                    id="newPassword"
                    name="newPassword"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>

                <div>
                  <label for="confirmPassword" class="block text-xs font-semibold text-foreground">Confirm New Password *</label>
                  <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    required
                    minlength="8"
                    autocomplete="new-password"
                    class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
                  />
                </div>
              </div>

              <div id="password-status" class="hidden rounded-xl p-3 text-xs font-medium"></div>

              <button
                type="submit"
                id="save-password-btn"
                class="rounded-xl border border-border bg-white px-5 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition cursor-pointer"
              >
                Update Password
              </button>
            </form>
          </section>

          <!-- 3. Newsletter & Tech Digest -->
          <section class="rounded-2xl border border-border bg-white p-6 sm:p-7 shadow-xs">
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="flex items-center gap-2">
                  <h2 class="text-base font-bold text-foreground">Desi Alternatives Dispatch</h2>
                  <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800 uppercase tracking-wider">
                    Weekly Digest
                  </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                  Curated weekly intelligence on sovereign Indian software, SaaS alternatives, and engineering blueprints.
                </p>
              </div>
              <div class="hidden sm:flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
            </div>

            <div class="mt-5 rounded-xl border border-border bg-slate-50/70 p-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold text-foreground">Subscription Status:</span>
                    <span
                      id="newsletter-status-pill"
                      class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-bold ${
                        isSubscribed
                          ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                          : 'bg-slate-200 text-slate-700'
                      }`}
                    >
                      <span class={`h-1.5 w-1.5 rounded-full ${isSubscribed ? 'bg-emerald-500' : 'bg-slate-400'}`}></span>
                      <span id="newsletter-status-text">{isSubscribed ? 'SUBSCRIBED' : 'NOT SUBSCRIBED'}</span>
                    </span>
                  </div>
                  {userSubscriber && isSubscribed && (
                    <p class="mt-1 text-[11px] text-muted-foreground">
                      Origin: <span class="font-semibold capitalize">{userSubscriber.source.replace('_', ' ')}</span>
                    </p>
                  )}
                </div>

                <div>
                  <button
                    type="button"
                    id="newsletter-toggle-btn"
                    data-subscribed={isSubscribed ? 'true' : 'false'}
                    data-email={currentUser.email}
                    data-name={currentUser.name}
                    class={`rounded-xl px-4 py-2 text-xs font-semibold transition cursor-pointer shadow-2xs ${
                      isSubscribed
                        ? 'border border-red-200 bg-white text-red-700 hover:bg-red-50'
                        : 'bg-primary text-primary-foreground hover:bg-primary-hover shadow-xs'
                    }`}
                  >
                    {isSubscribed ? 'Unsubscribe from Dispatch' : 'Subscribe to Dispatch'}
                  </button>
                </div>
              </div>
              <div id="newsletter-feedback" class="hidden mt-3 rounded-lg p-2.5 text-xs font-medium"></div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { changePassword } from '@/lib/auth-client';
  import { trackEvent } from '@/lib/client/analytics';

  // 1. Tab Switching (Activity Timeline vs Settings)
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.profile-tab-btn');
  const tabPanes = document.querySelectorAll<HTMLElement>('.profile-tab-pane');

  function switchTab(tabId: string) {
    tabPanes.forEach((pane) => {
      if (pane.id === `tab-pane-${tabId}`) {
        pane.classList.remove('hidden');
      } else {
        pane.classList.add('hidden');
      }
    });

    tabButtons.forEach((btn) => {
      if (btn.getAttribute('data-tab') === tabId) {
        btn.className = 'profile-tab-btn inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-xs transition cursor-pointer';
      } else {
        btn.className = 'profile-tab-btn inline-flex items-center gap-2 rounded-xl border border-transparent bg-transparent px-4 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground transition cursor-pointer';
      }
    });

    if (window.history.replaceState) {
      window.history.replaceState(null, '', `#${tabId}`);
    }
  }

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');
      if (tabId) switchTab(tabId);
    });
  });

  // Check URL hash on page load
  if (window.location.hash) {
    const hash = window.location.hash.replace('#', '');
    if (hash === 'settings' || hash === 'activity') {
      switchTab(hash);
    }
  }

  // 2. Funny Username Generator
  const generateUsernameBtn = document.getElementById('generate-username-btn');
  const usernameInput = document.getElementById('username-input') as HTMLInputElement | null;
  const avatarPreview = document.getElementById('avatar-preview') as HTMLImageElement | null;
  const avatarUrlHidden = document.getElementById('avatar-url-hidden') as HTMLInputElement | null;

  if (generateUsernameBtn && usernameInput) {
    generateUsernameBtn.addEventListener('click', async () => {
      generateUsernameBtn.textContent = 'Generating...';
      try {
        const res = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'generateUsername' }),
        });
        const data = (await res.json()) as any;
        if (data.username) {
          usernameInput.value = data.username;
        }
      } finally {
        generateUsernameBtn.textContent = '🎲 Generate Funny Username';
      }
    });
  }

  // 3. Randomize Glyph Avatar
  const dicebearBtn = document.getElementById('dicebear-avatar-btn');
  if (dicebearBtn && avatarPreview && avatarUrlHidden) {
    dicebearBtn.addEventListener('click', () => {
      const seed = Math.random().toString(36).substring(2, 10);
      const newAvatar = `https://api.dicebear.com/9.x/identicon/svg?seed=${seed}`;
      avatarPreview.src = newAvatar;
      avatarUrlHidden.value = newAvatar;
    });
  }

  // 4. Custom Avatar R2 Upload
  const avatarFileInput = document.getElementById('avatar-file-input') as HTMLInputElement | null;
  const avatarUploadStatus = document.getElementById('avatar-upload-status');

  if (avatarFileInput && avatarPreview && avatarUrlHidden && avatarUploadStatus) {
    avatarFileInput.addEventListener('change', async () => {
      const file = avatarFileInput.files?.[0];
      if (!file) return;

      avatarUploadStatus.textContent = 'Uploading avatar to R2...';
      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData,
        });
        const data = (await res.json()) as any;
        if (res.ok && data.url) {
          avatarPreview.src = data.url;
          avatarUrlHidden.value = data.url;
          avatarUploadStatus.textContent = 'Avatar uploaded successfully!';
        } else {
          avatarUploadStatus.textContent = data.error || 'Upload failed.';
        }
      } catch {
        avatarUploadStatus.textContent = 'Upload network error.';
      }
    });
  }

  // 5. Save Profile Info
  const profileForm = document.getElementById('profile-info-form') as HTMLFormElement | null;
  const profileStatus = document.getElementById('profile-status');
  const saveProfileBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;

  if (profileForm && profileStatus && saveProfileBtn) {
    profileForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      profileStatus.className = 'hidden rounded-xl p-3 text-xs font-medium';
      saveProfileBtn.disabled = true;
      saveProfileBtn.textContent = 'Saving...';

      const formData = new FormData(profileForm);
      const payload = {
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        username: formData.get('username'),
        image: avatarUrlHidden?.value || formData.get('image'),
      };

      try {
        const res = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json()) as any;

        if (res.ok) {
          profileStatus.textContent = 'Profile changes saved successfully!';
          profileStatus.className = 'rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 p-3 text-xs font-semibold';
          setTimeout(() => window.location.reload(), 1000);
        } else {
          profileStatus.textContent = data.error || 'Failed to update profile.';
          profileStatus.className = 'rounded-xl bg-red-50 text-red-800 border border-red-200 p-3 text-xs font-semibold';
        }
      } catch {
        profileStatus.textContent = 'Network error. Please try again.';
        profileStatus.className = 'rounded-xl bg-red-50 text-red-800 border border-red-200 p-3 text-xs font-semibold';
      } finally {
        saveProfileBtn.disabled = false;
        saveProfileBtn.textContent = 'Save Profile Changes';
      }
    });
  }

  // 6. Change Password Form
  const passwordForm = document.getElementById('change-password-form') as HTMLFormElement | null;
  const passwordStatus = document.getElementById('password-status');
  const savePasswordBtn = document.getElementById('save-password-btn') as HTMLButtonElement | null;

  if (passwordForm && passwordStatus && savePasswordBtn) {
    passwordForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      passwordStatus.className = 'hidden rounded-xl p-3 text-xs font-medium';

      const formData = new FormData(passwordForm);
      const currentPassword = formData.get('currentPassword') as string;
      const newPassword = formData.get('newPassword') as string;
      const confirmPassword = formData.get('confirmPassword') as string;

      if (newPassword !== confirmPassword) {
        passwordStatus.textContent = 'New passwords do not match.';
        passwordStatus.className = 'rounded-xl bg-red-50 text-red-800 border border-red-200 p-3 text-xs font-semibold';
        return;
      }

      savePasswordBtn.disabled = true;
      savePasswordBtn.textContent = 'Updating...';

      try {
        const res = await changePassword({
          currentPassword,
          newPassword,
          revokeOtherSessions: true,
        });

        if (res.error) {
          passwordStatus.textContent = res.error.message || 'Failed to update password.';
          passwordStatus.className = 'rounded-xl bg-red-50 text-red-800 border border-red-200 p-3 text-xs font-semibold';
        } else {
          passwordStatus.textContent = 'Password updated successfully!';
          passwordStatus.className = 'rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 p-3 text-xs font-semibold';
          passwordForm.reset();
        }
      } catch (err: any) {
        passwordStatus.textContent = err.message || 'Password update failed.';
        passwordStatus.className = 'rounded-xl bg-red-50 text-red-800 border border-red-200 p-3 text-xs font-semibold';
      } finally {
        savePasswordBtn.disabled = false;
        savePasswordBtn.textContent = 'Update Password';
      }
    });
  }

  // 7. Newsletter Subscription Toggle
  const newsletterToggleBtn = document.getElementById('newsletter-toggle-btn') as HTMLButtonElement | null;
  const newsletterFeedback = document.getElementById('newsletter-feedback');
  const newsletterStatusPill = document.getElementById('newsletter-status-pill');
  const newsletterStatusText = document.getElementById('newsletter-status-text');

  if (newsletterToggleBtn && newsletterFeedback && newsletterStatusPill && newsletterStatusText) {
    newsletterToggleBtn.addEventListener('click', async () => {
      const currentlySubscribed = newsletterToggleBtn.dataset.subscribed === 'true';
      const email = newsletterToggleBtn.dataset.email;
      const name = newsletterToggleBtn.dataset.name;

      newsletterToggleBtn.disabled = true;
      newsletterToggleBtn.textContent = currentlySubscribed ? 'Unsubscribing...' : 'Subscribing...';
      newsletterFeedback.className = 'hidden mt-3 rounded-lg p-2.5 text-xs font-medium';

      try {
        if (currentlySubscribed) {
          // Unsubscribe call
          const res = await fetch('/api/newsletter/unsubscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          const data = (await res.json()) as any;

          if (res.ok) {
            newsletterToggleBtn.dataset.subscribed = 'false';
            newsletterToggleBtn.textContent = 'Subscribe to Dispatch';
            newsletterToggleBtn.className = 'rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition cursor-pointer';
            
            newsletterStatusPill.className = 'inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-bold bg-slate-200 text-slate-700';
            newsletterStatusText.textContent = 'NOT SUBSCRIBED';

            newsletterFeedback.textContent = data.message || 'You have been unsubscribed.';
            newsletterFeedback.className = 'mt-3 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 p-2.5 text-xs font-semibold block';
          } else {
            newsletterFeedback.textContent = data.error || 'Failed to unsubscribe.';
            newsletterFeedback.className = 'mt-3 rounded-lg bg-red-50 text-red-800 border border-red-200 p-2.5 text-xs font-semibold block';
            newsletterToggleBtn.textContent = 'Unsubscribe from Dispatch';
          }
        } else {
          // Subscribe call
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, name, source: 'profile' }),
          });
          const data = (await res.json()) as any;

          if (res.ok) {
            // 1. Analytics Events (3-in-1: First-Party, GA4, Umami)
            trackEvent('newsletter_subscribe', {
              source: 'profile',
            });

            newsletterToggleBtn.dataset.subscribed = 'true';
            newsletterToggleBtn.textContent = 'Unsubscribe from Dispatch';
            newsletterToggleBtn.className = 'rounded-xl border border-red-200 bg-white px-4 py-2 text-xs font-semibold text-red-700 hover:bg-red-50 shadow-2xs transition cursor-pointer';

            newsletterStatusPill.className = 'inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200';
            newsletterStatusText.textContent = 'SUBSCRIBED';

            newsletterFeedback.textContent = data.message || 'Subscribed successfully to the Dispatch!';
            newsletterFeedback.className = 'mt-3 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 p-2.5 text-xs font-semibold block';
          } else {
            newsletterFeedback.textContent = data.error || 'Failed to subscribe.';
            newsletterFeedback.className = 'mt-3 rounded-lg bg-red-50 text-red-800 border border-red-200 p-2.5 text-xs font-semibold block';
            newsletterToggleBtn.textContent = 'Subscribe to Dispatch';
          }
        }
      } catch (err) {
        newsletterFeedback.textContent = 'Network error. Please try again.';
        newsletterFeedback.className = 'mt-3 rounded-lg bg-red-50 text-red-800 border border-red-200 p-2.5 text-xs font-semibold block';
        newsletterToggleBtn.textContent = currentlySubscribed ? 'Unsubscribe from Dispatch' : 'Subscribe to Dispatch';
      } finally {
        newsletterToggleBtn.disabled = false;
      }
    });
  }
</script>
