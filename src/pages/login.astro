---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Sign In — Desi Alternatives"
  description="Sign in to your Desi Alternatives account using a secure 6-digit email verification code"
>
  <main class="flex min-h-screen flex-col justify-center px-4 py-12 sm:px-6 lg:px-8 bg-slate-50/50">
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
      <a href="/" class="inline-flex items-center gap-2 text-2xl font-bold tracking-tight text-foreground">
        <span>Desi</span>
        <span class="font-serif-editorial italic text-primary">Alternatives</span>
      </a>
      <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl text-foreground">
        Sign in with <span class="font-serif-editorial italic font-normal text-primary">Email Code</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-muted-foreground">
        Passwordless, fast & secure. We'll send a 6-digit numeric verification code to your inbox.
      </p>
    </div>

    <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="rounded-2xl border border-border bg-white p-6 shadow-xs sm:p-8">
        <!-- Error Banner -->
        <div id="error-message" class="hidden mb-5 rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700"></div>

        <!-- Success/Info Banner -->
        <div id="info-message" class="hidden mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800"></div>

        <!-- STEP 1: Enter Email -->
        <form id="email-step-form" class="space-y-4">
          <div>
            <label for="email-input" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              Work or Personal Email
            </label>
            <div class="mt-1.5">
              <input
                id="email-input"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="name@company.in"
                class="block w-full rounded-xl border border-input bg-white px-3.5 py-2.5 text-xs sm:text-sm text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
              />
            </div>
          </div>

          <button
            type="submit"
            id="send-code-btn"
            class="flex w-full justify-center rounded-xl bg-primary px-4 py-2.5 text-xs sm:text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition cursor-pointer disabled:opacity-50"
          >
            Send 6-Digit Code
          </button>
        </form>

        <!-- STEP 2: Enter 6-Digit OTP (Hidden Initially) -->
        <div id="otp-step-container" class="hidden space-y-5">
          <div class="rounded-xl border border-amber-200 bg-amber-50/60 p-3.5 text-center">
            <p class="text-xs text-foreground/80">
              Verification code sent to <strong id="display-email" class="text-primary font-semibold"></strong>
            </p>
            <button
              type="button"
              id="change-email-btn"
              class="mt-1 text-[11px] font-semibold text-primary hover:underline cursor-pointer"
            >
              Change email address
            </button>
          </div>

          <!-- 6-Box Numeric Input -->
          <div>
            <label class="block text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">
              Enter 6-Digit Code
            </label>
            <div class="flex justify-center gap-2 sm:gap-2.5" id="otp-inputs-group">
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" class="otp-box h-12 w-10 sm:w-11 text-center font-mono text-xl font-bold rounded-xl border border-input bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs" />
            </div>
          </div>

          <button
            type="button"
            id="verify-code-btn"
            class="flex w-full justify-center rounded-xl bg-primary px-4 py-2.5 text-xs sm:text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition cursor-pointer disabled:opacity-50"
          >
            Verify & Sign In
          </button>

          <div class="text-center text-xs text-muted-foreground">
            Didn't receive the code?{' '}
            <button
              type="button"
              id="resend-code-btn"
              class="font-semibold text-primary hover:underline cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Resend Code
            </button>
          </div>
        </div>

        <div class="mt-6 border-t border-border pt-5 text-center text-xs text-muted-foreground">
          Don't have an account?{' '}
          <a href="/register" class="font-semibold text-primary hover:underline">
            Get started
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { authClient } from '@/lib/auth-client';

    const emailForm = document.getElementById('email-step-form') as HTMLFormElement;
    const emailInput = document.getElementById('email-input') as HTMLInputElement;
    const sendCodeBtn = document.getElementById('send-code-btn') as HTMLButtonElement;
    const otpContainer = document.getElementById('otp-step-container') as HTMLDivElement;
    const displayEmail = document.getElementById('display-email') as HTMLElement;
    const changeEmailBtn = document.getElementById('change-email-btn') as HTMLButtonElement;
    const verifyBtn = document.getElementById('verify-code-btn') as HTMLButtonElement;
    const resendBtn = document.getElementById('resend-code-btn') as HTMLButtonElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;
    const infoDiv = document.getElementById('info-message') as HTMLDivElement;
    const otpBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.otp-box'));

    let currentEmail = '';
    let resendTimer: any = null;
    let resendCountdown = 30;

    function showError(msg: string) {
      if (infoDiv) infoDiv.classList.add('hidden');
      if (errorDiv) {
        errorDiv.textContent = msg;
        errorDiv.classList.remove('hidden');
      }
    }

    function showInfo(msg: string) {
      if (errorDiv) errorDiv.classList.add('hidden');
      if (infoDiv) {
        infoDiv.textContent = msg;
        infoDiv.classList.remove('hidden');
      }
    }

    function clearMessages() {
      if (errorDiv) errorDiv.classList.add('hidden');
      if (infoDiv) infoDiv.classList.add('hidden');
    }

    function startResendCountdown() {
      if (resendTimer) clearInterval(resendTimer);
      resendCountdown = 30;
      resendBtn.disabled = true;
      resendBtn.textContent = `Resend in ${resendCountdown}s`;

      resendTimer = setInterval(() => {
        resendCountdown -= 1;
        if (resendCountdown <= 0) {
          clearInterval(resendTimer);
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
        } else {
          resendBtn.textContent = `Resend in ${resendCountdown}s`;
        }
      }, 1000);
    }

    // Step 1: Send OTP
    async function handleSendOtp() {
      const email = emailInput?.value?.trim();
      if (!email) {
        showError('Please enter a valid email address.');
        return;
      }

      clearMessages();
      sendCodeBtn.disabled = true;
      sendCodeBtn.textContent = 'Sending 6-digit code...';

      try {
        const res = await authClient.emailOtp.sendVerificationOtp({
          email,
          type: 'sign-in',
        });

        if (res.error) {
          showError(res.error.message || 'Failed to send verification code.');
          sendCodeBtn.disabled = false;
          sendCodeBtn.textContent = 'Send 6-Digit Code';
          return;
        }

        currentEmail = email;
        displayEmail.textContent = email;
        emailForm.classList.add('hidden');
        otpContainer.classList.remove('hidden');
        showInfo('6-digit code sent! Check your inbox (and spam folder).');
        startResendCountdown();

        // Focus first box
        otpBoxes[0]?.focus();
      } catch (err: any) {
        showError(err.message || 'Something went wrong. Please try again.');
        sendCodeBtn.disabled = false;
        sendCodeBtn.textContent = 'Send 6-Digit Code';
      }
    }

    emailForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSendOtp();
    });

    changeEmailBtn?.addEventListener('click', () => {
      otpContainer.classList.add('hidden');
      emailForm.classList.remove('hidden');
      clearMessages();
      sendCodeBtn.disabled = false;
      sendCodeBtn.textContent = 'Send 6-Digit Code';
      emailInput.focus();
    });

    resendBtn?.addEventListener('click', async () => {
      if (!currentEmail || resendCountdown > 0) return;
      clearMessages();
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';

      try {
        const res = await authClient.emailOtp.sendVerificationOtp({
          email: currentEmail,
          type: 'sign-in',
        });

        if (res.error) {
          showError(res.error.message || 'Failed to resend verification code.');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
        } else {
          showInfo('New 6-digit code sent to your inbox!');
          startResendCountdown();
        }
      } catch {
        showError('Network error while resending code.');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Code';
      }
    });

    // OTP Boxes Auto-Advance & Paste Handlers
    otpBoxes.forEach((box, idx) => {
      box.addEventListener('input', (e) => {
        const input = e.target as HTMLInputElement;
        const val = input.value.replace(/\D/g, '');
        input.value = val ? val[val.length - 1] : '';

        if (input.value && idx < otpBoxes.length - 1) {
          otpBoxes[idx + 1].focus();
        }

        // If all 6 filled, trigger verification automatically
        const currentCode = otpBoxes.map((b) => b.value).join('');
        if (currentCode.length === 6) {
          handleVerifyOtp();
        }
      });

      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && idx > 0) {
          otpBoxes[idx - 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasted = e.clipboardData?.getData('text') || '';
        const digits = pasted.replace(/\D/g, '').slice(0, 6);
        if (!digits) return;

        digits.split('').forEach((d, i) => {
          if (otpBoxes[i]) otpBoxes[i].value = d;
        });

        const nextFocus = Math.min(digits.length, otpBoxes.length - 1);
        otpBoxes[nextFocus]?.focus();

        if (digits.length === 6) {
          handleVerifyOtp();
        }
      });
    });

    // Step 2: Verify OTP
    async function handleVerifyOtp() {
      const code = otpBoxes.map((b) => b.value).join('');
      if (code.length !== 6) {
        showError('Please enter the full 6-digit code.');
        return;
      }

      clearMessages();
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying...';

      try {
        const res = await authClient.signIn.emailOtp({
          email: currentEmail,
          otp: code,
        });

        if (res.error) {
          showError(res.error.message || 'Invalid or expired verification code.');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Verify & Sign In';
          otpBoxes.forEach((b) => (b.value = ''));
          otpBoxes[0]?.focus();
        } else {
          showInfo('Verification successful! Redirecting...');
          window.location.href = '/';
        }
      } catch (err: any) {
        showError(err.message || 'Verification failed. Please try again.');
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify & Sign In';
      }
    }

    verifyBtn?.addEventListener('click', handleVerifyOtp);
  </script>
</BaseLayout>
