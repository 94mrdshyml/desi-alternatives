---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { desiTools, globalTools, toolPricingPlans, categories, toolAlternatives } from '@/lib/server/db/schema';
import { eq, asc } from 'drizzle-orm';

const db = Astro.locals.db;
const { comparison } = Astro.params;

if (!comparison || !comparison.includes('-vs-')) {
  return Astro.redirect('/compare');
}

const parts = comparison.split('-vs-');
const slugA = parts[0]?.trim();
const slugB = parts[1]?.trim();

if (!slugA || !slugB) {
  return Astro.redirect('/compare');
}

let desiTool: any = null;
let globalTool: any = null;
let pricingPlansDesi: any[] = [];
let categoryInfo: any = null;
let relatedComparisons: any[] = [];

const USD_TO_INR_RATE = 86;

if (db) {
  try {
    // 1. Fetch potential Desi and Global candidates
    const [foundDesiA, foundGlobalA, foundDesiB, foundGlobalB] = await Promise.all([
      db.select().from(desiTools).where(eq(desiTools.slug, slugA)).get(),
      db.select().from(globalTools).where(eq(globalTools.slug, slugA)).get(),
      db.select().from(desiTools).where(eq(desiTools.slug, slugB)).get(),
      db.select().from(globalTools).where(eq(globalTools.slug, slugB)).get(),
    ]);

    if (foundDesiA && foundGlobalB) {
      desiTool = foundDesiA;
      globalTool = foundGlobalB;
    } else if (foundGlobalA && foundDesiB) {
      desiTool = foundDesiB;
      globalTool = foundGlobalA;
    }

    if (desiTool && globalTool) {
      // Fetch pricing plans for the Desi tool
      pricingPlansDesi = await db
        .select()
        .from(toolPricingPlans)
        .where(eq(toolPricingPlans.toolId, desiTool.id))
        .orderBy(asc(toolPricingPlans.sortOrder))
        .all();

      // Fetch category info
      if (desiTool.categoryId) {
        categoryInfo = await db
          .select()
          .from(categories)
          .where(eq(categories.id, desiTool.categoryId))
          .get();

        // Fetch related comparisons in same category
        try {
          const rawRelated = await db
            .select({
              desiSlug: desiTools.slug,
              desiName: desiTools.name,
              desiLogo: desiTools.logoUrl,
              globalSlug: globalTools.slug,
              globalName: globalTools.name,
              globalLogo: globalTools.logoUrl,
            })
            .from(toolAlternatives)
            .leftJoin(desiTools, eq(toolAlternatives.desiToolId, desiTools.id))
            .leftJoin(globalTools, eq(toolAlternatives.globalToolId, globalTools.id))
            .where(eq(desiTools.categoryId, desiTool.categoryId))
            .all();

          relatedComparisons = rawRelated
            .filter((r) => r.desiSlug && r.globalSlug && !(r.desiSlug === desiTool.slug && r.globalSlug === globalTool.slug))
            .slice(0, 4);
        } catch {
          relatedComparisons = [];
        }
      }
    }
  } catch (e) {
    console.error('Error resolving comparison tools:', e);
  }
}

// If not a valid Indian vs Global comparison, redirect to hub
if (!desiTool || !globalTool) {
  return Astro.redirect('/compare');
}

// Canonical URL is always [desi-slug]-vs-[global-slug]
const canonicalSlug = `${desiTool.slug}-vs-${globalTool.slug}`;
const canonicalUrl = `https://desialternatives.in/compare/${canonicalSlug}`;

// Helper: parse JSON array safely
function parseJsonArray(input: any): string[] {
  if (!input) return [];
  if (Array.isArray(input)) return input;
  try {
    const parsed = JSON.parse(input);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

// Helper: parse pricing plans safely
function parsePricingPlans(input: any): Array<{ planName?: string; priceInr?: number; priceUsd?: number | string; billingCycle?: string; highlights?: string[] }> {
  if (!input) return [];
  if (Array.isArray(input)) return input;
  try {
    const parsed = JSON.parse(input);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

const desiPros = parseJsonArray(desiTool.pros);
const desiCons = parseJsonArray(desiTool.cons);
const globalPros = parseJsonArray(globalTool.pros);
const globalCons = parseJsonArray(globalTool.cons || globalTool.foreignPainPoints);
const globalPricingList = parsePricingPlans(globalTool.pricingPlans);

// Default Pros & Cons fallbacks
const defaultDesiPros = [
  'Direct 18% GST input tax credit invoices for Indian businesses',
  'Zero foreign exchange markups (3.5%) or unpredictable USD billing surge',
  'Domestic Indian data residency compliant with DPDP regulations',
  'Dedicated engineering support operating during Indian Standard Time (IST)',
];

const defaultDesiCons = [
  'Ecosystem of third-party plugins is still expanding compared to decades-old incumbents',
  'Brand recognition in Western enterprise markets is emerging',
];

const defaultGlobalPros = [
  'Extensive global brand recognition and massive third-party integration catalog',
  'Decade-long feature development history and enterprise adoption',
];

const defaultGlobalCons = [
  'Invoices billed in USD with no 18% Indian GST input tax credit eligibility',
  'High cross-border forex fees and unpredictable USD-to-INR inflation surges',
  'Foreign cloud hosting regions creating friction for strict DPDP compliance',
  'Customer support ticket response times misaligned with Indian working hours',
];

const finalDesiPros = desiPros.length > 0 ? desiPros : defaultDesiPros;
const finalDesiCons = desiCons.length > 0 ? desiCons : defaultDesiCons;
const finalGlobalPros = globalPros.length > 0 ? globalPros : defaultGlobalPros;
const finalGlobalCons = globalCons.length > 0 ? globalCons : defaultGlobalCons;

// TCO Pricing Calculations
const desiMonthlyInr = desiTool.startingPriceInr ?? 0;
const globalMonthlyUsd = globalTool.startingPriceUsd ?? 0;
const globalMonthlyInr = globalMonthlyUsd * USD_TO_INR_RATE;

const monthlyDifferenceInr = Math.max(0, globalMonthlyInr - desiMonthlyInr);
const annualSavingsInr = monthlyDifferenceInr * 12;
const gstSavingsAnnualInr = desiMonthlyInr > 0 ? Math.round(desiMonthlyInr * 12 * 0.18) : 0;

// Programmatic FAQ Generation for JSON-LD & Rich Snippets
const programmaticFaqs = [
  {
    question: `Is ${desiTool.name} cheaper than ${globalTool.name}?`,
    answer: `${desiTool.name} starts from ${desiTool.startingPriceInr === 0 ? 'a generous Free tier' : `₹${desiTool.startingPriceInr.toLocaleString('en-IN')}/mo`}, while ${globalTool.name} starts from $${globalToolMonthlyUsd(globalTool.startingPriceUsd)}/mo (approx ₹${globalMonthlyInr.toLocaleString('en-IN')}/mo). Indian teams typically save significant software expenditure along with 18% GST tax credits.`,
  },
  {
    question: `Does ${desiTool.name} provide 18% GST tax invoices for Indian companies?`,
    answer: `Yes. ${desiTool.name} is an Indian entity providing official GST invoices with input tax credit (ITC) eligibility. ${globalTool.name} is billed in foreign currency (USD) without direct 18% Indian GST input tax credit.`,
  },
  {
    question: `Where is data stored for ${desiTool.name} vs ${globalTool.name}?`,
    answer: `${desiTool.name} offers domestic cloud hosting within Indian data regions, satisfying the requirements of India's Digital Personal Data Protection (DPDP) Act. ${globalTool.name} primarily hosts customer data in foreign cloud regions.`,
  },
  {
    question: `Can I migrate from ${globalTool.name} to ${desiTool.name}?`,
    answer: `Yes, ${desiTool.name} offers migration utilities, API integrations, and direct onboarding support to transition workloads from ${globalTool.name} with minimal friction.`,
  },
];

function globalToolMonthlyUsd(usd: number | null | undefined): string {
  return usd !== null && usd !== undefined ? usd.toString() : '0';
}

// Structured JSON-LD Data for SEO
const jsonLdData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': 'https://desialternatives.in',
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Comparison Engine',
          'item': 'https://desialternatives.in/compare',
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': `${desiTool.name} vs ${globalTool.name}`,
          'item': canonicalUrl,
        },
      ],
    },
    {
      '@type': 'SoftwareApplication',
      'name': desiTool.name,
      'applicationCategory': categoryInfo?.name || 'Software',
      'operatingSystem': 'Web, Cloud',
      'offers': {
        '@type': 'Offer',
        'price': (desiTool.startingPriceInr ?? 0).toString(),
        'priceCurrency': 'INR',
      },
    },
    {
      '@type': 'SoftwareApplication',
      'name': globalTool.name,
      'applicationCategory': categoryInfo?.name || 'Software',
      'operatingSystem': 'Web, Cloud',
      'offers': {
        '@type': 'Offer',
        'price': (globalTool.startingPriceUsd ?? 0).toString(),
        'priceCurrency': 'USD',
      },
    },
    {
      '@type': 'FAQPage',
      'mainEntity': programmaticFaqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={`${desiTool.name} vs ${globalTool.name} (2026): Detailed Breakdown, Pricing & 18% GST Savings`}
  description={`Comprehensive 2026 comparison: ${desiTool.name} (Indian Sovereign SaaS) vs ${globalTool.name}. Compare ₹ INR vs $ USD pricing, 18% GST tax credit, DPDP compliance, and feature pros & cons.`}
  canonicalUrl={canonicalUrl}
  ogImage={`/api/og/tool/${desiTool.slug}.png`}
  ogType="product"
>
  <!-- Schema.org Programmatic JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />

  <Navbar />

  <main class="min-h-screen bg-slate-50/50 pb-20 pt-6 sm:pt-10">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Comparison Engine', href: '/compare' },
          { label: `${desiTool.name} vs ${globalTool.name}` },
        ]}
        class="mb-6"
      />

      <!-- Hero Header Card -->
      <div class="rounded-3xl border border-border/80 bg-white p-6 sm:p-10 shadow-sm overflow-hidden relative">
        <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full bg-amber-500/5 blur-3xl pointer-events-none"></div>

        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-semibold text-amber-900">
            <span>⚖️</span>
            <span>Head-to-Head Teardown</span>
            <span class="text-amber-300">•</span>
            <span>{categoryInfo?.name || 'SaaS'}</span>
          </div>

          <div class="flex items-center gap-2">
            <a
              href="/compare"
              class="inline-flex items-center gap-1 rounded-lg border border-border bg-slate-50 px-2.5 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground transition"
            >
              <span>← All Comparisons</span>
            </a>
          </div>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          {desiTool.name} <span class="font-serif-editorial italic font-normal text-muted-foreground">vs</span> {globalTool.name}
        </h1>

        <p class="mt-3 text-sm sm:text-base text-muted-foreground max-w-3xl leading-relaxed">
          Comprehensive database comparison between sovereign Indian software <strong class="text-foreground">{desiTool.name}</strong> and global incumbent <strong class="text-foreground">{globalTool.name}</strong>.
        </p>

        <!-- Head to Head Matchup Cards -->
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 relative">
          <!-- Desi Tool Hero Pill -->
          <div class="rounded-2xl border-2 border-primary/30 bg-amber-50/20 p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 border border-emerald-200">
                  🇮🇳 Indian Sovereign SaaS
                </span>
                <span class="text-xs font-mono font-bold text-primary">RECOMMENDED</span>
              </div>

              <div class="mt-4 flex items-center gap-3">
                <div class="h-12 w-12 rounded-xl bg-white border border-border p-2 shadow-2xs shrink-0">
                  <img src={desiTool.logoUrl} alt={desiTool.name} class="h-full w-full object-contain" />
                </div>
                <div>
                  <h2 class="text-lg font-bold text-foreground">{desiTool.name}</h2>
                  <p class="text-xs text-muted-foreground line-clamp-1">{desiTool.tagline}</p>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-border/60 flex items-baseline justify-between text-xs">
              <span class="text-muted-foreground">Starting price:</span>
              <span class="font-extrabold text-foreground text-sm">
                {desiTool.startingPriceInr === 0 ? 'Free Tier' : `₹${desiTool.startingPriceInr?.toLocaleString('en-IN')}/mo`}
              </span>
            </div>
          </div>

          <!-- Global Tool Hero Pill -->
          <div class="rounded-2xl border border-border bg-slate-50/60 p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-slate-200 px-2.5 py-0.5 text-[11px] font-medium text-slate-700">
                  🌐 Global Incumbent
                </span>
                <span class="text-xs text-muted-foreground">{globalTool.country || 'Foreign'}</span>
              </div>

              <div class="mt-4 flex items-center gap-3">
                <div class="h-12 w-12 rounded-xl bg-white border border-border p-2 shadow-2xs shrink-0 flex items-center justify-center">
                  {globalTool.logoUrl ? (
                    <img src={globalTool.logoUrl} alt={globalTool.name} class="h-full w-full object-contain" />
                  ) : (
                    <span class="text-sm font-bold text-slate-500">{globalTool.name.slice(0, 2).toUpperCase()}</span>
                  )}
                </div>
                <div>
                  <h2 class="text-lg font-bold text-foreground">{globalTool.name}</h2>
                  <p class="text-xs text-muted-foreground line-clamp-1">{globalTool.tagline || 'Global software standard'}</p>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-border/60 flex items-baseline justify-between text-xs">
              <span class="text-muted-foreground">Starting price:</span>
              <span class="font-extrabold text-foreground text-sm">
                {globalTool.startingPriceUsd ? `$${globalTool.startingPriceUsd}/mo (approx ₹${globalMonthlyInr.toLocaleString('en-IN')})` : 'Custom Quote'}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Executive Verdict Box -->
      <div class="mt-8 rounded-2xl border border-emerald-200 bg-emerald-50/40 p-6 shadow-2xs">
        <div class="flex items-start gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 text-lg font-bold">
            💡
          </div>
          <div>
            <h3 class="text-sm font-bold text-emerald-950">
              Executive Verdict: Why Choose {desiTool.name} over {globalTool.name}?
            </h3>
            <p class="mt-1 text-xs text-emerald-900/90 leading-relaxed">
              Choosing <strong>{desiTool.name}</strong> provides domestic Indian data residency for full DPDP Act compliance, 18% GST input credit recovery, direct INR billing with zero foreign transaction fees, and responsive IST timezone support.
              {annualSavingsInr > 0 && ` A typical team saves approx ₹${annualSavingsInr.toLocaleString('en-IN')} annually on baseline software licenses alone.`}
            </p>
          </div>
        </div>
      </div>

      <!-- 1. Side-by-Side Pros and Cons Matrix -->
      <section class="mt-10 rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs">
        <div class="border-b border-border pb-4 mb-6">
          <h2 class="text-lg font-bold text-foreground">
            Pros & Cons Comparison
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">
            Database-stored feature superpowers and trade-offs
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
          <!-- Desi Tool Column -->
          <div class="rounded-2xl border border-emerald-200/80 bg-emerald-50/20 p-5 space-y-4">
            <div class="flex items-center gap-2 font-bold text-xs text-emerald-900 uppercase tracking-wider">
              <span>🇮🇳</span>
              <span>{desiTool.name} (Strengths & Trade-offs)</span>
            </div>

            <div>
              <div class="text-xs font-bold text-emerald-800 mb-2">Strengths & Pros:</div>
              <ul class="space-y-2 text-xs sm:text-sm text-foreground">
                {finalDesiPros.map((pro) => (
                  <li class="flex items-start gap-2">
                    <span class="text-emerald-600 font-bold shrink-0">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-3 border-t border-emerald-200/60">
              <div class="text-xs font-bold text-amber-800 mb-2">Trade-offs & Considerations:</div>
              <ul class="space-y-2 text-xs sm:text-sm text-foreground/80">
                {finalDesiCons.map((con) => (
                  <li class="flex items-start gap-2">
                    <span class="text-amber-600 font-bold shrink-0">•</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Global Tool Column -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/50 p-5 space-y-4">
            <div class="flex items-center gap-2 font-bold text-xs text-slate-800 uppercase tracking-wider">
              <span>🌐</span>
              <span>{globalTool.name} (Strengths & Trade-offs)</span>
            </div>

            <div>
              <div class="text-xs font-bold text-slate-800 mb-2">Strengths & Pros:</div>
              <ul class="space-y-2 text-xs sm:text-sm text-foreground">
                {finalGlobalPros.map((pro) => (
                  <li class="flex items-start gap-2">
                    <span class="text-blue-600 font-bold shrink-0">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-3 border-t border-slate-200">
              <div class="text-xs font-bold text-rose-800 mb-2">Trade-offs & Limitations for Indian Teams:</div>
              <ul class="space-y-2 text-xs sm:text-sm text-foreground/80">
                {finalGlobalCons.map((con) => (
                  <li class="flex items-start gap-2">
                    <span class="text-rose-500 font-bold shrink-0">✗</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 2. Interactive TCO Calculator & 18% GST Benefit -->
      <section class="mt-10 rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs">
        <div class="border-b border-border pb-4 mb-6 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-bold text-foreground">
              Total Cost of Ownership (TCO) Simulator
            </h2>
            <p class="text-xs text-muted-foreground mt-0.5">
              Annual expenditure modeling benchmarked at ₹{USD_TO_INR_RATE} / $1 USD
            </p>
          </div>
          <span class="rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-800 border border-emerald-200">
            18% GST Tax Recoverable
          </span>
        </div>

        <!-- Team Size Switcher Buttons -->
        <div class="mb-6 flex flex-wrap items-center gap-2">
          <span class="text-xs font-bold text-muted-foreground mr-2">Simulate Team Size:</span>
          <button type="button" data-seats="5" class="tco-btn rounded-xl px-3.5 py-1.5 text-xs font-bold bg-primary text-primary-foreground shadow-xs cursor-pointer">5 Seats</button>
          <button type="button" data-seats="20" class="tco-btn rounded-xl px-3.5 py-1.5 text-xs font-bold bg-slate-100 text-foreground hover:bg-slate-200 transition cursor-pointer">20 Seats</button>
          <button type="button" data-seats="50" class="tco-btn rounded-xl px-3.5 py-1.5 text-xs font-bold bg-slate-100 text-foreground hover:bg-slate-200 transition cursor-pointer">50 Seats</button>
          <button type="button" data-seats="100" class="tco-btn rounded-xl px-3.5 py-1.5 text-xs font-bold bg-slate-100 text-foreground hover:bg-slate-200 transition cursor-pointer">100 Seats</button>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <!-- Desi Cost Box -->
          <div class="rounded-2xl border-2 border-primary/40 bg-amber-50/20 p-5">
            <div class="text-xs font-bold text-emerald-800 uppercase tracking-wider">🇮🇳 {desiTool.name}</div>
            <div class="mt-2 text-2xl sm:text-3xl font-extrabold text-foreground" id="tco-desi-annual">
              ₹{(desiMonthlyInr * 12 * 5).toLocaleString('en-IN')}
            </div>
            <div class="text-xs text-muted-foreground mt-1">Est. annual license cost</div>
            <div class="mt-4 pt-3 border-t border-border/60 text-xs text-emerald-700 font-semibold">
              + ₹<span id="tco-gst-benefit">{Math.round(desiMonthlyInr * 12 * 5 * 0.18).toLocaleString('en-IN')}</span> recoverable via 18% GST ITC
            </div>
          </div>

          <!-- Global Cost Box -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/60 p-5">
            <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">🌐 {globalTool.name}</div>
            <div class="mt-2 text-2xl sm:text-3xl font-extrabold text-foreground" id="tco-global-annual">
              ₹{(globalMonthlyInr * 12 * 5).toLocaleString('en-IN')}
            </div>
            <div class="text-xs text-muted-foreground mt-1">Approx ($<span id="tco-global-usd">{(globalMonthlyUsd * 12 * 5).toLocaleString('en-US')}</span>/yr)</div>
            <div class="mt-4 pt-3 border-t border-border/60 text-xs text-rose-600 font-medium">
              Zero Indian GST credit + foreign currency markup
            </div>
          </div>

          <!-- Net Annual Savings Highlight -->
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 flex flex-col justify-between">
            <div>
              <div class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Estimated Annual Savings</div>
              <div class="mt-2 text-2xl sm:text-3xl font-black text-emerald-800" id="tco-net-savings">
                ₹{Math.max(0, (globalMonthlyInr - desiMonthlyInr) * 12 * 5).toLocaleString('en-IN')}
              </div>
              <div class="text-xs text-emerald-700 mt-1">Direct software budget saved</div>
            </div>
            <div class="mt-4 pt-3 border-t border-emerald-200 text-[11px] text-emerald-900 font-medium">
              Reinvest software savings into domestic team growth.
            </div>
          </div>
        </div>
      </section>

      <!-- 3. Sovereign Compliance & Feature Matrix -->
      <section class="mt-10 rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs">
        <div class="border-b border-border pb-4 mb-6">
          <h2 class="text-lg font-bold text-foreground">
            Sovereign & DPDP Compliance Checklist
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">
            Key regulatory and infrastructure differences
          </p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-border bg-slate-50/80">
                <th class="py-3 px-4 font-bold text-foreground">Compliance Criterion</th>
                <th class="py-3 px-4 font-bold text-primary">🇮🇳 {desiTool.name}</th>
                <th class="py-3 px-4 font-bold text-slate-600">🌐 {globalTool.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="py-3.5 px-4 font-semibold text-foreground">18% GST Tax Invoicing (ITC Eligible)</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">✓ Yes (Direct Indian GSTIN)</td>
                <td class="py-3.5 px-4 text-rose-600 font-medium">✗ No (Foreign USD Invoice)</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-foreground">Domestic Indian Cloud Data Residency</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">✓ Yes (DPDP Compliant)</td>
                <td class="py-3.5 px-4 text-slate-500">Foreign Region Default</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-foreground">Direct INR & UPI / NetBanking Support</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">✓ Native INR & UPI</td>
                <td class="py-3.5 px-4 text-slate-500">Credit Card / USD Only</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-foreground">IST Timezone Engineering Support</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">✓ Realtime IST Support</td>
                <td class="py-3.5 px-4 text-slate-500">Delayed US/EU Shifts</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-semibold text-foreground">Self-Hostable / Open Source Option</td>
                <td class="py-3.5 px-4 font-semibold text-foreground">{desiTool.isOpenSource || desiTool.isSelfHostable ? '✓ Available' : 'Cloud SaaS'}</td>
                <td class="py-3.5 px-4 text-slate-500">{globalTool.isOpenSource ? 'Open Source' : 'Proprietary Cloud'}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. Programmatic FAQ Section -->
      <section class="mt-10 rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs">
        <div class="border-b border-border pb-4 mb-6">
          <h2 class="text-lg font-bold text-foreground">
            Frequently Asked Questions: {desiTool.name} vs {globalTool.name}
          </h2>
          <p class="text-xs text-muted-foreground mt-0.5">
            Key questions Indian engineering teams and CTOs ask before migrating
          </p>
        </div>

        <div class="space-y-4">
          {programmaticFaqs.map((faq) => (
            <div class="rounded-2xl border border-border/80 bg-slate-50/50 p-4.5">
              <h3 class="text-sm font-bold text-foreground">{faq.question}</h3>
              <p class="mt-2 text-xs sm:text-sm text-muted-foreground leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Related Programmatic Comparisons (Internal Links) -->
      {relatedComparisons.length > 0 && (
        <section class="mt-10">
          <div class="border-b border-border pb-3 mb-5 flex items-center justify-between">
            <h2 class="text-base font-bold text-foreground">
              Related Comparisons in {categoryInfo?.name || 'this category'}
            </h2>
            <a href="/compare" class="text-xs font-semibold text-primary hover:underline">
              View All Comparisons →
            </a>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {relatedComparisons.map((rc) => (
              <a
                href={`/compare/${rc.desiSlug}-vs-${rc.globalSlug}`}
                class="rounded-2xl border border-border bg-white p-4 shadow-2xs hover:border-primary/40 hover:shadow-xs transition"
              >
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="text-xs font-bold text-foreground truncate">{rc.desiName}</span>
                  <span class="text-[10px] text-muted-foreground font-mono">VS</span>
                  <span class="text-xs font-bold text-foreground truncate">{rc.globalName}</span>
                </div>
                <div class="text-[11px] text-emerald-700 font-semibold">
                  Save 18% GST • Teardown →
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Action Footer CTA Card -->
      <div class="mt-12 rounded-3xl bg-slate-900 p-8 sm:p-10 text-white text-center shadow-xl">
        <h2 class="text-xl sm:text-2xl font-bold">
          Ready to migrate to {desiTool.name}?
        </h2>
        <p class="mt-2 text-xs sm:text-sm text-slate-300 max-w-xl mx-auto">
          Explore the full profile of {desiTool.name}, check verified Indian customer reviews, or visit their official site.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <a
            href={`/tools/${desiTool.slug}`}
            class="rounded-xl bg-white px-5 py-2.5 text-xs font-bold text-slate-900 hover:bg-slate-100 transition shadow-xs"
          >
            View {desiTool.name} Profile →
          </a>
          <a
            href={desiTool.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-primary px-5 py-2.5 text-xs font-bold text-primary-foreground hover:bg-primary-hover transition shadow-xs"
          >
            Visit {desiTool.name} Official Website ↗
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline define:vars={{ desiMonthlyInr, globalMonthlyInr, globalMonthlyUsd }}>
  const seatButtons = document.querySelectorAll('.tco-btn');
  const desiAnnualEl = document.getElementById('tco-desi-annual');
  const globalAnnualEl = document.getElementById('tco-global-annual');
  const globalUsdEl = document.getElementById('tco-global-usd');
  const netSavingsEl = document.getElementById('tco-net-savings');
  const gstBenefitEl = document.getElementById('tco-gst-benefit');

  seatButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      seatButtons.forEach((b) => {
        b.classList.remove('bg-primary', 'text-primary-foreground');
        b.classList.add('bg-slate-100', 'text-foreground');
      });
      btn.classList.add('bg-primary', 'text-primary-foreground');
      btn.classList.remove('bg-slate-100', 'text-foreground');

      const seats = parseInt(btn.getAttribute('data-seats') || '5', 10);
      const desiTotal = desiMonthlyInr * 12 * seats;
      const globalTotalInr = globalMonthlyInr * 12 * seats;
      const globalTotalUsd = globalMonthlyUsd * 12 * seats;
      const netSavings = Math.max(0, globalTotalInr - desiTotal);
      const gstBenefit = Math.round(desiTotal * 0.18);

      if (desiAnnualEl) desiAnnualEl.textContent = `₹${desiTotal.toLocaleString('en-IN')}`;
      if (globalAnnualEl) globalAnnualEl.textContent = `₹${globalTotalInr.toLocaleString('en-IN')}`;
      if (globalUsdEl) globalUsdEl.textContent = globalTotalUsd.toLocaleString('en-US');
      if (netSavingsEl) netSavingsEl.textContent = `₹${netSavings.toLocaleString('en-IN')}`;
      if (gstBenefitEl) gstBenefitEl.textContent = gstBenefit.toLocaleString('en-IN');
    });
  });
</script>
