---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { desiTools, globalTools } from '@/lib/server/db/schema';
import { eq } from 'drizzle-orm';

const db = Astro.locals.db;
const { comparison } = Astro.params;

if (!comparison || !comparison.includes('-vs-')) {
  return Astro.redirect('/compare');
}

const parts = comparison.split('-vs-');
const slugA = parts[0]?.trim();
const slugB = parts[1]?.trim();

if (!slugA || !slugB) {
  return Astro.redirect('/compare');
}

let toolA: any = null;
let toolB: any = null;

const USD_TO_INR_RATE = 86;

if (db) {
  try {
    // 1. Resolve Tool A (Desi first, then Global)
    const desiA = await db
      .select()
      .from(desiTools)
      .where(eq(desiTools.slug, slugA))
      .get();

    if (desiA) {
      toolA = {
        ...desiA,
        isDesi: true,
        country: 'India',
        originBadge: '🇮🇳 India',
        hqLocation: desiA.city ? `${desiA.city}, ${desiA.state || 'India'}` : 'India',
        startingPriceInr: desiA.startingPriceInr ?? 0,
        startingPriceUsd: desiA.startingPriceInr ? Math.round(desiA.startingPriceInr / USD_TO_INR_RATE) : 0,
      };
    } else {
      const globalA = await db
        .select()
        .from(globalTools)
        .where(eq(globalTools.slug, slugA))
        .get();

      if (globalA) {
        toolA = {
          ...globalA,
          isDesi: false,
          country: globalA.country || 'Global',
          originBadge: `🌐 ${globalA.country || 'Global'}`,
          hqLocation: globalA.city ? `${globalA.city}, ${globalA.country || ''}` : (globalA.country || 'Global'),
          startingPriceUsd: globalA.startingPriceUsd ?? 0,
          startingPriceInr: globalA.startingPriceUsd ? Math.round(globalA.startingPriceUsd * USD_TO_INR_RATE) : 0,
          hasGstInvoice: false,
          hasIndianDataResidency: false,
          hasInrPricing: false,
          hasUpiSupport: false,
          hasIstSupport: false,
          isSelfHostable: globalA.isOpenSource,
          hasFreeTier: false,
          pricingModel: 'Paid / USD',
        };
      }
    }

    // 2. Resolve Tool B (Desi first, then Global)
    const desiB = await db
      .select()
      .from(desiTools)
      .where(eq(desiTools.slug, slugB))
      .get();

    if (desiB) {
      toolB = {
        ...desiB,
        isDesi: true,
        country: 'India',
        originBadge: '🇮🇳 India',
        hqLocation: desiB.city ? `${desiB.city}, ${desiB.state || 'India'}` : 'India',
        startingPriceInr: desiB.startingPriceInr ?? 0,
        startingPriceUsd: desiB.startingPriceInr ? Math.round(desiB.startingPriceInr / USD_TO_INR_RATE) : 0,
      };
    } else {
      const globalB = await db
        .select()
        .from(globalTools)
        .where(eq(globalTools.slug, slugB))
        .get();

      if (globalB) {
        toolB = {
          ...globalB,
          isDesi: false,
          country: globalB.country || 'Global',
          originBadge: `🌐 ${globalB.country || 'Global'}`,
          hqLocation: globalB.city ? `${globalB.city}, ${globalB.country || ''}` : (globalB.country || 'Global'),
          startingPriceUsd: globalB.startingPriceUsd ?? 0,
          startingPriceInr: globalB.startingPriceUsd ? Math.round(globalB.startingPriceUsd * USD_TO_INR_RATE) : 0,
          hasGstInvoice: false,
          hasIndianDataResidency: false,
          hasInrPricing: false,
          hasUpiSupport: false,
          hasIstSupport: false,
          isSelfHostable: globalB.isOpenSource,
          hasFreeTier: false,
          pricingModel: 'Paid / USD',
        };
      }
    }
  } catch (e) {
    console.error('Error resolving comparison tools:', e);
  }
}

if (!toolA || !toolB) {
  return Astro.redirect('/compare');
}

// Helper: parse JSON array safely
function parseJsonArray(input: any): string[] {
  if (!input) return [];
  if (Array.isArray(input)) return input;
  try {
    const parsed = JSON.parse(input);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

// Helper: parse pricing plans safely
function parsePricingPlans(input: any): Array<{ planName?: string; priceInr?: number; priceUsd?: number | string; billingCycle?: string; highlights?: string[] }> {
  if (!input) return [];
  if (Array.isArray(input)) return input;
  try {
    const parsed = JSON.parse(input);
    return Array.isArray(parsed) ? parsed : [];
  } catch {
    return [];
  }
}

const prosA = parseJsonArray(toolA.pros);
let consA = parseJsonArray(toolA.cons);
if (consA.length === 0 && toolA.foreignPainPoints) {
  consA = parseJsonArray(toolA.foreignPainPoints);
}
const plansA = parsePricingPlans(toolA.pricingPlans);

const prosB = parseJsonArray(toolB.pros);
let consB = parseJsonArray(toolB.cons);
if (consB.length === 0 && toolB.foreignPainPoints) {
  consB = parseJsonArray(toolB.foreignPainPoints);
}
const plansB = parsePricingPlans(toolB.pricingPlans);

// Default fallback pros/cons if DB records are sparse
if (prosA.length === 0) {
  prosA.push(toolA.isDesi ? 'Designed for Indian workflows & currency' : 'Mature global feature ecosystem');
  prosA.push(toolA.isOpenSource ? 'Open-source code transparency' : 'Enterprise reliability');
}
if (consA.length === 0) {
  consA.push(toolA.isDesi ? 'Younger ecosystem than decade-old global incumbents' : 'Foreign billing without 18% GST input credit');
}

if (prosB.length === 0) {
  prosB.push(toolB.isDesi ? 'Designed for Indian workflows & currency' : 'Mature global feature ecosystem');
  prosB.push(toolB.isOpenSource ? 'Open-source code transparency' : 'Enterprise reliability');
}
if (consB.length === 0) {
  consB.push(toolB.isDesi ? 'Younger ecosystem than decade-old global incumbents' : 'Foreign billing without 18% GST input credit');
}

// TCO Calculations
const teamSizes = [5, 20, 50, 100];
const monthlyCostA = toolA.startingPriceInr || (toolA.startingPriceUsd * USD_TO_INR_RATE);
const monthlyCostB = toolB.startingPriceInr || (toolB.startingPriceUsd * USD_TO_INR_RATE);

const gstSavingsA = toolA.hasGstInvoice ? Math.round(monthlyCostA * 12 * 0.18) : 0;
const gstSavingsB = toolB.hasGstInvoice ? Math.round(monthlyCostB * 12 * 0.18) : 0;

const pageTitle = `${toolA.name} vs ${toolB.name} Comparison (2026) — Pricing, Pros, Cons & DPDP`;
const pageDescription = `Compare ${toolA.name} vs ${toolB.name} head-to-head. Database teardown of features, INR vs USD pricing, 18% GST savings, pros & cons, and Indian data sovereignty.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main class="min-h-screen bg-slate-50/50 pb-24 pt-8 sm:pt-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Breadcrumbs -->
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Compare', href: '/compare' },
          { label: `${toolA.name} vs ${toolB.name}` },
        ]}
        class="mb-4"
      />

      <!-- Head-to-Head Masthead Card -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-10 shadow-sm text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-b from-amber-500/[0.02] to-transparent pointer-events-none"></div>

        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1 text-xs font-semibold text-amber-900 shadow-2xs">
          <span>⚖️ Head-to-Head Teardown</span>
          <span class="text-amber-300">•</span>
          <span>Verified Database Specs</span>
        </div>

        <h1 class="text-2xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          <span>{toolA.name}</span>
          <span class="font-serif-editorial italic font-normal text-primary mx-2 sm:mx-3">vs</span>
          <span>{toolB.name}</span>
        </h1>

        <p class="mx-auto mt-3 max-w-2xl text-xs sm:text-sm text-muted-foreground leading-relaxed">
          Comprehensive comparison of features, pricing tiers, pros & cons, and Indian sovereign compliance readiness.
        </p>

        <!-- Head-to-Head Logos & Quick Specs Matchup -->
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6 relative">
          <!-- Tool A Column -->
          <div class={`rounded-2xl border p-6 text-left flex flex-col justify-between ${toolA.isDesi ? 'border-amber-200 bg-amber-50/20' : 'border-border bg-white'}`}>
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-border bg-white p-2 shadow-2xs overflow-hidden">
                  <img src={toolA.logoUrl} alt={toolA.name} class="h-full w-full object-contain" />
                </div>
                <span class={`rounded-md px-2.5 py-1 text-[11px] font-bold ${toolA.isDesi ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-slate-100 text-slate-700'}`}>
                  {toolA.originBadge}
                </span>
              </div>

              <h2 class="mt-4 text-xl font-bold text-foreground">{toolA.name}</h2>
              <p class="mt-1 text-xs text-muted-foreground leading-relaxed">{toolA.tagline || toolA.description}</p>
            </div>

            <div class="mt-6 border-t border-border/80 pt-4 space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">HQ Location:</span>
                <span class="font-semibold text-foreground">{toolA.hqLocation}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">Starting Price:</span>
                <span class="font-bold text-foreground font-mono">
                  {toolA.startingPriceInr > 0 ? `₹${toolA.startingPriceInr.toLocaleString('en-IN')}/mo` : 'Free / Open-Source'}
                  {toolA.startingPriceUsd > 0 && <span class="text-muted-foreground font-normal"> (${toolA.startingPriceUsd}/mo)</span>}
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">Open Source:</span>
                <span class={`font-semibold ${toolA.isOpenSource ? 'text-emerald-700' : 'text-slate-600'}`}>
                  {toolA.isOpenSource ? '✓ Yes (Public Repo)' : 'Proprietary'}
                </span>
              </div>
            </div>
          </div>

          <!-- VS Badge Desktop Center -->
          <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-slate-900 text-white font-extrabold text-xs shadow-md z-10 font-mono">
            VS
          </div>

          <!-- Tool B Column -->
          <div class={`rounded-2xl border p-6 text-left flex flex-col justify-between ${toolB.isDesi ? 'border-amber-200 bg-amber-50/20' : 'border-border bg-white'}`}>
            <div>
              <div class="flex items-center justify-between gap-3">
                <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-border bg-white p-2 shadow-2xs overflow-hidden">
                  {toolB.logoUrl ? (
                    <img src={toolB.logoUrl} alt={toolB.name} class="h-full w-full object-contain" />
                  ) : (
                    <span class="text-base font-bold text-slate-600 uppercase">{toolB.name.slice(0, 2)}</span>
                  )}
                </div>
                <span class={`rounded-md px-2.5 py-1 text-[11px] font-bold ${toolB.isDesi ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-slate-100 text-slate-700'}`}>
                  {toolB.originBadge}
                </span>
              </div>

              <h2 class="mt-4 text-xl font-bold text-foreground">{toolB.name}</h2>
              <p class="mt-1 text-xs text-muted-foreground leading-relaxed">{toolB.tagline || toolB.description}</p>
            </div>

            <div class="mt-6 border-t border-border/80 pt-4 space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">HQ Location:</span>
                <span class="font-semibold text-foreground">{toolB.hqLocation}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">Starting Price:</span>
                <span class="font-bold text-foreground font-mono">
                  {toolB.startingPriceInr > 0 ? `₹${toolB.startingPriceInr.toLocaleString('en-IN')}/mo` : 'Free / Open-Source'}
                  {toolB.startingPriceUsd > 0 && <span class="text-muted-foreground font-normal"> (${toolB.startingPriceUsd}/mo)</span>}
                </span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">Open Source:</span>
                <span class={`font-semibold ${toolB.isOpenSource ? 'text-emerald-700' : 'text-slate-600'}`}>
                  {toolB.isOpenSource ? '✓ Yes (Public Repo)' : 'Proprietary'}
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 1: Executive Verdict & Recommendations -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-2.5 border-b border-border pb-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700 text-base">
            🎯
          </span>
          <div>
            <h2 class="text-lg font-bold text-foreground">Executive Verdict</h2>
            <p class="text-xs text-muted-foreground">Which solution is right for your engineering stack?</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Choose Tool A -->
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-5 space-y-3">
            <h3 class="text-sm font-bold text-emerald-950 flex items-center gap-2">
              <span>Choose {toolA.name} if:</span>
            </h3>
            <ul class="space-y-2 text-xs text-emerald-900/90 leading-relaxed">
              {toolA.isDesi && (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>You want <strong>18% GST tax input credit</strong> and domestic INR/UPI invoicing.</span>
                </li>
              )}
              {toolA.hasIndianDataResidency && (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>You require <strong>100% Indian Data Residency</strong> for RBI or DPDP compliance.</span>
                </li>
              )}
              {prosA.slice(0, 3).map((p) => (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Choose Tool B -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-3">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span>Choose {toolB.name} if:</span>
            </h3>
            <ul class="space-y-2 text-xs text-slate-800 leading-relaxed">
              {toolB.isDesi && (
                <li class="flex items-start gap-2">
                  <span class="text-primary font-bold">✓</span>
                  <span>You want <strong>18% GST tax input credit</strong> and domestic INR invoicing.</span>
                </li>
              )}
              {prosB.slice(0, 3).map((p) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary font-bold">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 2: Pricing & Total Cost of Ownership (TCO) Simulator -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-2.5 border-b border-border pb-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700 text-base">
            💰
          </span>
          <div>
            <h2 class="text-lg font-bold text-foreground">Pricing & Total Cost of Ownership (TCO)</h2>
            <p class="text-xs text-muted-foreground">Standardized comparison calculated at ₹86 = $1 USD benchmark</p>
          </div>
        </div>

        <!-- Annualized Team Cost Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border bg-secondary/50">
              <tr>
                <th class="py-3 px-4 font-semibold text-foreground">Team Size</th>
                <th class="py-3 px-4 font-semibold text-foreground">{toolA.name} Annual Est.</th>
                <th class="py-3 px-4 font-semibold text-foreground">{toolB.name} Annual Est.</th>
                <th class="py-3 px-4 font-semibold text-foreground text-right">Potential Difference</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              {teamSizes.map((seats) => {
                const costA = monthlyCostA * seats * 12;
                const costB = monthlyCostB * seats * 12;
                const diff = costB - costA;
                return (
                  <tr class="hover:bg-slate-50/50 transition">
                    <td class="py-3 px-4 font-bold text-foreground">{seats} Seats</td>
                    <td class="py-3 px-4 font-mono font-semibold">
                      ₹{costA.toLocaleString('en-IN')}
                      {toolA.hasGstInvoice && (
                        <span class="ml-1 text-[10px] text-emerald-700 font-normal">(-18% GST credit)</span>
                      )}
                    </td>
                    <td class="py-3 px-4 font-mono font-semibold">
                      ₹{costB.toLocaleString('en-IN')}
                      {toolB.hasGstInvoice && (
                        <span class="ml-1 text-[10px] text-emerald-700 font-normal">(-18% GST credit)</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right font-mono font-bold">
                      {diff > 0 ? (
                        <span class="text-emerald-700">Save ₹{diff.toLocaleString('en-IN')}/yr with {toolA.name}</span>
                      ) : diff < 0 ? (
                        <span class="text-amber-800">Save ₹{Math.abs(diff).toLocaleString('en-IN')}/yr with {toolB.name}</span>
                      ) : (
                        <span class="text-muted-foreground">Parity</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <!-- GST Tax Input Credit Box -->
        {(gstSavingsA > 0 || gstSavingsB > 0) && (
          <div class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <h4 class="text-xs font-bold text-amber-950 uppercase tracking-wider">
                🇮🇳 18% GST Input Tax Credit Advantage
              </h4>
              <p class="text-xs text-amber-900 leading-relaxed">
                Indian businesses purchasing from GST-compliant Indian entities reclaim 18% of their entire software bill as input tax credit on GSTR-2B. Foreign USD billing offers zero GST input credit.
              </p>
            </div>
            <span class="shrink-0 rounded-xl bg-amber-200/80 px-3 py-1.5 text-xs font-bold text-amber-950">
              18% Direct Tax Savings
            </span>
          </div>
        )}

        <!-- Pricing Plans Breakdown (if available in DB) -->
        {(plansA.length > 0 || plansB.length > 0) && (
          <div class="pt-4 border-t border-border space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
              Official Tiered Pricing Plans
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Plans A -->
              <div class="space-y-2.5">
                <h5 class="text-xs font-bold text-foreground">{toolA.name} Plans ({plansA.length})</h5>
                {plansA.length === 0 ? (
                  <p class="text-xs text-muted-foreground italic">Custom or single-tier model.</p>
                ) : (
                  <div class="space-y-2">
                    {plansA.map((p) => (
                      <div class="rounded-xl border border-border bg-slate-50/70 p-3 text-xs">
                        <div class="flex items-center justify-between font-semibold">
                          <span class="text-foreground font-bold">{p.planName || 'Plan'}</span>
                          <span class="text-primary font-mono font-bold">
                            {p.priceInr !== undefined && p.priceInr !== null
                              ? `₹${p.priceInr.toLocaleString('en-IN')}/mo`
                              : p.priceUsd !== undefined && p.priceUsd !== null
                              ? `$${p.priceUsd}/mo`
                              : 'Custom'}
                          </span>
                        </div>
                        {p.highlights && p.highlights.length > 0 && (
                          <ul class="mt-1.5 space-y-0.5 text-[11px] text-muted-foreground">
                            {p.highlights.map((h) => <li>• {h}</li>)}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>

              <!-- Plans B -->
              <div class="space-y-2.5">
                <h5 class="text-xs font-bold text-foreground">{toolB.name} Plans ({plansB.length})</h5>
                {plansB.length === 0 ? (
                  <p class="text-xs text-muted-foreground italic">Custom or single-tier model.</p>
                ) : (
                  <div class="space-y-2">
                    {plansB.map((p) => (
                      <div class="rounded-xl border border-border bg-slate-50/70 p-3 text-xs">
                        <div class="flex items-center justify-between font-semibold">
                          <span class="text-foreground font-bold">{p.planName || 'Plan'}</span>
                          <span class="text-primary font-mono font-bold">
                            {p.priceInr !== undefined && p.priceInr !== null
                              ? `₹${p.priceInr.toLocaleString('en-IN')}/mo`
                              : p.priceUsd !== undefined && p.priceUsd !== null
                              ? `$${p.priceUsd}/mo`
                              : 'Custom'}
                          </span>
                        </div>
                        {p.highlights && p.highlights.length > 0 && (
                          <ul class="mt-1.5 space-y-0.5 text-[11px] text-muted-foreground">
                            {p.highlights.map((h) => <li>• {h}</li>)}
                          </ul>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}
      </section>

      <!-- Section 3: Side-by-Side Pros (Database-driven) -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-2.5 border-b border-border pb-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-700 text-base">
            👍
          </span>
          <div>
            <h2 class="text-lg font-bold text-foreground">Pros & Key Superpowers</h2>
            <p class="text-xs text-muted-foreground">Database-curated strengths and architectural advantages</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Pros A -->
          <div class="rounded-2xl border border-border bg-slate-50/50 p-5 space-y-3">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              <img src={toolA.logoUrl} alt={toolA.name} class="h-6 w-6 object-contain" />
              <h3 class="text-sm font-bold text-foreground">{toolA.name} Strengths</h3>
            </div>
            <ul class="space-y-2.5 text-xs text-foreground/90 leading-relaxed">
              {prosA.map((pro) => (
                <li class="flex items-start gap-2.5">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-[10px]">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Pros B -->
          <div class="rounded-2xl border border-border bg-slate-50/50 p-5 space-y-3">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              {toolB.logoUrl && <img src={toolB.logoUrl} alt={toolB.name} class="h-6 w-6 object-contain" />}
              <h3 class="text-sm font-bold text-foreground">{toolB.name} Strengths</h3>
            </div>
            <ul class="space-y-2.5 text-xs text-foreground/90 leading-relaxed">
              {prosB.map((pro) => (
                <li class="flex items-start gap-2.5">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-[10px]">✓</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 4: Side-by-Side Cons (Database-driven) -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-2.5 border-b border-border pb-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-red-500/10 text-red-700 text-base">
            ⚠️
          </span>
          <div>
            <h2 class="text-lg font-bold text-foreground">Cons & Limitations</h2>
            <p class="text-xs text-muted-foreground">Tradeoffs, friction points, and constraints to consider</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Cons A -->
          <div class="rounded-2xl border border-border bg-slate-50/50 p-5 space-y-3">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              <img src={toolA.logoUrl} alt={toolA.name} class="h-6 w-6 object-contain" />
              <h3 class="text-sm font-bold text-foreground">{toolA.name} Limitations</h3>
            </div>
            <ul class="space-y-2.5 text-xs text-foreground/90 leading-relaxed">
              {consA.map((con) => (
                <li class="flex items-start gap-2.5">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-[10px]">✕</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Cons B -->
          <div class="rounded-2xl border border-border bg-slate-50/50 p-5 space-y-3">
            <div class="flex items-center gap-2 border-b border-border pb-3">
              {toolB.logoUrl && <img src={toolB.logoUrl} alt={toolB.name} class="h-6 w-6 object-contain" />}
              <h3 class="text-sm font-bold text-foreground">{toolB.name} Limitations</h3>
            </div>
            <ul class="space-y-2.5 text-xs text-foreground/90 leading-relaxed">
              {consB.map((con) => (
                <li class="flex items-start gap-2.5">
                  <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 font-bold text-[10px]">✕</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 5: Sovereign & DPDP Compliance Checklist -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex items-center gap-2.5 border-b border-border pb-4">
          <span class="flex h-8 w-8 items-center justify-center rounded-xl bg-indigo-500/10 text-indigo-700 text-base">
            🛡️
          </span>
          <div>
            <h2 class="text-lg font-bold text-foreground">Sovereign Compliance & Features Matrix</h2>
            <p class="text-xs text-muted-foreground">Regulatory checklist for Indian engineering scaleups and enterprises</p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="border-b border-border bg-secondary/50">
              <tr>
                <th class="py-3 px-4 font-semibold text-foreground">Compliance Dimension</th>
                <th class="py-3 px-4 font-semibold text-foreground text-center">{toolA.name}</th>
                <th class="py-3 px-4 font-semibold text-foreground text-center">{toolB.name}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <!-- Dimension 1: GST Tax Invoice -->
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4 font-medium text-foreground">
                  <div class="font-bold">GST Tax Invoice (18% Input Credit)</div>
                  <div class="text-[11px] text-muted-foreground">Direct tax deduction for Indian registered companies</div>
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolA.hasGstInvoice ? <span class="text-emerald-700">✓ Supported</span> : <span class="text-muted-foreground">✕ No</span>}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolB.hasGstInvoice ? <span class="text-emerald-700">✓ Supported</span> : <span class="text-muted-foreground">✕ No</span>}
                </td>
              </tr>

              <!-- Dimension 2: Indian Data Residency -->
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4 font-medium text-foreground">
                  <div class="font-bold">Indian Data Residency (DPDP 2023)</div>
                  <div class="text-[11px] text-muted-foreground">Data hosted in Mumbai/Pune/Delhi cloud regions</div>
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolA.hasIndianDataResidency ? <span class="text-emerald-700">✓ Sovereign (India)</span> : <span class="text-muted-foreground">Foreign Clouds</span>}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolB.hasIndianDataResidency ? <span class="text-emerald-700">✓ Sovereign (India)</span> : <span class="text-muted-foreground">Foreign Clouds</span>}
                </td>
              </tr>

              <!-- Dimension 3: INR Pricing & UPI -->
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4 font-medium text-foreground">
                  <div class="font-bold">INR Domestic Billing & UPI Payments</div>
                  <div class="text-[11px] text-muted-foreground">Zero foreign exchange (FX) conversion markup</div>
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolA.hasInrPricing || toolA.hasUpiSupport ? <span class="text-emerald-700">✓ INR / UPI</span> : <span class="text-muted-foreground">USD Only</span>}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolB.hasInrPricing || toolB.hasUpiSupport ? <span class="text-emerald-700">✓ INR / UPI</span> : <span class="text-muted-foreground">USD Only</span>}
                </td>
              </tr>

              <!-- Dimension 4: Open Source & Self-Hostable -->
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4 font-medium text-foreground">
                  <div class="font-bold">Self-Hostable on Private Infrastructure</div>
                  <div class="text-[11px] text-muted-foreground">Deployable on private Kubernetes / VPC clusters</div>
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolA.isSelfHostable || toolA.isOpenSource ? <span class="text-emerald-700">✓ Yes</span> : <span class="text-muted-foreground">Cloud SaaS Only</span>}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolB.isSelfHostable || toolB.isOpenSource ? <span class="text-emerald-700">✓ Yes</span> : <span class="text-muted-foreground">Cloud SaaS Only</span>}
                </td>
              </tr>

              <!-- Dimension 5: IST Support -->
              <tr class="hover:bg-slate-50/50 transition">
                <td class="py-3 px-4 font-medium text-foreground">
                  <div class="font-bold">IST Business Hours Engineering Support</div>
                  <div class="text-[11px] text-muted-foreground">Dedicated domestic timezone SLA</div>
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolA.hasIstSupport ? <span class="text-emerald-700">✓ IST Native</span> : <span class="text-muted-foreground">US / Global Hours</span>}
                </td>
                <td class="py-3 px-4 text-center font-bold">
                  {toolB.hasIstSupport ? <span class="text-emerald-700">✓ IST Native</span> : <span class="text-muted-foreground">US / Global Hours</span>}
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 6: Actionable Links & Next Steps -->
      <section class="rounded-3xl border border-border bg-white p-6 sm:p-8 shadow-xs">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-base font-bold text-foreground">Explore Full Profiles</h3>
            <p class="text-xs text-muted-foreground">View detailed teardowns, screenshots, and community reviews.</p>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            {toolA.isDesi ? (
              <a
                href={`/tools/${toolA.slug}`}
                class="rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition"
              >
                View {toolA.name} Profile →
              </a>
            ) : (
              <a
                href={`/alternatives/${toolA.slug}`}
                class="rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition"
              >
                {toolA.name} Alternatives →
              </a>
            )}

            {toolB.isDesi ? (
              <a
                href={`/tools/${toolB.slug}`}
                class="rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition"
              >
                View {toolB.name} Profile →
              </a>
            ) : (
              <a
                href={`/alternatives/${toolB.slug}`}
                class="rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition"
              >
                {toolB.name} Alternatives →
              </a>
            )}

            <a
              href="/compare"
              class="rounded-xl bg-primary px-4 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
            >
              New Comparison ⚖️
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
