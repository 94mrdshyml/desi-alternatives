---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { desiTools, globalTools, toolAlternatives, categories } from '@/lib/server/db/schema';
import { eq } from 'drizzle-orm';

const db = Astro.locals.db;

let allDesi: any[] = [];
let allGlobal: any[] = [];
let popularComparisons: any[] = [];
let categoriesList: any[] = [];
let mappingMatrix: Array<{ desiSlug: string; desiName: string; globalSlug: string; globalName: string }> = [];

if (db) {
  try {
    const [desiList, globalList, altList, catList] = await Promise.all([
      db
        .select({
          id: desiTools.id,
          slug: desiTools.slug,
          name: desiTools.name,
          tagline: desiTools.tagline,
          logoUrl: desiTools.logoUrl,
          primaryColor: desiTools.primaryColor,
          categoryId: desiTools.categoryId,
        })
        .from(desiTools)
        .where(eq(desiTools.status, 'published'))
        .all(),
      db
        .select({
          id: globalTools.id,
          slug: globalTools.slug,
          name: globalTools.name,
          tagline: globalTools.tagline,
          logoUrl: globalTools.logoUrl,
          categoryId: globalTools.categoryId,
        })
        .from(globalTools)
        .all(),
      db
        .select({
          desiId: toolAlternatives.desiToolId,
          desiSlug: desiTools.slug,
          desiName: desiTools.name,
          desiLogo: desiTools.logoUrl,
          desiTagline: desiTools.tagline,
          desiStartingPriceInr: desiTools.startingPriceInr,
          desiHasGstInvoice: desiTools.hasGstInvoice,
          desiHasIndianDataResidency: desiTools.hasIndianDataResidency,
          globalId: toolAlternatives.globalToolId,
          globalSlug: globalTools.slug,
          globalName: globalTools.name,
          globalLogo: globalTools.logoUrl,
          globalTagline: globalTools.tagline,
          globalStartingPriceUsd: globalTools.startingPriceUsd,
          categoryId: categories.id,
          categorySlug: categories.slug,
          categoryName: categories.name,
          categoryEmoji: categories.emoji,
        })
        .from(toolAlternatives)
        .leftJoin(desiTools, eq(toolAlternatives.desiToolId, desiTools.id))
        .leftJoin(globalTools, eq(toolAlternatives.globalToolId, globalTools.id))
        .leftJoin(categories, eq(desiTools.categoryId, categories.id))
        .all(),
      db.select().from(categories).all(),
    ]);

    allDesi = desiList;
    allGlobal = globalList;
    popularComparisons = altList.filter((a) => a.desiSlug && a.globalSlug);
    categoriesList = catList;

    mappingMatrix = popularComparisons.map((c) => ({
      desiSlug: c.desiSlug,
      desiName: c.desiName,
      globalSlug: c.globalSlug,
      globalName: c.globalName,
    }));
  } catch (e) {
    console.error('Failed to load comparison hub data:', e);
  }
}

// Group comparisons by Category for Programmatic SEO Directory
const comparisonsByCategory: Record<string, { categoryName: string; categoryEmoji: string; categorySlug: string; items: any[] }> = {};

for (const comp of popularComparisons) {
  const catKey = comp.categorySlug || 'general';
  if (!comparisonsByCategory[catKey]) {
    comparisonsByCategory[catKey] = {
      categoryName: comp.categoryName || 'General Software',
      categoryEmoji: comp.categoryEmoji || '⚡',
      categorySlug: comp.categorySlug || 'general',
      items: [],
    };
  }
  comparisonsByCategory[catKey].items.push(comp);
}

// Extract unique Desi tools that have mapped global alternatives
const desiToolsWithAlternatives = Array.from(
  new Map(popularComparisons.map((c) => [c.desiSlug, { slug: c.desiSlug, name: c.desiName, logoUrl: c.desiLogo }])).values()
).sort((a, b) => a.name.localeCompare(b.name));

// Extract unique Global tools that have mapped Indian alternatives
const globalToolsWithAlternatives = Array.from(
  new Map(popularComparisons.map((c) => [c.globalSlug, { slug: c.globalSlug, name: c.globalName, logoUrl: c.globalLogo }])).values()
).sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout
  title="Software Comparison Engine — Sovereign Indian SaaS vs Global Giants"
  description="Head-to-head database comparisons between sovereign Indian software and global incumbents. Compare pricing in ₹ INR vs $ USD, 18% GST tax credits, and DPDP compliance."
  canonicalUrl="https://desialternatives.in/compare"
>
  <Navbar />

  <main class="min-h-screen bg-slate-50/50 pb-20 pt-8 sm:pt-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Comparison Engine' },
        ]}
        class="mb-6"
      />

      <!-- Hero Header -->
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-1 text-xs font-semibold text-amber-900 shadow-2xs">
          <span>⚖️</span>
          <span>Sovereign Teardown Engine</span>
          <span class="text-amber-300">•</span>
          <span>Indian SaaS vs Global Giants</span>
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
          Head-to-Head <span class="font-serif-editorial italic font-normal text-primary">Comparison</span> Engine
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-sm sm:text-base text-muted-foreground leading-relaxed">
          Compare sovereign Indian software with foreign incumbents. See side-by-side database pros & cons, ₹ INR vs $ USD pricing, 18% GST input credit savings, and DPDP compliance.
        </p>
      </div>

      <!-- Smart 2-Way Linked Tool Picker Card -->
      <div class="mx-auto mt-10 max-w-3xl rounded-3xl border border-border/80 bg-white p-6 sm:p-8 shadow-xl shadow-amber-500/5">
        <div class="text-center mb-6">
          <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
            Select Indian Sovereign Tool vs Global Counterpart
          </h2>
          <p class="text-[11px] text-muted-foreground mt-1">
            Pick an Indian tool to filter its global targets, or select a foreign tool to find its Indian replacements.
          </p>
        </div>

        <form id="compare-selector-form" class="space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 items-center relative">
            <!-- Indian Tool Selector -->
            <div class="space-y-2">
              <label for="desi-select" class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-foreground">
                <span>🇮🇳 Indian Sovereign Tool</span>
                <span class="text-[10px] text-amber-700 font-semibold lowercase">Homegrown</span>
              </label>
              <select
                id="desi-select"
                required
                class="block w-full rounded-xl border border-border bg-white px-3.5 py-3 text-xs sm:text-sm font-semibold text-foreground shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 cursor-pointer"
              >
                <option value="" selected>Choose Indian SaaS...</option>
                {desiToolsWithAlternatives.map((t) => (
                  <option value={t.slug}>
                    {t.name}
                  </option>
                ))}
              </select>
            </div>

            <!-- VS Badge (Desktop Center / Mobile Separator) -->
            <div class="sm:absolute sm:left-1/2 sm:top-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 flex items-center justify-center pointer-events-none pt-2 sm:pt-4">
              <span class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-amber-50 text-xs font-extrabold text-amber-800 shadow-xs font-mono">
                VS
              </span>
            </div>

            <!-- Global Tool Selector -->
            <div class="space-y-2">
              <label for="global-select" class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-foreground">
                <span>🌐 Global Incumbent</span>
                <span class="text-[10px] text-slate-500 font-semibold lowercase">Foreign Target</span>
              </label>
              <select
                id="global-select"
                required
                class="block w-full rounded-xl border border-border bg-white px-3.5 py-3 text-xs sm:text-sm font-semibold text-foreground shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 cursor-pointer"
              >
                <option value="" selected>Choose Global Incumbent...</option>
                {globalToolsWithAlternatives.map((t) => (
                  <option value={t.slug}>
                    {t.name}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div class="text-center pt-2">
            <button
              type="submit"
              id="start-compare-btn"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-8 py-3 text-sm font-bold text-primary-foreground shadow-md hover:bg-primary-hover transition cursor-pointer"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <span>Launch Head-to-Head Comparison</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Sovereign Advantage Banner -->
      <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
          <div class="flex items-center gap-2.5 text-xs font-bold text-emerald-800">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">🇮🇳</span>
            <span>18% GST Input Credit</span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
            Direct GST tax invoices with reverse charge credit eligibility for all Indian registered entities.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
          <div class="flex items-center gap-2.5 text-xs font-bold text-blue-800">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-blue-700">🔒</span>
            <span>DPDP Act Compliance</span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
            Data hosted in domestic Indian cloud regions with full sovereign data protection and audit trails.
          </p>
        </div>

        <div class="rounded-2xl border border-border bg-white p-5 shadow-2xs">
          <div class="flex items-center gap-2.5 text-xs font-bold text-amber-800">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 text-amber-700">₹</span>
            <span>Zero Forex Volatility</span>
          </div>
          <p class="mt-2 text-xs text-muted-foreground leading-relaxed">
            Direct INR invoicing without 3.5% foreign transaction fees, USD markups, or currency fluctuations.
          </p>
        </div>
      </div>

      <!-- Programmatic Comparison Directory (Grouped by Category) -->
      <div class="mt-16 space-y-12">
        <div class="flex items-center justify-between border-b border-border pb-4">
          <div>
            <h2 class="text-xl font-bold tracking-tight text-foreground">
              Directory of Sovereign Comparisons
            </h2>
            <p class="mt-1 text-xs text-muted-foreground">
              Programmatic teardowns mapped across {popularComparisons.length} sovereign pairings
            </p>
          </div>
          <span class="rounded-full bg-secondary px-3 py-1 text-xs font-bold text-muted-foreground">
            {popularComparisons.length} Matchups
          </span>
        </div>

        {Object.entries(comparisonsByCategory).map(([catKey, categoryGroup]) => (
          <section class="space-y-4">
            <div class="flex items-center gap-2">
              <span class="text-base">{categoryGroup.categoryEmoji}</span>
              <h3 class="text-base font-bold text-foreground">
                {categoryGroup.categoryName}
              </h3>
              <span class="text-xs text-muted-foreground font-mono">
                ({categoryGroup.items.length} {categoryGroup.items.length === 1 ? 'comparison' : 'comparisons'})
              </span>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {categoryGroup.items.map((c) => (
                <a
                  href={`/compare/${c.desiSlug}-vs-${c.globalSlug}`}
                  class="group relative flex flex-col justify-between rounded-2xl border border-border bg-white p-5 shadow-2xs hover:border-primary/50 hover:shadow-md transition duration-200"
                >
                  <div>
                    <!-- Header Badges -->
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-800 border border-emerald-200">
                        🇮🇳 18% GST Invoicing
                      </span>
                      <span class="text-[10px] font-mono text-muted-foreground group-hover:text-primary transition">
                        Teardown →
                      </span>
                    </div>

                    <!-- Matchup Row -->
                    <div class="flex items-center justify-between gap-3 py-2">
                      <!-- Desi Tool -->
                      <div class="flex-1 text-center">
                        <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-slate-50 p-1.5 shadow-2xs overflow-hidden">
                          <img src={c.desiLogo} alt={c.desiName} class="h-full w-full object-contain" />
                        </div>
                        <div class="mt-1.5 font-bold text-xs text-foreground truncate">{c.desiName}</div>
                        <span class="text-[10px] text-emerald-700 font-semibold">
                          {c.desiStartingPriceInr === 0 ? 'Free tier' : c.desiStartingPriceInr ? `₹${c.desiStartingPriceInr}/mo` : 'INR Pricing'}
                        </span>
                      </div>

                      <!-- VS Badge -->
                      <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[9px] font-black text-slate-500 font-mono">
                        VS
                      </div>

                      <!-- Global Tool -->
                      <div class="flex-1 text-center">
                        <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-slate-50 p-1.5 shadow-2xs overflow-hidden">
                          {c.globalLogo ? (
                            <img src={c.globalLogo} alt={c.globalName} class="h-full w-full object-contain" />
                          ) : (
                            <span class="text-xs font-bold text-slate-500 uppercase">{c.globalName.slice(0, 2)}</span>
                          )}
                        </div>
                        <div class="mt-1.5 font-bold text-xs text-foreground truncate">{c.globalName}</div>
                        <span class="text-[10px] text-muted-foreground font-medium">
                          {c.globalStartingPriceUsd ? `$${c.globalStartingPriceUsd}/mo` : 'USD Pricing'}
                        </span>
                      </div>
                    </div>

                    <p class="mt-3 text-[11px] text-muted-foreground line-clamp-2">
                      {c.desiName} vs {c.globalName}: pricing breakdown, 18% GST savings, DPDP data residency, and migration friction.
                    </p>
                  </div>

                  <div class="mt-3.5 pt-2.5 border-t border-border/60 flex items-center justify-between text-[11px]">
                    <span class="font-medium text-emerald-700">Save 18% GST</span>
                    <span class="font-bold text-primary group-hover:underline">Compare {c.desiName} vs {c.globalName} →</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<!-- Client Script for 2-Way Linked Dynamic Filtering -->
<script is:inline define:vars={{ mappingMatrix, desiToolsWithAlternatives, globalToolsWithAlternatives }}>
  const desiSelect = document.getElementById('desi-select');
  const globalSelect = document.getElementById('global-select');
  const form = document.getElementById('compare-selector-form');

  if (desiSelect && globalSelect && form) {
    // When Indian tool is chosen, filter Global tool options to only its mapped competitors
    desiSelect.addEventListener('change', () => {
      const selectedDesi = desiSelect.value;
      if (!selectedDesi) {
        // Reset global options
        populateGlobalOptions(globalToolsWithAlternatives);
        return;
      }

      const mappedGlobals = mappingMatrix
        .filter((m) => m.desiSlug === selectedDesi)
        .map((m) => ({ slug: m.globalSlug, name: m.globalName }));

      populateGlobalOptions(mappedGlobals);
      if (mappedGlobals.length === 1) {
        globalSelect.value = mappedGlobals[0].slug;
      }
    });

    // When Global tool is chosen, filter Indian tool options to only its mapped alternatives
    globalSelect.addEventListener('change', () => {
      const selectedGlobal = globalSelect.value;
      if (!selectedGlobal) {
        // Reset desi options
        populateDesiOptions(desiToolsWithAlternatives);
        return;
      }

      const mappedDesis = mappingMatrix
        .filter((m) => m.globalSlug === selectedGlobal)
        .map((m) => ({ slug: m.desiSlug, name: m.desiName }));

      populateDesiOptions(mappedDesis);
      if (mappedDesis.length === 1) {
        desiSelect.value = mappedDesis[0].slug;
      }
    });

    function populateGlobalOptions(items) {
      const currentValue = globalSelect.value;
      globalSelect.innerHTML = '<option value="" selected>Choose Global Incumbent...</option>';
      items.forEach((item) => {
        const opt = document.createElement('option');
        opt.value = item.slug;
        opt.textContent = item.name;
        if (item.slug === currentValue) opt.selected = true;
        globalSelect.appendChild(opt);
      });
    }

    function populateDesiOptions(items) {
      const currentValue = desiSelect.value;
      desiSelect.innerHTML = '<option value="" selected>Choose Indian SaaS...</option>';
      items.forEach((item) => {
        const opt = document.createElement('option');
        opt.value = item.slug;
        opt.textContent = item.name;
        if (item.slug === currentValue) opt.selected = true;
        desiSelect.appendChild(opt);
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const desiVal = desiSelect.value;
      const globalVal = globalSelect.value;

      if (!desiVal || !globalVal) {
        alert('Please select both an Indian Sovereign tool and a Global Incumbent tool.');
        return;
      }

      window.location.href = `/compare/${desiVal}-vs-${globalVal}`;
    });
  }
</script>
