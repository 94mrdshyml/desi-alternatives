---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { newsletterSubscribers, users, claimsQueue } from '@/lib/server/db/schema';
import { eq, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}

let subscribersList: any[] = [];
let totalSubscribers = 0;
let activeSubscribers = 0;
let unsubscribedCount = 0;
let sourceStats = {
  registration: 0,
  profile: 0,
  newsletter_page: 0,
};

let pendingClaimsCount = 0;
let totalUsersCount = 0;

if (db) {
  try {
    // 1. Fetch all subscribers with user details
    subscribersList = await db
      .select({
        id: newsletterSubscribers.id,
        email: newsletterSubscribers.email,
        name: newsletterSubscribers.name,
        userId: newsletterSubscribers.userId,
        source: newsletterSubscribers.source,
        status: newsletterSubscribers.status,
        token: newsletterSubscribers.token,
        subscribedAt: newsletterSubscribers.subscribedAt,
        unsubscribedAt: newsletterSubscribers.unsubscribedAt,
        userName: users.name,
        userRole: users.role,
        userAvatar: users.image,
      })
      .from(newsletterSubscribers)
      .leftJoin(users, eq(newsletterSubscribers.userId, users.id))
      .orderBy(desc(newsletterSubscribers.subscribedAt))
      .all();

    totalSubscribers = subscribersList.length;
    activeSubscribers = subscribersList.filter((s) => s.status === 'subscribed').length;
    unsubscribedCount = subscribersList.filter((s) => s.status === 'unsubscribed').length;

    subscribersList.forEach((s) => {
      if (s.source === 'registration') sourceStats.registration++;
      else if (s.source === 'profile') sourceStats.profile++;
      else if (s.source === 'newsletter_page') sourceStats.newsletter_page++;
    });

    // Counts for sidebar
    const [claimsRes, usersRes] = await Promise.all([
      db.select({ count: sql<number>`count(*)` }).from(claimsQueue).where(eq(claimsQueue.status, 'pending')).get(),
      db.select({ count: sql<number>`count(*)` }).from(users).get(),
    ]);
    pendingClaimsCount = claimsRes?.count || 0;
    totalUsersCount = usersRes?.count || 0;
  } catch (e) {
    console.error('Failed to load newsletter admin data:', e);
  }
}

const regPct = totalSubscribers > 0 ? Math.round((sourceStats.registration / totalSubscribers) * 100) : 0;
const profPct = totalSubscribers > 0 ? Math.round((sourceStats.profile / totalSubscribers) * 100) : 0;
const pagePct = totalSubscribers > 0 ? Math.round((sourceStats.newsletter_page / totalSubscribers) * 100) : 0;
---

<AdminLayout
  title="Newsletter & Subscribers — Desi Alternatives Admin"
  description="Manage Desi Alternatives Dispatch subscribers, monitor acquisition attribution channels, and export subscriber lists."
  currentSection="newsletter"
  counts={{
    claims: pendingClaimsCount,
    users: totalUsersCount,
    newsletter: activeSubscribers,
  }}
>
  <div class="space-y-6 pb-12">
    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border bg-white p-6 rounded-2xl shadow-xs">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold tracking-tight text-foreground sm:text-2xl">
              Desi Alternatives Dispatch
            </h1>
            <p class="text-xs text-muted-foreground">
              Subscriber management, source attribution analytics, and list hygiene.
            </p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/newsletter"
          target="_blank"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-white px-3.5 py-2 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition"
        >
          <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>View Public Page</span>
        </a>

        <button
          type="button"
          id="export-csv-btn"
          class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Export CSV</span>
        </button>
      </div>
    </div>

    <!-- 4 Metrics Cards -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Card 1: Active Subscribers -->
      <div class="rounded-2xl border border-border bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-muted-foreground">
          <span>Active Subscribers</span>
          <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-foreground">{activeSubscribers}</span>
          <span class="text-xs text-muted-foreground">/ {totalSubscribers} total</span>
        </div>
        <p class="mt-1 text-[11px] text-emerald-700">
          {unsubscribedCount} unsubscribed ({totalSubscribers > 0 ? Math.round((unsubscribedCount / totalSubscribers) * 100) : 0}% churn)
        </p>
      </div>

      <!-- Card 2: Registration Origin -->
      <div class="rounded-2xl border border-border bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-muted-foreground">
          <span>Registration Checkbox</span>
          <span class="rounded bg-indigo-50 px-1.5 py-0.5 text-[10px] font-bold text-indigo-700">
            {regPct}%
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-foreground">{sourceStats.registration}</span>
          <span class="text-xs text-muted-foreground">signups</span>
        </div>
        <p class="mt-1 text-[11px] text-muted-foreground">
          Converted during account creation
        </p>
      </div>

      <!-- Card 3: Profile Settings Origin -->
      <div class="rounded-2xl border border-border bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-muted-foreground">
          <span>Profile Settings</span>
          <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700">
            {profPct}%
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-foreground">{sourceStats.profile}</span>
          <span class="text-xs text-muted-foreground">users</span>
        </div>
        <p class="mt-1 text-[11px] text-muted-foreground">
          Activated from account settings
        </p>
      </div>

      <!-- Card 4: Dedicated Page Origin -->
      <div class="rounded-2xl border border-border bg-white p-5 shadow-xs">
        <div class="flex items-center justify-between text-xs font-semibold text-muted-foreground">
          <span>Dedicated Landing Page</span>
          <span class="rounded bg-amber-50 px-1.5 py-0.5 text-[10px] font-bold text-amber-700">
            {pagePct}%
          </span>
        </div>
        <div class="mt-2 flex items-baseline gap-2">
          <span class="text-2xl font-extrabold text-foreground">{sourceStats.newsletter_page}</span>
          <span class="text-xs text-muted-foreground">readers</span>
        </div>
        <p class="mt-1 text-[11px] text-muted-foreground">
          Acquired via /newsletter landing page
        </p>
      </div>
    </div>

    <!-- Source Attribution Progress Bar -->
    <div class="rounded-2xl border border-border bg-white p-5 shadow-xs">
      <h2 class="text-xs font-bold uppercase tracking-wider text-muted-foreground mb-3">
        Acquisition Source Distribution
      </h2>
      <div class="h-3 w-full overflow-hidden rounded-full bg-slate-100 flex">
        <div style={`width: ${regPct}%`} class="bg-indigo-500 transition-all duration-500" title={`Registration: ${sourceStats.registration} (${regPct}%)`}></div>
        <div style={`width: ${profPct}%`} class="bg-emerald-500 transition-all duration-500" title={`Profile: ${sourceStats.profile} (${profPct}%)`}></div>
        <div style={`width: ${pagePct}%`} class="bg-amber-500 transition-all duration-500" title={`Landing Page: ${sourceStats.newsletter_page} (${pagePct}%)`}></div>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-4 text-xs font-medium">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-indigo-500"></span>
          <span class="text-muted-foreground">Registration:</span>
          <span class="font-bold text-foreground">{sourceStats.registration} ({regPct}%)</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span class="text-muted-foreground">Profile Settings:</span>
          <span class="font-bold text-foreground">{sourceStats.profile} ({profPct}%)</span>
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          <span class="text-muted-foreground">Dedicated Page:</span>
          <span class="font-bold text-foreground">{sourceStats.newsletter_page} ({pagePct}%)</span>
        </span>
      </div>
    </div>

    <!-- Subscriber Table Section -->
    <div class="rounded-2xl border border-border bg-white shadow-xs overflow-hidden">
      <!-- Search & Filters Toolbar -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border bg-slate-50/50 p-4">
        <div class="relative flex-1 sm:max-w-xs">
          <input
            type="text"
            id="search-input"
            placeholder="Search email, name..."
            class="w-full rounded-xl border border-border bg-white py-2 pl-9 pr-3 text-xs text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none"
          />
          <svg class="absolute left-3 top-2.5 h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <div class="flex items-center gap-2">
          <!-- Source Filter -->
          <select
            id="source-filter"
            class="rounded-xl border border-border bg-white px-3 py-2 text-xs text-foreground shadow-2xs focus:outline-none cursor-pointer"
          >
            <option value="all">All Sources</option>
            <option value="registration">Registration Checkbox</option>
            <option value="profile">Profile Settings</option>
            <option value="newsletter_page">Dedicated Page</option>
          </select>

          <!-- Status Filter -->
          <select
            id="status-filter"
            class="rounded-xl border border-border bg-white px-3 py-2 text-xs text-foreground shadow-2xs focus:outline-none cursor-pointer"
          >
            <option value="all">All Statuses</option>
            <option value="subscribed">Active Subscribed</option>
            <option value="unsubscribed">Unsubscribed</option>
          </select>
        </div>
      </div>

      <!-- Subscribers Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-border bg-slate-50/80">
            <tr>
              <th class="py-3 px-4 font-semibold text-foreground">Subscriber</th>
              <th class="py-3 px-4 font-semibold text-foreground">Acquisition Source</th>
              <th class="py-3 px-4 font-semibold text-foreground">Account Link</th>
              <th class="py-3 px-4 font-semibold text-foreground">Status</th>
              <th class="py-3 px-4 font-semibold text-foreground">Subscribed Date</th>
              <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="subscribers-tbody" class="divide-y divide-border">
            {subscribersList.length === 0 ? (
              <tr>
                <td colspan="6" class="py-8 text-center text-xs text-muted-foreground">
                  No subscribers recorded yet.
                </td>
              </tr>
            ) : (
              subscribersList.map((s) => (
                <tr
                  class="subscriber-row hover:bg-slate-50/50 transition"
                  data-email={s.email.toLowerCase()}
                  data-name={(s.name || s.userName || '').toLowerCase()}
                  data-source={s.source}
                  data-status={s.status}
                >
                  <!-- Subscriber -->
                  <td class="py-3 px-4">
                    <div class="flex items-center gap-2.5">
                      <div class="flex h-7 w-7 items-center justify-center rounded-full bg-secondary text-xs font-bold text-foreground">
                        {(s.name || s.email).slice(0, 1).toUpperCase()}
                      </div>
                      <div>
                        <div class="font-bold text-foreground">{s.name || s.userName || 'Anonymous Reader'}</div>
                        <div class="font-mono text-[11px] text-muted-foreground">{s.email}</div>
                      </div>
                    </div>
                  </td>

                  <!-- Acquisition Source Pill -->
                  <td class="py-3 px-4">
                    {s.source === 'registration' ? (
                      <span class="inline-flex items-center gap-1 rounded-md bg-indigo-50 border border-indigo-200 px-2 py-0.5 text-[10px] font-bold text-indigo-700">
                        <span>📝</span> Registration Checkbox
                      </span>
                    ) : s.source === 'profile' ? (
                      <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[10px] font-bold text-emerald-700">
                        <span>👤</span> Profile Settings
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 border border-amber-200 px-2 py-0.5 text-[10px] font-bold text-amber-700">
                        <span>📬</span> Dedicated Page
                      </span>
                    )}
                  </td>

                  <!-- Account Link -->
                  <td class="py-3 px-4">
                    {s.userId ? (
                      <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-semibold text-slate-700">
                        ✓ Registered User
                      </span>
                    ) : (
                      <span class="text-muted-foreground text-[11px]">Guest Subscriber</span>
                    )}
                  </td>

                  <!-- Status -->
                  <td class="py-3 px-4">
                    <span class={`inline-flex items-center gap-1 rounded-md px-2 py-0.5 text-[10px] font-bold ${
                      s.status === 'subscribed'
                        ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        : 'bg-red-50 text-red-700 border border-red-200'
                    }`}>
                      <span class={`h-1.5 w-1.5 rounded-full ${s.status === 'subscribed' ? 'bg-emerald-500' : 'bg-red-500'}`}></span>
                      {s.status.toUpperCase()}
                    </span>
                  </td>

                  <!-- Subscribed Date -->
                  <td class="py-3 px-4 text-muted-foreground font-mono text-[11px]">
                    {s.subscribedAt ? new Date(s.subscribedAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }) : '—'}
                  </td>

                  <!-- Actions -->
                  <td class="py-3 px-4 text-right">
                    {s.status === 'subscribed' ? (
                      <button
                        type="button"
                        data-action="unsub"
                        data-email={s.email}
                        class="admin-sub-action-btn rounded-lg border border-red-200 bg-white px-2 py-1 text-[11px] font-semibold text-red-700 hover:bg-red-50 transition cursor-pointer"
                      >
                        Unsubscribe
                      </button>
                    ) : (
                      <button
                        type="button"
                        data-action="resub"
                        data-email={s.email}
                        class="admin-sub-action-btn rounded-lg border border-emerald-200 bg-white px-2 py-1 text-[11px] font-semibold text-emerald-700 hover:bg-emerald-50 transition cursor-pointer"
                      >
                        Reactivate
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Search & Filter Logic
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const sourceFilter = document.getElementById('source-filter') as HTMLSelectElement | null;
  const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.subscriber-row'));

  function filterTable() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const source = sourceFilter?.value || 'all';
    const status = statusFilter?.value || 'all';

    rows.forEach((row) => {
      const email = row.dataset.email || '';
      const name = row.dataset.name || '';
      const rowSource = row.dataset.source || '';
      const rowStatus = row.dataset.status || '';

      const matchesQuery = !q || email.includes(q) || name.includes(q);
      const matchesSource = source === 'all' || rowSource === source;
      const matchesStatus = status === 'all' || rowStatus === status;

      if (matchesQuery && matchesSource && matchesStatus) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  searchInput?.addEventListener('input', filterTable);
  sourceFilter?.addEventListener('change', filterTable);
  statusFilter?.addEventListener('change', filterTable);

  // Export CSV
  const exportBtn = document.getElementById('export-csv-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const visibleRows = rows.filter((r) => r.style.display !== 'none');
      const headers = ['Email', 'Name', 'Source', 'Status'];
      const csvLines = [headers.join(',')];

      visibleRows.forEach((row) => {
        const email = row.dataset.email || '';
        const name = row.dataset.name || '';
        const source = row.dataset.source || '';
        const status = row.dataset.status || '';
        csvLines.push(`"${email}","${name}","${source}","${status}"`);
      });

      const blob = new Blob([csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `desi-alternatives-subscribers-${new Date().toISOString().split('T')[0]}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  // Admin Action Buttons (Unsubscribe / Reactivate)
  const actionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.admin-sub-action-btn'));
  actionButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const action = btn.dataset.action;
      const email = btn.dataset.email;
      if (!email) return;

      btn.disabled = true;
      btn.textContent = 'Processing...';

      try {
        if (action === 'unsub') {
          const res = await fetch('/api/newsletter/unsubscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          if (res.ok) {
            window.location.reload();
          }
        } else {
          const res = await fetch('/api/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, source: 'profile' }),
          });
          if (res.ok) {
            window.location.reload();
          }
        }
      } catch {
        alert('Action failed. Please try again.');
        btn.disabled = false;
        btn.textContent = action === 'unsub' ? 'Unsubscribe' : 'Reactivate';
      }
    });
  });
</script>
