---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { categories, claimsQueue, desiTools, globalTools, users } from '@/lib/server/db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

let pendingClaims: any[] = [];
let pendingTools: any[] = [];
let allUsersList: any[] = [];
let allCategoriesList: any[] = [];
let globalToolsList: any[] = [];
let totalToolsCount = 0;
let totalAdminsCount = 0;
let categoryCounts: Record<string, number> = {};

if (db && user && user.role === 'admin') {
  try {
    // 1. Pending Claims
    pendingClaims = await db
      .select({
        id: claimsQueue.id,
        toolId: claimsQueue.toolId,
        toolName: desiTools.name,
        toolSlug: desiTools.slug,
        userId: claimsQueue.userId,
        userName: users.name,
        userEmail: users.email,
        workEmail: claimsQueue.workEmail,
        notes: claimsQueue.notes,
        submittedAt: claimsQueue.submittedAt,
        status: claimsQueue.status,
      })
      .from(claimsQueue)
      .leftJoin(desiTools, eq(claimsQueue.toolId, desiTools.id))
      .leftJoin(users, eq(claimsQueue.userId, users.id))
      .where(eq(claimsQueue.status, 'pending'))
      .orderBy(desc(claimsQueue.submittedAt))
      .all();

    // 2. Pending / Draft Tools
    pendingTools = await db
      .select({
        id: desiTools.id,
        name: desiTools.name,
        slug: desiTools.slug,
        tagline: desiTools.tagline,
        websiteUrl: desiTools.websiteUrl,
        pricingModel: desiTools.pricingModel,
        startingPriceInr: desiTools.startingPriceInr,
        createdAt: desiTools.createdAt,
        status: desiTools.status,
      })
      .from(desiTools)
      .where(eq(desiTools.status, 'draft'))
      .orderBy(desc(desiTools.createdAt))
      .all();

    // 3. All Users
    allUsersList = await db
      .select({
        id: users.id,
        name: users.name,
        email: users.email,
        role: users.role,
        banned: users.banned,
        createdAt: users.createdAt,
      })
      .from(users)
      .orderBy(desc(users.createdAt))
      .all();

    totalAdminsCount = allUsersList.filter((u) => u.role === 'admin').length;

    // 4. Categories & Counts
    allCategoriesList = await db.select().from(categories).orderBy(categories.name).all();
    globalToolsList = await db.select().from(globalTools).orderBy(globalTools.name).all();

    const allTools = await db
      .select({ id: desiTools.id, categoryId: desiTools.categoryId })
      .from(desiTools)
      .all();

    totalToolsCount = allTools.length;
    for (const t of allTools) {
      if (t.categoryId) {
        categoryCounts[t.categoryId] = (categoryCounts[t.categoryId] || 0) + 1;
      }
    }
  } catch (e) {
    console.error('Failed to load admin dashboard:', e);
  }
}
---

<BaseLayout title="Admin Control Center — Desi Alternatives">
  <Navbar />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    {!user || user.role !== 'admin' ? (
      <div class="mx-auto max-w-md rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
        <span class="text-3xl">🛡️</span>
        <h1 class="mt-3 text-lg font-bold text-red-900">Admin Access Restricted</h1>
        <p class="mt-2 text-xs text-red-700 leading-relaxed">
          You must be logged into an account with the <code>admin</code> role to view the moderation center and manage tools.
        </p>
        <a
          href="/login"
          class="mt-5 inline-flex items-center rounded-xl bg-foreground px-4 py-2 text-xs font-semibold text-background hover:bg-foreground/90 transition"
        >
          Sign in as Admin
        </a>
      </div>
    ) : (
      <div>
        <!-- Admin Header -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-6">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-2xl font-bold text-foreground">Admin Control Center</h1>
              <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-bold text-amber-800 uppercase">
                Admin Panel
              </span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
              Direct tool publishing, category taxonomy management, user role elevation, and moderation queues.
            </p>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="open-create-tool-modal"
              class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
            >
              <span>➕ Add New Tool</span>
            </button>

            <button
              type="button"
              id="open-create-cat-modal"
              class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-white px-3.5 py-2 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition cursor-pointer"
            >
              <span>📁 Add Category</span>
            </button>
          </div>
        </div>

        <!-- Metrics Row -->
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
          <div class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs">
            <span class="text-muted-foreground">Total Tools</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{totalToolsCount}</p>
          </div>
          <div class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs">
            <span class="text-muted-foreground">Categories</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{allCategoriesList.length}</p>
          </div>
          <div class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs">
            <span class="text-muted-foreground">Total Users</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{allUsersList.length}</p>
          </div>
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-center shadow-2xs">
            <span class="text-amber-800 font-semibold">Pending Approvals</span>
            <p class="font-bold text-amber-900 text-lg mt-0.5">{pendingTools.length + pendingClaims.length}</p>
          </div>
        </div>

        <!-- Section 1: Categories Taxonomy Management -->
        <section class="mt-10">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-foreground">
              Categories & Taxonomy ({allCategoriesList.length})
            </h2>
            <span class="text-xs text-muted-foreground">Clean URLs live at <code>/category/[slug]</code></span>
          </div>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-border bg-secondary/40">
                <tr>
                  <th class="py-3 px-4 font-semibold text-foreground">Category</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Slug</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Tools Count</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Featured</th>
                  <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {allCategoriesList.map((cat) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="py-3 px-4 font-medium text-foreground">
                      <span class="mr-1.5">{cat.emoji}</span>
                      <span class="font-bold">{cat.name}</span>
                    </td>
                    <td class="py-3 px-4 text-muted-foreground">
                      <a href={`/category/${cat.slug}`} target="_blank" class="text-primary underline hover:text-primary-hover">
                        /category/{cat.slug}
                      </a>
                    </td>
                    <td class="py-3 px-4 font-semibold text-foreground">
                      {categoryCounts[cat.id] || 0} tools
                    </td>
                    <td class="py-3 px-4">
                      {cat.isFeatured ? (
                        <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-800">
                          Featured
                        </span>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="inline-flex items-center gap-2">
                        <button
                          type="button"
                          data-edit-cat-id={cat.id}
                          data-edit-cat-name={cat.name}
                          data-edit-cat-slug={cat.slug}
                          data-edit-cat-emoji={cat.emoji}
                          data-edit-cat-desc={cat.description || ''}
                          data-edit-cat-featured={cat.isFeatured ? 'true' : 'false'}
                          class="edit-cat-btn rounded-lg border border-border bg-white px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
                        >
                          Edit
                        </button>
                        <button
                          type="button"
                          data-delete-cat-id={cat.id}
                          class="delete-cat-btn rounded-lg border border-red-200 bg-red-50 px-2.5 py-1 text-[11px] font-semibold text-red-700 hover:bg-red-100 transition cursor-pointer"
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 2: User & Role Management -->
        <section class="mt-10">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-foreground">
              User & Role Management ({allUsersList.length})
            </h2>
            <span class="text-xs text-muted-foreground">{totalAdminsCount} admins registered</span>
          </div>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-border bg-secondary/40">
                <tr>
                  <th class="py-3 px-4 font-semibold text-foreground">User</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Email</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Role</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Status</th>
                  <th class="py-3 px-4 font-semibold text-foreground text-right">Role Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {allUsersList.map((u) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="py-3 px-4 font-semibold text-foreground">{u.name}</td>
                    <td class="py-3 px-4 text-muted-foreground">{u.email}</td>
                    <td class="py-3 px-4">
                      {u.role === 'admin' ? (
                        <span class="inline-flex items-center rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800 uppercase">
                          Admin
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded-md bg-secondary px-2 py-0.5 text-[10px] font-medium text-foreground">
                          User
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-4">
                      {u.banned ? (
                        <span class="inline-flex items-center rounded-md bg-red-100 px-2 py-0.5 text-[10px] font-bold text-red-800">
                          Banned
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-medium text-emerald-700">
                          Active
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="inline-flex items-center gap-2">
                        {u.role === 'admin' ? (
                          <button
                            type="button"
                            data-user-action="setRole"
                            data-user-id={u.id}
                            data-target-role="user"
                            class="rounded-lg border border-border bg-white px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
                          >
                            Demote to User
                          </button>
                        ) : (
                          <button
                            type="button"
                            data-user-action="setRole"
                            data-user-id={u.id}
                            data-target-role="admin"
                            class="rounded-lg bg-amber-600 px-2.5 py-1 text-[11px] font-semibold text-white hover:bg-amber-700 transition cursor-pointer"
                          >
                            Promote to Admin
                          </button>
                        )}

                        {u.banned ? (
                          <button
                            type="button"
                            data-user-action="unban"
                            data-user-id={u.id}
                            class="rounded-lg border border-emerald-300 bg-emerald-50 px-2 py-1 text-[10px] font-semibold text-emerald-700 hover:bg-emerald-100 transition cursor-pointer"
                          >
                            Unban
                          </button>
                        ) : (
                          <button
                            type="button"
                            data-user-action="ban"
                            data-user-id={u.id}
                            class="rounded-lg border border-red-200 bg-red-50 px-2 py-1 text-[10px] font-semibold text-red-700 hover:bg-red-100 transition cursor-pointer"
                          >
                            Ban
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 3: Pending Tool Submissions -->
        <section class="mt-10">
          <h2 class="text-base font-bold text-foreground">
            Pending Tool Submissions ({pendingTools.length})
          </h2>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            {pendingTools.length === 0 ? (
              <div class="p-8 text-center text-xs text-muted-foreground">
                No pending tool submissions in queue.
              </div>
            ) : (
              <table class="w-full text-left text-xs">
                <thead class="border-b border-border bg-secondary/40">
                  <tr>
                    <th class="py-3 px-4 font-semibold text-foreground">Tool</th>
                    <th class="py-3 px-4 font-semibold text-foreground">Pricing</th>
                    <th class="py-3 px-4 font-semibold text-foreground">Website</th>
                    <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {pendingTools.map((tool) => (
                    <tr class="hover:bg-slate-50/50">
                      <td class="py-3 px-4">
                        <p class="font-bold text-foreground">{tool.name}</p>
                        <p class="text-muted-foreground line-clamp-1">{tool.tagline}</p>
                      </td>
                      <td class="py-3 px-4 font-medium text-foreground">
                        {tool.pricingModel} {tool.startingPriceInr ? `(₹${tool.startingPriceInr})` : ''}
                      </td>
                      <td class="py-3 px-4">
                        <a href={tool.websiteUrl} target="_blank" class="text-primary underline hover:text-primary-hover">
                          {tool.websiteUrl}
                        </a>
                      </td>
                      <td class="py-3 px-4 text-right">
                        <div class="inline-flex items-center gap-2">
                          <button
                            type="button"
                            data-tool-action="publish"
                            data-tool-id={tool.id}
                            class="rounded-lg bg-emerald-600 px-3 py-1.5 font-semibold text-white hover:bg-emerald-700 transition cursor-pointer"
                          >
                            Publish
                          </button>
                          <button
                            type="button"
                            data-tool-action="delete"
                            data-tool-id={tool.id}
                            class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 font-semibold text-red-700 hover:bg-red-100 transition cursor-pointer"
                          >
                            Reject
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </section>

        <!-- Section 4: Pending Claims Queue -->
        <section class="mt-10">
          <h2 class="text-base font-bold text-foreground">
            Pending Ownership Claims ({pendingClaims.length})
          </h2>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            {pendingClaims.length === 0 ? (
              <div class="p-8 text-center text-xs text-muted-foreground">
                No pending claims in queue.
              </div>
            ) : (
              <table class="w-full text-left text-xs">
                <thead class="border-b border-border bg-secondary/40">
                  <tr>
                    <th class="py-3 px-4 font-semibold text-foreground">Tool</th>
                    <th class="py-3 px-4 font-semibold text-foreground">Claimant</th>
                    <th class="py-3 px-4 font-semibold text-foreground">Work Email</th>
                    <th class="py-3 px-4 font-semibold text-foreground">Notes</th>
                    <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border">
                  {pendingClaims.map((claim) => (
                    <tr class="hover:bg-slate-50/50">
                      <td class="py-3 px-4 font-bold text-foreground">{claim.toolName}</td>
                      <td class="py-3 px-4">
                        <p class="font-medium text-foreground">{claim.userName}</p>
                        <p class="text-muted-foreground">{claim.userEmail}</p>
                      </td>
                      <td class="py-3 px-4 font-semibold text-primary">{claim.workEmail}</td>
                      <td class="py-3 px-4 text-muted-foreground">{claim.notes || '—'}</td>
                      <td class="py-3 px-4 text-right">
                        <div class="inline-flex items-center gap-2">
                          <button
                            type="button"
                            data-claim-action="approve"
                            data-claim-id={claim.id}
                            class="rounded-lg bg-emerald-600 px-3 py-1.5 font-semibold text-white hover:bg-emerald-700 transition cursor-pointer"
                          >
                            Approve
                          </button>
                          <button
                            type="button"
                            data-claim-action="reject"
                            data-claim-id={claim.id}
                            class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 font-semibold text-red-700 hover:bg-red-100 transition cursor-pointer"
                          >
                            Reject
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </section>
      </div>
    )}
  </main>

  <!-- Modal 1: Create Tool Direct (Published) -->
  <div id="create-tool-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-2xl border border-border bg-white p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-border">
        <h3 class="text-base font-bold text-foreground">➕ Add New Indian SaaS Tool (Direct Publish)</h3>
        <button id="close-tool-modal" class="text-muted-foreground hover:text-foreground cursor-pointer text-sm">✕</button>
      </div>

      <form id="admin-create-tool-form" class="mt-4 space-y-4">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-foreground">Tool Name *</label>
            <input type="text" name="name" required placeholder="e.g. Zoho" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-foreground">Website URL *</label>
            <input type="url" name="websiteUrl" required placeholder="https://zoho.com" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground">Tagline *</label>
          <input type="text" name="tagline" required placeholder="Suite of cloud software applications for businesses" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground">Description</label>
          <textarea name="description" rows="2" placeholder="Full overview of the software..." class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary"></textarea>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div>
            <label class="block text-xs font-semibold text-foreground">Category *</label>
            <select name="categoryId" required class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary">
              <option value="">Select category...</option>
              {allCategoriesList.map((c) => (
                <option value={c.id}>{c.emoji} {c.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-foreground">Pricing Model *</label>
            <select name="pricingModel" required class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary">
              <option value="Freemium">Freemium</option>
              <option value="Free">Free</option>
              <option value="Paid">Paid</option>
              <option value="Open-Source">Open-Source</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-foreground">Starting Price (₹ INR)</label>
            <input type="number" name="startingPriceInr" placeholder="0" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
        </div>

        <!-- Global Alternatives Mapping -->
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1">Global Alternative Replaced</label>
          <select name="globalToolIds" class="w-full rounded-xl border border-border bg-white px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary">
            <option value="">None / Independent</option>
            {globalToolsList.map((gt) => (
              <option value={gt.id}>{gt.name} ({gt.websiteUrl})</option>
            ))}
          </select>
        </div>

        <!-- Sovereign Badges Checklist -->
        <div>
          <label class="block text-xs font-semibold text-foreground mb-1.5">Sovereign Compliance Badges</label>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-1.5"><input type="checkbox" name="hasIndianDataResidency" /> 🇮🇳 India Data Residency</label>
            <label class="flex items-center gap-1.5"><input type="checkbox" name="hasGstInvoice" /> 🧾 GST Invoices</label>
            <label class="flex items-center gap-1.5"><input type="checkbox" name="hasInrPricing" /> ₹ Direct INR Billing</label>
            <label class="flex items-center gap-1.5"><input type="checkbox" name="hasUpiSupport" /> ⚡ UPI Payments</label>
            <label class="flex items-center gap-1.5"><input type="checkbox" name="isOpenSource" /> 🔓 Open Source</label>
            <label class="flex items-center gap-1.5"><input type="checkbox" name="hasIstSupport" /> ⏱️ Dedicated IST Support</label>
          </div>
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-primary py-2.5 text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition cursor-pointer"
        >
          Publish Tool to Directory
        </button>
      </form>
    </div>
  </div>

  <!-- Modal 2: Create Category -->
  <div id="create-cat-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-white p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-border">
        <h3 class="text-base font-bold text-foreground">📁 Add New Category</h3>
        <button id="close-create-cat-modal" class="text-muted-foreground hover:text-foreground cursor-pointer text-sm">✕</button>
      </div>

      <form id="admin-create-cat-form" class="mt-4 space-y-3">
        <div>
          <label class="block text-xs font-semibold text-foreground">Category Name *</label>
          <input type="text" name="name" required placeholder="e.g. Email & Communications" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-foreground">Emoji Icon *</label>
            <input type="text" name="emoji" required placeholder="✉️" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-foreground">Custom Slug (optional)</label>
            <input type="text" name="slug" placeholder="email-communications" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground">Description</label>
          <textarea name="description" rows="2" placeholder="Brief description for SEO..." class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary"></textarea>
        </div>

        <label class="flex items-center gap-2 text-xs font-medium text-foreground cursor-pointer">
          <input type="checkbox" name="isFeatured" />
          <span>Feature on top filters list</span>
        </label>

        <button type="submit" class="w-full rounded-xl bg-primary py-2.5 text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition cursor-pointer">
          Create Category
        </button>
      </form>
    </div>
  </div>

  <!-- Modal 3: Edit Category -->
  <div id="edit-cat-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-white p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-3 border-b border-border">
        <h3 class="text-base font-bold text-foreground">✏️ Edit Category</h3>
        <button id="close-edit-cat-modal" class="text-muted-foreground hover:text-foreground cursor-pointer text-sm">✕</button>
      </div>

      <form id="admin-edit-cat-form" class="mt-4 space-y-3">
        <input type="hidden" name="id" id="edit-cat-id-input" />

        <div>
          <label class="block text-xs font-semibold text-foreground">Category Name *</label>
          <input type="text" name="name" id="edit-cat-name-input" required class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-foreground">Emoji Icon *</label>
            <input type="text" name="emoji" id="edit-cat-emoji-input" required class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-foreground">Slug</label>
            <input type="text" name="slug" id="edit-cat-slug-input" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground">Description</label>
          <textarea name="description" id="edit-cat-desc-input" rows="2" class="mt-1 w-full rounded-xl border border-border px-3 py-2 text-xs text-foreground focus:outline-none focus:border-primary"></textarea>
        </div>

        <label class="flex items-center gap-2 text-xs font-medium text-foreground cursor-pointer">
          <input type="checkbox" name="isFeatured" id="edit-cat-featured-input" />
          <span>Feature on top filters list</span>
        </label>

        <button type="submit" class="w-full rounded-xl bg-primary py-2.5 text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition cursor-pointer">
          Save Changes
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  // Tool modal
  const toolModal = document.getElementById('create-tool-modal');
  const openToolBtn = document.getElementById('open-create-tool-modal');
  const closeToolBtn = document.getElementById('close-tool-modal');
  const createToolForm = document.getElementById('admin-create-tool-form') as HTMLFormElement | null;

  if (openToolBtn && toolModal && closeToolBtn) {
    openToolBtn.addEventListener('click', () => toolModal.classList.remove('hidden'));
    closeToolBtn.addEventListener('click', () => toolModal.classList.add('hidden'));
  }

  if (createToolForm) {
    createToolForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createToolForm);
      const payload = {
        action: 'create',
        name: formData.get('name'),
        websiteUrl: formData.get('websiteUrl'),
        tagline: formData.get('tagline'),
        description: formData.get('description'),
        categoryId: formData.get('categoryId'),
        pricingModel: formData.get('pricingModel'),
        startingPriceInr: formData.get('startingPriceInr') ? Number(formData.get('startingPriceInr')) : 0,
        globalToolIds: formData.get('globalToolIds') ? [formData.get('globalToolIds')] : [],
        hasIndianDataResidency: formData.get('hasIndianDataResidency') === 'on',
        hasGstInvoice: formData.get('hasGstInvoice') === 'on',
        hasInrPricing: formData.get('hasInrPricing') === 'on',
        hasUpiSupport: formData.get('hasUpiSupport') === 'on',
        isOpenSource: formData.get('isOpenSource') === 'on',
        hasIstSupport: formData.get('hasIstSupport') === 'on',
      };

      try {
        const res = await fetch('/api/admin/tools', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to publish tool');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Create Category modal
  const createCatModal = document.getElementById('create-cat-modal');
  const openCreateCatBtn = document.getElementById('open-create-cat-modal');
  const closeCreateCatBtn = document.getElementById('close-create-cat-modal');
  const createCatForm = document.getElementById('admin-create-cat-form') as HTMLFormElement | null;

  if (openCreateCatBtn && createCatModal && closeCreateCatBtn) {
    openCreateCatBtn.addEventListener('click', () => createCatModal.classList.remove('hidden'));
    closeCreateCatBtn.addEventListener('click', () => createCatModal.classList.add('hidden'));
  }

  if (createCatForm) {
    createCatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createCatForm);
      const payload = {
        action: 'create',
        name: formData.get('name'),
        emoji: formData.get('emoji'),
        slug: formData.get('slug'),
        description: formData.get('description'),
        isFeatured: formData.get('isFeatured') === 'on',
      };

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to create category');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Edit Category modal
  const editCatModal = document.getElementById('edit-cat-modal');
  const closeEditCatBtn = document.getElementById('close-edit-cat-modal');
  const editCatForm = document.getElementById('admin-edit-cat-form') as HTMLFormElement | null;

  if (closeEditCatBtn && editCatModal) {
    closeEditCatBtn.addEventListener('click', () => editCatModal.classList.add('hidden'));
  }

  document.querySelectorAll('.edit-cat-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!editCatModal) return;
      (document.getElementById('edit-cat-id-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-id') || '';
      (document.getElementById('edit-cat-name-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-name') || '';
      (document.getElementById('edit-cat-slug-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-slug') || '';
      (document.getElementById('edit-cat-emoji-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-emoji') || '';
      (document.getElementById('edit-cat-desc-input') as HTMLTextAreaElement).value = btn.getAttribute('data-edit-cat-desc') || '';
      (document.getElementById('edit-cat-featured-input') as HTMLInputElement).checked = btn.getAttribute('data-edit-cat-featured') === 'true';
      editCatModal.classList.remove('hidden');
    });
  });

  if (editCatForm) {
    editCatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(editCatForm);
      const payload = {
        action: 'update',
        id: formData.get('id'),
        name: formData.get('name'),
        emoji: formData.get('emoji'),
        slug: formData.get('slug'),
        description: formData.get('description'),
        isFeatured: formData.get('isFeatured') === 'on',
      };

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update category');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Delete category
  document.querySelectorAll('.delete-cat-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-delete-cat-id');
      if (!confirm('Are you sure you want to delete this category?')) return;

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete category');
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // User role actions
  document.querySelectorAll('[data-user-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const userId = btn.getAttribute('data-user-id');
      const action = btn.getAttribute('data-user-action');
      const role = btn.getAttribute('data-target-role');
      btn.textContent = 'Updating...';

      try {
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, action, role }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update user');
          btn.textContent = 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Tool moderation actions
  document.querySelectorAll('[data-tool-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const toolId = btn.getAttribute('data-tool-id');
      const action = btn.getAttribute('data-tool-action');
      btn.textContent = 'Processing...';

      try {
        const res = await fetch('/api/admin/tools', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toolId, action }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to perform action');
          btn.textContent = action || 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Claim moderation actions
  document.querySelectorAll('[data-claim-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const claimId = btn.getAttribute('data-claim-id');
      const action = btn.getAttribute('data-claim-action');
      btn.textContent = 'Processing...';

      try {
        const res = await fetch('/api/admin/claims', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ claimId, action }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to perform action');
          btn.textContent = action || 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });
</script>
