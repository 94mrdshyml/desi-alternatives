<script>
  // Tool R2 Upload Helper
  async function uploadFileToR2(fileInput: HTMLInputElement, statusEl: HTMLElement | null, hiddenUrlInput: HTMLInputElement | null) {
    const file = fileInput.files?.[0];
    if (!file) return;

    if (statusEl) statusEl.textContent = 'Uploading to R2...';
    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch('/api/upload', {
        method: 'POST',
        body: formData,
      });
      const data = (await res.json()) as any;
      if (res.ok && data.url) {
        if (hiddenUrlInput) hiddenUrlInput.value = data.url;
        if (statusEl) statusEl.textContent = 'Uploaded to R2!';
      } else {
        if (statusEl) statusEl.textContent = data.error || 'Upload failed.';
      }
    } catch {
      if (statusEl) statusEl.textContent = 'Upload network error.';
    }
  }

  // Create Tool R2 Upload
  const createLogoFileInput = document.getElementById('create-tool-logo-file') as HTMLInputElement | null;
  const createLogoUrlHidden = document.getElementById('create-tool-logo-url-hidden') as HTMLInputElement | null;
  const createUploadStatus = document.getElementById('create-tool-upload-status');
  if (createLogoFileInput) {
    createLogoFileInput.addEventListener('change', () => uploadFileToR2(createLogoFileInput, createUploadStatus, createLogoUrlHidden));
  }

  // Edit Tool R2 Upload
  const editLogoFileInput = document.getElementById('edit-tool-logo-file') as HTMLInputElement | null;
  const editLogoUrlInput = document.getElementById('edit-tool-logo-url') as HTMLInputElement | null;
  const editUploadStatus = document.getElementById('edit-tool-upload-status');
  if (editLogoFileInput) {
    editLogoFileInput.addEventListener('change', () => uploadFileToR2(editLogoFileInput, editUploadStatus, editLogoUrlInput));
  }

  // Create Tool modal
  const toolModal = document.getElementById('create-tool-modal');
  const openToolBtn = document.getElementById('open-create-tool-modal');
  const closeToolBtn = document.getElementById('close-tool-modal');
  const createToolForm = document.getElementById('admin-create-tool-form') as HTMLFormElement | null;
  const autoFillBtn = document.getElementById('create-tool-autofill-btn');

  if (autoFillBtn) {
    autoFillBtn.addEventListener('click', async () => {
      const websiteInput = document.getElementById('create-tool-website-input') as HTMLInputElement | null;
      const url = websiteInput?.value?.trim();
      if (!url) {
        alert('Please enter a website URL first.');
        return;
      }

      const originalText = autoFillBtn.innerHTML;
      autoFillBtn.innerHTML = '⏳ <span>Scraping...</span>';

      try {
        const res = await fetch('/api/admin/scrape', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const data = (await res.json()) as any;
        if (res.ok && data) {
          const nameInput = document.getElementById('create-tool-name-input') as HTMLInputElement | null;
          const taglineInput = document.getElementById('create-tool-tagline-input') as HTMLInputElement | null;
          const descInput = document.getElementById('create-tool-description-input') as HTMLTextAreaElement | null;
          const colorInput = document.getElementById('create-tool-primary-color-input') as HTMLInputElement | null;
          const logoHidden = document.getElementById('create-tool-logo-url-hidden') as HTMLInputElement | null;
          const uploadStatus = document.getElementById('create-tool-upload-status');

          if (nameInput && !nameInput.value && data.title) nameInput.value = data.title;
          if (taglineInput && data.description) taglineInput.value = data.description.slice(0, 140);
          if (descInput && data.description) descInput.value = data.description;
          if (colorInput && data.primaryColor) colorInput.value = data.primaryColor;
          if (logoHidden && data.logoUrl) {
            logoHidden.value = data.logoUrl;
            if (uploadStatus) uploadStatus.textContent = 'Auto-fetched logo favicon!';
          }
          autoFillBtn.innerHTML = '✓ <span>Auto-Filled!</span>';
          setTimeout(() => {
            autoFillBtn.innerHTML = originalText;
          }, 2000);
        } else {
          alert(data.error || 'Failed to auto-fetch metadata');
          autoFillBtn.innerHTML = originalText;
        }
      } catch {
        alert('Network error while scraping URL');
        autoFillBtn.innerHTML = originalText;
      }
    });
  }

  if (openToolBtn && toolModal && closeToolBtn) {
    openToolBtn.addEventListener('click', () => toolModal.classList.remove('hidden'));
    closeToolBtn.addEventListener('click', () => toolModal.classList.add('hidden'));
  }

  if (createToolForm) {
    createToolForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createToolForm);
      const payload = {
        action: 'create',
        name: formData.get('name'),
        websiteUrl: formData.get('websiteUrl'),
        logoUrl: createLogoUrlHidden?.value || formData.get('logoUrl'),
        primaryColor: formData.get('primaryColor'),
        tagline: formData.get('tagline'),
        description: formData.get('description'),
        categoryId: formData.get('categoryId'),
        pricingModel: formData.get('pricingModel'),
        startingPriceInr: formData.get('startingPriceInr') ? Number(formData.get('startingPriceInr')) : 0,
        globalToolIds: formData.get('globalToolIds') ? [formData.get('globalToolIds')] : [],
        hasIndianDataResidency: formData.get('hasIndianDataResidency') === 'on',
        hasGstInvoice: formData.get('hasGstInvoice') === 'on',
        hasInrPricing: formData.get('hasInrPricing') === 'on',
        hasUpiSupport: formData.get('hasUpiSupport') === 'on',
        isOpenSource: formData.get('isOpenSource') === 'on',
        hasIstSupport: formData.get('hasIstSupport') === 'on',
        isFeatured: formData.get('isFeatured') === 'on',
        twitterHandle: formData.get('twitterHandle'),
        instagramHandle: formData.get('instagramHandle'),
        youtubeUrl: formData.get('youtubeUrl'),
        facebookUrl: formData.get('facebookUrl'),
        linkedinUrl: formData.get('linkedinUrl'),
      };

      try {
        const res = await fetch('/api/admin/tools', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to publish tool');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Edit Tool modal
  const editToolModal = document.getElementById('edit-tool-modal');
  const closeEditToolBtn = document.getElementById('close-edit-tool-modal');
  const editToolForm = document.getElementById('admin-edit-tool-form') as HTMLFormElement | null;

  if (closeEditToolBtn && editToolModal) {
    closeEditToolBtn.addEventListener('click', () => editToolModal.classList.add('hidden'));
  }

  document.querySelectorAll('.edit-tool-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dataStr = btn.getAttribute('data-tool-json');
      if (!dataStr || !editToolModal) return;
      const t = JSON.parse(dataStr);

      (document.getElementById('edit-tool-id') as HTMLInputElement).value = t.id;
      (document.getElementById('edit-tool-name') as HTMLInputElement).value = t.name || '';
      (document.getElementById('edit-tool-website') as HTMLInputElement).value = t.websiteUrl || '';
      (document.getElementById('edit-tool-logo-url') as HTMLInputElement).value = t.logoUrl || '';
      (document.getElementById('edit-tool-primary-color') as HTMLInputElement).value = t.primaryColor || '';
      (document.getElementById('edit-tool-tagline') as HTMLInputElement).value = t.tagline || '';
      (document.getElementById('edit-tool-description') as HTMLTextAreaElement).value = t.description || '';
      (document.getElementById('edit-tool-category') as unknown as HTMLSelectElement).value = t.categoryId || '';
      (document.getElementById('edit-tool-pricing-model') as unknown as HTMLSelectElement).value = t.pricingModel || 'Freemium';
      (document.getElementById('edit-tool-price') as HTMLInputElement).value = t.startingPriceInr !== null ? String(t.startingPriceInr) : '';

      (document.getElementById('edit-tool-twitter') as HTMLInputElement).value = t.twitterHandle || '';
      (document.getElementById('edit-tool-youtube') as HTMLInputElement).value = t.youtubeUrl || '';
      (document.getElementById('edit-tool-instagram') as HTMLInputElement).value = t.instagramHandle || '';
      (document.getElementById('edit-tool-linkedin') as HTMLInputElement).value = t.linkedinUrl || '';

      (document.getElementById('edit-tool-residency') as HTMLInputElement).checked = Boolean(t.hasIndianDataResidency);
      (document.getElementById('edit-tool-gst') as HTMLInputElement).checked = Boolean(t.hasGstInvoice);
      (document.getElementById('edit-tool-inr') as HTMLInputElement).checked = Boolean(t.hasInrPricing);
      (document.getElementById('edit-tool-upi') as HTMLInputElement).checked = Boolean(t.hasUpiSupport);
      (document.getElementById('edit-tool-oss') as HTMLInputElement).checked = Boolean(t.isOpenSource);
      (document.getElementById('edit-tool-ist') as HTMLInputElement).checked = Boolean(t.hasIstSupport);
      (document.getElementById('edit-tool-featured') as HTMLInputElement).checked = Boolean(t.isFeatured);

      editToolModal.classList.remove('hidden');
    });
  });

  if (editToolForm) {
    editToolForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(editToolForm);
      const payload = {
        action: 'update',
        id: formData.get('id'),
        name: formData.get('name'),
        websiteUrl: formData.get('websiteUrl'),
        logoUrl: formData.get('logoUrl'),
        primaryColor: formData.get('primaryColor'),
        tagline: formData.get('tagline'),
        description: formData.get('description'),
        categoryId: formData.get('categoryId'),
        pricingModel: formData.get('pricingModel'),
        startingPriceInr: formData.get('startingPriceInr'),
        hasIndianDataResidency: formData.get('hasIndianDataResidency') === 'on',
        hasGstInvoice: formData.get('hasGstInvoice') === 'on',
        hasInrPricing: formData.get('hasInrPricing') === 'on',
        hasUpiSupport: formData.get('hasUpiSupport') === 'on',
        isOpenSource: formData.get('isOpenSource') === 'on',
        hasIstSupport: formData.get('hasIstSupport') === 'on',
        isFeatured: formData.get('isFeatured') === 'on',
        twitterHandle: formData.get('twitterHandle'),
        instagramHandle: formData.get('instagramHandle'),
        youtubeUrl: formData.get('youtubeUrl'),
        facebookUrl: formData.get('facebookUrl'),
        linkedinUrl: formData.get('linkedinUrl'),
      };

      try {
        const res = await fetch('/api/admin/tools', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update tool');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Create Category modal
  const createCatModal = document.getElementById('create-cat-modal');
  const openCreateCatBtn = document.getElementById('open-create-cat-modal');
  const closeCreateCatBtn = document.getElementById('close-create-cat-modal');
  const createCatForm = document.getElementById('admin-create-cat-form') as HTMLFormElement | null;

  if (openCreateCatBtn && createCatModal && closeCreateCatBtn) {
    openCreateCatBtn.addEventListener('click', () => createCatModal.classList.remove('hidden'));
    closeCreateCatBtn.addEventListener('click', () => createCatModal.classList.add('hidden'));
  }

  if (createCatForm) {
    createCatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(createCatForm);
      const payload = {
        action: 'create',
        name: formData.get('name'),
        emoji: formData.get('emoji'),
        slug: formData.get('slug'),
        description: formData.get('description'),
        isFeatured: formData.get('isFeatured') === 'on',
      };

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to create category');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Edit Category modal
  const editCatModal = document.getElementById('edit-cat-modal');
  const closeEditCatBtn = document.getElementById('close-edit-cat-modal');
  const editCatForm = document.getElementById('admin-edit-cat-form') as HTMLFormElement | null;

  if (closeEditCatBtn && editCatModal) {
    closeEditCatBtn.addEventListener('click', () => editCatModal.classList.add('hidden'));
  }

  document.querySelectorAll('.edit-cat-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!editCatModal) return;
      (document.getElementById('edit-cat-id-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-id') || '';
      (document.getElementById('edit-cat-name-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-name') || '';
      (document.getElementById('edit-cat-slug-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-slug') || '';
      (document.getElementById('edit-cat-emoji-input') as HTMLInputElement).value = btn.getAttribute('data-edit-cat-emoji') || '';
      (document.getElementById('edit-cat-desc-input') as HTMLTextAreaElement).value = btn.getAttribute('data-edit-cat-desc') || '';
      (document.getElementById('edit-cat-featured-input') as HTMLInputElement).checked = btn.getAttribute('data-edit-cat-featured') === 'true';
      editCatModal.classList.remove('hidden');
    });
  });

  if (editCatForm) {
    editCatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(editCatForm);
      const payload = {
        action: 'update',
        id: formData.get('id'),
        name: formData.get('name'),
        emoji: formData.get('emoji'),
        slug: formData.get('slug'),
        description: formData.get('description'),
        isFeatured: formData.get('isFeatured') === 'on',
      };

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update category');
        }
      } catch {
        alert('Network error');
      }
    });
  }

  // Delete category
  document.querySelectorAll('.delete-cat-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-delete-cat-id');
      if (!confirm('Are you sure you want to delete this category?')) return;

      try {
        const res = await fetch('/api/admin/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete category');
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // User role actions
  document.querySelectorAll('[data-user-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const userId = btn.getAttribute('data-user-id');
      const action = btn.getAttribute('data-user-action');
      const role = btn.getAttribute('data-target-role');
      btn.textContent = 'Updating...';

      try {
        const res = await fetch('/api/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, action, role }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to update user');
          btn.textContent = 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Tool moderation actions (publish, unpublish, toggleFeatured, delete)
  document.querySelectorAll('[data-tool-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const toolId = btn.getAttribute('data-tool-id');
      const action = btn.getAttribute('data-tool-action');
      btn.textContent = 'Processing...';

      try {
        const res = await fetch('/api/admin/tools', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ toolId, action }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to perform action');
          btn.textContent = 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Claim moderation actions
  document.querySelectorAll('[data-claim-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const claimId = btn.getAttribute('data-claim-id');
      const action = btn.getAttribute('data-claim-action');
      btn.textContent = 'Processing...';

      try {
        const res = await fetch('/api/admin/claims', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ claimId, action }),
        });
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Failed to perform action');
          btn.textContent = action || 'Retry';
        }
      } catch {
        alert('Network error');
      }
    });
  });

  // Tab Navigation Logic
  function switchTab(targetTab: string) {
    const validTabs = ['tools', 'categories', 'users', 'claims', 'analytics', 'settings'];
    const activeTab = validTabs.includes(targetTab) ? targetTab : 'tools';

    // Update panels
    document.querySelectorAll('.tab-panel').forEach((panel) => {
      if (panel.id === `tab-panel-${activeTab}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });

    // Update tab buttons
    document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
      const target = btn.getAttribute('data-tab-target');
      const icon = btn.querySelector('svg');
      const badge = btn.querySelector('.tab-badge');
      if (target === activeTab) {
        btn.className = 'admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition cursor-pointer bg-white text-foreground shadow-xs border border-border';
        if (icon) icon.setAttribute('class', 'h-3.5 w-3.5 text-primary');
        if (badge && target !== 'claims') {
          badge.className = 'tab-badge rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary';
        }
      } else {
        btn.className = 'admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-medium transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 border border-transparent';
        if (icon) icon.setAttribute('class', 'h-3.5 w-3.5 text-muted-foreground');
        if (badge && target !== 'claims') {
          badge.className = 'tab-badge rounded-full bg-secondary px-2 py-0.5 text-[10px] font-bold text-muted-foreground';
        }
      }
    });

    // Update URL hash without jump
    if (window.location.hash.replace('#', '') !== activeTab) {
      history.replaceState(null, '', `#${activeTab}`);
    }
  }

  // Initial tab from hash or default 'tools'
  const initialHash = window.location.hash.replace('#', '');
  if (initialHash) {
    switchTab(initialHash);
  }

  // Handle tab button clicks
  document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab-target');
      if (target) switchTab(target);
    });
  });

  // Handle metric card clicks to switch tabs
  document.querySelectorAll('[data-metric-tab]').forEach((card) => {
    card.addEventListener('click', () => {
      const target = card.getAttribute('data-metric-tab');
      if (target) switchTab(target);
    });
  });

  // Listen to external hash changes
  window.addEventListener('hashchange', () => {
    const hash = window.location.hash.replace('#', '');
    if (hash) switchTab(hash);
  });

  // Admin Settings Form Handler
  const settingsForm = document.getElementById('admin-settings-form') as HTMLFormElement | null;
  const settingsAlert = document.getElementById('settings-status-alert');
  const saveSettingsBtn = document.getElementById('save-settings-btn') as HTMLButtonElement | null;

  settingsForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!saveSettingsBtn) return;
    saveSettingsBtn.disabled = true;
    saveSettingsBtn.textContent = 'Saving...';

    if (settingsAlert) {
      settingsAlert.classList.add('hidden');
      settingsAlert.textContent = '';
      settingsAlert.className = 'hidden rounded-xl p-3 text-xs';
    }

    const formData = new FormData(settingsForm);
    const fromName = formData.get('fromName') as string;
    const fromEmail = formData.get('fromEmail') as string;

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ fromName, fromEmail }),
      });

      const data = (await res.json()) as any;
      if (res.ok && data.success) {
        if (settingsAlert) {
          settingsAlert.textContent = '✓ Platform settings saved successfully!';
          settingsAlert.className = 'rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800 font-medium';
          settingsAlert.classList.remove('hidden');
        }
      } else {
        if (settingsAlert) {
          settingsAlert.textContent = data.error || 'Failed to save settings.';
          settingsAlert.className = 'rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 font-medium';
          settingsAlert.classList.remove('hidden');
        }
      }
    } catch {
      if (settingsAlert) {
        settingsAlert.textContent = 'Network error while saving settings.';
        settingsAlert.className = 'rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-700 font-medium';
        settingsAlert.classList.remove('hidden');
      }
    } finally {
      saveSettingsBtn.disabled = false;
      saveSettingsBtn.textContent = 'Save Changes';
    }
  });
</script>
