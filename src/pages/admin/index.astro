---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { categories, claimsQueue, desiTools, globalTools, users, siteSettings } from '@/lib/server/db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

let allToolsList: any[] = [];
let pendingClaims: any[] = [];
let pendingTools: any[] = [];
let allUsersList: any[] = [];
let allCategoriesList: any[] = [];
let globalToolsList: any[] = [];
let totalToolsCount = 0;
let totalAdminsCount = 0;
let categoryCounts: Record<string, number> = {};
let fromName = 'Desi Alternatives';
let fromEmail = 'auth@desialternatives.in';

if (db && user && user.role === 'admin') {
  try {
    // 1. All Directory Tools
    allToolsList = await db
      .select({
        id: desiTools.id,
        name: desiTools.name,
        slug: desiTools.slug,
        tagline: desiTools.tagline,
        description: desiTools.description,
        websiteUrl: desiTools.websiteUrl,
        logoUrl: desiTools.logoUrl,
        primaryColor: desiTools.primaryColor,
        categoryId: desiTools.categoryId,
        categoryName: categories.name,
        categoryEmoji: categories.emoji,
        pricingModel: desiTools.pricingModel,
        startingPriceInr: desiTools.startingPriceInr,
        hasIndianDataResidency: desiTools.hasIndianDataResidency,
        hasGstInvoice: desiTools.hasGstInvoice,
        hasInrPricing: desiTools.hasInrPricing,
        hasUpiSupport: desiTools.hasUpiSupport,
        isOpenSource: desiTools.isOpenSource,
        hasIstSupport: desiTools.hasIstSupport,
        isSelfHostable: desiTools.isSelfHostable,
        hasFreeTier: desiTools.hasFreeTier,
        isFeatured: desiTools.isFeatured,
        status: desiTools.status,
        twitterHandle: desiTools.twitterHandle,
        instagramHandle: desiTools.instagramHandle,
        youtubeUrl: desiTools.youtubeUrl,
        facebookUrl: desiTools.facebookUrl,
        linkedinUrl: desiTools.linkedinUrl,
        createdAt: desiTools.createdAt,
      })
      .from(desiTools)
      .leftJoin(categories, eq(desiTools.categoryId, categories.id))
      .orderBy(desc(desiTools.createdAt))
      .all();

    totalToolsCount = allToolsList.length;
    pendingTools = allToolsList.filter((t) => t.status === 'draft');

    // 2. Pending Claims
    pendingClaims = await db
      .select({
        id: claimsQueue.id,
        toolId: claimsQueue.toolId,
        toolName: desiTools.name,
        toolSlug: desiTools.slug,
        userId: claimsQueue.userId,
        userName: users.name,
        userEmail: users.email,
        workEmail: claimsQueue.workEmail,
        notes: claimsQueue.notes,
        submittedAt: claimsQueue.submittedAt,
        status: claimsQueue.status,
      })
      .from(claimsQueue)
      .leftJoin(desiTools, eq(claimsQueue.toolId, desiTools.id))
      .leftJoin(users, eq(claimsQueue.userId, users.id))
      .where(eq(claimsQueue.status, 'pending'))
      .orderBy(desc(claimsQueue.submittedAt))
      .all();

    // 3. All Users
    allUsersList = await db
      .select({
        id: users.id,
        name: users.name,
        email: users.email,
        role: users.role,
        banned: users.banned,
        createdAt: users.createdAt,
      })
      .from(users)
      .orderBy(desc(users.createdAt))
      .all();

    totalAdminsCount = allUsersList.filter((u) => u.role === 'admin').length;

    // 4. Categories & Counts
    allCategoriesList = await db.select().from(categories).orderBy(categories.name).all();
    globalToolsList = await db.select().from(globalTools).orderBy(globalTools.name).all();

    for (const t of allToolsList) {
      if (t.categoryId) {
        categoryCounts[t.categoryId] = (categoryCounts[t.categoryId] || 0) + 1;
      }
    }

    // 5. Site Settings
    const settingsRow = await db.select().from(siteSettings).where(eq(siteSettings.id, 'general')).get();
    if (settingsRow) {
      fromName = settingsRow.fromName;
      fromEmail = settingsRow.fromEmail;
    }
  } catch (e) {
    console.error('Failed to load admin dashboard:', e);
  }
}
---

<BaseLayout title="Admin Control Center — Desi Alternatives">
  <Navbar />

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    {!user || user.role !== 'admin' ? (
      <div class="mx-auto max-w-md rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
        <svg class="mx-auto h-10 w-10 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H10m11-3.5a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h1 class="mt-3 text-lg font-bold text-red-900">Admin Access Restricted</h1>
        <p class="mt-2 text-xs text-red-700 leading-relaxed">
          You must be logged into an account with the <code>admin</code> role to view the moderation center.
        </p>
        <a
          href="/login"
          class="mt-5 inline-flex items-center rounded-xl bg-foreground px-4 py-2 text-xs font-semibold text-background hover:bg-foreground/90 transition"
        >
          Sign in as Admin
        </a>
      </div>
    ) : (
      <div>
        <!-- Admin Header -->
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-border pb-6">
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-2xl font-bold text-foreground">Admin Control Center</h1>
              <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-bold text-amber-800 uppercase">
                Admin Panel
              </span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
              Direct tool management, R2 logo uploads, social handles, category taxonomy, user roles, and moderation queues.
            </p>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="open-create-tool-modal"
              class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-3.5 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
            >
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Add New Tool</span>
            </button>

            <button
              type="button"
              id="open-create-cat-modal"
              class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-white px-3.5 py-2 text-xs font-semibold text-foreground shadow-2xs hover:bg-slate-50 transition cursor-pointer"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z" />
              </svg>
              <span>Add Category</span>
            </button>
          </div>
        </div>

        <!-- Metrics Row -->
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4 text-xs">
          <button type="button" data-metric-tab="tools" class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs hover:border-primary/50 transition cursor-pointer">
            <span class="text-muted-foreground">Total Tools</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{totalToolsCount}</p>
          </button>
          <button type="button" data-metric-tab="categories" class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs hover:border-primary/50 transition cursor-pointer">
            <span class="text-muted-foreground">Categories</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{allCategoriesList.length}</p>
          </button>
          <button type="button" data-metric-tab="users" class="rounded-xl border border-border bg-white p-4 text-center shadow-2xs hover:border-primary/50 transition cursor-pointer">
            <span class="text-muted-foreground">Total Users</span>
            <p class="font-bold text-foreground text-lg mt-0.5">{allUsersList.length}</p>
          </button>
          <button type="button" data-metric-tab="claims" class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-center shadow-2xs hover:border-amber-400 transition cursor-pointer">
            <span class="text-amber-800 font-semibold">Pending Approvals</span>
            <p class="font-bold text-amber-900 text-lg mt-0.5">{pendingTools.length + pendingClaims.length}</p>
          </button>
        </div>

        <!-- Dedicated Admin In-Page Menu Bar -->
        <div class="mt-8 rounded-2xl border border-border bg-card p-1.5 shadow-2xs">
          <nav class="flex items-center gap-1.5 overflow-x-auto" aria-label="Admin Menu" id="admin-tabs-nav">
            <!-- Menu Item 1: Tools -->
            <button
              type="button"
              data-tab-target="tools"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer bg-white text-foreground font-semibold shadow-xs border border-border"
            >
              <svg class="h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>Directory Tools</span>
              <span class="tab-badge rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-bold text-primary">
                {allToolsList.length}
              </span>
            </button>

            <!-- Menu Item 2: Categories -->
            <button
              type="button"
              data-tab-target="categories"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 font-medium border border-transparent"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              <span>Categories Taxonomy</span>
              <span class="tab-badge rounded-full bg-secondary px-2 py-0.5 text-[10px] font-bold text-muted-foreground">
                {allCategoriesList.length}
              </span>
            </button>

            <!-- Menu Item 3: Users -->
            <button
              type="button"
              data-tab-target="users"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 font-medium border border-transparent"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
              <span>User & Role Controls</span>
              <span class="tab-badge rounded-full bg-secondary px-2 py-0.5 text-[10px] font-bold text-muted-foreground">
                {allUsersList.length}
              </span>
            </button>

            <!-- Menu Item 4: Claims Queue -->
            <button
              type="button"
              data-tab-target="claims"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 font-medium border border-transparent"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Ownership Claims</span>
              <span class={`tab-badge rounded-full px-2 py-0.5 text-[10px] font-bold ${pendingClaims.length > 0 ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-secondary text-muted-foreground'}`}>
                {pendingClaims.length}
              </span>
            </button>

            <!-- Menu Item 5: Analytics Intelligence -->
            <button
              type="button"
              data-tab-target="analytics"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 font-medium border border-transparent"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              <span>Analytics Intelligence</span>
              <span class="tab-badge rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-800 border border-emerald-200">
                Live
              </span>
            </button>

            <!-- Menu Item 6: Platform Settings -->
            <button
              type="button"
              data-tab-target="settings"
              class="admin-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 font-medium border border-transparent"
            >
              <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Settings</span>
            </button>
          </nav>
        </div>

        <!-- Section 1: All Directory Tools Management (Tab: tools) -->
        <section id="tab-panel-tools" class="tab-panel mt-6">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-foreground">
              Directory Tools ({allToolsList.length})
            </h2>
            <span class="text-xs text-muted-foreground">Edit, unpublish, delete, or feature any tool</span>
          </div>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-border bg-secondary/40">
                <tr>
                  <th class="py-3 px-4 font-semibold text-foreground">Tool</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Category</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Socials</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Status</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Featured</th>
                  <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {allToolsList.map((t) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="py-3 px-4">
                      <div class="flex items-center gap-2.5">
                        <img src={t.logoUrl} alt={t.name} class="h-6 w-6 rounded-md object-contain border border-border bg-slate-50 p-0.5" />
                        <div>
                          <a href={`/tools/${t.slug}`} target="_blank" class="font-bold text-foreground hover:text-primary transition">
                            {t.name}
                          </a>
                          <p class="text-[11px] text-muted-foreground line-clamp-1">{t.tagline}</p>
                        </div>
                      </div>
                    </td>
                    <td class="py-3 px-4 text-foreground font-medium">
                      <span>{t.categoryEmoji} {t.categoryName || 'Unassigned'}</span>
                    </td>
                    <td class="py-3 px-4">
                      <div class="flex items-center gap-1.5 text-muted-foreground text-[11px]">
                        {t.twitterHandle && <span title={`@${t.twitterHandle}`}>𝕏</span>}
                        {t.youtubeUrl && <span title={t.youtubeUrl}>▶</span>}
                        {t.instagramHandle && <span title={`@${t.instagramHandle}`}>📸</span>}
                        {t.linkedinUrl && <span title={t.linkedinUrl}>in</span>}
                        {!t.twitterHandle && !t.youtubeUrl && !t.instagramHandle && !t.linkedinUrl && <span class="text-muted-foreground/50">—</span>}
                      </div>
                    </td>
                    <td class="py-3 px-4">
                      {t.status === 'published' ? (
                        <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800 border border-emerald-200">
                          Published
                        </span>
                      ) : (
                        <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-800 border border-amber-200">
                          Draft
                        </span>
                      )}
                    </td>
                    <td class="py-3 px-4">
                      {t.isFeatured ? (
                        <span class="inline-flex items-center rounded-md bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-900">
                          ★ Featured
                        </span>
                      ) : (
                        <span class="text-muted-foreground text-[11px]">Standard</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="inline-flex items-center gap-1.5">
                        <button
                          type="button"
                          class="edit-tool-btn rounded-lg border border-border bg-white px-2 py-1 text-[11px] font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
                          data-tool-json={JSON.stringify(t)}
                        >
                          Edit
                        </button>

                        <button
                          type="button"
                          data-tool-action="toggleFeatured"
                          data-tool-id={t.id}
                          class="rounded-lg border border-amber-200 bg-amber-50/60 px-2 py-1 text-[11px] font-semibold text-amber-900 hover:bg-amber-100 transition cursor-pointer"
                        >
                          {t.isFeatured ? 'Unfeature' : 'Feature'}
                        </button>

                        <button
                          type="button"
                          data-tool-action="toggleStatus"
                          data-tool-id={t.id}
                          class="rounded-lg border border-border bg-white px-2 py-1 text-[11px] font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
                        >
                          {t.status === 'published' ? 'Unpublish' : 'Publish'}
                        </button>

                        <button
                          type="button"
                          data-tool-action="delete"
                          data-tool-id={t.id}
                          class="rounded-lg border border-red-200 bg-red-50 px-2 py-1 text-[11px] font-semibold text-red-700 hover:bg-red-100 transition cursor-pointer"
                        >
                          Delete
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 2: Categories Taxonomy Management (Tab: categories) -->
        <section id="tab-panel-categories" class="tab-panel mt-6 hidden">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-foreground">
              Categories Taxonomy ({allCategoriesList.length})
            </h2>
            <span class="text-xs text-muted-foreground">Clean URLs live at <code>/category/[slug]</code></span>
          </div>

          <div class="mt-3 overflow-hidden rounded-2xl border border-border bg-white shadow-xs">
            <table class="w-full text-left text-xs">
              <thead class="border-b border-border bg-secondary/40">
                <tr>
                  <th class="py-3 px-4 font-semibold text-foreground">Category</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Slug</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Tools Count</th>
                  <th class="py-3 px-4 font-semibold text-foreground">Featured</th>
                  <th class="py-3 px-4 font-semibold text-foreground text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y border-border">
                {allCategoriesList.map((cat) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="py-3 px-4 font-medium text-foreground">
                      <span class="mr-1.5">{cat.emoji}</span>
                      <span class="font-bold">{cat.name}</span>
                    </td>
                    <td class="py-3 px-4 text-muted-foreground">
                      <a href={`/category/${cat.slug}`} target="_blank" class="text-primary underline hover:text-primary-hover">
                        /category/{cat.slug}
                      </a>
                    </td>
                    <td class="py-3 px-4 font-semibold text-foreground">
                      {categoryCounts[cat.id] || 0} tools
                    </td>
                    <td class="py-3 px-4">
                      {cat.isFeatured ? (
                        <span class="inline-flex items-center rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-800">
                          Featured
                        </span>
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </td>
                    <td class="py-3 px-4 text-right">
                      <div class="inline-flex items-center gap-2">
                        <button
                          type="button"
                          data-edit-cat-id={cat.id}
                          data-edit-cat-name={cat.name}
                          data-edit-cat-slug={cat.slug}
                          data-edit-cat-emoji={cat.emoji}
                          data-edit-cat-desc={cat.description || ''}
                          data-edit-cat-featured={cat.isFeatured ? 'true' : 'false'}
                          class="edit-cat-btn rounded-lg border border-border bg-white px-2.5 py-1 text-[11px] font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
                        >
                          Edit
                        </button>
                        <button
                          type="button"
                          data-delete-cat-id={cat.id}
