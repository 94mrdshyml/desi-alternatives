---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { blogPosts, blogAuthors, categories } from '@/lib/server/db/schema';
import { desc, eq } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}

let postsList: any[] = [];
let totalPublished = 0;
let totalDrafts = 0;
let totalScheduled = 0;

if (db) {
  try {
    postsList = await db
      .select({
        id: blogPosts.id,
        slug: blogPosts.slug,
        title: blogPosts.title,
        subtitle: blogPosts.subtitle,
        coverImageUrl: blogPosts.coverImageUrl,
        status: blogPosts.status,
        readingTimeMinutes: blogPosts.readingTimeMinutes,
        publishedAt: blogPosts.publishedAt,
        createdAt: blogPosts.createdAt,
        updatedAt: blogPosts.updatedAt,
        authorName: blogAuthors.name,
        authorAvatarUrl: blogAuthors.avatarUrl,
        categoryName: categories.name,
        categoryEmoji: categories.emoji,
      })
      .from(blogPosts)
      .leftJoin(blogAuthors, eq(blogPosts.authorId, blogAuthors.id))
      .leftJoin(categories, eq(blogPosts.categoryId, categories.id))
      .orderBy(desc(blogPosts.createdAt))
      .all();

    totalPublished = postsList.filter((p) => p.status === 'published').length;
    totalDrafts = postsList.filter((p) => p.status === 'draft').length;
    totalScheduled = postsList.filter((p) => p.status === 'scheduled').length;
  } catch (e) {
    console.error('Error fetching blog posts for admin:', e);
  }
}
---

<AdminLayout
  title="Blog & Editorial CMS — Admin Control Center"
  currentSection="blog"
  counts={{
    posts: postsList.length,
    drafts: totalDrafts,
  }}
>
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header with Stats & New Post CTA -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border/80 pb-5">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-bold tracking-tight text-foreground font-serif-editorial">Editorial & Blog CMS</h1>
          <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-800 border border-amber-200">
            SEO Engine
          </span>
        </div>
        <p class="text-xs text-muted-foreground mt-1">
          Manage long-form sovereign software analyses, comparison showdowns, founder stories, and category guides.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/blog"
          target="_blank"
          class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-white px-3.5 py-2 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition shadow-2xs"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>View Public Blog</span>
        </a>

        <a
          href="/admin/blog/editor"
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>+ Write New Article</span>
        </a>
      </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-[11px] font-semibold text-muted-foreground uppercase tracking-wider">Total Articles</div>
        <div class="mt-1 text-2xl font-black text-foreground">{postsList.length}</div>
      </div>
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-[11px] font-semibold text-emerald-700 uppercase tracking-wider">Live & Published</div>
        <div class="mt-1 text-2xl font-black text-emerald-700">{totalPublished}</div>
      </div>
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-[11px] font-semibold text-amber-700 uppercase tracking-wider">Drafts in Progress</div>
        <div class="mt-1 text-2xl font-black text-amber-700">{totalDrafts}</div>
      </div>
      <div class="rounded-2xl border border-border bg-white p-4 shadow-2xs">
        <div class="text-[11px] font-semibold text-blue-700 uppercase tracking-wider">Scheduled</div>
        <div class="mt-1 text-2xl font-black text-blue-700">{totalScheduled}</div>
      </div>
    </div>

    <!-- Status Tabs & Filter Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-border pb-3">
      <div class="flex items-center gap-1.5 overflow-x-auto" id="status-filter-tabs">
        <button
          type="button"
          data-filter="all"
          class="filter-tab active rounded-lg px-3 py-1.5 text-xs font-bold transition bg-primary text-primary-foreground shadow-2xs cursor-pointer"
        >
          All Articles ({postsList.length})
        </button>
        <button
          type="button"
          data-filter="published"
          class="filter-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-100 transition cursor-pointer"
        >
          Published ({totalPublished})
        </button>
        <button
          type="button"
          data-filter="draft"
          class="filter-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-100 transition cursor-pointer"
        >
          Drafts ({totalDrafts})
        </button>
        {totalScheduled > 0 && (
          <button
            type="button"
            data-filter="scheduled"
            class="filter-tab rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-100 transition cursor-pointer"
          >
            Scheduled ({totalScheduled})
          </button>
        )}
      </div>

      <div class="relative w-full sm:w-64">
        <input
          type="text"
          id="post-search-input"
          placeholder="Search by title, author..."
          class="w-full rounded-xl border border-border bg-white py-1.5 pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
        />
        <svg class="absolute left-2.5 top-2 h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Posts Table / Card Grid -->
    {postsList.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-border bg-white p-12 text-center shadow-2xs">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-amber-50 text-2xl border border-amber-200">
          ✍️
        </div>
        <h3 class="mt-4 text-base font-bold text-foreground">No blog posts published yet</h3>
        <p class="mt-1 text-xs text-muted-foreground max-w-md mx-auto">
          Start publishing high-ranking comparison guides, software architecture deep dives, and sovereign founder stories.
        </p>
        <div class="mt-5">
          <a
            href="/admin/blog/editor"
            class="inline-flex items-center gap-2 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition cursor-pointer"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Write Your First Article</span>
          </a>
        </div>
      </div>
    ) : (
      <div class="rounded-2xl border border-border bg-white overflow-hidden shadow-2xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-muted-foreground">
            <thead class="bg-slate-50/80 border-b border-border text-[11px] font-bold uppercase tracking-wider text-foreground">
              <tr>
                <th class="px-5 py-3.5">Article</th>
                <th class="px-4 py-3.5">Category</th>
                <th class="px-4 py-3.5">Author</th>
                <th class="px-4 py-3.5">Status</th>
                <th class="px-4 py-3.5">Reading Time</th>
                <th class="px-4 py-3.5">Date</th>
                <th class="px-5 py-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border/60" id="posts-table-body">
              {postsList.map((post) => (
                <tr class="hover:bg-slate-50/70 transition post-row" data-status={post.status} data-title={post.title.toLowerCase()} data-author={(post.authorName || '').toLowerCase()}>
                  <td class="px-5 py-4">
                    <div class="flex items-start gap-3">
                      {post.coverImageUrl ? (
                        <img
                          src={post.coverImageUrl}
                          alt={post.title}
                          class="h-12 w-16 shrink-0 rounded-lg object-cover border border-border shadow-2xs"
                        />
                      ) : (
                        <div class="h-12 w-16 shrink-0 rounded-lg bg-slate-100 flex items-center justify-center text-lg border border-border">
                          📝
                        </div>
                      )}
                      <div class="min-w-0 flex-1">
                        <a
                          href={`/admin/blog/editor?id=${post.id}`}
                          class="font-bold text-foreground hover:text-primary transition line-clamp-1 text-sm"
                        >
                          {post.title}
                        </a>
                        <p class="text-[11px] text-muted-foreground line-clamp-1 mt-0.5">
                          {post.subtitle || `/blog/${post.slug}`}
                        </p>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    {post.categoryName ? (
                      <span class="inline-flex items-center gap-1 rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-800 border border-slate-200">
                        <span>{post.categoryEmoji || '📁'}</span>
                        <span>{post.categoryName}</span>
                      </span>
                    ) : (
                      <span class="text-[11px] text-muted-foreground/60">—</span>
                    )}
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <div class="flex items-center gap-2">
                      {post.authorAvatarUrl ? (
                        <img src={post.authorAvatarUrl} alt={post.authorName} class="h-6 w-6 rounded-full object-cover" />
                      ) : (
                        <div class="h-6 w-6 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-[10px] font-bold">
                          {(post.authorName || 'A')[0]}
                        </div>
                      )}
                      <span class="font-medium text-foreground text-xs">{post.authorName || 'Desi Team'}</span>
                    </div>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    {post.status === 'published' ? (
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 border border-emerald-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
                        Published
                      </span>
                    ) : post.status === 'scheduled' ? (
                      <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-bold text-blue-800 border border-blue-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-blue-600"></span>
                        Scheduled
                      </span>
                    ) : (
                      <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 text-[11px] font-bold text-amber-800 border border-amber-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                        Draft
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-[11px] text-muted-foreground">
                    ⏱ {post.readingTimeMinutes} min read
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-[11px] text-muted-foreground">
                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Not published'}
                  </td>
                  <td class="px-5 py-4 whitespace-nowrap text-right">
                    <div class="flex items-center justify-end gap-1.5">
                      {post.status === 'published' && (
                        <a
                          href={`/blog/${post.slug}`}
                          target="_blank"
                          class="rounded-lg p-1.5 text-muted-foreground hover:text-foreground hover:bg-slate-100 transition"
                          title="View Live Article"
                        >
                          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}

                      <a
                        href={`/admin/blog/editor?id=${post.id}`}
                        class="rounded-lg px-2.5 py-1 text-xs font-semibold text-primary hover:bg-primary/10 transition"
                      >
                        Edit
                      </a>

                      <button
                        type="button"
                        data-action="toggle-status"
                        data-id={post.id}
                        data-current-status={post.status}
                        class="rounded-lg px-2 py-1 text-xs font-medium text-muted-foreground hover:text-foreground hover:bg-slate-100 transition cursor-pointer"
                      >
                        {post.status === 'published' ? 'Unpublish' : 'Publish'}
                      </button>

                      <button
                        type="button"
                        data-action="delete"
                        data-id={post.id}
                        data-title={post.title}
                        class="rounded-lg p-1.5 text-rose-600 hover:bg-rose-50 transition cursor-pointer"
                        title="Delete Post"
                      >
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </div>
</AdminLayout>

<script>
  // Filter Tabs
  const filterTabs = document.querySelectorAll('.filter-tab');
  const postRows = document.querySelectorAll('.post-row') as NodeListOf<HTMLTableRowElement>;
  const searchInput = document.getElementById('post-search-input') as HTMLInputElement | null;

  let currentFilter = 'all';
  let searchQuery = '';

  function applyFilters() {
    postRows.forEach((row) => {
      const status = row.dataset.status || '';
      const title = row.dataset.title || '';
      const author = row.dataset.author || '';

      const matchesStatus = currentFilter === 'all' || status === currentFilter;
      const matchesSearch = !searchQuery || title.includes(searchQuery) || author.includes(searchQuery);

      if (matchesStatus && matchesSearch) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => {
        t.classList.remove('bg-primary', 'text-primary-foreground', 'shadow-2xs');
        t.classList.add('text-muted-foreground');
      });
      tab.classList.add('bg-primary', 'text-primary-foreground', 'shadow-2xs');
      tab.classList.remove('text-muted-foreground');

      currentFilter = (tab as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Action Handlers
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    // Toggle Status (Publish / Unpublish)
    const toggleBtn = target.closest('[data-action="toggle-status"]') as HTMLButtonElement | null;
    if (toggleBtn) {
      const id = toggleBtn.dataset.id;
      const currentStatus = toggleBtn.dataset.currentStatus;
      const action = currentStatus === 'published' ? 'unpublish' : 'publish';

      toggleBtn.disabled = true;
      toggleBtn.textContent = 'Saving...';

      try {
        const res = await fetch('/api/admin/blog/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action, id }),
        });

        const data: any = await res.json();
        if (data.success) {
          (window as any).showToast(
            `Article ${action === 'publish' ? 'published live' : 'moved to drafts'}.`,
            'success'
          );
          setTimeout(() => window.location.reload(), 600);
        } else {
          (window as any).showToast(data.error || 'Failed to update status', 'error');
          toggleBtn.disabled = false;
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Network error', 'error');
        toggleBtn.disabled = false;
      }
      return;
    }

    // Delete Post
    const deleteBtn = target.closest('[data-action="delete"]') as HTMLButtonElement | null;
    if (deleteBtn) {
      const id = deleteBtn.dataset.id;
      const title = deleteBtn.dataset.title;

      const confirmed = await (window as any).showConfirmDialog({
        title: 'Delete Article',
        message: `Are you sure you want to permanently delete "${title}"? This action cannot be undone.`,
        confirmText: 'Delete Permanently',
        isDestructive: true,
      });

      if (!confirmed) return;

      try {
        const res = await fetch('/api/admin/blog/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        });

        const data: any = await res.json();
        if (data.success) {
          (window as any).showToast('Article deleted.', 'success');
          setTimeout(() => window.location.reload(), 500);
        } else {
          (window as any).showToast(data.error || 'Failed to delete article', 'error');
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Network error', 'error');
      }
      return;
    }
  });
</script>
