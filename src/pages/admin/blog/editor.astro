---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { blogPosts, blogAuthors, categories, blogPostTools, desiTools, users } from '@/lib/server/db/schema';
import { eq, or, inArray } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

if (!user || (user.role !== 'admin' && user.role !== 'author')) {
  return Astro.redirect('/login');
}

const url = new URL(Astro.request.url);
const editId = url.searchParams.get('id');

let existingPost: any = null;
let taggedToolIds: string[] = [];
let authorsList: any[] = [];
let categoriesList: any[] = [];
let toolsList: any[] = [];

if (db) {
  try {
    // 1. Ensure all users with admin or author role have a blogAuthors profile
    const authorUsers = await db
      .select({
        id: users.id,
        name: users.name,
        role: users.role,
        image: users.image,
      })
      .from(users)
      .where(or(eq(users.role, 'admin'), eq(users.role, 'author')))
      .orderBy(users.name)
      .all();

    const validAuthorIds: string[] = [];

    for (const u of authorUsers) {
      const authorProfileId = `author_u_${u.id}`;
      validAuthorIds.push(authorProfileId);
      const existing = await db.select().from(blogAuthors).where(eq(blogAuthors.id, authorProfileId)).get();
      if (!existing) {
        const slug = u.name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        await db.insert(blogAuthors).values({
          id: authorProfileId,
          slug: `${slug}-${u.id.slice(-4)}`,
          name: u.name,
          avatarUrl: u.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(u.name)}`,
          role: u.role === 'admin' ? 'Editor in Chief' : 'Contributing Author',
          bio: `Verified ${u.role === 'admin' ? 'editorial lead' : 'author'} at Desi Alternatives.`,
        }).onConflictDoNothing().run();
      }
    }

    // Strictly fetch only live authors mapped to real admin/author users
    authorsList = validAuthorIds.length > 0
      ? await db.select().from(blogAuthors).where(inArray(blogAuthors.id, validAuthorIds)).orderBy(blogAuthors.name).all()
      : [];
    categoriesList = await db.select().from(categories).orderBy(categories.name).all();
    toolsList = await db
      .select({
        id: desiTools.id,
        name: desiTools.name,
        slug: desiTools.slug,
        categoryEmoji: categories.emoji,
      })
      .from(desiTools)
      .leftJoin(categories, eq(desiTools.categoryId, categories.id))
      .orderBy(desiTools.name)
      .all();

    if (editId) {
      existingPost = await db.select().from(blogPosts).where(eq(blogPosts.id, editId)).get();
      if (existingPost) {
        const tagged = await db
          .select({ desiToolId: blogPostTools.desiToolId })
          .from(blogPostTools)
          .where(eq(blogPostTools.postId, editId))
          .all();
        taggedToolIds = tagged.map((t) => t.desiToolId);
      }
    }
  } catch (e) {
    console.error('Error loading blog editor dependencies:', e);
  }
}

const pageTitle = existingPost ? `Edit: ${existingPost.title}` : 'Write Article — WYSIWYG Notion Studio';
---

<BaseLayout title={pageTitle} description="WYSIWYG writing canvas for sovereign tech articles and comparisons.">
  <!-- Toast & Notification Container -->
  <div id="editor-toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- Main Studio Shell -->
  <div class="min-h-screen bg-[#FDFDFC] flex flex-col">
    <!-- Top Action Bar -->
    <header class="sticky top-0 z-30 flex h-14 items-center justify-between border-b border-border/80 bg-white/90 px-4 sm:px-6 backdrop-blur-md">
      <!-- Left: Back & Breadcrumb -->
      <div class="flex items-center gap-3">
        <a
          href="/admin/blog"
          class="flex items-center gap-1.5 rounded-lg px-2 py-1 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-100 transition"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span class="hidden sm:inline">Back to Articles</span>
        </a>

        <div class="h-4 w-px bg-border hidden sm:block"></div>

        <div class="flex items-center gap-2">
          <span id="save-indicator" class="text-[11px] font-medium text-muted-foreground flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>Saved</span>
          </span>
          <span id="reading-stats" class="text-[11px] text-muted-foreground/80 hidden sm:inline">
            · 0 words · 1 min read
          </span>
        </div>
      </div>

      <!-- Right: Preview, Settings Drawer & Save Buttons -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="toggle-preview-btn"
          class="rounded-xl border border-border px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition cursor-pointer"
        >
          Reader Preview
        </button>

        <button
          type="button"
          id="toggle-drawer-btn"
          class="rounded-xl border border-border px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>SEO & Settings</span>
        </button>

        <button
          type="button"
          id="save-draft-btn"
          class="rounded-xl border border-border bg-white px-3.5 py-1.5 text-xs font-bold text-foreground hover:bg-slate-50 transition shadow-2xs cursor-pointer"
        >
          Save Draft
        </button>

        <button
          type="button"
          id="publish-btn"
          class="rounded-xl bg-primary px-4 py-1.5 text-xs font-bold text-primary-foreground shadow-sm hover:bg-primary/90 transition cursor-pointer"
        >
          {existingPost && existingPost.status === 'published' ? 'Update Live' : 'Publish Article'}
        </button>
      </div>
    </header>

    <!-- Main Canvas & Drawer Container -->
    <div class="flex-1 flex overflow-hidden relative">
      <!-- Left: Notion WYSIWYG Writing Canvas -->
      <main class="flex-1 overflow-y-auto px-4 sm:px-12 py-8 sm:py-12 transition-all" id="editor-canvas-container">
        <div class="max-w-3xl mx-auto space-y-6">
          <!-- Cover Image Container -->
          <div class="group relative" id="cover-image-wrapper">
            <div
              id="cover-preview-container"
              class={`w-full h-48 sm:h-64 rounded-2xl overflow-hidden border border-border relative bg-slate-100 ${
                existingPost?.coverImageUrl ? '' : 'hidden'
              }`}
            >
              <img
                id="cover-preview-img"
                src={existingPost?.coverImageUrl || ''}
                alt="Article Cover"
                class="w-full h-full object-cover"
              />
              <button
                type="button"
                id="remove-cover-btn"
                class="absolute top-3 right-3 rounded-lg bg-black/60 text-white p-1.5 hover:bg-black/80 transition text-xs flex items-center gap-1 cursor-pointer"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                <span>Remove</span>
              </button>
            </div>

            <div id="add-cover-btn-container" class={existingPost?.coverImageUrl ? 'hidden' : ''}>
              <button
                type="button"
                id="trigger-cover-upload"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground py-1 px-2.5 rounded-lg hover:bg-slate-100 transition cursor-pointer"
              >
                <svg class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span>Add Cover Image</span>
              </button>
              <input type="file" id="cover-file-input" accept="image/*" class="hidden" />
            </div>
          </div>

          <!-- Article Title Input -->
          <div>
            <textarea
              id="article-title"
              placeholder="Article Title..."
              rows="1"
              class="w-full resize-none border-0 bg-transparent text-3xl sm:text-4xl font-extrabold text-foreground placeholder:text-muted-foreground/40 focus:outline-none font-serif-editorial leading-tight"
            >{existingPost?.title || ''}</textarea>
          </div>

          <!-- Subtitle / Excerpt Input -->
          <div>
            <textarea
              id="article-subtitle"
              placeholder="Add a crisp subtitle or summary..."
              rows="1"
              class="w-full resize-none border-0 bg-transparent text-base sm:text-lg text-muted-foreground placeholder:text-muted-foreground/30 focus:outline-none leading-relaxed"
            >{existingPost?.subtitle || ''}</textarea>
          </div>

          <!-- WYSIWYG Interactive Formatting Toolbar -->
          <div class="sticky top-14 z-20 flex items-center justify-between gap-1 flex-wrap text-xs text-muted-foreground bg-white/95 backdrop-blur-md px-3 py-2 rounded-2xl border border-border/80 shadow-xs">
            <div class="flex items-center gap-1 flex-wrap">
              <!-- Text Styling -->
              <button type="button" data-format="bold" class="format-btn p-1.5 rounded-lg hover:bg-slate-100 hover:text-foreground font-bold transition text-xs" title="Bold (Ctrl+B)">B</button>
              <button type="button" data-format="italic" class="format-btn p-1.5 rounded-lg hover:bg-slate-100 hover:text-foreground italic transition text-xs font-serif" title="Italic (Ctrl+I)">I</button>
              <button type="button" data-format="strikethrough" class="format-btn p-1.5 rounded-lg hover:bg-slate-100 hover:text-foreground line-through transition text-xs" title="Strikethrough">S</button>
              <button type="button" data-format="code" class="format-btn p-1.5 rounded-lg hover:bg-slate-100 hover:text-foreground font-mono text-[11px] transition" title="Inline Code">&lt;/&gt;</button>
              <button type="button" data-format="link" class="format-btn p-1.5 rounded-lg hover:bg-slate-100 hover:text-foreground transition text-xs" title="Insert Link (Ctrl+K)">🔗</button>

              <div class="h-4 w-px bg-border mx-1"></div>

              <!-- Headings -->
              <button type="button" data-block-cmd="h2" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground font-bold text-xs font-serif-editorial" title="Heading 2">H2</button>
              <button type="button" data-block-cmd="h3" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground font-bold text-xs font-serif-editorial" title="Heading 3">H3</button>
              <button type="button" data-block-cmd="p" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs" title="Paragraph / Normal Text">¶</button>

              <div class="h-4 w-px bg-border mx-1"></div>

              <!-- Lists -->
              <button type="button" data-block-cmd="numbered-list" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs flex items-center gap-1 font-medium" title="Numbered List (1. 2. 3.)">
                <span class="font-bold text-[11px]">1.</span> List
              </button>
              <button type="button" data-block-cmd="bullet-list" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs flex items-center gap-1 font-medium" title="Bullet List (• • •)">
                <span class="font-bold text-[11px]">•</span> Bullet
              </button>

              <div class="h-4 w-px bg-border mx-1"></div>

              <!-- Quotes & Callouts -->
              <button type="button" data-block-cmd="quote" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs flex items-center gap-1 font-serif italic" title="Editorial Blockquote">
                <span>❝</span> Quote
              </button>
              <button type="button" data-block-cmd="callout" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs flex items-center gap-1" title="Callout Box">
                <span>💡</span> Callout
              </button>

              <div class="h-4 w-px bg-border mx-1"></div>

              <!-- Blocks -->
              <button type="button" data-block-cmd="codeblock" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground font-mono text-xs" title="Code Block">
                Code Box
              </button>
              <button type="button" data-block-cmd="table" class="format-btn px-2 py-1 rounded-lg hover:bg-slate-100 hover:text-foreground text-xs flex items-center gap-1" title="Comparison Table">
                <span>📊</span> Table
              </button>
              <button type="button" data-block-cmd="tool" class="format-btn px-2.5 py-1 rounded-lg bg-amber-50 text-amber-900 border border-amber-200/80 font-bold text-xs hover:bg-amber-100 transition flex items-center gap-1" title="Embed Indian Software Card">
                <span>⚡</span> Embed Tool
              </button>
            </div>

            <div class="text-[11px] font-mono text-muted-foreground/60 hidden md:block">
              Type <span class="bg-slate-100 px-1 py-0.5 rounded font-bold text-foreground">/</span> for blocks
            </div>
          </div>

          <!-- Hidden raw storage textarea for backward compatibility -->
          <textarea id="article-content" class="hidden">{existingPost?.content || ''}</textarea>

          <!-- Main WYSIWYG Visual Canvas -->
          <div class="relative min-h-[500px]">
            <div
              id="wysiwyg-canvas"
              contenteditable="true"
              spellcheck="true"
              class="w-full min-h-[500px] text-foreground focus:outline-none font-sans leading-relaxed text-base prose prose-slate max-w-none prose-headings:font-serif-editorial prose-headings:font-bold prose-a:text-primary prose-a:font-semibold prose-a:no-underline hover:prose-a:underline prose-p:my-3 prose-ul:my-3 prose-ol:my-3 prose-li:my-1"
            ></div>

            <!-- Floating Slash Command Menu (Notion-Style) -->
            <div
              id="floating-slash-menu"
              class="hidden fixed z-50 w-72 rounded-2xl border border-border bg-white p-2 shadow-2xl ring-1 ring-black/5 text-xs transition-all duration-150 animate-in fade-in zoom-in-95"
            >
              <div class="px-2.5 py-1 text-[10px] font-bold text-muted-foreground uppercase tracking-wider border-b border-border/60 mb-1 flex items-center justify-between">
                <span>Blocks &amp; Embeds</span>
                <span class="font-mono text-[9px] text-muted-foreground">↑↓ navigate · ↵ choose</span>
              </div>
              <div id="slash-menu-items" class="space-y-0.5 max-h-72 overflow-y-auto">
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-amber-50/80 hover:text-amber-900 transition cursor-pointer active" data-cmd="tool" data-keywords="tool embed software desi indian app card">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100 text-amber-900 font-bold text-xs shrink-0">⚡</span>
                  <div>
                    <div class="font-bold text-foreground">Embed Indian Tool</div>
                    <div class="text-[10px] text-muted-foreground">Live software card from directory</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="numbered-list" data-keywords="numbered list 1 2 3 ol ordered numbers">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-800 font-bold text-xs shrink-0">1.</span>
                  <div>
                    <div class="font-bold text-foreground">Numbered List</div>
                    <div class="text-[10px] text-muted-foreground">Ordered steps or sequential points</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="bullet-list" data-keywords="bullet list ul unordered unnumber points dots">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-800 font-bold text-xs shrink-0">•</span>
                  <div>
                    <div class="font-bold text-foreground">Bulleted List</div>
                    <div class="text-[10px] text-muted-foreground">Unordered list items</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="quote" data-keywords="quote blockquote insight pullquote cite">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-100 text-amber-800 font-bold text-xs shrink-0">❝</span>
                  <div>
                    <div class="font-bold text-foreground">Quote / Blockquote</div>
                    <div class="text-[10px] text-muted-foreground">Editorial pull-quote or citation</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="callout" data-keywords="callout note tip warning alert box info takeaway">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-100 text-blue-800 font-bold text-xs shrink-0">💡</span>
                  <div>
                    <div class="font-bold text-foreground">Callout Box</div>
                    <div class="text-[10px] text-muted-foreground">Key takeaway or sovereign note</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="h2" data-keywords="h2 heading title section">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-800 font-bold text-xs shrink-0 font-serif-editorial">H2</span>
                  <div>
                    <div class="font-bold text-foreground">Heading 2</div>
                    <div class="text-[10px] text-muted-foreground">Main section title</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="h3" data-keywords="h3 sub-heading subsection">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-800 font-bold text-xs shrink-0 font-serif-editorial">H3</span>
                  <div>
                    <div class="font-bold text-foreground">Heading 3</div>
                    <div class="text-[10px] text-muted-foreground">Sub-section title</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="table" data-keywords="table comparison vs grid matrix">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-800 font-bold text-xs shrink-0">📊</span>
                  <div>
                    <div class="font-bold text-foreground">Comparison Table</div>
                    <div class="text-[10px] text-muted-foreground">Sovereign Alternative vs Global Giant</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="code" data-keywords="code snippet terminal script bash syntax pre">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-100 text-purple-800 font-bold text-xs shrink-0 font-mono">&lt;/&gt;</span>
                  <div>
                    <div class="font-bold text-foreground">Code Block</div>
                    <div class="text-[10px] text-muted-foreground">Commands, configuration, or code</div>
                  </div>
                </button>
                <button type="button" class="slash-item flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left hover:bg-slate-100 transition cursor-pointer" data-cmd="divider" data-keywords="divider line hr separator rule">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-slate-100 text-slate-800 font-bold text-xs shrink-0">―</span>
                  <div>
                    <div class="font-bold text-foreground">Divider</div>
                    <div class="text-[10px] text-muted-foreground">Horizontal rule separator</div>
                  </div>
                </button>
              </div>
            </div>

            <!-- Live Reader Preview Container (Hidden by default) -->
            <div id="live-preview-box" class="hidden prose prose-slate max-w-none prose-headings:font-serif-editorial prose-headings:font-bold prose-a:text-primary"></div>
          </div>
        </div>
      </main>

      <!-- Right: Slide-out SEO & Settings Drawer -->
      <aside
        id="settings-drawer"
        class="w-80 sm:w-96 border-l border-border bg-white p-5 overflow-y-auto hidden lg:block shrink-0 shadow-lg lg:shadow-none transition-all z-20"
      >
        <div class="flex items-center justify-between pb-4 border-b border-border">
          <h3 class="text-sm font-bold text-foreground flex items-center gap-1.5">
            <svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
