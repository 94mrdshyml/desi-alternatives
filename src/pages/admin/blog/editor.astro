  // --- NOTION-STYLE SLASH COMMAND POPUP MENU ---
  const slashMenu = document.getElementById('floating-slash-menu') as HTMLElement;
  const slashItems = document.querySelectorAll<HTMLButtonElement>('.slash-item');
  let isSlashMenuOpen = false;
  let activeSlashIndex = 0;

  function updateActiveSlashItem() {
    const visibleItems = Array.from(slashItems).filter((it) => !it.classList.contains('hidden'));
    visibleItems.forEach((it, idx) => {
      if (idx === activeSlashIndex) {
        it.classList.add('bg-amber-100/90', 'text-amber-950', 'ring-1', 'ring-amber-400/50');
      } else {
        it.classList.remove('bg-amber-100/90', 'text-amber-950', 'ring-1', 'ring-amber-400/50');
      }
    });
  }

  function openSlashMenuAtSelection() {
    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    const range = sel.getRangeAt(0);
    const rect = range.getBoundingClientRect();

    slashMenu.style.left = `${Math.min(window.innerWidth - 300, Math.max(16, rect.left))}px`;
    slashMenu.style.top = `${rect.bottom + window.scrollY + 8}px`;

    isSlashMenuOpen = true;
    slashMenu.classList.remove('hidden');
    filterSlashMenu('');
  }

  function closeSlashMenu() {
    isSlashMenuOpen = false;
    slashMenu.classList.add('hidden');
  }

  function filterSlashMenu(query: string) {
    const q = query.toLowerCase().trim();
    let visibleCount = 0;

    slashItems.forEach((item) => {
      const cmd = item.dataset.cmd || '';
      const keywords = item.dataset.keywords || '';
      const text = item.textContent?.toLowerCase() || '';

      if (!q || cmd.includes(q) || keywords.includes(q) || text.includes(q)) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    activeSlashIndex = 0;
    updateActiveSlashItem();

    if (visibleCount === 0) {
      closeSlashMenu();
    }
  }

  function removeTypedSlashQuery() {
    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    const node = sel.anchorNode;
    if (node && node.nodeType === Node.TEXT_NODE) {
      const text = node.textContent || '';
      const slashIdx = text.lastIndexOf('/');
      if (slashIdx >= 0) {
        node.textContent = text.substring(0, slashIdx);
      }
    }
  }

  function executeWysiwygCommand(cmd: string) {
    removeTypedSlashQuery();
    closeSlashMenu();
    wysiwygCanvas.focus();

    if (cmd === 'h2') {
      document.execCommand('formatBlock', false, '<h2>');
    } else if (cmd === 'h3') {
      document.execCommand('formatBlock', false, '<h3>');
    } else if (cmd === 'p') {
      document.execCommand('formatBlock', false, '<p>');
    } else if (cmd === 'numbered-list') {
      document.execCommand('insertOrderedList', false);
    } else if (cmd === 'bullet-list') {
      document.execCommand('insertUnorderedList', false);
    } else if (cmd === 'quote') {
      const quoteHtml = `<blockquote class="border-l-4 border-amber-500 pl-4 italic my-4 text-slate-700 bg-amber-50/30 py-2.5 rounded-r-xl">"Sovereign engineering builds software you truly own and control."</blockquote><p><br/></p>`;
      document.execCommand('insertHTML', false, quoteHtml);
    } else if (cmd === 'callout') {
      const calloutHtml = `
        <div class="my-6 rounded-2xl border p-4 text-sm bg-blue-50/70 border-blue-200 text-blue-900 not-prose leading-relaxed" data-block="callout" data-callout="NOTE">
          <div class="font-bold text-xs uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>💡 NOTE</span>
          </div>
          <div class="callout-content" contenteditable="true">Key takeaway or sovereign insight goes here...</div>
        </div><p><br/></p>
      `;
      document.execCommand('insertHTML', false, calloutHtml);
    } else if (cmd === 'codeblock' || cmd === 'code') {
      const codeHtml = `
        <div class="my-6 rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 not-prose shadow-md" data-block="codeblock" data-lang="bash">
          <div class="flex items-center justify-between px-4 py-1.5 bg-slate-900/90 border-b border-slate-800 text-[11px] font-mono text-slate-400 select-none">
            <span>bash</span>
            <span class="text-[10px] text-slate-500">Syntax block</span>
          </div>
          <pre class="p-4 text-xs font-mono text-slate-200 overflow-x-auto focus:outline-none" contenteditable="true"><code># Installation command\ncurl -fsSL https://get.signoz.io/install.sh | bash</code></pre>
        </div><p><br/></p>
      `;
      document.execCommand('insertHTML', false, codeHtml);
    } else if (cmd === 'table') {
      const tableHtml = `
        <div class="my-6 overflow-x-auto not-prose" data-block="table">
          <table class="w-full text-left text-xs border-collapse border border-border rounded-xl bg-white shadow-2xs">
            <thead class="bg-slate-50 border-b border-border font-bold text-foreground">
              <tr>
                <th class="p-3 border-r border-border/60" contenteditable="true">Capability</th>
                <th class="p-3 border-r border-border/60" contenteditable="true">Sovereign Alternative</th>
                <th class="p-3" contenteditable="true">Global Giant</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-border/60 hover:bg-slate-50/50">
                <td class="p-3 border-r border-border/60 font-semibold" contenteditable="true">Data Hosting</td>
                <td class="p-3 border-r border-border/60" contenteditable="true">🇮🇳 Mumbai / India Region</td>
                <td class="p-3" contenteditable="true">🇺🇸 US-East</td>
              </tr>
              <tr class="border-b border-border/60 hover:bg-slate-50/50">
                <td class="p-3 border-r border-border/60 font-semibold" contenteditable="true">Tax &amp; Currency</td>
                <td class="p-3 border-r border-border/60" contenteditable="true">INR + 18% GST Input Credit</td>
                <td class="p-3" contenteditable="true">USD + 3.5% Forex Markups</td>
              </tr>
              <tr class="hover:bg-slate-50/50">
                <td class="p-3 border-r border-border/60 font-semibold" contenteditable="true">Compliance</td>
                <td class="p-3 border-r border-border/60" contenteditable="true">DPDP Act 2023 &amp; RBI Ready</td>
                <td class="p-3" contenteditable="true">GDPR / SOC2 Only</td>
              </tr>
            </tbody>
          </table>
        </div><p><br/></p>
      `;
      document.execCommand('insertHTML', false, tableHtml);
    } else if (cmd === 'divider') {
      document.execCommand('insertHorizontalRule', false);
    } else if (cmd === 'tool') {
      openToolModal();
      return;
    }

    attachCanvasInteractions();
    updateReadingStats();
  }

  // Keyboard navigation & slash detection on WYSIWYG canvas
  wysiwygCanvas.addEventListener('keydown', (e: KeyboardEvent) => {
    if (isSlashMenuOpen) {
      const visibleItems = Array.from(slashItems).filter((it) => !it.classList.contains('hidden'));

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeSlashIndex = (activeSlashIndex + 1) % visibleItems.length;
        updateActiveSlashItem();
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeSlashIndex = (activeSlashIndex - 1 + visibleItems.length) % visibleItems.length;
        updateActiveSlashItem();
        return;
      }
      if (e.key === 'Enter' || e.key === 'Tab') {
        e.preventDefault();
        const selected = visibleItems[activeSlashIndex];
        if (selected) {
          executeWysiwygCommand(selected.dataset.cmd || '');
        }
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        closeSlashMenu();
        return;
      }
    }
  });

  wysiwygCanvas.addEventListener('keyup', (e: KeyboardEvent) => {
    if (['ArrowDown', 'ArrowUp', 'Enter', 'Escape'].includes(e.key) && isSlashMenuOpen) {
      return;
    }

    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return;
    const textNode = sel.anchorNode;
    const text = textNode?.textContent || '';
    const slashIdx = text.lastIndexOf('/');

    if (slashIdx >= 0) {
      const query = text.substring(slashIdx + 1);
      if (!query.includes(' ')) {
        if (!isSlashMenuOpen) openSlashMenuAtSelection();
        filterSlashMenu(query);
      } else {
        closeSlashMenu();
      }
    } else {
      closeSlashMenu();
    }

    updateReadingStats();
  });

  // Slash items click handler
  slashItems.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const cmd = btn.dataset.cmd || '';
      executeWysiwygCommand(cmd);
    });
  });

