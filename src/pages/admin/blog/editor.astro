  function showToast(msg: string, type: 'success' | 'error' | 'info' = 'info') {
    const container = document.getElementById('editor-toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `rounded-xl p-3.5 text-xs font-semibold shadow-lg border pointer-events-auto transition-all transform duration-200 ${
      type === 'success'
        ? 'bg-emerald-950 text-emerald-100 border-emerald-800'
        : type === 'error'
        ? 'bg-rose-950 text-rose-100 border-rose-800'
        : 'bg-slate-900 text-slate-100 border-slate-700'
    }`;
    toast.innerHTML = msg;
    container.appendChild(toast);

    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(-10px)';
      setTimeout(() => toast.remove(), 250);
    }, 3000);
  }

  // --- BIDIRECTIONAL MARKDOWN <-> WYSIWYG DOM ENGINE ---

  function parseMarkdownToWysiwygHtml(md: string): string {
    if (!md || !md.trim()) {
      return '<p>Write your article here... Type <span class="bg-slate-100 px-1 py-0.5 rounded font-mono text-xs">/</span> for blocks.</p>';
    }

    let html = md;

    // 1. Tool embeds: :::tool{slug="xyz"}:::
    html = html.replace(/:::tool\{slug="([^"]+)"\}\s*:::/g, (_m, slug) => {
      const cleanSlug = String(slug || '').trim();
      const displayName = cleanSlug.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
      return `
        <div class="my-6 rounded-2xl border border-border/80 bg-gradient-to-br from-white via-amber-50/20 to-slate-50/60 p-4 sm:p-5 shadow-sm not-prose select-none cursor-default" data-block="tool" data-slug="${cleanSlug}" contenteditable="false">
          <div class="flex items-center justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3">
              <div class="h-11 w-11 rounded-xl bg-amber-100 border border-amber-200 flex items-center justify-center text-base font-bold text-amber-900 shrink-0">
                ⚡
              </div>
              <div>
                <div class="font-bold text-foreground text-sm sm:text-base">${displayName}</div>
                <div class="text-[11px] text-muted-foreground">Live Indian Software Card · Directory Embed (<code>${cleanSlug}</code>)</div>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 text-[10px] font-bold">
                ✓ Live Embed
              </span>
              <button type="button" class="remove-tool-btn text-xs text-rose-500 hover:text-rose-700 font-bold p-1 hover:bg-rose-50 rounded" title="Remove Embed">✕</button>
            </div>
          </div>
        </div>
      `;
    });

    // 2. Callout Boxes (> [!NOTE] or > [!TIP] etc.)
    html = html.replace(/> \[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\n([\s\S]*?)(?=\n\n|$)/g, (_m, type, body) => {
      const cleanBody = body.replace(/^>\s?/gm, '').trim();
      const colors: Record<string, { bg: string; icon: string }> = {
        NOTE: { bg: 'bg-blue-50/70 border-blue-200 text-blue-900', icon: '💡' },
        TIP: { bg: 'bg-emerald-50/70 border-emerald-200 text-emerald-900', icon: '⚡' },
        IMPORTANT: { bg: 'bg-amber-50/70 border-amber-200 text-amber-900', icon: '⚠️' },
        WARNING: { bg: 'bg-rose-50/70 border-rose-200 text-rose-900', icon: '🛑' },
        CAUTION: { bg: 'bg-orange-50/70 border-orange-200 text-orange-900', icon: '⚡' },
      };
      const conf = colors[type] || colors.NOTE;
      return `
        <div class="my-6 rounded-2xl border p-4 text-sm ${conf.bg} not-prose leading-relaxed relative" data-block="callout" data-callout="${type}">
          <div class="font-bold text-xs uppercase tracking-wider mb-1 flex items-center justify-between">
            <span>${conf.icon} ${type}</span>
          </div>
          <div class="callout-content" contenteditable="true">${cleanBody}</div>
        </div>
      `;
    });

    // 3. Code Blocks
    html = html.replace(/```([a-z0-9_-]*)\n([\s\S]*?)```/g, (_m, lang, code) => {
      const escaped = code.replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `
        <div class="my-6 rounded-2xl overflow-hidden border border-slate-800 bg-slate-950 not-prose shadow-md" data-block="codeblock" data-lang="${lang || 'bash'}">
          <div class="flex items-center justify-between px-4 py-1.5 bg-slate-900/90 border-b border-slate-800 text-[11px] font-mono text-slate-400 select-none">
            <span>${lang || 'code'}</span>
            <span class="text-[10px] text-slate-500">Syntax block</span>
          </div>
          <pre class="p-4 text-xs font-mono text-slate-200 overflow-x-auto focus:outline-none" contenteditable="true"><code>${escaped}</code></pre>
        </div>
      `;
    });

    // 4. Split blocks (paragraphs, headings, blockquotes, lists, tables)
    const blocks = html.split(/\n\n+/);
    html = blocks
      .map((blk) => {
        blk = blk.trim();
        if (!blk) return '';
        if (blk.startsWith('<div') || blk.startsWith('<pre')) return blk;

        // Headings
        if (blk.startsWith('### ')) {
          return `<h3 class="text-xl font-bold font-serif-editorial mt-6 mb-2 text-foreground">${blk.replace(/^###\s+/, '')}</h3>`;
        }
        if (blk.startsWith('## ')) {
          return `<h2 class="text-2xl font-bold font-serif-editorial mt-8 mb-3 text-foreground border-b border-border/40 pb-1">${blk.replace(/^##\s+/, '')}</h2>`;
        }
        if (blk.startsWith('# ')) {
          return `<h2 class="text-3xl font-extrabold font-serif-editorial mt-8 mb-3 text-foreground">${blk.replace(/^#\s+/, '')}</h2>`;
        }

        // Horizontal rule
        if (blk === '---' || blk === '***' || blk === '___') {
          return '<hr class="my-8 border-border/80" />';
        }

        // Blockquotes
        if (blk.startsWith('> ')) {
          const quoteLines = blk.split('\n').map((l) => l.replace(/^>\s?/, '')).join('<br/>');
          return `<blockquote class="border-l-4 border-amber-500 pl-4 italic my-4 text-slate-700 bg-amber-50/30 py-2.5 rounded-r-xl">${quoteLines}</blockquote>`;
        }

        // Numbered Lists (Ordered)
        if (/^\d+\.\s+/.test(blk)) {
          const items = blk.split('\n').map((li) => `<li>${li.replace(/^\d+\.\s+/, '')}</li>`).join('');
          return `<ol class="list-decimal pl-6 my-4 space-y-1.5 text-foreground">${items}</ol>`;
        }

        // Bulleted Lists (Unordered)
        if (blk.startsWith('- ') || blk.startsWith('* ')) {
          const items = blk.split('\n').map((li) => `<li>${li.replace(/^[-*]\s+/, '')}</li>`).join('');
          return `<ul class="list-disc pl-6 my-4 space-y-1.5 text-foreground">${items}</ul>`;
        }

        // Markdown Table
        if (blk.startsWith('|') && blk.endsWith('|')) {
          const rows = blk.split('\n');
          let tableHtml = '<div class="my-6 overflow-x-auto not-prose" data-block="table"><table class="w-full text-left text-xs border-collapse border border-border rounded-xl bg-white shadow-2xs">';
          rows.forEach((row, idx) => {
            if (row.includes('---')) return;
            const cells = row.split('|').slice(1, -1).map((c) => c.trim());
            if (idx === 0) {
              tableHtml += '<thead class="bg-slate-50 border-b border-border font-bold text-foreground"><tr>' + cells.map((c) => `<th class="p-3 border-r border-border/60 last:border-0" contenteditable="true">${c}</th>`).join('') + '</tr></thead><tbody>';
            } else {
              tableHtml += '<tr class="border-b border-border/60 hover:bg-slate-50/50">' + cells.map((c) => `<td class="p-3 border-r border-border/60 last:border-0" contenteditable="true">${c}</td>`).join('') + '</tr>';
            }
          });
          tableHtml += '</tbody></table></div>';
          return tableHtml;
        }

        return `<p class="my-3 leading-relaxed text-foreground">${blk.replace(/\n/g, '<br/>')}</p>`;
      })
      .join('\n');

    // Inline formatting: bold, italic, code, links
    html = html
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-amber-900 border border-slate-200">$1</code>')
      .replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-primary font-semibold hover:underline" target="_blank">$1</a>');

    return html;
  }

  function serializeCanvasToMarkdown(): string {
    const clone = wysiwygCanvas.cloneNode(true) as HTMLElement;
    const blocks: string[] = [];

    clone.childNodes.forEach((node) => {
      if (node.nodeType === Node.TEXT_NODE) {
        const text = node.textContent?.trim();
        if (text) blocks.push(text);
        return;
      }

      if (node.nodeType === Node.ELEMENT_NODE) {
        const el = node as HTMLElement;
        const tagName = el.tagName.toLowerCase();

        // 1. Tool Embed Card
        if (el.dataset.block === 'tool') {
          const slug = el.dataset.slug || '';
          if (slug) blocks.push(`:::tool{slug="${slug}"}\n:::`);
          return;
        }

        // 2. Callout Box
        if (el.dataset.block === 'callout') {
          const type = el.dataset.callout || 'NOTE';
          const contentEl = el.querySelector('.callout-content') || el;
          const text = (contentEl.textContent || '').trim();
          blocks.push(`> [!${type}]\n> ${text.replace(/\n/g, '\n> ')}`);
          return;
        }

        // 3. Code Block
        if (el.dataset.block === 'codeblock' || tagName === 'pre') {
          const lang = el.dataset.lang || 'bash';
          const code = el.querySelector('code')?.textContent || el.textContent || '';
          blocks.push(`\`\`\`${lang}\n${code.trim()}\n\`\`\``);
          return;
        }

        // 4. Table
        if (el.dataset.block === 'table' || tagName === 'table') {
          const table = (tagName === 'table' ? el : el.querySelector('table')) as HTMLTableElement;
          if (table) {
            const rows: string[] = [];
            const headerCells = Array.from(table.querySelectorAll('thead th')).map((th) => th.textContent?.trim() || 'Col');
            if (headerCells.length > 0) {
              rows.push(`| ${headerCells.join(' | ')} |`);
              rows.push(`| ${headerCells.map(() => ':---').join(' | ')} |`);
            }
            table.querySelectorAll('tbody tr').forEach((tr) => {
              const cells = Array.from(tr.querySelectorAll('td')).map((td) => td.textContent?.trim() || '');
              if (cells.length > 0) {
                rows.push(`| ${cells.join(' | ')} |`);
              }
            });
            if (rows.length > 0) {
              blocks.push(rows.join('\n'));
              return;
            }
          }
        }

        // 5. Headings
        if (tagName === 'h1' || tagName === 'h2') {
          blocks.push(`## ${el.textContent?.trim() || ''}`);
          return;
        }
        if (tagName === 'h3') {
          blocks.push(`### ${el.textContent?.trim() || ''}`);
          return;
        }

        // 6. Numbered Lists
        if (tagName === 'ol') {
          const items = Array.from(el.querySelectorAll('li')).map((li, idx) => `${idx + 1}. ${li.innerHTML.replace(/<br\s*[\/]?>/gi, ' ').trim()}`);
          if (items.length > 0) blocks.push(items.join('\n'));
          return;
        }

        // 7. Bullet Lists
        if (tagName === 'ul') {
          const items = Array.from(el.querySelectorAll('li')).map((li) => `- ${li.innerHTML.replace(/<br\s*[\/]?>/gi, ' ').trim()}`);
          if (items.length > 0) blocks.push(items.join('\n'));
          return;
        }

        // 8. Blockquote
        if (tagName === 'blockquote') {
          const text = (el.textContent || '').trim();
          blocks.push(`> "${text.replace(/^["“”]|["“”]$/g, '').trim()}"`);
          return;
        }

        // 9. Horizontal Rule
        if (tagName === 'hr') {
          blocks.push('---');
          return;
        }

        // 10. Normal Paragraphs
        let text = el.innerHTML || '';
        // Convert inline HTML to clean Markdown
        text = text
          .replace(/<strong>(.*?)<\/strong>/gi, '**$1**')
          .replace(/<b>(.*?)<\/b>/gi, '**$1**')
          .replace(/<em>(.*?)<\/em>/gi, '*$1*')
          .replace(/<i>(.*?)<\/i>/gi, '*$1*')
          .replace(/<code[^>]*>(.*?)<\/code>/gi, '`$1`')
          .replace(/<a[^>]*href="([^"]+)"[^>]*>(.*?)<\/a>/gi, '[$2]($1)')
          .replace(/<br\s*[\/]?>/gi, '\n')
          .replace(/<[^>]+>/g, '')
          .trim();

        if (text) {
          blocks.push(text);
        }
      }
    });

    return blocks.join('\n\n');
  }

