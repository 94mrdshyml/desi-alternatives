      });
    } catch (e: any) {
      toolSearchResults.innerHTML = `<div class="text-center py-4 text-xs text-rose-600">Error loading tools.</div>`;
    }
  }

  // Quick Add Author Modal
  quickAddAuthorBtn.addEventListener('click', () => authorModal.classList.remove('hidden'));
  closeAuthorModal.addEventListener('click', () => authorModal.classList.add('hidden'));
  cancelAuthorBtn.addEventListener('click', () => authorModal.classList.add('hidden'));

  saveAuthorBtn.addEventListener('click', async () => {
    const name = (document.getElementById('new-author-name') as HTMLInputElement).value.trim();
    const role = (document.getElementById('new-author-role') as HTMLInputElement).value.trim();
    const twitter = (document.getElementById('new-author-twitter') as HTMLInputElement).value.trim();
    const bio = (document.getElementById('new-author-bio') as HTMLTextAreaElement).value.trim();

    if (!name) {
      showToast('Author name is required', 'error');
      return;
    }

    saveAuthorBtn.disabled = true;
    saveAuthorBtn.textContent = 'Saving...';

    try {
      const res = await fetch('/api/admin/blog/authors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, role, twitterHandle: twitter, bio }),
      });

      const data: any = await res.json();
      if (data.success) {
        const opt = document.createElement('option');
        opt.value = data.author.id;
        opt.textContent = `${data.author.name} (${data.author.role})`;
        opt.selected = true;
        authorSelect.appendChild(opt);
        authorModal.classList.add('hidden');
        showToast('Author created and selected.', 'success');
      } else {
        showToast(data.error || 'Failed to create author', 'error');
      }
    } catch (err: any) {
      showToast(err.message || 'Network error', 'error');
    } finally {
      saveAuthorBtn.disabled = false;
      saveAuthorBtn.textContent = 'Save Author';
    }
  });

  // Save Post Handler (Draft vs Published)
  async function savePost(targetStatus?: string) {
    if (isSaving) return;

    const title = titleInput.value.trim();
    if (!title) {
      showToast('Please enter an article title', 'error');
      titleInput.focus();
      return;
    }

    const subtitle = subtitleInput.value.trim();
    const content = serializeCanvasToMarkdown();
    const status = targetStatus || statusSelect.value || 'draft';
    const authorId = authorSelect.value || null;
    const categoryId = categorySelect.value || null;
    const slug = slugInput.value.trim();
    const metaTitle = metaTitleInput.value.trim();
    const metaDescription = metaDescInput.value.trim();
    const canonicalUrl = canonicalUrlInput.value.trim();
    const publishedAt = publishedAtInput.value ? new Date(publishedAtInput.value).toISOString() : null;

    // Get checked tagged tools
    const taggedToolIds: string[] = [];
    document.querySelectorAll('input[name="tagged-tool"]:checked').forEach((chk) => {
      taggedToolIds.push((chk as HTMLInputElement).value);
    });

    isSaving = true;
    saveIndicator.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-ping"></span><span>Saving to cloud...</span>`;
    saveDraftBtn.disabled = true;
    publishBtn.disabled = true;

    try {
      const payload: any = {
        action: editPostId ? 'update' : 'create',
        id: editPostId || undefined,
        title,
        subtitle,
        content,
        coverImageUrl,
        authorId,
        categoryId,
        status,
        slug,
        metaTitle,
        metaDescription,
        canonicalUrl,
        publishedAt,
        taggedToolIds,
      };

      const res = await fetch('/api/admin/blog/posts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data: any = await res.json();
      if (data.success) {
        saveIndicator.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span><span>Saved</span>`;
        showToast(
          status === 'published'
            ? 'Article published live on /blog!'
            : 'Article saved to drafts.',
          'success'
        );

        if (!editPostId && data.postId) {
          window.location.href = `/admin/blog/editor?id=${data.postId}`;
        }
      } else {
        saveIndicator.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span><span>Save error</span>`;
        showToast(data.error || 'Failed to save article', 'error');
      }
    } catch (err: any) {
      saveIndicator.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span><span>Network error</span>`;
      showToast(err.message || 'Network error while saving', 'error');
    } finally {
      isSaving = false;
      saveDraftBtn.disabled = false;
      publishBtn.disabled = false;
    }
  }

  saveDraftBtn.addEventListener('click', () => savePost('draft'));
  publishBtn.addEventListener('click', () => savePost('published'));
</script>
