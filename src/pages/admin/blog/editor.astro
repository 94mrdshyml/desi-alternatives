      const data: any = await res.json();
      if (data.available) {
        slugCheckMsg.innerHTML = `<span class="text-emerald-600">✓ Slug is available</span>`;
      } else {
        slugCheckMsg.innerHTML = `<span class="text-rose-600">⚠ Slug already taken (${data.error || 'choose another'})</span>`;
      }
    } catch (e) {
