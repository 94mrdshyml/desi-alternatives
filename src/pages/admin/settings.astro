---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { siteSettings, desiTools, globalTools, categories, claimsQueue, users } from '@/lib/server/db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
const db = Astro.locals.db;

if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}

let fromName = 'Desi Alternatives';
let fromEmail = 'team@letter.mrdshyml.xyz';

let welcomeEnabled = true;
let welcomeSubject = 'Welcome to Desi Alternatives, {{first_name|builder}}! 🇮🇳';
let welcomeBody = `<p>Hi {{first_name|there}} 👋,</p>
<p>Welcome to Desi Alternatives! We're absolutely thrilled you're here. Whether you're writing the code, leading a team, or founding the next big thing, if you love seeing the Indian tech scene thrive, you've found your people.</p>
<p><strong>Here is what you can dive into right away:</strong></p>
<ol>
  <li><strong>🛠️ Explore homegrown tools:</strong> Browse our curated list of local apps spanning AI, cloud, developer tools, and everyday productivity.</li>
  <li><strong>🥊 See the matchups:</strong> Check out how our local SaaS heroes stack up against the global heavyweights.</li>
  <li><strong>🚀 Show off your work:</strong> Built something awesome? Submit your software or claim an existing listing so everyone knows it belongs to you.</li>
  <li><strong>🤓 Geek out:</strong> Read behind-the-scenes tech stories, guides, and deep dives on our blog.</li>
</ol>
<p>Got a question, or built a tool you want us to feature? Just hit reply—we actually read these and would love to chat 💬!</p>
<p>Regards,<br><strong>Desi Alternatives Team</strong></p>`;

let newsletterWelcomeEnabled = true;
let newsletterWelcomeSubject = 'Welcome to Desi Alternatives Dispatch, {{first_name|there}}! 📬';
let newsletterWelcomeBody = `<p>Hi {{first_name|there}},</p>
<p>Thanks for subscribing to the <strong>Desi Alternatives Dispatch</strong>!</p>
<p>Every Thursday morning, we deliver curated intelligence directly to your inbox:</p>
<ul>
  <li><strong>Sovereign SaaS Radar:</strong> Hidden gems and high-performing Indian software</li>
  <li><strong>Cost Teardowns:</strong> Real case studies on cutting foreign cloud bills</li>
  <li><strong>Migration Blueprints:</strong> Step-by-step guides for moving off global monopolies</li>
  <li><strong>Compliance Guides:</strong> Navigating Indian data residency, 18% GST invoices, and DPDP rules</li>
</ul>
<p>Look out for our next dispatch in your inbox this Thursday!</p>
<p>Warmly,<br><strong>The Dispatch Editorial Team</strong><br><a href="https://desialternatives.in/newsletter">https://desialternatives.in/newsletter</a></p>`;

let gtmEnabled = false;
let gtmId = '';
let umamiEnabled = false;
let umamiWebsiteId = '';
let umamiScriptUrl = 'https://cloud.umami.is/script.js';
let umamiPixelEnabled = false;
let umamiPixelUrl = '';
let emailPixelTrackingEnabled = false;

let totalToolsCount = 0;
let totalGlobalCount = 0;
let totalCategoriesCount = 0;
let pendingClaimsCount = 0;
let totalUsersCount = 0;

if (db) {
  try {
    const settings = await db.select().from(siteSettings).where(eq(siteSettings.id, 'general')).get();
    if (settings) {
      fromName = settings.fromName || fromName;
      fromEmail = settings.fromEmail || fromEmail;
      welcomeEnabled = settings.welcomeEnabled !== false;
      welcomeSubject = settings.welcomeSubject || welcomeSubject;
      welcomeBody = settings.welcomeBody || welcomeBody;
      newsletterWelcomeEnabled = settings.newsletterWelcomeEnabled !== false;
      newsletterWelcomeSubject = settings.newsletterWelcomeSubject || newsletterWelcomeSubject;
      newsletterWelcomeBody = settings.newsletterWelcomeBody || newsletterWelcomeBody;
      gtmEnabled = settings.gtmEnabled === true;
      gtmId = settings.gtmId || '';
      umamiEnabled = settings.umamiEnabled === true;
      umamiWebsiteId = settings.umamiWebsiteId || '';
      umamiScriptUrl = settings.umamiScriptUrl || umamiScriptUrl;
      umamiPixelEnabled = settings.umamiPixelEnabled === true;
      umamiPixelUrl = settings.umamiPixelUrl || '';
      emailPixelTrackingEnabled = settings.emailPixelTrackingEnabled === true;
    }

    const tools = await db.select().from(desiTools).all();
    totalToolsCount = tools.length;
    const globals = await db.select().from(globalTools).all();
    totalGlobalCount = globals.length;
    const cats = await db.select().from(categories).all();
    totalCategoriesCount = cats.length;
    const claims = await db.select().from(claimsQueue).where(eq(claimsQueue.status, 'pending')).all();
    pendingClaimsCount = claims.length;
    const usersList = await db.select().from(users).all();
    totalUsersCount = usersList.length;
  } catch (e) {
    console.error('Failed to load site settings:', e);
  }
}

function sampleRender(str: string, name = 'Aarav Sharma', firstName = 'Aarav', email = 'aarav@example.com'): string {
  if (!str) return '';
  return str
    .replace(/\{\{\s*first_name(?:\|([^}]+))?\s*\}\}/gi, (_, fallback) => firstName || fallback || 'there')
    .replace(/\{\{\s*name(?:\|([^}]+))?\s*\}\}/gi, (_, fallback) => name || fallback || 'there')
    .replace(/\{\{\s*email\s*\}\}/gi, email);
}
---

<AdminLayout
  title="Platform Settings — Admin Control Center"
  currentSection="settings"
  counts={{
    tools: totalToolsCount,
    globalTools: totalGlobalCount,
    categories: totalCategoriesCount,
    claims: pendingClaimsCount,
    users: totalUsersCount,
  }}
>
  <style is:global>
    /* Scoped WYSIWYG Editor Canvas Styles */
    .wysiwyg-editor-canvas {
      min-height: 240px;
      outline: none;
      font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
      color: #1e293b;
      line-height: 1.7;
      font-size: 0.875rem;
    }
    .wysiwyg-editor-canvas p,
    .wysiwyg-editor-canvas li,
    .wysiwyg-editor-canvas span {
      font-size: 0.875rem !important;
      line-height: 1.7 !important;
      color: #1e293b !important;
    }
    .wysiwyg-editor-canvas p {
      margin-bottom: 0.75rem;
    }
    .wysiwyg-editor-canvas h2 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0f172a;
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }
    .wysiwyg-editor-canvas h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #0f172a;
      margin-top: 0.75rem;
      margin-bottom: 0.35rem;
    }
    .wysiwyg-editor-canvas ul {
      list-style-type: disc;
      padding-left: 1.4rem;
      margin-bottom: 0.75rem;
    }
    .wysiwyg-editor-canvas ol {
      list-style-type: decimal;
      padding-left: 1.4rem;
      margin-bottom: 0.75rem;
    }
    .wysiwyg-editor-canvas li {
      margin-bottom: 0.25rem;
    }
    .wysiwyg-editor-canvas a {
      color: #d97706;
      text-decoration: underline;
    }
    .wysiwyg-editor-canvas blockquote {
      border-left: 3px solid #d97706;
      padding-left: 0.75rem;
      color: #64748b;
      font-style: italic;
      margin: 0.75rem 0;
    }
    .wysiwyg-editor-canvas hr {
      border: 0;
      border-top: 1px solid #e2e8f0;
      margin: 1rem 0;
    }
  </style>

  <div class="space-y-6 max-w-4xl pb-16">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground">Platform & Email Settings</h1>
        <p class="text-xs sm:text-sm text-muted-foreground mt-0.5">
          Manage outbound sender identity, registration welcome emails, and weekly newsletter onboarding with rich WYSIWYG editors.
        </p>
      </div>

      <button
        type="button"
        id="save-all-top-btn"
        class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer shrink-0"
      >
        Save All Settings
      </button>
    </div>

    <!-- Status Message Banner -->
    <div id="settings-status" class="hidden rounded-xl p-4 text-xs font-medium transition"></div>

    <!-- Settings Navigation Tabs -->
    <div class="border-b border-border bg-white rounded-2xl p-1.5 shadow-2xs">
      <nav class="flex flex-wrap sm:flex-nowrap gap-1.5" aria-label="Settings Tabs">
        <button
          type="button"
          class="settings-tab active flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition cursor-pointer text-amber-950 bg-amber-50 border border-amber-200/80 shadow-2xs"
          data-tab="identity"
        >
          <span>✉️</span>
          <span>Sender Identity &amp; Resend</span>
        </button>
        <button
          type="button"
          class="settings-tab flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition cursor-pointer border border-transparent"
          data-tab="registration"
        >
          <span>👋</span>
          <span>Registration Welcome (WYSIWYG)</span>
        </button>
        <button
          type="button"
          class="settings-tab flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition cursor-pointer border border-transparent"
          data-tab="newsletter"
        >
          <span>📬</span>
          <span>Newsletter Welcome (WYSIWYG)</span>
        </button>
        <button
          type="button"
          class="settings-tab flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition cursor-pointer border border-transparent"
          data-tab="analytics"
        >
          <span>📊</span>
          <span>Analytics &amp; Tracking (GTM / Umami)</span>
        </button>
      </nav>
    </div>

    <form id="admin-settings-form" class="space-y-6">
      <!-- Hidden input carriers for rich HTML payloads -->
      <input type="hidden" name="welcomeBody" id="welcome-body-hidden" value={welcomeBody} />
      <input type="hidden" name="newsletterWelcomeBody" id="newsletter-welcome-body-hidden" value={newsletterWelcomeBody} />

      <!-- ========================================== -->
      <!-- TAB 1: SENDER IDENTITY & RESEND DIAGNOSTIC -->
      <!-- ========================================== -->
      <div id="tab-panel-identity" class="settings-panel space-y-6">
        <div class="rounded-2xl border border-border bg-white p-6 shadow-xs">
          <div class="flex items-center gap-2.5 pb-4 border-b border-border">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-amber-50 text-base">
              ✉️
            </div>
            <div>
              <h3 class="text-sm font-bold text-foreground">Sender Identity Configuration</h3>
              <p class="text-xs text-muted-foreground">Global sender name and verified sending email address for all transactional emails</p>
            </div>
          </div>

          <div class="mt-5 space-y-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label for="settings-from-name" class="block text-xs font-semibold text-foreground">
                  From Name *
                </label>
                <input
                  type="text"
                  id="settings-from-name"
                  name="fromName"
                  required
                  value={fromName}
                  placeholder="Desi Alternatives"
                  class="mt-1.5 w-full rounded-xl border border-border px-3.5 py-2.5 text-xs text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
                />
                <p class="mt-1 text-[11px] text-muted-foreground">
                  Display name shown in recipient inboxes.
                </p>
              </div>

              <div>
                <label for="settings-from-email" class="block text-xs font-semibold text-foreground">
                  From Email *
                </label>
                <input
                  type="email"
                  id="settings-from-email"
                  name="fromEmail"
                  required
                  value={fromEmail}
                  placeholder="team@letter.mrdshyml.xyz"
                  class="mt-1.5 w-full rounded-xl border border-border px-3.5 py-2.5 text-xs text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
                />
                <p class="mt-1 text-[11px] text-muted-foreground">
                  Must be a verified sending domain in your Resend Dashboard.
                </p>
              </div>
            </div>

            <!-- Resend Notice -->
            <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4 text-xs text-amber-950">
              <div class="flex items-start gap-2.5">
                <span class="text-base">💡</span>
                <div class="space-y-1 text-[11.5px] leading-relaxed">
                  <p class="font-bold text-amber-900">Resend Domain Verification Notice:</p>
                  <p class="text-amber-850">
                    If using custom domain (e.g. <code>team@letter.mrdshyml.xyz</code>), ensure DNS records (DKIM & SPF) are active in Resend.
                    In Resend Sandbox mode (<code>onboarding@resend.dev</code>), Resend only dispatches to your account owner email.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Live Resend Connectivity Diagnostic Card -->
        <div class="rounded-2xl border border-border bg-white p-6 shadow-xs">
          <div class="flex items-center gap-2.5 pb-4 border-b border-border">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-base">
              🚀
            </div>
            <div>
              <h3 class="text-sm font-bold text-foreground">Live Resend Connectivity Test</h3>
              <p class="text-xs text-muted-foreground">Dispatch a real OTP verification email right now to verify API keys and network delivery</p>
            </div>
          </div>

          <div class="mt-5 space-y-4">
            <div id="test-otp-status" class="hidden rounded-xl p-3 text-xs font-medium"></div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
              <input
                type="email"
                id="test-otp-target"
                placeholder="Enter recipient email (e.g. your email)"
                value={user.email}
                class="flex-1 rounded-xl border border-border px-3.5 py-2 text-xs text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
              />
              <button
                type="button"
                id="send-test-otp-btn"
                class="rounded-xl bg-foreground px-4 py-2 text-xs font-semibold text-background hover:bg-foreground/90 transition cursor-pointer shrink-0 disabled:opacity-50"
              >
                Send Test OTP Email
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: USER REGISTRATION WELCOME EMAIL     -->
      <!-- ========================================== -->
      <div id="tab-panel-registration" class="settings-panel hidden space-y-6">
        <div class="rounded-2xl border border-border bg-white p-6 shadow-xs space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-border">
            <div class="flex items-center gap-2.5">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-700 text-base">
                👋
              </div>
              <div>
                <h3 class="text-sm font-bold text-foreground">User Registration Welcome Email (WYSIWYG)</h3>
                <p class="text-xs text-muted-foreground">Dispatched when a new user verifies OTP and signs up on Desi Alternatives</p>
              </div>
            </div>

            <label class="inline-flex items-center gap-2 cursor-pointer select-none text-xs font-semibold text-foreground bg-slate-50 px-3 py-1.5 rounded-xl border border-border">
              <input
                type="checkbox"
                name="welcomeEnabled"
                id="welcome-enabled-toggle"
                checked={welcomeEnabled}
                class="h-4 w-4 rounded border-border text-primary focus:ring-primary/20 accent-primary"
              />
              <span>Enable Welcome Email</span>
            </label>
          </div>

          <div class="space-y-5">
            <!-- Subject Input -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="welcome-subject" class="block text-xs font-semibold text-foreground">
                  Email Subject / Title *
                </label>
                <div class="flex items-center gap-1.5">
                  <span class="text-[11px] text-muted-foreground">Insert:</span>
                  <button type="button" class="insert-subject-tag-btn rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-mono hover:bg-amber-100 hover:text-amber-900 transition" data-target="welcome-subject" data-tag="{'{{first_name|builder}}'}">{'{{first_name|builder}}'}</button>
                  <button type="button" class="insert-subject-tag-btn rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-mono hover:bg-amber-100 hover:text-amber-900 transition" data-target="welcome-subject" data-tag="{'{{name|there}}'}">{'{{name|there}}'}</button>
                </div>
              </div>
              <input
                type="text"
                id="welcome-subject"
                name="welcomeSubject"
                required
                value={welcomeSubject}
                class="w-full rounded-xl border border-border px-3.5 py-2.5 text-xs text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition font-medium"
              />
            </div>

            <!-- WYSIWYG Editor Container -->
            <div class="space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <label class="block text-xs font-semibold text-foreground">
                  Email Body (WYSIWYG Visual Canvas) *
                </label>

                <!-- Variable Insertion Pills -->
                <div class="flex flex-wrap items-center gap-1.5 text-xs">
                  <span class="text-[11px] text-muted-foreground">Personalize:</span>
                  <button type="button" class="insert-wysiwyg-tag-btn rounded-md bg-amber-50 border border-amber-200/80 px-2 py-0.5 text-[10px] font-mono font-semibold text-amber-900 hover:bg-amber-100 transition cursor-pointer" data-editor="welcome" data-tag="{'{{first_name|there}}'}">{'{{first_name|there}}'}</button>
                  <button type="button" class="insert-wysiwyg-tag-btn rounded-md bg-amber-50 border border-amber-200/80 px-2 py-0.5 text-[10px] font-mono font-semibold text-amber-900 hover:bg-amber-100 transition cursor-pointer" data-editor="welcome" data-tag="{'{{first_name|builder}}'}">{'{{first_name|builder}}'}</button>
                  <button type="button" class="insert-wysiwyg-tag-btn rounded-md bg-amber-50 border border-amber-200/80 px-2 py-0.5 text-[10px] font-mono font-semibold text-amber-900 hover:bg-amber-100 transition cursor-pointer" data-editor="welcome" data-tag="{'{{email}}'}">{'{{email}}'}</button>
                </div>
              </div>

              <!-- WYSIWYG Component Card -->
              <div class="rounded-2xl border border-border bg-white overflow-hidden shadow-2xs focus-within:border-primary focus-within:ring-2 focus-within:ring-primary/20 transition">
                <!-- Toolbar -->
                <div class="flex flex-wrap items-center gap-1 border-b border-border bg-slate-50/80 p-2 text-xs">
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 font-bold hover:bg-white transition" data-editor="welcome" data-cmd="bold" title="Bold (Ctrl+B)">B</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 italic hover:bg-white transition" data-editor="welcome" data-cmd="italic" title="Italic (Ctrl+I)">I</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 underline hover:bg-white transition" data-editor="welcome" data-cmd="underline" title="Underline (Ctrl+U)">U</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 line-through hover:bg-white transition" data-editor="welcome" data-cmd="strikeThrough" title="Strikethrough">S</button>
                  
                  <span class="h-4 w-px bg-border mx-1"></span>

                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 font-semibold hover:bg-white transition" data-editor="welcome" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 font-semibold hover:bg-white transition" data-editor="welcome" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" data-cmd="formatBlock" data-val="p" title="Paragraph">¶</button>

                  <span class="h-4 w-px bg-border mx-1"></span>

                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" data-cmd="insertUnorderedList" title="Bullet List">• List</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" data-cmd="insertOrderedList" title="Numbered List">1. List</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" data-cmd="formatBlock" data-val="blockquote" title="Blockquote">“ Quote</button>

                  <span class="h-4 w-px bg-border mx-1"></span>

                  <button type="button" class="wysiwyg-link-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" title="Insert Link">🔗 Link</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 hover:bg-white transition" data-editor="welcome" data-cmd="insertHorizontalRule" title="Divider">— Line</button>
                  <button type="button" class="wysiwyg-btn rounded px-2 py-1 text-muted-foreground hover:bg-white transition" data-editor="welcome" data-cmd="removeFormat" title="Clear Formatting">🧹 Clear</button>

                  <div class="ml-auto flex items-center gap-1">
                    <button type="button" class="toggle-source-btn rounded bg-white border border-border px-2 py-1 text-[11px] font-mono hover:bg-slate-100 transition cursor-pointer" data-editor="welcome">
                      &lt;/&gt; View Code
                    </button>
                  </div>
                </div>

                <!-- ContentEditable Canvas -->
                <div
                  id="welcome-wysiwyg-canvas"
                  contenteditable="true"
                  class="wysiwyg-editor-canvas p-4"
                  set:html={welcomeBody}
                />

                <!-- Raw HTML Source Editor (hidden by default) -->
                <textarea
                  id="welcome-source-textarea"
                  class="hidden w-full min-h-[240px] p-4 text-xs font-mono bg-slate-900 text-emerald-400 focus:outline-none"
                >{welcomeBody}</textarea>
              </div>
            </div>

            <!-- Live Sample Preview -->
            <div class="rounded-xl border border-slate-200 bg-slate-50/80 p-4 space-y-2">
              <div class="flex items-center justify-between text-[11px] font-bold text-muted-foreground uppercase tracking-wider">
                <span>Live Sample Preview (Recipient: "Aarav Sharma")</span>
                <span class="text-primary font-medium lowercase font-sans">Live Email Preview</span>
              </div>
              <div class="rounded-lg border border-border bg-white p-4 space-y-2 text-xs">
                <div class="font-bold text-foreground text-sm border-b border-border/60 pb-2" id="welcome-preview-subject">
                  {sampleRender(welcomeSubject, 'Aarav Sharma', 'Aarav', 'aarav@example.com')}
                </div>
                <div class="text-slate-700 leading-relaxed text-xs" id="welcome-preview-body" set:html={sampleRender(welcomeBody, 'Aarav Sharma', 'Aarav', 'aarav@example.com')}></div>
              </div>
            </div>

            <!-- Test Dispatch Trigger -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 border-t border-border/60">
              <div class="text-[11px] text-muted-foreground">
                Send a real test email to check layout in your email client.
              </div>
              <button
                type="button"
                class="test-dispatcher-btn rounded-xl border border-border bg-slate-50 px-4 py-2 text-xs font-semibold text-foreground hover:bg-slate-100 hover:border-border/80 transition cursor-pointer"
                data-type="welcome"
                data-subject-id="welcome-subject"
                data-editor="welcome"
              >
