<script>
  // Tab Switching Logic
  const tabs = document.querySelectorAll<HTMLButtonElement>('.settings-tab');
  const panels = document.querySelectorAll<HTMLDivElement>('.settings-panel');

  function activateTab(tabName: string) {
    tabs.forEach((tab) => {
      const isActive = tab.dataset.tab === tabName;
      if (isActive) {
        tab.className = 'settings-tab active flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-bold transition cursor-pointer text-amber-950 bg-amber-50 border border-amber-200/80 shadow-2xs';
      } else {
        tab.className = 'settings-tab flex-1 sm:flex-initial flex items-center justify-center gap-2 rounded-xl px-4 py-2.5 text-xs font-semibold text-muted-foreground hover:text-foreground hover:bg-slate-50 transition cursor-pointer border border-transparent';
      }
    });

    panels.forEach((panel) => {
      if (panel.id === `tab-panel-${tabName}`) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const tabName = tab.dataset.tab || 'identity';
      activateTab(tabName);
    });
  });

  // WYSIWYG Helpers
  function getEditorElements(editorType: string) {
    const canvas = document.getElementById(`${editorType}-wysiwyg-canvas`) as HTMLDivElement | null;
    const sourceTextarea = document.getElementById(`${editorType}-source-textarea`) as HTMLTextAreaElement | null;
    const hiddenInput = document.getElementById(`${editorType}-body-hidden`) as HTMLInputElement | null;
    return { canvas, sourceTextarea, hiddenInput };
  }

  function getActiveEditorHtml(editorType: string): string {
    const { canvas, sourceTextarea } = getEditorElements(editorType);
    if (sourceTextarea && !sourceTextarea.classList.contains('hidden')) {
      return sourceTextarea.value;
    }
    return canvas?.innerHTML || '';
  }

  function syncEditor(editorType: string) {
    const { canvas, sourceTextarea, hiddenInput } = getEditorElements(editorType);
    if (!canvas || !sourceTextarea || !hiddenInput) return;

    if (!sourceTextarea.classList.contains('hidden')) {
      // Source mode active
      canvas.innerHTML = sourceTextarea.value;
      hiddenInput.value = sourceTextarea.value;
    } else {
      // Visual canvas active
      sourceTextarea.value = canvas.innerHTML;
      hiddenInput.value = canvas.innerHTML;
    }
    updatePreviews();
  }

  // WYSIWYG Command Execution
  document.querySelectorAll<HTMLButtonElement>('.wysiwyg-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const editorType = btn.dataset.editor || 'welcome';
      const { canvas, sourceTextarea } = getEditorElements(editorType);
      if (sourceTextarea && !sourceTextarea.classList.contains('hidden')) return; // No commands in source mode

      canvas?.focus();
      const cmd = btn.dataset.cmd;
      const val = btn.dataset.val || '';

      if (cmd === 'formatBlock' && val) {
        document.execCommand('formatBlock', false, `<${val}>`);
      } else if (cmd) {
        document.execCommand(cmd, false, val);
      }
      syncEditor(editorType);
    });
  });

  // Link Insertion Command
  document.querySelectorAll<HTMLButtonElement>('.wysiwyg-link-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const editorType = btn.dataset.editor || 'welcome';
      const { canvas, sourceTextarea } = getEditorElements(editorType);
      if (sourceTextarea && !sourceTextarea.classList.contains('hidden')) return;

      canvas?.focus();
      const url = prompt('Enter URL (e.g. https://desialternatives.in):', 'https://');
      if (url && url.trim()) {
        document.execCommand('createLink', false, url.trim());
        syncEditor(editorType);
      }
    });
  });

  // Toggle Source / Code View
  document.querySelectorAll<HTMLButtonElement>('.toggle-source-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const editorType = btn.dataset.editor || 'welcome';
      const { canvas, sourceTextarea } = getEditorElements(editorType);
      if (!canvas || !sourceTextarea) return;

      if (sourceTextarea.classList.contains('hidden')) {
        // Switch to Code View
        sourceTextarea.value = canvas.innerHTML;
        sourceTextarea.classList.remove('hidden');
        canvas.classList.add('hidden');
        btn.textContent = '👁️ Visual Mode';
      } else {
        // Switch to Visual Mode
        canvas.innerHTML = sourceTextarea.value;
        sourceTextarea.classList.add('hidden');
        canvas.classList.remove('hidden');
        btn.textContent = '</> View Code';
      }
      syncEditor(editorType);
    });
  });

  // Variable Tag Insertion into WYSIWYG
  document.querySelectorAll<HTMLButtonElement>('.insert-wysiwyg-tag-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const editorType = btn.dataset.editor || 'welcome';
      const tag = btn.dataset.tag || '';
      const { canvas, sourceTextarea } = getEditorElements(editorType);
      if (!canvas || !sourceTextarea) return;

      if (!sourceTextarea.classList.contains('hidden')) {
        const start = sourceTextarea.selectionStart || sourceTextarea.value.length;
        const end = sourceTextarea.selectionEnd || sourceTextarea.value.length;
        const val = sourceTextarea.value;
        sourceTextarea.value = val.substring(0, start) + tag + val.substring(end);
        sourceTextarea.focus();
        sourceTextarea.selectionStart = sourceTextarea.selectionEnd = start + tag.length;
      } else {
        canvas.focus();
        document.execCommand('insertHTML', false, tag);
      }
      syncEditor(editorType);
    });
  });

  // Subject Tag Insertion Buttons
  document.querySelectorAll<HTMLButtonElement>('.insert-subject-tag-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      const tag = btn.dataset.tag;
      if (!targetId || !tag) return;

      const input = document.getElementById(targetId) as HTMLInputElement | null;
      if (!input) return;

      const start = input.selectionStart || input.value.length;
      const end = input.selectionEnd || input.value.length;
      const val = input.value;
      input.value = val.substring(0, start) + tag + val.substring(end);
      input.focus();
      input.selectionStart = input.selectionEnd = start + tag.length;
      updatePreviews();
    });
  });

  // Canvas Input Event Listeners
  ['welcome', 'newsletter'].forEach((type) => {
    const canvas = document.getElementById(`${type}-wysiwyg-canvas`);
    const textarea = document.getElementById(`${type}-source-textarea`);

    canvas?.addEventListener('input', () => syncEditor(type));
    canvas?.addEventListener('keyup', () => syncEditor(type));
    textarea?.addEventListener('input', () => syncEditor(type));

    canvas?.addEventListener('paste', (e: ClipboardEvent) => {
      e.preventDefault();
      const html = e.clipboardData?.getData('text/html');
      const text = e.clipboardData?.getData('text/plain') || '';

      if (html) {
        // Sanitize pasted HTML: remove data-* and style attributes with font-size
        const cleaned = html
          .replace(/\s+data-[a-z0-9_-]+=(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
          .replace(/\s*style="([^"]*)"/gi, (_, styleContent) => {
            const cleanStyle = styleContent.replace(/font-size\s*:\s*[^;]+;?/gi, '').trim();
            return cleanStyle ? ` style="${cleanStyle}"` : '';
          })
          .replace(/\s*style='([^']*)'/gi, (_, styleContent) => {
            const cleanStyle = styleContent.replace(/font-size\s*:\s*[^;]+;?/gi, '').trim();
            return cleanStyle ? ` style='${cleanStyle}'` : '';
          })
          .replace(/<span>([\s\S]*?)<\/span>/gi, '$1')
          .replace(/<p>\s*(?:&nbsp;|<br\s*\/?>|\s*)*<\/p>/gi, '');
        document.execCommand('insertHTML', false, cleaned);
      } else if (text) {
        document.execCommand('insertText', false, text);
      }
      syncEditor(type);
    });
  });

  // Dynamic Live Preview Interpolator
  function updatePreviews() {
    const welcomeSub = (document.getElementById('welcome-subject') as HTMLInputElement)?.value || '';
    const welcomeHtml = getActiveEditorHtml('welcome');
    const newsSub = (document.getElementById('newsletter-welcome-subject') as HTMLInputElement)?.value || '';
    const newsHtml = getActiveEditorHtml('newsletter');

    const replaceTags = (text: string, first: string, full: string, email: string) => {
      return text
        .replace(/\{\{\s*first_name(?:\s*\|\s*([^}]+?))?\s*\}\}/gi, (_, fb) => first || (fb ? fb.trim() : 'there'))
        .replace(/\{\{\s*name(?:\s*\|\s*([^}]+?))?\s*\}\}/gi, (_, fb) => full || (fb ? fb.trim() : 'there'))
        .replace(/\{\{\s*email\s*\}\}/gi, email);
    };

    const wSubEl = document.getElementById('welcome-preview-subject');
    const wBdyEl = document.getElementById('welcome-preview-body');
    if (wSubEl) wSubEl.textContent = replaceTags(welcomeSub, 'Aarav', 'Aarav Sharma', 'aarav@example.com');
    if (wBdyEl) wBdyEl.innerHTML = replaceTags(welcomeHtml, 'Aarav', 'Aarav Sharma', 'aarav@example.com');

    const nSubEl = document.getElementById('newsletter-preview-subject');
    const nBdyEl = document.getElementById('newsletter-preview-body');
    if (nSubEl) nSubEl.textContent = replaceTags(newsSub, 'Priya', 'Priya Nair', 'priya@example.com');
    if (nBdyEl) nBdyEl.innerHTML = replaceTags(newsHtml, 'Priya', 'Priya Nair', 'priya@example.com');
  }

  ['welcome-subject', 'newsletter-welcome-subject'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', updatePreviews);
  });

  // Form Submission
  const settingsForm = document.getElementById('admin-settings-form') as HTMLFormElement;
  const saveBtn = document.getElementById('save-settings-btn') as HTMLButtonElement;
  const saveTopBtn = document.getElementById('save-all-top-btn') as HTMLButtonElement;
  const statusDiv = document.getElementById('settings-status') as HTMLDivElement;

  async function handleSaveSettings() {
    if (!settingsForm) return;

    syncEditor('welcome');
    syncEditor('newsletter');

    if (saveBtn) {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
    }
    if (saveTopBtn) {
      saveTopBtn.disabled = true;
      saveTopBtn.textContent = 'Saving...';
    }
    statusDiv?.classList.add('hidden');

    const formData = new FormData(settingsForm);
    const fromName = formData.get('fromName');
    const fromEmail = formData.get('fromEmail');

    const welcomeEnabled = (document.getElementById('welcome-enabled-toggle') as HTMLInputElement)?.checked;
    const welcomeSubject = formData.get('welcomeSubject');
    const welcomeBody = formData.get('welcomeBody');

    const newsletterWelcomeEnabled = (document.getElementById('newsletter-welcome-enabled-toggle') as HTMLInputElement)?.checked;
    const newsletterWelcomeSubject = formData.get('newsletterWelcomeSubject');
    const newsletterWelcomeBody = formData.get('newsletterWelcomeBody');

    const gtmEnabled = (document.getElementById('gtm-enabled-toggle') as HTMLInputElement)?.checked;
    const gtmId = formData.get('gtmId');

    const umamiEnabled = (document.getElementById('umami-enabled-toggle') as HTMLInputElement)?.checked;
    const umamiWebsiteId = formData.get('umamiWebsiteId');
    const umamiScriptUrl = formData.get('umamiScriptUrl');

    const umamiPixelEnabled = (document.getElementById('umami-pixel-enabled-toggle') as HTMLInputElement)?.checked;
    const umamiPixelUrl = formData.get('umamiPixelUrl');
    const emailPixelTrackingEnabled = (document.getElementById('email-pixel-tracking-toggle') as HTMLInputElement)?.checked;

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          fromName,
          fromEmail,
          welcomeEnabled,
          welcomeSubject,
          welcomeBody,
          newsletterWelcomeEnabled,
          newsletterWelcomeSubject,
          newsletterWelcomeBody,
          gtmEnabled,
          gtmId,
          umamiEnabled,
          umamiWebsiteId,
          umamiScriptUrl,
          umamiPixelEnabled,
          umamiPixelUrl,
          emailPixelTrackingEnabled,
        }),
      });

      const data = (await res.json()) as any;

      if (res.ok) {
        if (statusDiv) {
          statusDiv.className = 'rounded-xl p-4 text-xs font-medium border border-emerald-200 bg-emerald-50 text-emerald-800 block';
          statusDiv.textContent = '✓ All platform, email & analytics tracking settings saved successfully!';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } else {
        if (statusDiv) {
          statusDiv.className = 'rounded-xl p-4 text-xs font-medium border border-red-200 bg-red-50 text-red-700 block';
          statusDiv.textContent = `Error: ${data.error || 'Failed to save settings'}`;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }
    } catch (err: any) {
      if (statusDiv) {
        statusDiv.className = 'rounded-xl p-4 text-xs font-medium border border-red-200 bg-red-50 text-red-700 block';
        statusDiv.textContent = `Network error: ${err.message}`;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    } finally {
      if (saveBtn) {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save All Email Settings';
      }
      if (saveTopBtn) {
        saveTopBtn.disabled = false;
        saveTopBtn.textContent = 'Save All Settings';
      }
    }
  }

  settingsForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleSaveSettings();
  });

  saveTopBtn?.addEventListener('click', handleSaveSettings);

  // OTP Test Dispatcher Handler
  const sendTestOtpBtn = document.getElementById('send-test-otp-btn') as HTMLButtonElement;
  const testOtpTargetInput = document.getElementById('test-otp-target') as HTMLInputElement;
  const testOtpStatusDiv = document.getElementById('test-otp-status') as HTMLDivElement;

  sendTestOtpBtn?.addEventListener('click', async () => {
    const recipient = testOtpTargetInput?.value?.trim();
    if (!recipient) {
      alert('Please enter a recipient email address.');
      return;
    }

    sendTestOtpBtn.disabled = true;
    sendTestOtpBtn.textContent = 'Dispatching OTP...';
    testOtpStatusDiv.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/test-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ recipient, type: 'otp' }),
      });

      const data = (await res.json()) as any;

      if (res.ok && data.success) {
        testOtpStatusDiv.className = 'rounded-xl p-3 text-xs font-medium border border-emerald-200 bg-emerald-50 text-emerald-800 block';
        testOtpStatusDiv.textContent = `✓ ${data.message}`;
      } else {
        testOtpStatusDiv.className = 'rounded-xl p-3 text-xs font-medium border border-red-200 bg-red-50 text-red-700 block';
        testOtpStatusDiv.textContent = `✗ Failed: ${data.error || 'Check Resend logs'}`;
      }
    } catch (err: any) {
      testOtpStatusDiv.className = 'rounded-xl p-3 text-xs font-medium border border-red-200 bg-red-50 text-red-700 block';
      testOtpStatusDiv.textContent = `Network error: ${err.message}`;
    } finally {
      sendTestOtpBtn.disabled = false;
      sendTestOtpBtn.textContent = 'Send Test OTP Email';
    }
  });

  // Welcome Email Test Dispatch Handlers
  document.querySelectorAll<HTMLButtonElement>('.test-dispatcher-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const type = btn.dataset.type || 'welcome';
      const subjectInputId = btn.dataset.subjectId;
      const editorType = btn.dataset.editor || 'welcome';

      const overrideSubject = subjectInputId ? (document.getElementById(subjectInputId) as HTMLInputElement)?.value : undefined;
      const overrideBody = getActiveEditorHtml(editorType);

      const recipient = prompt('Enter recipient email address for this test:', '');
      if (!recipient || !recipient.trim()) return;

      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Dispatching test...';

      try {
        const res = await fetch('/api/admin/test-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            recipient: recipient.trim(),
            type,
            testName: 'Aarav Sharma',
            overrideSubject,
            overrideBody,
          }),
        });

        const data = (await res.json()) as any;

        if (res.ok && data.success) {
          alert(`✓ ${data.message}`);
        } else {
          alert(`✗ Test failed: ${data.error || 'Check Resend configuration'}`);
        }
      } catch (err: any) {
        alert(`Network error: ${err.message}`);
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  });
</script>
