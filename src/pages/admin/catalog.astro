  // Live JSON Validator & Preview Generator
  function validateJsonInput() {
    const rawText = jsonTextarea?.value?.trim();
    jsonImportError?.classList.add('hidden');

    if (!rawText) {
      parsedToolsPayload = [];
      if (jsonStatusBanner) jsonStatusBanner.className = 'rounded-xl border border-border bg-secondary/50 p-3 text-xs flex items-center justify-between';
      if (jsonStatusText) jsonStatusText.textContent = 'Paste a valid JSON tool object or array of tools above.';
