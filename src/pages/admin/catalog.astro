      let cleaned = rawText;
      if (cleaned.startsWith('```')) {
        cleaned = cleaned.replace(/^```[a-z]*\n?/i, '').replace(/\n?```$/, '');
      }

      const parsed = JSON.parse(cleaned);
      let tools: any[] = [];
      if (Array.isArray(parsed)) {
        tools = parsed;
      } else if (Array.isArray(parsed?.tools)) {
        tools = parsed.tools;
      } else if (parsed && typeof parsed === 'object' && parsed.name) {
        tools = [parsed];
      }

      if (!tools.length) {
        throw new Error('JSON is valid syntax, but does not contain tool objects with a "name" property.');
      }

      parsedToolsPayload = tools;

      // Update Live Status
      if (jsonStatusBanner) jsonStatusBanner.className = 'rounded-xl border border-emerald-300 bg-emerald-50 p-3 text-xs flex items-center justify-between';
      if (jsonStatusText) jsonStatusText.innerHTML = `<span class="text-emerald-900 font-medium">✓ Ready to Import: <strong>${tools.length}</strong> tool${tools.length > 1 ? 's' : ''} detected.</span>`;
      if (jsonBadge) {
        jsonBadge.textContent = 'Valid JSON';
        jsonBadge.className = 'font-bold text-[10px] uppercase tracking-wider text-emerald-800 bg-emerald-200/60 px-2 py-0.5 rounded-md';
        jsonBadge.classList.remove('hidden');
      }

      // Render Preview Cards
      if (jsonPreviewContainer && previewCardsList && previewCount) {
        previewCount.textContent = `${tools.length} item${tools.length > 1 ? 's' : ''}`;
        previewCardsList.innerHTML = tools
          .map((t, i) => {
            const name = t.name || `Tool #${i + 1}`;
            const city = t.company?.city || t.city || 'India';
            const cat = t.category || 'General';
            const plansCount = Array.isArray(t.pricingPlans) ? t.pricingPlans.length : 0;
            const prosCount = Array.isArray(t.pros) ? t.pros.length : 0;
            const replaces = Array.isArray(t.replacesGlobalTools) ? t.replacesGlobalTools.join(', ') : 'None';

            return `
              <div class="rounded-lg border border-border bg-white p-3 text-xs flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-foreground text-sm">${name}</span>
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[10px] font-medium text-slate-700">📍 ${city}</span>
                    <span class="rounded-md bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-800 border border-amber-200">${cat}</span>
                  </div>
                  <p class="text-muted-foreground text-[11px]">${t.tagline || 'No tagline'}</p>
                  <div class="flex items-center gap-3 text-[10px] text-muted-foreground pt-1">
                    <span>💵 ${plansCount} Pricing Tier${plansCount === 1 ? '' : 's'}</span>
                    <span>✨ ${prosCount} Superpower${prosCount === 1 ? '' : 's'}</span>
                    <span>🔄 Replaces: <strong class="text-foreground">${replaces}</strong></span>
                  </div>
                </div>
              </div>
            `;
          })
          .join('');

        jsonPreviewContainer.classList.remove('hidden');
      }

      if (submitJsonImportBtn) submitJsonImportBtn.disabled = false;
    } catch (err: any) {
      parsedToolsPayload = [];
      if (jsonStatusBanner) jsonStatusBanner.className = 'rounded-xl border border-red-200 bg-red-50 p-3 text-xs flex items-center justify-between';
      if (jsonStatusText) jsonStatusText.innerHTML = `<span class="text-red-800 font-medium">✕ JSON Error: ${err.message}</span>`;
      if (jsonBadge) {
        jsonBadge.textContent = 'Invalid';
        jsonBadge.className = 'font-bold text-[10px] uppercase tracking-wider text-red-800 bg-red-200 px-2 py-0.5 rounded-md';
        jsonBadge.classList.remove('hidden');
      }
      jsonPreviewContainer?.classList.add('hidden');
      if (submitJsonImportBtn) submitJsonImportBtn.disabled = true;
    }
  }

  jsonTextarea?.addEventListener('input', validateJsonInput);

  // Submit Ingestion
  submitJsonImportBtn?.addEventListener('click', async () => {
    if (!parsedToolsPayload.length) return;

    submitJsonImportBtn.disabled = true;
    submitJsonImportBtn.textContent = 'Importing to D1...';
    if (jsonImportError) jsonImportError.classList.add('hidden');

    try {
      const res = await fetch('/api/admin/tools/import-json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsedToolsPayload),
      });

      const data = (await res.json()) as any;

      if (res.ok && data.success) {
        alert(`🎉 Successfully imported ${data.count} tool(s) and pricing plans to D1!`);
        window.location.reload();
      } else {
        if (jsonImportError) {
          jsonImportError.textContent = data.error || 'Failed to import JSON tools.';
          jsonImportError.classList.remove('hidden');
        }
        submitJsonImportBtn.disabled = false;
        submitJsonImportBtn.textContent = 'Import & Publish to D1';
      }
    } catch {
      if (jsonImportError) {
        jsonImportError.textContent = 'Network error while importing tools.';
        jsonImportError.classList.remove('hidden');
      }
      submitJsonImportBtn.disabled = false;
      submitJsonImportBtn.textContent = 'Import & Publish to D1';
    }
  });
</script>
