<script>
  // Sub-Tab Switcher
  function switchCatalogTab(tabId: string) {
    const validTabs = ['indian-tools', 'global-giants', 'categories'];
    const activeTab = validTabs.includes(tabId) ? tabId : 'indian-tools';

    document.querySelectorAll('.catalog-panel').forEach((p) => {
      if (p.id === `catalog-panel-${activeTab}`) p.classList.remove('hidden');
      else p.classList.add('hidden');
    });

    document.querySelectorAll('.catalog-tab-btn').forEach((btn) => {
      const target = btn.getAttribute('data-catalog-tab');
      if (target === activeTab) {
        btn.className = 'catalog-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-semibold transition cursor-pointer bg-white text-foreground shadow-xs border border-border';
      } else {
        btn.className = 'catalog-tab-btn flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-medium transition cursor-pointer text-muted-foreground hover:text-foreground hover:bg-white/60 border border-transparent';
      }
    });

    if (window.location.hash.replace('#', '') !== activeTab) {
      history.replaceState(null, '', `#${activeTab}`);
    }
  }

  const initialHash = window.location.hash.replace('#', '');
  if (initialHash) switchCatalogTab(initialHash);

  document.querySelectorAll('.catalog-tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-catalog-tab');
      if (target) switchCatalogTab(target);
    });
  });

  // Global Tool Modal Handlers
  const globalModal = document.getElementById('global-tool-modal');
  const openGlobalBtn = document.getElementById('open-create-global-btn');
  const closeGlobalBtn = document.getElementById('close-global-modal');
  const globalForm = document.getElementById('global-tool-form') as HTMLFormElement | null;
  const globalAutofillBtn = document.getElementById('global-autofill-btn') as HTMLButtonElement | null;

  openGlobalBtn?.addEventListener('click', () => {
    globalForm?.reset();
    (document.getElementById('global-tool-id') as HTMLInputElement).value = '';
    (document.getElementById('global-tool-action') as HTMLInputElement).value = 'create';
    (document.getElementById('global-modal-title') as HTMLElement).textContent = 'Add Global Giant (Programmatic SEO)';
    globalModal?.classList.remove('hidden');
  });

  closeGlobalBtn?.addEventListener('click', () => globalModal?.classList.add('hidden'));

  // Global Tool Auto-Slugification
  const globalNameInput = document.getElementById('global-name-input') as HTMLInputElement | null;
  const globalSlugInput = document.getElementById('global-slug-input') as HTMLInputElement | null;
  let globalSlugManuallyEdited = false;

  globalNameInput?.addEventListener('input', () => {
    if (!globalSlugManuallyEdited && globalSlugInput) {
      globalSlugInput.value = globalNameInput.value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');
    }
  });

  globalSlugInput?.addEventListener('input', () => {
    globalSlugManuallyEdited = true;
    globalSlugInput.value = globalSlugInput.value.toLowerCase().trim().replace(/[^a-z0-9-]+/g, '');
  });

  // Global Tool Auto-Fill
  globalAutofillBtn?.addEventListener('click', async () => {
    const urlInput = document.getElementById('global-website-input') as HTMLInputElement;
    const targetUrl = urlInput?.value?.trim();
    if (!targetUrl) {
      alert('Please enter a website URL first.');
      return;
    }

    globalAutofillBtn.disabled = true;
    globalAutofillBtn.textContent = 'Scraping...';

    try {
      const res = await fetch(`/api/admin/scrape?url=${encodeURIComponent(targetUrl)}`);
      const data = (await res.json()) as any;
      if (res.ok && (data.name || data.title)) {
        const scrapedName = data.name || data.title;
        if (globalNameInput) globalNameInput.value = scrapedName;
        if (globalSlugInput && (!globalSlugManuallyEdited || !globalSlugInput.value)) {
          globalSlugInput.value = scrapedName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        }
        if (data.logoUrl) (document.getElementById('global-logo-input') as HTMLInputElement).value = data.logoUrl;
        if (data.tagline) (document.getElementById('global-tagline-input') as HTMLInputElement).value = data.tagline;
        else if (data.description && !(document.getElementById('global-tagline-input') as HTMLInputElement).value) {
          (document.getElementById('global-tagline-input') as HTMLInputElement).value = data.description.slice(0, 100);
        }
      } else {
        alert(data?.error || 'Auto-fill could not scrape this URL. Please enter details manually.');
      }
    } catch {
      alert('Network error while scraping metadata.');
    } finally {
      globalAutofillBtn.disabled = false;
      globalAutofillBtn.textContent = '✨ Auto-Fill';
    }
  });

  // Global Tool Form Submit
  globalForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-global-tool-btn') as HTMLButtonElement;
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const formData = new FormData(globalForm);
    const id = formData.get('id') as string;
    const action = formData.get('action') as string;
    const name = formData.get('name') as string;
    const slug = formData.get('slug') as string;
    const websiteUrl = formData.get('websiteUrl') as string;
    const logoUrl = formData.get('logoUrl') as string;
    const tagline = formData.get('tagline') as string;
    const startingPriceUsd = formData.get('startingPriceUsd') as string;
    const categoryId = formData.get('categoryId') as string;
    const features = formData.get('features') as string;
    const foreignPainPoints = formData.get('foreignPainPoints') as string;
    const mappedDesiToolIds = formData.getAll('mappedDesiToolIds') as string[];

    try {
      const res = await fetch('/api/admin/global-tools', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id,
          action,
          name,
          slug,
          websiteUrl,
          logoUrl,
          tagline,
          startingPriceUsd,
          categoryId,
          features,
          foreignPainPoints,
          mappedDesiToolIds,
        }),
      });

      if (res.ok) {
        window.location.reload();
      } else {
        const err = await res.json() as any;
        alert(err.error || 'Failed to save global tool.');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Global Giant';
      }
    } catch {
      alert('Network error');
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Global Giant';
    }
  });

  // Edit Global Tool
  document.querySelectorAll('[data-edit-global]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const raw = btn.getAttribute('data-edit-global');
      if (!raw) return;
      const g = JSON.parse(raw);

      (document.getElementById('global-tool-id') as HTMLInputElement).value = g.id;
      (document.getElementById('global-tool-action') as HTMLInputElement).value = 'update';
      (document.getElementById('global-modal-title') as HTMLElement).textContent = `Edit ${g.name}`;
      (document.getElementById('global-name-input') as HTMLInputElement).value = g.name || '';
      (document.getElementById('global-slug-input') as HTMLInputElement).value = g.slug || '';
      (document.getElementById('global-website-input') as HTMLInputElement).value = g.websiteUrl || '';
      (document.getElementById('global-logo-input') as HTMLInputElement).value = g.logoUrl || '';
      (document.getElementById('global-tagline-input') as HTMLInputElement).value = g.tagline || '';
      (document.getElementById('global-price-input') as HTMLInputElement).value = g.startingPriceUsd || '';
      const catSelect = document.getElementById('global-category-input') as HTMLSelectElement | null;
      if (catSelect) catSelect.value = g.categoryId || '';

