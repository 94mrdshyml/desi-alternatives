---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import SearchDialog from '@/components/SearchDialog';
import { eq, asc } from 'drizzle-orm';
import { categories, desiTools, globalTools, toolAlternatives, toolPricingPlans } from '@/lib/server/db/schema';

const db = Astro.locals.db;
const { slug } = Astro.params;

if (!slug || !db) {
  return Astro.redirect('/404');
}

let toolResult: any = null;
let alternatives: any[] = [];
let pricingPlans: any[] = [];
let parsedPros: string[] = [];
let parsedCons: string[] = [];
let searchableTools: any[] = [];

try {
  // 1. Fetch tool by slug
  toolResult = await db
    .select({
      id: desiTools.id,
      slug: desiTools.slug,
      name: desiTools.name,
      tagline: desiTools.tagline,
      description: desiTools.description,
      websiteUrl: desiTools.websiteUrl,
      logoUrl: desiTools.logoUrl,
      primaryColor: desiTools.primaryColor,
      categoryId: desiTools.categoryId,
      categorySlug: categories.slug,
      categoryName: categories.name,
      categoryEmoji: categories.emoji,
      hasGstInvoice: desiTools.hasGstInvoice,
      hasIndianDataResidency: desiTools.hasIndianDataResidency,
      hasInrPricing: desiTools.hasInrPricing,
      hasUpiSupport: desiTools.hasUpiSupport,
      isOpenSource: desiTools.isOpenSource,
      hasIstSupport: desiTools.hasIstSupport,
      isSelfHostable: desiTools.isSelfHostable,
      hasFreeTier: desiTools.hasFreeTier,
      pricingModel: desiTools.pricingModel,
      startingPriceInr: desiTools.startingPriceInr,
      claimedById: desiTools.claimedById,
      status: desiTools.status,
      city: desiTools.city,
      state: desiTools.state,
      foundedYear: desiTools.foundedYear,
      companyType: desiTools.companyType,
      githubUrl: desiTools.githubUrl,
      discordUrl: desiTools.discordUrl,
      pros: desiTools.pros,
      cons: desiTools.cons,
      twitterHandle: desiTools.twitterHandle,
      instagramHandle: desiTools.instagramHandle,
      youtubeUrl: desiTools.youtubeUrl,
      facebookUrl: desiTools.facebookUrl,
      linkedinUrl: desiTools.linkedinUrl,
    })
    .from(desiTools)
    .leftJoin(categories, eq(desiTools.categoryId, categories.id))
    .where(eq(desiTools.slug, slug))
    .get();

  if (toolResult) {
    // 2. Fetch alternative mappings
    const rawAlternatives = await db
      .select({
        name: globalTools.name,
        slug: globalTools.slug,
        websiteUrl: globalTools.websiteUrl,
        logoUrl: globalTools.logoUrl,
      })
      .from(toolAlternatives)
      .leftJoin(globalTools, eq(toolAlternatives.globalToolId, globalTools.id))
      .where(eq(toolAlternatives.desiToolId, toolResult.id))
      .all();

    alternatives = rawAlternatives;

    // 3. Fetch tool pricing plans
    pricingPlans = await db
      .select()
      .from(toolPricingPlans)
      .where(eq(toolPricingPlans.toolId, toolResult.id))
      .orderBy(asc(toolPricingPlans.sortOrder))
      .all();

    // 4. Parse pros & cons JSON arrays
    try {
      if (toolResult.pros) parsedPros = JSON.parse(toolResult.pros);
    } catch {}

    try {
      if (toolResult.cons) parsedCons = JSON.parse(toolResult.cons);
    } catch {}
  }
} catch (e) {
  console.error('Error fetching tool details:', e);
}

if (!toolResult) {
  return Astro.redirect('/404');
}

// Generate fallback deterministic brand colors if primaryColor is missing
const brandColor = toolResult.primaryColor || '#D97706';
---

<BaseLayout
  title={`${toolResult.name} — Indian Alternative to ${alternatives.map((a: any) => a.name).join(', ') || 'Global Giants'}`}
  description={`${toolResult.name}: ${toolResult.tagline}. Indian alternative to global giants with INR billing, GST compliance, and local data residency.`}
  ogImage={toolResult.logoUrl && !toolResult.logoUrl.endsWith('.ico') ? toolResult.logoUrl : '/og-default.png'}
  ogType="product"
>
  <Navbar />
  <SearchDialog client:idle tools={searchableTools} />

  <!-- Breadcrumb Bar -->
  <div class="border-b border-border/80 bg-white/60">
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-muted-foreground">
        <a href="/" class="hover:text-foreground transition">Home</a>
        <span>/</span>
        <a href={`/category/${toolResult.categorySlug}`} class="hover:text-foreground transition">
          {toolResult.categoryEmoji} {toolResult.categoryName}
        </a>
        <span>/</span>
        <span class="font-medium text-foreground">{toolResult.name}</span>
      </nav>
    </div>
  </div>  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Unified Hero Card: Cover Banner + Profile Information -->
    <div class="rounded-2xl border border-border bg-white shadow-xs overflow-hidden">
      <!-- Dynamic Logo-Based Gradient Cover Banner -->
      <div
        id="tool-cover-banner"
        class="relative h-36 sm:h-48 w-full overflow-hidden transition-all duration-700"
        style={`background: linear-gradient(135deg, ${brandColor}30 0%, ${brandColor}12 45%, #FFFFFF 100%);`}
      >
        <!-- Geometric subtle grid overlay -->
        <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-40"></div>

        <!-- Vibrant Ambient Mesh Glows -->
        <div
          id="glow-sphere-1"
          class="absolute -top-10 -left-10 h-44 w-44 rounded-full blur-3xl opacity-40 transition-colors duration-700"
          style={`background-color: ${brandColor};`}
        ></div>
        <div
          id="glow-sphere-2"
          class="absolute -bottom-8 right-8 h-36 w-36 rounded-full blur-2xl opacity-25 transition-colors duration-700"
          style={`background-color: ${brandColor};`}
        ></div>

        <!-- Category Pill on Top Right of Cover -->
        <div class="absolute top-4 right-4 z-10">
          <a
            href={`/category/${toolResult.categorySlug}`}
            class="inline-flex items-center gap-1.5 rounded-full bg-white/90 backdrop-blur-md px-3 py-1 text-xs font-semibold text-foreground shadow-xs border border-white/70 hover:bg-white transition"
          >
            <span>{toolResult.categoryEmoji}</span>
            <span>{toolResult.categoryName}</span>
          </a>
        </div>
      </div>

      <!-- Tool Profile Body (With Overlapping Logo & Clean Alignment) -->
      <div class="px-5 sm:px-7 pb-6 pt-0">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
          <!-- Left Column: Logo + Name + Tagline + Socials -->
          <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-5">
            <!-- Logo with Overlap & White Ring -->
            <div class="relative -mt-12 sm:-mt-14 flex h-24 w-24 sm:h-28 sm:w-28 shrink-0 items-center justify-center rounded-2xl border-4 border-white bg-white p-2.5 shadow-md">
              <img
                id="tool-logo-img"
                src={toolResult.logoUrl}
                alt={`${toolResult.name} logo`}
                crossorigin="anonymous"
                class="h-full w-full object-contain"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="hidden h-full w-full items-center justify-center text-2xl font-bold text-foreground">
                {toolResult.name.slice(0, 2).toUpperCase()}
              </div>
            </div>

            <!-- Titles, Badges, Tagline, Socials -->
            <div class="pt-1 sm:pt-2">
              <div class="flex flex-wrap items-center gap-2.5">
                <h1 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">
                  {toolResult.name}
                </h1>

                <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground">
                  {toolResult.pricingModel}
                </span>

                {toolResult.startingPriceInr !== null && (
                  <span class="inline-flex items-center rounded-md bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 border border-emerald-200">
                    {toolResult.startingPriceInr === 0 ? 'Free tier' : `From ₹${toolResult.startingPriceInr.toLocaleString('en-IN')}/mo`}
                  </span>
                )}
              </div>

              <p class="mt-1 text-sm sm:text-base font-medium text-muted-foreground">
                {toolResult.tagline}
              </p>

              <!-- Company Origins & DNA Badges -->
              {(toolResult.city || toolResult.foundedYear || toolResult.companyType || toolResult.isOpenSource || toolResult.githubUrl || toolResult.discordUrl) && (
                <div class="mt-2.5 flex flex-wrap items-center gap-1.5 text-xs">
                  {toolResult.city && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-700">
                      <span>📍</span>
                      <span>{toolResult.city}{toolResult.state ? `, ${toolResult.state}` : ''}</span>
                    </span>
                  )}
                  {toolResult.foundedYear && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-700">
                      <span>📅</span>
                      <span>Est. {toolResult.foundedYear}</span>
                    </span>
                  )}
                  {toolResult.companyType && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-0.5 font-medium text-amber-900 border border-amber-200">
                      <span>🏢</span>
                      <span>{toolResult.companyType}</span>
                    </span>
                  )}
                  {toolResult.isOpenSource && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-0.5 font-bold text-emerald-800 border border-emerald-200">
                      <span>⚡</span>
                      <span>Open Source</span>
                    </span>
                  )}
                  {toolResult.githubUrl && (
                    <a
                      href={toolResult.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded-full bg-slate-900 px-2.5 py-0.5 font-medium text-white hover:bg-slate-800 transition"
                    >
                      <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                      </svg>
                      <span>GitHub</span>
                    </a>
                  )}
                  {toolResult.discordUrl && (
                    <a
                      href={toolResult.discordUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded-full bg-indigo-50 px-2.5 py-0.5 font-medium text-indigo-700 border border-indigo-200 hover:bg-indigo-100 transition"
                    >
                      <span>💬 Community</span>
                    </a>
                  )}
                </div>
              )}

              <!-- Social Media Links Row -->
              <div class="mt-3.5 flex flex-wrap items-center gap-2">
                {toolResult.twitterHandle && (
                  <a
                    href={`https://x.com/${toolResult.twitterHandle}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-medium text-foreground/80 hover:border-slate-400 hover:text-foreground transition shadow-2xs"
                  >
                    <svg class="h-3.5 w-3.5 text-foreground" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                    <span>@{toolResult.twitterHandle}</span>
                  </a>
                )}

                {toolResult.youtubeUrl && (
                  <a
                    href={toolResult.youtubeUrl.startsWith('http') ? toolResult.youtubeUrl : `https://youtube.com/${toolResult.youtubeUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-medium text-foreground/80 hover:border-red-300 hover:text-red-600 transition shadow-2xs"
                  >
                    <svg class="h-3.5 w-3.5 text-red-600" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                    <span>YouTube</span>
                  </a>
                )}

                {toolResult.instagramHandle && (
                  <a
                    href={`https://instagram.com/${toolResult.instagramHandle}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-medium text-foreground/80 hover:border-pink-300 hover:text-pink-600 transition shadow-2xs"
                  >
                    <svg class="h-3.5 w-3.5 text-pink-600" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                    <span>Instagram</span>
                  </a>
                )}

                {toolResult.facebookUrl && (
                  <a
                    href={toolResult.facebookUrl.startsWith('http') ? toolResult.facebookUrl : `https://facebook.com/${toolResult.facebookUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-medium text-foreground/80 hover:border-blue-300 hover:text-blue-600 transition shadow-2xs"
                  >
                    <svg class="h-3.5 w-3.5 text-blue-600" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                    <span>Facebook</span>
                  </a>
                )}

                {toolResult.linkedinUrl && (
                  <a
                    href={toolResult.linkedinUrl.startsWith('http') ? toolResult.linkedinUrl : `https://linkedin.com/company/${toolResult.linkedinUrl}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-white px-2.5 py-1 text-xs font-medium text-foreground/80 hover:border-sky-300 hover:text-sky-700 transition shadow-2xs"
                  >
                    <svg class="h-3.5 w-3.5 text-sky-700" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
                    </svg>
                    <span>LinkedIn</span>
                  </a>
                )}
              </div>
            </div>
          </div>

          <!-- Right Column: Action CTAs -->
          <div class="flex items-center gap-2.5 pt-2 sm:pt-3 shrink-0">
            <a
              href={toolResult.websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-outbound-tool={toolResult.slug}
              class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
            >
              <span>Visit Website</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>

            <button
              type="button"
              id="claim-tool-btn"
              class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-white px-4 py-2.5 text-xs font-semibold text-foreground shadow-2xs hover:border-primary/40 hover:bg-slate-50 transition cursor-pointer"
            >
              <svg class="h-4 w-4 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Claim Tool</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Layout -->
    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
      <!-- Left Column (2 Cols): Description, Pros/Cons, Pricing, Comparison -->
      <div class="space-y-8 lg:col-span-2">
        <!-- Overview Section -->
        <section class="rounded-2xl border border-border bg-white p-6 shadow-xs">
          <h2 class="text-base font-bold text-foreground">About {toolResult.name}</h2>
          <p class="mt-3 text-sm leading-relaxed text-foreground/80">
            {toolResult.description}
          </p>
        </section>

        <!-- Honest Pros & Superpowers / Considerations & Limitations -->
        {(parsedPros.length > 0 || parsedCons.length > 0) && (
          <section class="rounded-2xl border border-border bg-white p-6 shadow-xs">
            <h2 class="text-base font-bold text-foreground">Editorial Review & Superpowers</h2>
            <p class="mt-1 text-xs text-muted-foreground">Honest insights into why Indian teams choose {toolResult.name}, along with current tradeoffs.</p>

            <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
              <!-- Pros Column -->
              {parsedPros.length > 0 && (
                <div class="rounded-xl border border-emerald-200/80 bg-emerald-50/40 p-4">
                  <div class="flex items-center gap-2 text-emerald-900 font-bold text-xs uppercase tracking-wider">
                    <span>✨</span>
                    <span>Top Strengths & Superpowers</span>
                  </div>
                  <ul class="mt-3 space-y-2.5 text-xs text-foreground/90">
                    {parsedPros.map((pro) => (
                      <li class="flex items-start gap-2">
                        <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                        <span class="leading-relaxed">{pro}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <!-- Cons Column -->
              {parsedCons.length > 0 && (
                <div class="rounded-xl border border-amber-200/80 bg-amber-50/40 p-4">
                  <div class="flex items-center gap-2 text-amber-900 font-bold text-xs uppercase tracking-wider">
                    <span>⚠️</span>
                    <span>Honest Tradeoffs & Considerations</span>
                  </div>
                  <ul class="mt-3 space-y-2.5 text-xs text-foreground/90">
                    {parsedCons.map((con) => (
                      <li class="flex items-start gap-2">
                        <span class="text-amber-600 font-bold shrink-0 mt-0.5">•</span>
                        <span class="leading-relaxed">{con}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}

        <!-- Multi-Tier Pricing Plans Grid -->
        {pricingPlans.length > 0 && (
          <section class="rounded-2xl border border-border bg-white p-6 shadow-xs">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-base font-bold text-foreground">Transparent Pricing Plans</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">Direct ₹ INR billing with 18% GST input credit eligibility.</p>
              </div>
