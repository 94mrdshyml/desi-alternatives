            <option value="5" selected>5/5 - Instant & helpful</option>
            <option value="4">4/5 - Responsive</option>
            <option value="3">3/5 - Standard</option>
            <option value="2">2/5 - Slow</option>
            <option value="1">1/5 - Ineffective</option>
          </select>
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-muted-foreground mb-1">DPDP Residency</label>
          <select name="dataResidencyRating" class="w-full rounded-lg border border-border bg-white px-2 py-1 text-xs text-foreground">
            <option value="5" selected>5/5 - Verified Indian Cloud</option>
            <option value="4">4/5 - Compliant</option>
            <option value="3">3/5 - Multi-region</option>
            <option value="2">2/5 - Partial</option>
            <option value="1">1/5 - Global default</option>
          </select>
        </div>
      </div>

      <!-- Author Metadata -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
        <div>
          <label class="block text-[11px] font-semibold text-foreground mb-1">Your Name</label>
          <input
            type="text"
            name="authorName"
            value={user?.name || ''}
            placeholder="e.g. Vikram Joshi"
            class="w-full rounded-xl border border-border px-2.5 py-1.5 text-xs text-foreground"
          />
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-foreground mb-1">Your Role / Title</label>
          <input
            type="text"
            name="authorRole"
            placeholder="e.g. DevOps Engineer"
            class="w-full rounded-xl border border-border px-2.5 py-1.5 text-xs text-foreground"
          />
        </div>

        <div>
          <label class="block text-[11px] font-semibold text-foreground mb-1">Company / Team</label>
          <input
            type="text"
            name="authorCompany"
            placeholder="e.g. SaaS Startup"
            class="w-full rounded-xl border border-border px-2.5 py-1.5 text-xs text-foreground"
          />
        </div>
      </div>

      <div id="review-form-status" class="hidden text-xs rounded-lg p-2.5"></div>

      <div class="pt-3 border-t border-border flex items-center justify-end gap-2.5">
        <button
          type="button"
          id="cancel-review-btn"
          class="rounded-xl border border-border bg-white px-4 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submit-review-btn"
          class="rounded-xl bg-primary px-5 py-2 text-xs font-bold text-primary-foreground hover:bg-primary-hover transition cursor-pointer shadow-xs"
        >
          Publish Review
        </button>
      </div>
    </form>
  </dialog>

  <Footer />
</BaseLayout>

<script>
  // 1. Dynamic Canvas Dominant Color Extractor from Tool Logo
  const logoImg = document.getElementById('tool-logo-img') as HTMLImageElement | null;
  const coverBanner = document.getElementById('tool-cover-banner');
  const glowSphere1 = document.getElementById('glow-sphere-1');
  const glowSphere2 = document.getElementById('glow-sphere-2');

  function extractDominantColor(img: HTMLImageElement) {
    try {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      canvas.width = 32;
      canvas.height = 32;
      ctx.drawImage(img, 0, 0, 32, 32);

      const imageData = ctx.getImageData(0, 0, 32, 32).data;
      let r = 0, g = 0, b = 0, count = 0;

      for (let i = 0; i < imageData.length; i += 16) {
        const pr = imageData[i];
        const pg = imageData[i + 1];
        const pb = imageData[i + 2];
        const a = imageData[i + 3];

        if (a > 128 && !(pr > 240 && pg > 240 && pb > 240) && !(pr < 20 && pg < 20 && pb < 20)) {
          r += pr;
          g += pg;
          b += pb;
          count++;
        }
      }

      if (count > 0) {
        const avgR = Math.round(r / count);
        const avgG = Math.round(g / count);
        const avgB = Math.round(b / count);
        const hexColor = `#${((1 << 24) + (avgR << 16) + (avgG << 8) + avgB).toString(16).slice(1)}`;

        if (coverBanner) {
          coverBanner.style.background = `linear-gradient(135deg, rgba(${avgR}, ${avgG}, ${avgB}, 0.22) 0%, rgba(${avgR}, ${avgG}, ${avgB}, 0.08) 50%, #FFFFFF 100%)`;
        }
        if (glowSphere1) glowSphere1.style.backgroundColor = hexColor;
        if (glowSphere2) glowSphere2.style.backgroundColor = hexColor;
      }
    } catch {
      // Graceful fallback to server-rendered CSS gradient
    }
  }

  if (logoImg) {
    if (logoImg.complete && logoImg.naturalHeight !== 0) {
      extractDominantColor(logoImg);
    } else {
      logoImg.addEventListener('load', () => extractDominantColor(logoImg));
    }
  }

  // 2. Claim Tool Action
  const claimBtn = document.getElementById('claim-tool-btn');
  if (claimBtn) {
    claimBtn.addEventListener('click', () => {
      alert('To claim this tool as founder/owner, submit your official work email matching the domain on the claim form.');
    });
  }

  // 3. Review Modal Dialog Controls
  const reviewModal = document.getElementById('review-modal') as HTMLDialogElement | null;
  const openReviewBtn = document.getElementById('open-review-modal-btn');
  const closeReviewBtn = document.getElementById('close-review-modal-btn');
  const cancelReviewBtn = document.getElementById('cancel-review-btn');
  const reviewForm = document.getElementById('submit-review-form') as HTMLFormElement | null;
  const ratingInput = document.getElementById('rating-input') as HTMLInputElement | null;
  const ratingLabel = document.getElementById('star-rating-label');
  const starBtns = document.querySelectorAll<HTMLButtonElement>('.star-btn');
  const formStatus = document.getElementById('review-form-status');
  const submitReviewBtn = document.getElementById('submit-review-btn') as HTMLButtonElement | null;

  function updateStars(val: number) {
    if (ratingInput) ratingInput.value = String(val);
    const labels: Record<number, string> = {
      1: '1 Star (Poor)',
      2: '2 Stars (Fair)',
      3: '3 Stars (Good)',
      4: '4 Stars (Very Good)',
      5: '5 Stars (Excellent)',
    };
    if (ratingLabel) ratingLabel.textContent = labels[val] || `${val} Stars`;

    starBtns.forEach((btn) => {
      const btnVal = Number(btn.getAttribute('data-value') || 0);
      if (btnVal <= val) {
        btn.classList.add('text-amber-400');
        btn.classList.remove('text-slate-300');
      } else {
        btn.classList.remove('text-amber-400');
        btn.classList.add('text-slate-300');
      }
    });
  }

  updateStars(5);

  starBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const val = Number(btn.getAttribute('data-value') || 5);
      updateStars(val);
    });
  });

  if (openReviewBtn && reviewModal) {
    openReviewBtn.addEventListener('click', () => {
      reviewModal.showModal();
    });
  }

  if (closeReviewBtn && reviewModal) {
    closeReviewBtn.addEventListener('click', () => {
      reviewModal.close();
    });
  }

  if (cancelReviewBtn && reviewModal) {
    cancelReviewBtn.addEventListener('click', () => {
      reviewModal.close();
    });
  }

  // 4. Submit Review Form Handler
  if (reviewForm) {
    reviewForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitReviewBtn) return;

      submitReviewBtn.disabled = true;
      submitReviewBtn.textContent = 'Publishing...';
      if (formStatus) {
        formStatus.className = 'hidden text-xs rounded-lg p-2.5';
      }

      const formData = new FormData(reviewForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/reviews/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = (await res.json()) as any;
        if (!res.ok) {
          throw new Error(data.error || 'Failed to submit review.');
        }

        if (formStatus) {
          formStatus.className = 'block text-xs rounded-lg p-2.5 bg-emerald-50 text-emerald-800 border border-emerald-200';
          formStatus.textContent = '✓ Review published successfully! Thank you for supporting Indian software.';
        }

        setTimeout(() => {
          if (reviewModal) reviewModal.close();
          window.location.reload();
        }, 1200);
      } catch (err: any) {
        if (formStatus) {
          formStatus.className = 'block text-xs rounded-lg p-2.5 bg-red-50 text-red-700 border border-red-200';
          formStatus.textContent = err.message || 'Error publishing review.';
        }
      } finally {
        submitReviewBtn.disabled = false;
        submitReviewBtn.textContent = 'Publish Review';
      }
    });
  }

  // 5. Helpful Vote Handler
  document.querySelectorAll<HTMLButtonElement>('.helpful-vote-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const reviewId = btn.getAttribute('data-review-id');
      if (!reviewId) return;

      try {
        btn.disabled = true;
        const res = await fetch('/api/reviews/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reviewId }),
        });
        const data = (await res.json()) as any;
        if (res.ok) {
          const countSpan = btn.querySelector('.helpful-count');
          if (countSpan && data.helpfulCount !== undefined) {
            countSpan.textContent = String(data.helpfulCount);
          }
          btn.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-300');
        }
      } catch (e) {
        console.error('Failed to register vote:', e);
      }
    });
  });
</script>
