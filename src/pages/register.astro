---
import BaseLayout from '@/layouts/BaseLayout.astro';

// If user is already logged in, redirect home
const user = Astro.locals.user;
if (user) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title="Create Account — Desi Alternatives"
  description="Create your free Desi Alternatives account to submit tools, claim profiles, write reviews, and explore sovereign Indian software."
>
  <main class="flex min-h-screen flex-col justify-center px-4 py-12 sm:px-6 lg:px-8 bg-gradient-to-b from-amber-500/[0.03] via-slate-50 to-white">
    <!-- Back to Directory Navigation -->
    <div class="sm:mx-auto sm:w-full sm:max-w-md mb-4 text-left">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition group"
      >
        <svg class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Directory</span>
      </a>
    </div>

    <!-- Header & Brand -->
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
      <a href="/" class="inline-flex items-center gap-2 text-2xl font-bold tracking-tight text-foreground">
        <span>Desi</span>
        <span class="font-serif-editorial italic text-primary">Alternatives</span>
        <span class="rounded bg-amber-100 px-1.5 py-0.2 text-[10px] font-bold text-amber-800 border border-amber-200">
          🇮🇳 Bharat
        </span>
      </a>
      <h1 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl text-foreground">
        Join the <span class="font-serif-editorial italic font-normal text-primary">Movement</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-muted-foreground">
        Create your free account with a 6-digit email verification code
      </p>
    </div>

    <div class="mt-7 sm:mx-auto sm:w-full sm:max-w-md">
      <div class="rounded-3xl border border-border/80 bg-white/95 p-6 sm:p-8 shadow-xl shadow-amber-500/5 backdrop-blur-sm">
        <!-- Status Messages -->
        <div id="error-message" class="hidden mb-5 rounded-xl border border-red-200 bg-red-50 p-3.5 text-xs text-red-700 font-medium"></div>
        <div id="info-message" class="hidden mb-5 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 font-medium"></div>

        <!-- Step 1: Name, Email & Agreements Form -->
        <form id="register-step-form" class="space-y-4">
          <!-- Full Name -->
          <div>
            <label for="name-input" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              Full Name *
            </label>
            <div class="relative mt-1.5">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input
                id="name-input"
                name="name"
                type="text"
                autocomplete="name"
                required
                placeholder="Rohan Sharma"
                class="block w-full rounded-xl border border-border bg-white pl-10 pr-3.5 py-2.5 text-xs sm:text-sm text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
              />
            </div>
          </div>

          <!-- Work Email -->
          <div>
            <label for="email-input" class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              Work or Personal Email *
            </label>
            <div class="relative mt-1.5">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <input
                id="email-input"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder="name@company.in"
                class="block w-full rounded-xl border border-border bg-white pl-10 pr-3.5 py-2.5 text-xs sm:text-sm text-foreground placeholder:text-muted-foreground/60 shadow-2xs focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 transition"
              />
            </div>
            <p class="mt-1.5 text-[11px] text-muted-foreground">
              We'll send a 6-digit numeric verification code to this address.
            </p>
          </div>

          <!-- Checkboxes Container -->
          <div class="space-y-3 pt-2 border-t border-border/60">
            <!-- 1. Mandatory Terms & Privacy Checkbox -->
            <label class="flex items-start gap-2.5 cursor-pointer select-none group">
              <input
                type="checkbox"
                id="terms-checkbox"
                name="terms"
                required
                class="mt-0.5 h-4 w-4 rounded border-border text-primary focus:ring-primary/20 accent-primary cursor-pointer shrink-0"
              />
              <span class="text-xs text-muted-foreground leading-relaxed">
                I accept the <a href="/terms" target="_blank" class="font-semibold text-foreground hover:text-primary underline underline-offset-2">Terms of Service</a> and <a href="/privacy" target="_blank" class="font-semibold text-foreground hover:text-primary underline underline-offset-2">Privacy Policy</a>. <span class="text-red-500 font-bold">*</span>
              </span>
            </label>

            <!-- 2. Newsletter Opt-in Checkbox (Optional, Checked by default) -->
            <label class="flex items-start gap-2.5 cursor-pointer select-none group">
              <input
                type="checkbox"
                id="newsletter-opt-in"
                name="newsletterOptIn"
                checked
                class="mt-0.5 h-4 w-4 rounded border-border text-primary focus:ring-primary/20 accent-primary cursor-pointer shrink-0"
              />
              <span class="text-xs text-muted-foreground leading-relaxed">
                Subscribe to <strong class="text-foreground">Desi Alternatives Dispatch</strong> — weekly sovereign SaaS teardowns & tech blueprints.
              </span>
            </label>
          </div>

          <div>
            <button
              type="submit"
              id="send-code-btn"
              class="flex w-full justify-center items-center gap-2 rounded-xl bg-primary px-4 py-2.5 text-xs sm:text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition cursor-pointer disabled:opacity-50"
            >
              <span>Send 6-Digit Code</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </div>
        </form>

        <!-- Step 2: 6-Digit OTP Entry (Initially Hidden) -->
        <div id="otp-step-container" class="hidden space-y-5">
          <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-3.5 text-center">
            <p class="text-xs text-amber-900 font-medium">
              Code sent to <strong id="display-email" class="text-foreground font-bold"></strong>
            </p>
            <button
              type="button"
              id="change-email-btn"
              class="mt-1 text-[11px] font-semibold text-primary hover:underline cursor-pointer"
            >
              Edit email or name
            </button>
          </div>

          <div>
            <label class="block text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2.5">
              Enter 6-Digit Verification Code
            </label>

            <!-- 6 Individual Numeric Boxes -->
            <div class="flex justify-between gap-1.5 sm:gap-2">
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="one-time-code" data-index="0" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-index="1" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-index="2" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-index="3" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-index="4" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
              <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" data-index="5" class="otp-box h-12 w-11 sm:h-13 sm:w-12 text-center font-mono text-xl font-bold rounded-xl border border-border bg-white text-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none shadow-2xs transition" />
            </div>
          </div>

          <button
            type="button"
            id="verify-code-btn"
            class="flex w-full justify-center rounded-xl bg-primary px-4 py-2.5 text-xs sm:text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition cursor-pointer disabled:opacity-50"
          >
            Verify & Create Account
          </button>

          <div class="text-center text-xs text-muted-foreground">
            Didn't receive the code?{' '}
            <button
              type="button"
              id="resend-code-btn"
              class="font-semibold text-primary hover:underline cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Resend Code
            </button>
          </div>
        </div>

        <!-- Cross Link to Sign In -->
        <div class="mt-6 border-t border-border pt-5 text-center text-xs text-muted-foreground">
          Already have an account?{' '}
          <a href="/login" class="font-semibold text-primary hover:underline">
            Sign in
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { authClient } from '@/lib/auth-client';

    const registerForm = document.getElementById('register-step-form') as HTMLFormElement;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const emailInput = document.getElementById('email-input') as HTMLInputElement;
    const termsCheckbox = document.getElementById('terms-checkbox') as HTMLInputElement;
    const newsletterOptIn = document.getElementById('newsletter-opt-in') as HTMLInputElement | null;
    const sendCodeBtn = document.getElementById('send-code-btn') as HTMLButtonElement;
    const otpContainer = document.getElementById('otp-step-container') as HTMLDivElement;
    const displayEmail = document.getElementById('display-email') as HTMLElement;
    const changeEmailBtn = document.getElementById('change-email-btn') as HTMLButtonElement;
    const verifyBtn = document.getElementById('verify-code-btn') as HTMLButtonElement;
    const resendBtn = document.getElementById('resend-code-btn') as HTMLButtonElement;
    const errorDiv = document.getElementById('error-message') as HTMLDivElement;
    const infoDiv = document.getElementById('info-message') as HTMLDivElement;
    const otpBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.otp-box'));

    let currentEmail = '';
    let resendTimer: any = null;
    let resendCountdown = 30;

    function showError(msg: string) {
      if (infoDiv) infoDiv.classList.add('hidden');
      if (errorDiv) {
        errorDiv.textContent = msg;
        errorDiv.classList.remove('hidden');
      }
    }

    function showInfo(msg: string) {
      if (errorDiv) errorDiv.classList.add('hidden');
      if (infoDiv) {
        infoDiv.textContent = msg;
        infoDiv.classList.remove('hidden');
      }
    }

    function clearMessages() {
      if (errorDiv) errorDiv.classList.add('hidden');
      if (infoDiv) infoDiv.classList.add('hidden');
    }

    function getEnteredOtp(): string {
      return otpBoxes.map((b) => b.value.trim()).join('');
    }

    function startResendCountdown() {
      resendCountdown = 30;
      if (resendBtn) {
        resendBtn.disabled = true;
        resendBtn.textContent = `Resend in ${resendCountdown}s`;
      }
      clearInterval(resendTimer);
      resendTimer = setInterval(() => {
        resendCountdown--;
        if (resendCountdown <= 0) {
          clearInterval(resendTimer);
          if (resendBtn) {
            resendBtn.disabled = false;
            resendBtn.textContent = 'Resend Code';
          }
        } else {
          if (resendBtn) {
            resendBtn.textContent = `Resend in ${resendCountdown}s`;
          }
        }
      }, 1000);
    }

    // Step 1: Send OTP
    async function handleSendOtp() {
      const email = emailInput.value.trim();
      const name = nameInput.value.trim();

      if (!name) {
        showError('Please enter your full name.');
        return;
      }

      if (!email) {
        showError('Please enter your work or personal email.');
        return;
      }

      if (!termsCheckbox.checked) {
        showError('You must agree to the Terms of Service and Privacy Policy to create an account.');
        termsCheckbox.focus();
        return;
      }

      if (name) {
        try {
          localStorage.setItem('desi_pending_name', name);
        } catch {}
      }

      clearMessages();
      sendCodeBtn.disabled = true;
      sendCodeBtn.textContent = 'Sending 6-digit code...';

      try {
        const res = await authClient.emailOtp.sendVerificationOtp({
          email,
          type: 'sign-in',
        });

        if (res.error) {
          showError(res.error.message || 'Failed to send verification code.');
          sendCodeBtn.disabled = false;
          sendCodeBtn.textContent = 'Send 6-Digit Code';
          return;
        }

        currentEmail = email;
        displayEmail.textContent = email;
        registerForm.classList.add('hidden');
        otpContainer.classList.remove('hidden');
        showInfo('6-digit code sent! Check your inbox (and spam folder).');
        startResendCountdown();

        // Focus first box
        otpBoxes[0]?.focus();
      } catch (err: any) {
        showError(err.message || 'Something went wrong. Please try again.');
        sendCodeBtn.disabled = false;
        sendCodeBtn.textContent = 'Send 6-Digit Code';
      }
    }

    registerForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSendOtp();
    });

    changeEmailBtn?.addEventListener('click', () => {
      otpContainer.classList.add('hidden');
      registerForm.classList.remove('hidden');
      clearMessages();
      sendCodeBtn.disabled = false;
      sendCodeBtn.textContent = 'Send 6-Digit Code';
      emailInput.focus();
    });

    resendBtn?.addEventListener('click', async () => {
      if (!currentEmail || resendCountdown > 0) return;
      clearMessages();
      resendBtn.disabled = true;
      resendBtn.textContent = 'Sending...';

      try {
        const res = await authClient.emailOtp.sendVerificationOtp({
          email: currentEmail,
          type: 'sign-in',
        });

        if (res.error) {
          showError(res.error.message || 'Failed to resend verification code.');
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Code';
        } else {
          showInfo('Fresh 6-digit code sent!');
          startResendCountdown();
          otpBoxes.forEach((b) => (b.value = ''));
          otpBoxes[0]?.focus();
        }
      } catch (err: any) {
        showError(err.message || 'Failed to resend code.');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Resend Code';
      }
    });

    // Step 2: Verify OTP
    async function handleVerifyOtp() {
      const otp = getEnteredOtp();
      if (otp.length !== 6) {
        showError('Please enter the complete 6-digit code.');
        return;
      }

      clearMessages();
      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying & Creating Account...';

      try {
        const res = await authClient.signIn.emailOtp({
          email: currentEmail,
          otp,
        });

        if (res.error) {
          showError(res.error.message || 'Invalid or expired verification code.');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Verify & Create Account';
          otpBoxes.forEach((b) => (b.value = ''));
          otpBoxes[0]?.focus();
          return;
        }

        const pendingName = localStorage.getItem('desi_pending_name') || '';

        // Dispatch User Registration Welcome Email (non-blocking)
        try {
          await fetch('/api/auth/welcome', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: currentEmail,
              name: pendingName,
            }),
          });
        } catch (e) {
          // Non-blocking
        }

        // Handle newsletter subscription if opted in
        if (newsletterOptIn?.checked) {
          try {
            await fetch('/api/newsletter/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: currentEmail,
                name: pendingName,
                source: 'registration',
              }),
            });
          } catch (e) {
            // Non-blocking for registration flow
          }
        }

        showInfo('Verified successfully! Redirecting...');
        window.location.href = '/';
      } catch (err: any) {
        showError(err.message || 'Verification failed. Please check the code.');
        verifyBtn.disabled = false;
        verifyBtn.textContent = 'Verify & Create Account';
      }
    }

    verifyBtn?.addEventListener('click', handleVerifyOtp);

    // Auto-advance and paste handling for OTP boxes
    otpBoxes.forEach((box, idx) => {
      box.addEventListener('input', (e: Event) => {
        const target = e.target as HTMLInputElement;
        const val = target.value.replace(/\D/g, '');
        target.value = val.slice(0, 1);

        if (val && idx < otpBoxes.length - 1) {
          otpBoxes[idx + 1].focus();
        }

        if (getEnteredOtp().length === 6) {
          handleVerifyOtp();
        }
      });

      box.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Backspace' && !box.value && idx > 0) {
          otpBoxes[idx - 1].focus();
        }
        if (e.key === 'Enter') {
          handleVerifyOtp();
        }
      });

      box.addEventListener('paste', (e: ClipboardEvent) => {
        e.preventDefault();
        const pasted = e.clipboardData?.getData('text') || '';
        const digits = pasted.replace(/\D/g, '').slice(0, 6);

        digits.split('').forEach((d, i) => {
          if (otpBoxes[i]) {
            otpBoxes[i].value = d;
          }
        });

        if (digits.length === 6) {
          otpBoxes[5].focus();
          handleVerifyOtp();
        } else if (digits.length > 0 && digits.length < 6) {
          otpBoxes[digits.length].focus();
        }
      });
    });
  </script>
</BaseLayout>
