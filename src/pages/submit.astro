---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import { categories } from '@/lib/server/db/schema';

const db = Astro.locals.db;
const user = Astro.locals.user;

let categoriesList: any[] = [];

if (db) {
  try {
    categoriesList = await db.select().from(categories).all();
  } catch (e) {
    console.error('Failed to load form dependencies:', e);
  }
}
---

<BaseLayout title="Submit an Indian Product — Desi Alternatives" description="Submit your Indian software, hardware, game, newsletter, or agency to be listed on Desi Alternatives">
  <Navbar />

  <main class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <div class="text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-800">
        <svg class="h-3.5 w-3.5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Founder Submissions
      </span>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-foreground">
        List your <span class="font-serif-editorial italic text-primary">Indian product</span>
      </h1>
      <p class="mt-2 text-sm text-muted-foreground">
        Join the homegrown ecosystem replacing global giants across software, developer tools, hardware, games, newsletters, and agencies.
      </p>
    </div>

    {!user && (
      <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4 text-center text-xs text-amber-900">
        <span>You are currently not signed in. Please </span>
        <a href="/login" class="font-bold underline hover:text-amber-950">Sign In</a>
        <span> or </span>
        <a href="/register" class="font-bold underline hover:text-amber-950">Create an Account</a>
        <span> before submitting to manage and claim your listing.</span>
      </div>
    )}

    <form id="submit-tool-form" class="mt-8 space-y-6 rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-xs">
      <!-- Tool Name & Website -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-semibold text-foreground">Tool Name *</label>
          <input
            type="text"
            id="tool-name-input"
            name="name"
            required
            placeholder="e.g. SigNoz"
            class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
          />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <label class="block text-xs font-semibold text-foreground">Website URL *</label>
            <button
              type="button"
              id="submit-autofill-btn"
              class="text-[11px] font-semibold text-primary hover:text-primary-hover flex items-center gap-1 cursor-pointer"
            >
              ✨ <span>Auto-Fill Details</span>
            </button>
          </div>
          <input
            type="url"
            id="submit-website-input"
            name="websiteUrl"
            required
            placeholder="https://signoz.io"
            class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
          />
        </div>
      </div>

      <!-- Tagline -->
      <div>
        <label class="block text-xs font-semibold text-foreground">Tagline (One sentence summary) *</label>
        <input
          type="text"
          name="tagline"
          required
          placeholder="Open-source APM, Tracing, Logs and Metrics built for scale"
          class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
        />
      </div>

      <!-- Logo Upload to R2 or URL -->
      <div>
        <label class="block text-xs font-semibold text-foreground">Tool Logo (Upload to R2 or paste URL)</label>
        <div class="mt-1 flex items-center gap-3">
          <input
            type="file"
            id="logo-file-input"
            accept="image/*"
            class="text-xs text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border file:border-border file:text-xs file:font-semibold file:bg-slate-50 file:text-foreground hover:file:bg-slate-100 cursor-pointer"
          />
          <input
            type="hidden"
            name="logoUrl"
            id="logo-url-hidden"
          />
          <span id="upload-status" class="text-[11px] text-muted-foreground"></span>
        </div>
      </div>

      <!-- Description -->
      <div>
        <label class="block text-xs font-semibold text-foreground">Detailed Description</label>
        <textarea
          name="description"
          rows="3"
          placeholder="Describe how your software operates, key features, and domestic advantages..."
          class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
        ></textarea>
      </div>

      <!-- Category & Pricing Model -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-xs font-semibold text-foreground">Primary Category *</label>
          <select
            name="categoryId"
            required
            class="mt-1 w-full rounded-xl border border-border bg-white px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
          >
            <option value="">Select a category...</option>
            {categoriesList.map((cat) => (
              <option value={cat.id}>{cat.emoji} {cat.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-foreground">Pricing Model *</label>
          <select
            name="pricingModel"
            required
            class="mt-1 w-full rounded-xl border border-border bg-white px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
          >
            <option value="Freemium">Freemium (Free tier available)</option>
            <option value="Free">100% Free</option>
            <option value="Paid">Paid Only</option>
            <option value="Open-Source">Open-Source</option>
          </select>
        </div>
      </div>

      <!-- Starting Price in INR -->
      <div>
        <label class="block text-xs font-semibold text-foreground">Starting Monthly Price (INR ₹) — Enter 0 if free tier</label>
        <input
          type="number"
          name="startingPriceInr"
          min="0"
          placeholder="0"
          class="mt-1 w-full rounded-xl border border-border px-3.5 py-2 text-xs text-foreground focus:border-primary focus:outline-none"
        />
      </div>

      <!-- Social Media Profiles -->
      <div class="space-y-3 rounded-xl border border-border bg-slate-50/50 p-4">
        <label class="block text-xs font-bold text-foreground">Social & Community Handles</label>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label class="block text-[11px] font-semibold text-foreground">𝕏 / Twitter Handle</label>
            <input
              type="text"
              name="twitterHandle"
              placeholder="e.g. signoz_hq (without @)"
              class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-foreground">YouTube Channel URL</label>
            <input
              type="url"
              name="youtubeUrl"
              placeholder="https://youtube.com/@signoz"
              class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-foreground">Instagram Username</label>
            <input
              type="text"
              name="instagramHandle"
              placeholder="e.g. signoz (without @)"
              class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] font-semibold text-foreground">LinkedIn Company URL</label>
            <input
              type="url"
              name="linkedinUrl"
              placeholder="https://linkedin.com/company/signoz"
              class="mt-1 w-full rounded-xl border border-border bg-white px-3 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
            />
          </div>
        </div>
      </div>

      <!-- Indian Product Checklist -->
      <div>
        <label class="block text-xs font-semibold text-foreground mb-2">Indian Business & Product Checklist (Select all that apply)</label>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="hasIndianDataResidency" class="rounded text-primary focus:ring-primary" />
            <span>India Data Residency (Local Servers)</span>
          </label>

          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="hasGstInvoice" class="rounded text-primary focus:ring-primary" />
            <span>GST Invoices with Input Tax Credit</span>
          </label>

          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="hasInrPricing" class="rounded text-primary focus:ring-primary" />
            <span>Direct INR Billing</span>
          </label>

          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="hasUpiSupport" class="rounded text-primary focus:ring-primary" />
            <span>UPI Payment Support</span>
          </label>

          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="isOpenSource" class="rounded text-primary focus:ring-primary" />
            <span>Open Source Codebase</span>
          </label>

          <label class="flex items-center gap-2 rounded-lg border border-border p-2.5 text-xs text-foreground hover:bg-slate-50 cursor-pointer">
            <input type="checkbox" name="hasIstSupport" class="rounded text-primary focus:ring-primary" />
            <span>IST Dedicated Customer Support</span>
          </label>
        </div>
      </div>

      <!-- Feedback Messages -->
      <div id="submit-error" class="hidden rounded-xl bg-red-50 p-3 text-xs font-medium text-red-700"></div>
      <div id="submit-success" class="hidden rounded-xl bg-emerald-50 p-3 text-xs font-medium text-emerald-700"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-btn"
        class="w-full rounded-xl bg-primary py-3 text-xs font-semibold text-primary-foreground hover:bg-primary-hover shadow-xs transition cursor-pointer"
      >
        Submit Tool for Verification
      </button>
    </form>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('submit-tool-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn');
  const errorBox = document.getElementById('submit-error');
  const successBox = document.getElementById('submit-success');
  const fileInput = document.getElementById('logo-file-input') as HTMLInputElement | null;
  const logoUrlHidden = document.getElementById('logo-url-hidden') as HTMLInputElement | null;
  const uploadStatus = document.getElementById('upload-status');

  // Handle R2 Logo Upload
  if (fileInput && logoUrlHidden && uploadStatus) {
    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      uploadStatus.textContent = 'Uploading to R2...';
      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData,
        });
        const data = (await res.json()) as any;
        if (res.ok && data.url) {
          logoUrlHidden.value = data.url;
          uploadStatus.textContent = 'Logo uploaded to R2!';
        } else {
          uploadStatus.textContent = data.error || 'Upload failed.';
        }
      } catch {
        uploadStatus.textContent = 'Upload network error.';
      }
    });
  }

  // Auto-Fill Metadata Handler
  const autoFillBtn = document.getElementById('submit-autofill-btn');
  if (autoFillBtn) {
    autoFillBtn.addEventListener('click', async () => {
      const websiteInput = document.getElementById('submit-website-input') as HTMLInputElement | null;
      const url = websiteInput?.value?.trim();
      if (!url) {
        alert('Please enter a website URL first.');
        return;
      }

      const originalText = autoFillBtn.innerHTML;
      autoFillBtn.innerHTML = '⏳ <span>Scraping...</span>';

      try {
        const res = await fetch('/api/admin/scrape', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const data = (await res.json()) as any;
        if (res.ok && data) {
          const nameInput = document.getElementById('tool-name-input') as HTMLInputElement | null;
          const taglineInput = document.querySelector('input[name="tagline"]') as HTMLInputElement | null;
          const descInput = document.querySelector('textarea[name="description"]') as HTMLTextAreaElement | null;
          const logoHidden = document.getElementById('logo-url-hidden') as HTMLInputElement | null;
          const uploadStatus = document.getElementById('upload-status');

          if (nameInput && !nameInput.value && data.title) nameInput.value = data.title;
          if (taglineInput && data.description) taglineInput.value = data.description.slice(0, 140);
          if (descInput && data.description) descInput.value = data.description;
          if (logoHidden && data.logoUrl) {
            logoHidden.value = data.logoUrl;
            if (uploadStatus) uploadStatus.textContent = 'Auto-fetched logo favicon!';
          }
          autoFillBtn.innerHTML = '✓ <span>Auto-Filled!</span>';
          setTimeout(() => {
            autoFillBtn.innerHTML = originalText;
          }, 2000);
        } else {
          alert(data.error || 'Failed to auto-fetch metadata');
          autoFillBtn.innerHTML = originalText;
        }
      } catch {
        alert('Network error while scraping URL');
        autoFillBtn.innerHTML = originalText;
      }
    });
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.classList.add('hidden');
      if (successBox) successBox.classList.add('hidden');

      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        websiteUrl: formData.get('websiteUrl'),
        logoUrl: logoUrlHidden?.value || formData.get('logoUrl'),
        tagline: formData.get('tagline'),
        description: formData.get('description'),
        categoryId: formData.get('categoryId'),
        pricingModel: formData.get('pricingModel'),
        startingPriceInr: formData.get('startingPriceInr') ? Number(formData.get('startingPriceInr')) : 0,
        hasIndianDataResidency: formData.get('hasIndianDataResidency') === 'on',
        hasGstInvoice: formData.get('hasGstInvoice') === 'on',
        hasInrPricing: formData.get('hasInrPricing') === 'on',
        hasUpiSupport: formData.get('hasUpiSupport') === 'on',
        isOpenSource: formData.get('isOpenSource') === 'on',
        hasIstSupport: formData.get('hasIstSupport') === 'on',
        twitterHandle: formData.get('twitterHandle'),
        instagramHandle: formData.get('instagramHandle'),
        youtubeUrl: formData.get('youtubeUrl'),
        facebookUrl: formData.get('facebookUrl'),
        linkedinUrl: formData.get('linkedinUrl'),
      };

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Submitting...';
      }

      try {
        const res = await fetch('/api/tools/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = (await res.json()) as any;
        if (!res.ok) {
          throw new Error(data.error || 'Failed to submit tool');
        }

        if (successBox) {
          successBox.textContent = 'Your tool was successfully submitted! It has been added to our moderation queue for verification.';
          successBox.classList.remove('hidden');
          form.reset();
        }
      } catch (err: any) {
        if (errorBox) {
          errorBox.textContent = err.message;
          errorBox.classList.remove('hidden');
        }
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.textContent = 'Submit Tool for Verification';
        }
      }
    });
  }
</script>
