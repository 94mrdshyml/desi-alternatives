---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { eq } from 'drizzle-orm';
import { categories, desiTools, globalTools, toolAlternatives } from '@/lib/server/db/schema';

const db = Astro.locals.db;
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

let currentGlobalTool: any = null;
let allGlobalTools: any[] = [];
let mappedTools: any[] = [];

if (db) {
  try {
    currentGlobalTool = await db
      .select()
      .from(globalTools)
      .where(eq(globalTools.slug, slug))
      .get();

    if (currentGlobalTool) {
      mappedTools = await db
        .select({
          id: desiTools.id,
          slug: desiTools.slug,
          name: desiTools.name,
          tagline: desiTools.tagline,
          description: desiTools.description,
          websiteUrl: desiTools.websiteUrl,
          logoUrl: desiTools.logoUrl,
          primaryColor: desiTools.primaryColor,
          categoryId: desiTools.categoryId,
          categorySlug: categories.slug,
          categoryName: categories.name,
          categoryEmoji: categories.emoji,
          hasGstInvoice: desiTools.hasGstInvoice,
          hasIndianDataResidency: desiTools.hasIndianDataResidency,
          hasInrPricing: desiTools.hasInrPricing,
          hasUpiSupport: desiTools.hasUpiSupport,
          isOpenSource: desiTools.isOpenSource,
          hasIstSupport: desiTools.hasIstSupport,
          isSelfHostable: desiTools.isSelfHostable,
          hasFreeTier: desiTools.hasFreeTier,
          pricingModel: desiTools.pricingModel,
          startingPriceInr: desiTools.startingPriceInr,
        })
        .from(toolAlternatives)
        .innerJoin(desiTools, eq(toolAlternatives.desiToolId, desiTools.id))
        .leftJoin(categories, eq(desiTools.categoryId, categories.id))
        .where(
          eq(toolAlternatives.globalToolId, currentGlobalTool.id)
        )
        .all();
    }

    allGlobalTools = await db
      .select({
        id: globalTools.id,
        name: globalTools.name,
        slug: globalTools.slug,
      })
      .from(globalTools)
      .limit(30)
      .all();
  } catch (e) {
    console.error('Error fetching global tool alternatives:', e);
  }
}

if (!currentGlobalTool) {
  const formattedName = slug
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

  currentGlobalTool = {
    id: `gt_${slug}`,
    name: formattedName,
    slug,
    websiteUrl: `https://${slug}.com`,
    logoUrl: null,
    tagline: null,
    description: null,
    features: null,
    startingPriceUsd: 30,
    pricingPlans: null,
    foreignPainPoints: null,
    pros: null,
    cons: null,
    country: null,
    city: null,
    foundedYear: null,
    companyType: null,
    isOpenSource: false,
    githubUrl: null,
    discordUrl: null,
    twitterHandle: null,
    instagramHandle: null,
    youtubeUrl: null,
    facebookUrl: null,
    linkedinUrl: null,
  };
}

// Parse metadata arrays
let parsedPros: string[] = [];
try {
  if (currentGlobalTool.pros) {
    parsedPros = typeof currentGlobalTool.pros === 'string' 
      ? JSON.parse(currentGlobalTool.pros) 
      : currentGlobalTool.pros;
  }
} catch {}

let parsedCons: string[] = [];
try {
  if (currentGlobalTool.cons) {
    parsedCons = typeof currentGlobalTool.cons === 'string' 
      ? JSON.parse(currentGlobalTool.cons) 
      : currentGlobalTool.cons;
  }
} catch {}

// Fallback to foreignPainPoints if cons is empty
if (parsedCons.length === 0 && currentGlobalTool.foreignPainPoints) {
  try {
    const rawPain = typeof currentGlobalTool.foreignPainPoints === 'string'
      ? JSON.parse(currentGlobalTool.foreignPainPoints)
      : currentGlobalTool.foreignPainPoints;
    if (Array.isArray(rawPain)) parsedCons = rawPain;
  } catch {}
}

let parsedPricingPlans: Array<{ planName?: string; priceUsd?: number | string; billingCycle?: string; highlights?: string[] }> = [];
try {
  if (currentGlobalTool.pricingPlans) {
    parsedPricingPlans = typeof currentGlobalTool.pricingPlans === 'string'
      ? JSON.parse(currentGlobalTool.pricingPlans)
      : currentGlobalTool.pricingPlans;
  }
} catch {}

// SEO Metadata
const pageTitle = `Top Indian Alternatives to ${currentGlobalTool.name} in 2026 — Desi Alternatives`;
const pageDescription = `Looking for sovereign Indian alternatives to ${currentGlobalTool.name}? Compare top homegrown software with ₹ INR pricing, 18% GST invoices, zero forex markups, and local data residency in India.`;

// Schema.org Structured Data
const jsonLdData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Best Indian Alternatives to ${currentGlobalTool.name}`,
    description: pageDescription,
    itemListElement: mappedTools.map((tool, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: tool.name,
        applicationCategory: tool.categoryName || 'BusinessApplication',
        operatingSystem: 'Web, Cloud',
        offers: {
          '@type': 'Offer',
          price: tool.startingPriceInr || 0,
          priceCurrency: 'INR',
        },
        url: `https://da.mrdshyml.xyz/tools/${tool.slug}`,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: `Why should Indian startups look for alternatives to ${currentGlobalTool.name}?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Foreign tools like ${currentGlobalTool.name} bill in USD with unpredictable forex currency fluctuations, 3.5% credit card foreign transaction fees, and lack 18% GST Input Tax Credit invoices. Indian alternatives offer fixed ₹ INR billing, local data residency, and dedicated IST support.`,
        },
      },
      {
        '@type': 'Question',
        name: `Are Indian alternatives to ${currentGlobalTool.name} compliant with Indian DPDP Act?`,
        acceptedAnswer: {
          '@type': 'Answer',
          text: `Yes, homegrown Indian alternatives store and process customer data inside domestic Indian cloud data centers (e.g. AWS Mumbai, Azure Pune, GCP Delhi) ensuring full compliance with India's Digital Personal Data Protection (DPDP) Act.`,
        },
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={`/api/og/alternative/${currentGlobalTool.slug}.png`}
>
  <Navbar />

  <!-- Inject Schema.org JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdData)} />

  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Alternatives', href: '/alternatives' },
        { label: currentGlobalTool.name },
      ]}
      class="mb-6"
    />

    <!-- Hero Header with Circular Logo in H1 -->
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-4 inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-semibold text-amber-900 shadow-2xs">
        <span>🇮🇳</span>
        <span>Sovereign Alternative Directory</span>
      </div>

      <h1 class="flex flex-wrap items-center justify-center gap-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl lg:text-5xl">
        <span>Indian Alternatives to</span>
        <span class="inline-flex items-center gap-2.5 font-serif-editorial italic text-primary">
          <span class="inline-flex h-10 w-10 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-full border border-border bg-white shadow-2xs overflow-hidden p-1.5 align-middle not-italic">
            {currentGlobalTool.logoUrl ? (
              <img
                src={currentGlobalTool.logoUrl}
                alt={currentGlobalTool.name}
                class="h-full w-full object-contain rounded-full"
                loading="eager"
              />
            ) : (
              <span class="text-xs sm:text-sm font-bold text-slate-700 font-sans uppercase">
                {currentGlobalTool.name.slice(0, 2)}
              </span>
            )}
          </span>
          <span>{currentGlobalTool.name}</span>
        </span>
      </h1>

      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
        Discover verified Indian SaaS alternatives to replace {currentGlobalTool.name}. Save on 3.5% foreign transaction markups, claim 18% GST input credit, and keep your data hosted securely in India.
      </p>
    </div>

    <!-- 1. About Global Tool Section -->
    <section class="mt-10 rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-2xs">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 border-b border-border/80 pb-5">
        <div class="flex items-center gap-3.5">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-border bg-slate-50 p-2 overflow-hidden shadow-2xs">
            {currentGlobalTool.logoUrl ? (
              <img src={currentGlobalTool.logoUrl} alt={currentGlobalTool.name} class="h-full w-full object-contain" />
            ) : (
              <span class="text-base font-bold text-foreground uppercase">{currentGlobalTool.name.slice(0, 2)}</span>
            )}
          </div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-xl font-bold text-foreground">About {currentGlobalTool.name}</h2>
              {currentGlobalTool.isOpenSource ? (
                <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">
                  Open Source
                </span>
              ) : (
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700 border border-slate-200">
                  Proprietary Global SaaS
                </span>
              )}
            </div>
            {currentGlobalTool.tagline && (
              <p class="text-xs sm:text-sm text-muted-foreground mt-0.5">{currentGlobalTool.tagline}</p>
            )}
          </div>
        </div>

        {currentGlobalTool.websiteUrl && (
          <a
            href={currentGlobalTool.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl border border-border bg-slate-50 px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-slate-100 transition shadow-2xs shrink-0 self-start"
          >
            <span>Visit {currentGlobalTool.name}</span>
            <svg class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>

      <!-- Description / Overview -->
      <div class="mt-5 text-xs sm:text-sm leading-relaxed text-slate-700">
        {currentGlobalTool.description ? (
          <p class="whitespace-pre-line">{currentGlobalTool.description}</p>
        ) : (
          <p>
            {currentGlobalTool.name} is a global software tool widely used for team collaboration, development, and business operations. Many engineering and business teams in India use {currentGlobalTool.name}, but face high recurring subscription fees in USD, lack of GST tax invoicing, and foreign data hosting.
          </p>
        )}
      </div>

      <!-- Metadata Attributes Bar -->
      <div class="mt-6 flex flex-wrap items-center gap-2 pt-4 border-t border-border/60 text-xs">
        {currentGlobalTool.country && (
          <div class="inline-flex items-center gap-1.5 rounded-lg bg-slate-50 border border-border/80 px-2.5 py-1 text-slate-700">
            <span class="text-muted-foreground">HQ:</span>
            <span class="font-medium">{currentGlobalTool.city ? `${currentGlobalTool.city}, ` : ''}{currentGlobalTool.country}</span>
          </div>
        )}

        {currentGlobalTool.foundedYear && (
          <div class="inline-flex items-center gap-1.5 rounded-lg bg-slate-50 border border-border/80 px-2.5 py-1 text-slate-700">
            <span class="text-muted-foreground">Founded:</span>
            <span class="font-medium">{currentGlobalTool.foundedYear}</span>
          </div>
        )}

        {currentGlobalTool.companyType && (
          <div class="inline-flex items-center gap-1.5 rounded-lg bg-slate-50 border border-border/80 px-2.5 py-1 text-slate-700">
            <span class="text-muted-foreground">Type:</span>
            <span class="font-medium">{currentGlobalTool.companyType}</span>
          </div>
        )}

        {currentGlobalTool.startingPriceUsd !== null && currentGlobalTool.startingPriceUsd !== undefined && (
          <div class="inline-flex items-center gap-1.5 rounded-lg bg-amber-50 border border-amber-200 px-2.5 py-1 text-amber-900 font-semibold">
            <span>Starting Price:</span>
            <span>${currentGlobalTool.startingPriceUsd}/month USD</span>
          </div>
        )}
      </div>

      <!-- Strengths & Pros (if available) -->
      {parsedPros.length > 0 && (
        <div class="mt-5 pt-4 border-t border-border/60">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-2 text-muted-foreground">
            Key Strengths
          </h3>
          <div class="flex flex-wrap gap-2">
            {parsedPros.map((pro) => (
              <span class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-200 bg-emerald-50/70 px-2.5 py-1 text-xs font-medium text-emerald-900">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>{pro}</span>
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Pricing Plans Breakdown (if available) -->
      {parsedPricingPlans.length > 0 && (
        <div class="mt-5 pt-4 border-t border-border/60">
          <h3 class="text-xs font-bold text-foreground uppercase tracking-wider mb-2.5 text-muted-foreground">
            {currentGlobalTool.name} Pricing Tiers
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            {parsedPricingPlans.map((plan) => (
              <div class="rounded-xl border border-border bg-slate-50/70 p-3 text-xs">
                <div class="flex items-center justify-between">
                  <span class="font-bold text-foreground">{plan.planName || 'Plan'}</span>
                  <span class="font-mono font-semibold text-primary">
                    {plan.priceUsd !== undefined && plan.priceUsd !== null
                      ? plan.priceUsd === 0 || plan.priceUsd === '0'
                        ? 'Free'
                        : typeof plan.priceUsd === 'number'
                          ? `$${plan.priceUsd}${plan.billingCycle ? ` / ${plan.billingCycle}` : '/mo'}`
                          : plan.priceUsd
                      : 'Custom'}
                  </span>
                </div>
                {plan.highlights && plan.highlights.length > 0 && (
                  <ul class="mt-2 space-y-1 text-[11px] text-muted-foreground">
                    {plan.highlights.map((h) => (
                      <li class="flex items-start gap-1">
                        <span class="text-slate-400">•</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- 2. Ranked List of Indian Alternatives -->
    <section class="mt-12">
      <div class="flex items-center justify-between pb-4">
        <div>
          <h2 class="text-xl font-bold text-foreground">
            Ranked Indian Alternatives to {currentGlobalTool.name} ({mappedTools.length})
          </h2>
          <p class="text-xs text-muted-foreground">Homegrown sovereign products ready to replace {currentGlobalTool.name}</p>
        </div>
      </div>

      {mappedTools.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-border py-16 text-center bg-white shadow-2xs">
          <div class="text-2xl mb-2">🇮🇳</div>
          <p class="text-sm font-semibold text-foreground">No mapped Indian alternatives to {currentGlobalTool.name} yet.</p>
          <p class="mt-1 text-xs text-muted-foreground">Are you building an Indian software product that replaces {currentGlobalTool.name}?</p>
          <a
            href="/submit"
            class="mt-4 inline-flex items-center rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition cursor-pointer"
          >
            Submit an Indian Alternative
          </a>
        </div>
      ) : (
        <div class="space-y-5">
          {mappedTools.map((tool, index) => {
            return (
              <div class="rounded-2xl border border-border bg-white p-5 sm:p-6 shadow-xs hover:border-border/80 transition">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-border/80 pb-4">
                  <div class="flex items-center gap-3.5">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-xs font-bold text-slate-700">
                      #{index + 1}
                    </span>
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-border bg-slate-50 p-1.5 overflow-hidden">
                      {tool.logoUrl ? (
                        <img src={tool.logoUrl} alt={tool.name} class="h-full w-full object-contain" />
                      ) : (
                        <span class="text-sm font-bold text-foreground">{tool.name.slice(0, 2).toUpperCase()}</span>
                      )}
                    </div>
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <a href={`/tools/${tool.slug}`} class="text-lg font-bold text-foreground hover:text-primary transition">
                          {tool.name}
                        </a>
                        <span class="rounded-md bg-secondary px-2 py-0.5 text-[11px] font-semibold text-secondary-foreground">
                          {tool.pricingModel}
                        </span>
                        {tool.hasFreeTier && (
                          <span class="rounded-md bg-emerald-50 px-2 py-0.5 text-[11px] font-bold text-emerald-800 border border-emerald-200">
                            Free tier
                          </span>
                        )}
                        {tool.isOpenSource && (
                          <span class="rounded-md bg-sky-50 px-2 py-0.5 text-[11px] font-bold text-sky-800 border border-sky-200">
                            Open Source
                          </span>
                        )}
                      </div>
                      <p class="text-xs text-muted-foreground">{tool.tagline}</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-2 shrink-0">
                    <a
                      href={`/tools/${tool.slug}`}
                      class="rounded-xl border border-border bg-white px-4 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition shadow-2xs"
                    >
                      View Details & Review
                    </a>
                    <a
                      href={tool.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-primary-foreground hover:bg-primary-hover transition shadow-2xs"
                    >
                      <span>Visit Website</span>
                      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>

                <!-- Why Choose Callout & Pricing Box -->
                <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                  <div class="sm:col-span-2 rounded-xl bg-slate-50 p-3.5">
                    <p class="font-semibold text-foreground">Why choose {tool.name} over {currentGlobalTool.name}?</p>
                    <p class="mt-1 text-muted-foreground leading-relaxed">
                      {tool.description || `${tool.name} is an Indian software solution offering local data residency, direct ₹ INR billing, and seamless customer support.`}
                    </p>
                    <div class="mt-2.5 flex flex-wrap gap-2 text-[11px]">
                      {tool.hasGstInvoice && (
                        <span class="inline-flex items-center gap-1 text-emerald-700 font-medium">
                          <span>✓</span> 18% GST Tax Invoice
                        </span>
                      )}
                      {tool.hasIndianDataResidency && (
                        <span class="inline-flex items-center gap-1 text-blue-700 font-medium">
                          <span>✓</span> India Data Residency
                        </span>
                      )}
                      {tool.hasInrPricing && (
                        <span class="inline-flex items-center gap-1 text-amber-800 font-medium">
                          <span>✓</span> Fixed INR Billing
                        </span>
                      )}
                    </div>
                  </div>

                  <div class="rounded-xl bg-emerald-50/60 border border-emerald-100 p-3.5 flex flex-col justify-between">
                    <div>
                      <p class="font-semibold text-emerald-900">Pricing Advantage</p>
                      <p class="mt-1 text-xs font-bold text-emerald-800">
                        {tool.startingPriceInr !== null
                          ? tool.startingPriceInr === 0
                            ? 'Free Tier Available'
                            : `From ₹${tool.startingPriceInr.toLocaleString('en-IN')}/mo`
                          : 'Custom Indian Enterprise Pricing'}
                      </p>
                    </div>
                    <p class="mt-2 text-[11px] text-emerald-700">✓ No foreign currency conversion fee</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>

    <!-- 3. Cons & Limitations of Global Tool (Stored in DB) -->
    {parsedCons.length > 0 && (
      <section class="mt-12 rounded-2xl border border-rose-200/80 bg-rose-50/40 p-6 sm:p-8">
        <div class="flex items-center gap-2.5">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-700">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-rose-950">
              Limitations & Cons of {currentGlobalTool.name}
            </h2>
            <p class="text-xs text-rose-800/80">
              Common friction points and pain points reported by Indian engineering & business teams:
            </p>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {parsedCons.map((con) => (
            <div class="flex items-start gap-2.5 rounded-xl border border-rose-200/70 bg-white/80 p-3.5 text-xs text-rose-900 shadow-2xs">
              <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-600 font-bold text-[10px] mt-0.5">
                ✕
              </span>
              <span class="leading-relaxed font-medium">{con}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Frequently Asked Questions -->
    <section class="mt-12 rounded-2xl border border-border bg-white p-6 sm:p-8 shadow-xs">
      <h2 class="text-lg font-bold text-foreground">Frequently Asked Questions</h2>
      <div class="mt-5 space-y-4 text-xs">
        <div class="border-b border-border/80 pb-3">
          <h3 class="font-bold text-foreground text-sm">Why should Indian companies look for alternatives to {currentGlobalTool.name}?</h3>
          <p class="mt-1.5 text-muted-foreground leading-relaxed">
            Foreign tools bill in USD with unpredictable forex currency fluctuations, 3.5% credit card foreign transaction fees, and lack 18% GST Input Tax Credit invoices. Indian alternatives offer fixed ₹ INR billing, local data residency, and dedicated IST support.
          </p>
        </div>

        <div class="border-b border-border/80 pb-3">
          <h3 class="font-bold text-foreground text-sm">Are Indian alternatives compliant with India's DPDP Act?</h3>
          <p class="mt-1.5 text-muted-foreground leading-relaxed">
            Yes. Homegrown Indian alternatives store and process customer data inside domestic Indian cloud data centers (e.g. AWS Mumbai, Azure Pune, GCP Delhi) ensuring full compliance with India's Digital Personal Data Protection (DPDP) regulations and RBI data localization guidelines.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-foreground text-sm">How easy is it to migrate from {currentGlobalTool.name}?</h3>
          <p class="mt-1.5 text-muted-foreground leading-relaxed">
            Most Indian alternative tools support standard export/import protocols, OpenTelemetry pipelines, or automated migration assistants to make transitioning from foreign SaaS seamless.
          </p>
        </div>
      </div>
    </section>

    <!-- Other Global Tools Quick Links -->
    {allGlobalTools.length > 0 && (
      <section class="mt-10 rounded-2xl border border-border bg-white p-6 shadow-2xs">
        <h3 class="text-xs font-bold text-foreground uppercase tracking-wider text-muted-foreground">
          Compare Other Global SaaS Products
        </h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {allGlobalTools.map((gt) => (
            <a
              href={`/alternatives/${gt.slug}`}
              class={`inline-flex items-center gap-1.5 rounded-xl border px-3 py-1.5 text-xs font-medium transition ${
                gt.slug === slug
                  ? 'border-primary bg-primary/10 text-primary font-bold shadow-2xs'
                  : 'border-border bg-white text-muted-foreground hover:border-primary/40 hover:text-foreground'
              }`}
            >
              <span>{gt.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
