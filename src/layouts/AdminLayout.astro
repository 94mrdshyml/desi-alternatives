---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  currentSection: 'catalog' | 'moderation' | 'blog' | 'analytics' | 'settings';
  counts?: {
    tools?: number;
    globalTools?: number;
    categories?: number;
    claims?: number;
    users?: number;
    posts?: number;
    drafts?: number;
  };
}

const {
  title = 'Admin Control Center — Desi Alternatives',
  description = 'Manage directory catalog, global alternatives, moderation queue, analytics, and platform settings.',
  currentSection,
  counts = {},
} = Astro.props;

const user = Astro.locals.user;
const avatarUrl = user
  ? user.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(user.name || 'Admin')}`
  : null;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-slate-50/60 flex flex-col lg:flex-row">
    <!-- Mobile Admin Top Bar -->
    <div class="lg:hidden sticky top-0 z-40 flex h-14 items-center justify-between border-b border-border bg-white px-4 shadow-2xs">
      <a href="/" class="flex items-center gap-2 text-base font-bold text-foreground">
        <span>Desi</span>
        <span class="font-serif-editorial italic text-primary">{user?.role === 'author' ? 'Writer Studio' : 'Admin'}</span>
      </a>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="mobile-sidebar-toggle"
          class="rounded-lg border border-border p-1.5 text-muted-foreground hover:text-foreground cursor-pointer"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Left Sidebar (Desktop Fixed / Mobile Slide-over Drawer) -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 hidden lg:flex w-64 flex-col border-r border-border bg-white transition-transform duration-200 ease-in-out"
    >
      <!-- Sidebar Header -->
      <div class="flex h-16 shrink-0 items-center justify-between border-b border-border px-5">
        <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-foreground">
          <span>Desi</span>
          <span class="font-serif-editorial italic text-primary">{user?.role === 'author' ? 'Studio' : 'Alternatives'}</span>
          <span class={`rounded px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wider ${
            user?.role === 'author' ? 'bg-indigo-100 text-indigo-800' : 'bg-amber-100 text-amber-800'
          }`}>
            {user?.role === 'author' ? 'Author' : 'Admin'}
          </span>
        </a>

        <button
          type="button"
          id="mobile-sidebar-close"
          class="lg:hidden text-muted-foreground hover:text-foreground p-1 cursor-pointer"
        >
          ✕
        </button>
      </div>

      <!-- Sidebar Navigation Menu -->
      <div class="flex flex-1 flex-col justify-between overflow-y-auto px-3 py-5">
        <div class="space-y-6">
          <!-- Primary Navigation Sections -->
          <div>
            <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-wider text-muted-foreground/70">
              {user?.role === 'author' ? 'Editorial Studio' : 'Management'}
            </div>
            <nav class="space-y-1">
              {user?.role === 'admin' && (
                <!-- Item 1: Catalog -->
                <a
                  href="/admin/catalog"
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                    currentSection === 'catalog'
                      ? 'bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs font-bold'
                      : 'text-muted-foreground hover:bg-slate-50 hover:text-foreground'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <svg class={`h-4 w-4 ${currentSection === 'catalog' ? 'text-primary' : 'text-muted-foreground'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                    <span>Catalog & Tools</span>
                  </div>
                  {counts.tools !== undefined && (
                    <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                      currentSection === 'catalog' ? 'bg-primary/20 text-primary' : 'bg-secondary text-muted-foreground'
                    }`}>
                      {counts.tools}
                    </span>
                  )}
                </a>

                <!-- Item 2: Moderation -->
                <a
                  href="/admin/moderation"
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                    currentSection === 'moderation'
                      ? 'bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs font-bold'
                      : 'text-muted-foreground hover:bg-slate-50 hover:text-foreground'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <svg class={`h-4 w-4 ${currentSection === 'moderation' ? 'text-primary' : 'text-muted-foreground'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    <span>Moderation & Users</span>
                  </div>
                  {counts.claims !== undefined && counts.claims > 0 ? (
                    <span class="rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold text-white animate-pulse">
                      {counts.claims}
                    </span>
                  ) : counts.users !== undefined ? (
                    <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                      currentSection === 'moderation' ? 'bg-primary/20 text-primary' : 'bg-secondary text-muted-foreground'
                    }`}>
                      {counts.users}
                    </span>
                  ) : null}
                </a>
              )}

              <!-- Item 3: Blog & Editorial -->
              <a
                href="/admin/blog"
                class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                  currentSection === 'blog'
                    ? 'bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs font-bold'
                    : 'text-muted-foreground hover:bg-slate-50 hover:text-foreground'
                }`}
              >
                <div class="flex items-center gap-2.5">
                  <svg class={`h-4 w-4 ${currentSection === 'blog' ? 'text-primary' : 'text-muted-foreground'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                  <span>Blog & Articles</span>
                </div>
                {counts.drafts !== undefined && counts.drafts > 0 ? (
                  <span class="rounded-full bg-amber-500/15 border border-amber-300 px-2 py-0.5 text-[10px] font-bold text-amber-900">
                    {counts.drafts} draft{counts.drafts > 1 ? 's' : ''}
                  </span>
                ) : counts.posts !== undefined ? (
                  <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
                    currentSection === 'blog' ? 'bg-primary/20 text-primary' : 'bg-secondary text-muted-foreground'
                  }`}>
                    {counts.posts}
                  </span>
                ) : null}
              </a>

              {user?.role === 'admin' && (
                <!-- Item 4: Analytics -->
                <a
                  href="/admin/analytics"
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                    currentSection === 'analytics'
                      ? 'bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs font-bold'
                      : 'text-muted-foreground hover:bg-slate-50 hover:text-foreground'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <svg class={`h-4 w-4 ${currentSection === 'analytics' ? 'text-primary' : 'text-muted-foreground'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span>Analytics</span>
                  </div>
                  <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-800 border border-emerald-200">
                    Live
                  </span>
                </a>

                <!-- Item 5: Settings -->
                <a
                  href="/admin/settings"
                  class={`flex items-center justify-between rounded-xl px-3 py-2.5 text-xs font-semibold transition ${
                    currentSection === 'settings'
                      ? 'bg-amber-50 text-amber-900 border border-amber-200/80 shadow-2xs font-bold'
                      : 'text-muted-foreground hover:bg-slate-50 hover:text-foreground'
                  }`}
                >
                  <div class="flex items-center gap-2.5">
                    <svg class={`h-4 w-4 ${currentSection === 'settings' ? 'text-primary' : 'text-muted-foreground'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Settings</span>
                  </div>
                </a>
              )}
            </nav>
          </div>
        </div>

        <!-- Sidebar Footer: Admin Profile & Back to Site Link -->
        <div class="border-t border-border pt-4 space-y-3">
          <a
            href="/"
            class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-foreground/80 hover:bg-slate-100 hover:text-foreground transition"
          >
            <svg class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Back to Public Directory</span>
          </a>

          {user && (
            <div class="flex items-center gap-2.5 rounded-xl border border-border bg-slate-50/80 p-2.5">
              <img
                src={avatarUrl || ''}
                alt={user.name || 'Admin'}
                class="h-8 w-8 rounded-full bg-amber-100 object-cover"
              />
              <div class="min-w-0 flex-1">
                <p class="truncate text-xs font-bold text-foreground">{user.name}</p>
                <p class="truncate text-[10px] text-muted-foreground">{user.email}</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </aside>

    <!-- Main Workspace Content Canvas -->
    <div class="lg:pl-64 flex flex-1 flex-col min-w-0">
      <main class="flex-1 px-4 py-8 sm:px-6 lg:px-8 max-w-7xl w-full mx-auto">
        <slot />
      </main>
    </div>
  </div>

  <!-- Global Toast Notification Container -->
  <div id="admin-toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

  <!-- Global Custom Confirmation Modal -->
  <div id="admin-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs">
    <div class="relative w-full max-w-md rounded-2xl border border-border bg-white p-6 shadow-2xl animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-start gap-3">
        <div id="admin-confirm-icon" class="h-10 w-10 shrink-0 rounded-xl bg-red-50 text-red-600 flex items-center justify-center font-bold text-lg border border-red-100">
          ⚠️
        </div>
        <div class="space-y-1">
          <h3 id="admin-confirm-title" class="text-sm font-bold text-foreground">Confirm Action</h3>
          <p id="admin-confirm-message" class="text-xs text-muted-foreground leading-relaxed"></p>
        </div>
      </div>
      <div class="mt-6 flex items-center justify-end gap-2">
        <button id="admin-confirm-cancel-btn" type="button" class="rounded-xl border border-border px-3.5 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition cursor-pointer">
          Cancel
        </button>
        <button id="admin-confirm-action-btn" type="button" class="rounded-xl bg-red-600 px-4 py-2 text-xs font-semibold text-white hover:bg-red-700 shadow-xs transition cursor-pointer">
          Confirm
        </button>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('mobile-sidebar-toggle');
    const closeBtn = document.getElementById('mobile-sidebar-close');
    const sidebar = document.getElementById('admin-sidebar');

    if (toggleBtn && sidebar) {
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('flex');
      });
    }

    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', () => {
        sidebar.classList.add('hidden');
        sidebar.classList.remove('flex');
      });
    }

    // Global Toast Notification Helper
    (window as any).showToast = (message: string, type: 'success' | 'error' | 'info' = 'info') => {
      const container = document.getElementById('admin-toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center gap-2.5 rounded-xl border p-3 shadow-lg text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 ${
        type === 'success'
          ? 'bg-emerald-950 text-emerald-100 border-emerald-800'
          : type === 'error'
          ? 'bg-red-950 text-red-100 border-red-800'
          : 'bg-slate-900 text-white border-slate-700'
      }`;

      const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
      toast.innerHTML = `<span class="shrink-0 font-bold">${icon}</span><span class="flex-1">${message}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    // Global Confirm Dialog Helper
    (window as any).showConfirmDialog = ({
      title = 'Confirm Action',
      message = 'Are you sure you want to proceed?',
      confirmText = 'Confirm',
      isDestructive = true,
    }: {
      title?: string;
      message?: string;
      confirmText?: string;
      isDestructive?: boolean;
    }): Promise<boolean> => {
      return new Promise((resolve) => {
        const modal = document.getElementById('admin-confirm-modal');
        const titleEl = document.getElementById('admin-confirm-title');
        const msgEl = document.getElementById('admin-confirm-message');
        const actionBtn = document.getElementById('admin-confirm-action-btn') as HTMLButtonElement | null;
        const cancelBtn = document.getElementById('admin-confirm-cancel-btn');
        const iconEl = document.getElementById('admin-confirm-icon');

        if (!modal || !titleEl || !msgEl || !actionBtn || !cancelBtn) {
          resolve(false);
          return;
        }

        titleEl.textContent = title;
        msgEl.textContent = message;
        actionBtn.textContent = confirmText;
        if (isDestructive) {
          actionBtn.className = 'rounded-xl bg-red-600 px-4 py-2 text-xs font-semibold text-white hover:bg-red-700 shadow-xs transition cursor-pointer';
          if (iconEl) {
            iconEl.className = 'h-10 w-10 shrink-0 rounded-xl bg-red-50 text-red-600 flex items-center justify-center font-bold text-lg border border-red-100';
            iconEl.textContent = '⚠️';
          }
        } else {
          actionBtn.className = 'rounded-xl bg-primary px-4 py-2 text-xs font-semibold text-white hover:bg-primary-hover shadow-xs transition cursor-pointer';
          if (iconEl) {
            iconEl.className = 'h-10 w-10 shrink-0 rounded-xl bg-amber-50 text-primary flex items-center justify-center font-bold text-lg border border-amber-100';
            iconEl.textContent = 'ℹ️';
          }
        }

        const handleConfirm = () => {
          cleanup();
          resolve(true);
        };

        const handleCancel = () => {
          cleanup();
          resolve(false);
        };

        const cleanup = () => {
          modal.classList.add('hidden');
          actionBtn.removeEventListener('click', handleConfirm);
          cancelBtn.removeEventListener('click', handleCancel);
        };

        actionBtn.addEventListener('click', handleConfirm);
        cancelBtn.addEventListener('click', handleCancel);
        modal.classList.remove('hidden');
      });
    };
  </script>
</BaseLayout>
