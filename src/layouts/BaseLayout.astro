---
import '../styles/global.css';
import AnalyticsTracker from '@/components/AnalyticsTracker.astro';
import SearchDialog from '@/components/SearchDialog';
import CookieConsent from '@/components/CookieConsent.astro';
import { siteSettings } from '@/lib/server/db/schema';
import { eq } from 'drizzle-orm';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  canonicalUrl?: string;
  twitterCreator?: string;
}

const {
  title = 'Desi Alternatives — Indian Alternatives to Global Giants',
  description = 'Discover Indian software, developer tools, hardware, games, newsletters, and agencies built to replace global giants with INR pricing, UPI support, and GST invoicing.',
  ogImage = '/og-default.png',
  ogType = 'website',
  twitterCreator = '@desialts',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (Astro.url.origin || 'https://desialternatives.in');
const canonicalUrl = Astro.props.canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();

const rawOgImage = ogImage || '/og-default.png';
const absoluteOgImage = rawOgImage.startsWith('http')
  ? rawOgImage
  : new URL(rawOgImage.startsWith('/') ? rawOgImage : `/${rawOgImage}`, siteUrl).toString();

let imageMimeType = 'image/png';
if (absoluteOgImage.includes('.jpg') || absoluteOgImage.includes('.jpeg')) {
  imageMimeType = 'image/jpeg';
} else if (absoluteOgImage.includes('.webp')) {
  imageMimeType = 'image/webp';
} else if (absoluteOgImage.includes('.svg')) {
  imageMimeType = 'image/svg+xml';
}

let gtmId = (import.meta as any).env?.PUBLIC_GTM_ID || '';
let gtmEnabled = Boolean(gtmId);
let umamiWebsiteId = (import.meta as any).env?.PUBLIC_UMAMI_WEBSITE_ID || '';
let umamiScriptUrl = (import.meta as any).env?.PUBLIC_UMAMI_SCRIPT_URL || 'https://cloud.umami.is/script.js';
let umamiEnabled = Boolean(umamiWebsiteId);
let umamiPixelUrl = (import.meta as any).env?.PUBLIC_UMAMI_PIXEL_URL || '';
let umamiPixelEnabled = Boolean(umamiPixelUrl);
let consentBannerEnabled = true;

const db = Astro.locals.db;
const isLoggedIn = Boolean(Astro.locals.user);

if (db) {
  try {
    const settings = await db.select().from(siteSettings).where(eq(siteSettings.id, 'general')).get();
    if (settings) {
      if (settings.gtmEnabled !== undefined) gtmEnabled = settings.gtmEnabled === true;
      if (settings.gtmId) gtmId = settings.gtmId;
      if (settings.umamiEnabled !== undefined) umamiEnabled = settings.umamiEnabled === true;
      if (settings.umamiWebsiteId) umamiWebsiteId = settings.umamiWebsiteId;
      if (settings.umamiScriptUrl) umamiScriptUrl = settings.umamiScriptUrl;
      if (settings.umamiPixelEnabled !== undefined) umamiPixelEnabled = settings.umamiPixelEnabled === true;
      if (settings.umamiPixelUrl) umamiPixelUrl = settings.umamiPixelUrl;
      if (settings.consentBannerEnabled !== undefined) consentBannerEnabled = settings.consentBannerEnabled !== false;
    }
  } catch {
    // Graceful fallback if settings table not yet populated in preview/test
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph Protocol (Facebook, LinkedIn, Discord, Telegram, WhatsApp) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Desi Alternatives" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content={imageMimeType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@desialts" />
    <meta name="twitter:creator" content={twitterCreator} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Google Fonts: Source Serif 4 & Instrument Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600;1,8..60,700&display=swap"
      rel="stylesheet"
    />

    <!-- Google Consent Mode v2 (Advanced Mode Default State) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // 1. Establish default consent state before GTM / Google tags load
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });

      // 2. Immediately restore if previously saved
      try {
        var savedConsent = localStorage.getItem('da_consent');
        if (savedConsent === 'allowed') {
          gtag('consent', 'update', {
            'ad_storage': 'granted',
            'ad_user_data': 'granted',
            'ad_personalization': 'granted',
            'analytics_storage': 'granted'
          });
        }
      } catch (e) {}
    </script>

    <!-- Cove Analytics Beacon -->
    <script
      is:inline
      defer
      data-site="site_ZT6YGWsWRGZ7c97NHXKDAqEK"
      src="https://cove-ingest-beacon.mridu.workers.dev/script.js"
    ></script>

    <!-- Umami Analytics (Cookieless & DPDP Compliant) -->
    {umamiEnabled && umamiWebsiteId && (
      <script
        is:inline
        defer
        src={umamiScriptUrl}
        data-website-id={umamiWebsiteId}
      ></script>
    )}

    <!-- Google Tag Manager -->
    {gtmEnabled && gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer',gtmId);
      </script>
    )}
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <!-- Google Tag Manager (noscript fallback) -->
    {gtmEnabled && gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <!-- Umami Pixel (Cookieless noscript tracking) -->
    {umamiPixelEnabled && umamiPixelUrl && (
      <noscript>
        <img
          src={umamiPixelUrl}
          width="1"
          height="1"
          style="display:none;visibility:hidden;"
          alt=""
        />
      </noscript>
    )}

    <slot />
    <SearchDialog client:load />
    <AnalyticsTracker />
    {consentBannerEnabled && <CookieConsent isLoggedIn={isLoggedIn} />}
  </body>
</html>
