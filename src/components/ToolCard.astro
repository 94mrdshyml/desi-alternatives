---
interface Props {
  tool: {
    id: string;
    slug: string;
    name: string;
    tagline: string;
    description: string;
    websiteUrl: string;
    logoUrl: string;
    primaryColor: string;
    categoryName?: string;
    hasGstInvoice: boolean;
    hasIndianDataResidency: boolean;
    hasInrPricing: boolean;
    hasUpiSupport: boolean;
    isOpenSource: boolean;
    hasIstSupport: boolean;
    isSelfHostable: boolean;
    hasFreeTier: boolean;
    pricingModel: string;
    startingPriceInr?: number | null;
    alternatives?: Array<{
      name: string;
      slug: string;
    }>;
  };
}

const { tool } = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-xl border border-border bg-white p-5 shadow-xs transition hover:border-primary/50 hover:shadow-md">
  <div>
    <!-- Top Header: Logo + Name + Category -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-border bg-slate-50 p-2 overflow-hidden shadow-2xs group-hover:scale-105 transition-transform"
        >
          <img
            src={tool.logoUrl}
            alt={`${tool.name} logo`}
            class="h-full w-full object-contain"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden h-full w-full items-center justify-center text-sm font-bold text-foreground">
            {tool.name.slice(0, 2).toUpperCase()}
          </div>
        </div>

        <div>
          <h2 class="text-base font-bold tracking-tight text-foreground group-hover:text-primary transition">
            <a href={`/tools/${tool.slug}`}>
              <span class="absolute inset-0" aria-hidden="true"></span>
              {tool.name}
            </a>
          </h2>
          {tool.categoryName && (
            <span class="text-[11px] font-medium text-muted-foreground">
              {tool.categoryName}
            </span>
          )}
        </div>
      </div>

      <!-- Pricing Badge -->
      <span class="inline-flex shrink-0 items-center rounded-md bg-secondary px-2 py-0.5 text-[11px] font-semibold text-secondary-foreground">
        {tool.pricingModel}
      </span>
    </div>

    <!-- Tagline -->
    <p class="mt-3 text-xs leading-relaxed text-foreground/90 font-medium line-clamp-2">
      {tool.tagline}
    </p>

    <!-- Sovereign Badges Grid -->
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tool.hasIndianDataResidency && (
        <span class="inline-flex items-center gap-1 rounded bg-amber-50 px-2 py-0.5 text-[10px] font-semibold text-amber-800 border border-amber-200">
          <span>🇮🇳</span> India Residency
        </span>
      )}
      {tool.hasGstInvoice && (
        <span class="inline-flex items-center gap-1 rounded bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-800 border border-emerald-200">
          <span>🧾</span> GST Invoicing
        </span>
      )}
      {tool.hasUpiSupport && (
        <span class="inline-flex items-center gap-1 rounded bg-sky-50 px-2 py-0.5 text-[10px] font-semibold text-sky-800 border border-sky-200">
          <span>⚡</span> UPI / INR
        </span>
      )}
      {tool.isOpenSource && (
        <span class="inline-flex items-center gap-1 rounded bg-purple-50 px-2 py-0.5 text-[10px] font-semibold text-purple-800 border border-purple-200">
          <span>🔓</span> Open Source
        </span>
      )}
    </div>
  </div>

  <!-- Bottom Row: Alternatives & Pricing -->
  <div class="mt-5 border-t border-border/80 pt-3 flex items-center justify-between text-xs">
    {tool.alternatives && tool.alternatives.length > 0 ? (
      <div class="flex items-center gap-1.5 text-muted-foreground truncate">
        <span class="text-[10px] uppercase font-semibold text-muted-foreground/80">Alt to:</span>
        <div class="flex items-center gap-1 truncate">
          {tool.alternatives.map((alt) => (
            <span class="rounded bg-secondary px-1.5 py-0.5 text-[10px] font-medium text-foreground">
              {alt.name}
            </span>
          ))}
        </div>
      </div>
    ) : (
      <div class="text-[11px] text-muted-foreground">Sovereign Stack</div>
    )}

    <div class="font-semibold text-foreground text-right shrink-0">
      {tool.startingPriceInr !== null && tool.startingPriceInr !== undefined ? (
        tool.startingPriceInr === 0 ? (
          <span class="text-emerald-700">Free tier</span>
        ) : (
          <span>₹{tool.startingPriceInr.toLocaleString('en-IN')}<span class="text-[10px] text-muted-foreground font-normal">/mo</span></span>
        )
      ) : (
        <span class="text-muted-foreground font-normal">Custom</span>
      )}
    </div>
  </div>
</div>
