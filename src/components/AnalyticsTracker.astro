---
/**
 * Unified Analytics Beacon Tracker
 * Dispatches pageviews, tool views, comparison views, outbound clicks, and badge clicks
 * to Google Analytics 4/GTM, Umami, and First-Party Cloudflare Analytics.
 */
---

<script>
  import { trackEvent } from '@/lib/client/analytics';

  // 1. Initial Pageview & Contextual Routing
  const pathname = window.location.pathname;
  const isToolPage = pathname.startsWith('/tools/');
  const isAlternativePage = pathname.startsWith('/alternatives/');
  const isComparePage = pathname.startsWith('/compare/');
  const currentSlug = pathname.split('/')[2] || '';

  if (isToolPage && currentSlug) {
    trackEvent('tool_view', { tool_slug: currentSlug, toolSlug: currentSlug });
  } else if (isAlternativePage && currentSlug) {
    trackEvent('pageview', { global_tool_slug: currentSlug, globalToolSlug: currentSlug });
  } else if (isComparePage && currentSlug) {
    trackEvent('compare_view', { comparison_slug: currentSlug, comparisonSlug: currentSlug });
  } else {
    trackEvent('pageview');
  }

  // 2. Click Delegation (Outbound Clicks & Trust Badges)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    // Outbound link click (e.g. "Visit Website")
    const outboundEl = target.closest('[data-outbound-tool]') as HTMLElement | null;
    if (outboundEl) {
      const toolSlug = outboundEl.getAttribute('data-outbound-tool') || currentSlug;
      const targetUrl = (outboundEl as HTMLAnchorElement).href || '';
      trackEvent('outbound_click', {
        tool_slug: toolSlug,
        toolSlug,
        target_url: targetUrl,
        targetUrl,
      });
      return;
    }

    // Sovereign Badge click / interest
    const badgeEl = target.closest('[data-badge-type]') as HTMLElement | null;
    if (badgeEl) {
      const badgeType = badgeEl.getAttribute('data-badge-type');
      trackEvent('badge_click', {
        badge_type: badgeType,
        badgeType,
        tool_slug: currentSlug,
        toolSlug: currentSlug,
      });
    }
  });

  // 3. Search Query Tracking (Cmd+K / Search Dialog)
  window.addEventListener('desi:search', ((e: CustomEvent) => {
    if (e.detail?.query) {
      trackEvent('search', {
        search_query: String(e.detail.query).slice(0, 100),
        searchQuery: String(e.detail.query).slice(0, 100),
        results_count: e.detail.resultsCount,
      });
    }
  }) as EventListener);
</script>
