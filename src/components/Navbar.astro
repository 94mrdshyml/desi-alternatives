---
const user = Astro.locals.user;
const avatarUrl = user
  ? user.image || `https://api.dicebear.com/9.x/glass/svg?seed=${encodeURIComponent(user.name || user.email || 'desi')}`
  : null;
---

<header class="sticky top-0 z-50 border-b border-border bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-foreground">
      <span>Desi</span>
      <span class="font-serif-editorial italic text-primary">Alternatives</span>
    </a>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-open-search
        class="hidden sm:flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-1.5 text-xs text-muted-foreground shadow-xs transition hover:border-primary/40 hover:text-foreground cursor-pointer"
      >
        <span>Quick Search</span>
        <kbd class="rounded bg-secondary px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">⌘K</kbd>
      </button>

      <a
        href="/submit"
        class="hidden sm:inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs font-semibold text-foreground/80 hover:border-primary/40 hover:text-foreground transition"
      >
        <span>➕ Submit Tool</span>
      </a>

      {user ? (
        <div class="relative" id="user-menu-container">
          <button
            type="button"
            id="user-menu-button"
            class="flex items-center gap-2 rounded-full border border-border p-1 hover:border-primary/50 transition cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <img
              src={avatarUrl}
              alt={user.name || 'User avatar'}
              class="h-8 w-8 rounded-full bg-amber-50 object-cover"
            />
          </button>

          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-56 rounded-xl border border-border bg-white p-2 shadow-lg ring-1 ring-black/5 z-50 transition-all duration-150"
            role="menu"
          >
            <div class="px-3 py-2 border-b border-border mb-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-foreground truncate">{user.name}</p>
                {user.role === 'admin' && (
                  <span class="rounded bg-amber-100 px-1.5 py-0.2 text-[9px] font-bold text-amber-800 uppercase">
                    Admin
                  </span>
                )}
              </div>
              <p class="text-xs text-muted-foreground truncate">{user.email}</p>
            </div>

            {user.role === 'admin' && (
              <a
                href="/admin"
                class="flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-semibold text-amber-900 bg-amber-50/60 hover:bg-amber-100/80 transition mb-1"
                role="menuitem"
              >
                <span>🛡️</span>
                <span>Admin Moderation</span>
              </a>
            )}

            <a
              href="/submit"
              class="flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-foreground hover:bg-secondary transition mb-1"
              role="menuitem"
            >
              <span>➕</span>
              <span>Submit a Tool</span>
            </a>

            <button
              type="button"
              id="sign-out-btn"
              class="flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 transition cursor-pointer"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign Out
            </button>
          </div>
        </div>
      ) : (
        <div class="flex items-center gap-3">
          <a
            href="/login"
            class="rounded-lg px-3 py-1.5 text-xs font-semibold text-foreground/80 hover:text-foreground transition"
          >
            Sign In
          </a>

          <a
            href="/register"
            class="rounded-lg bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
          >
            Get Started
          </a>
        </div>
      )}
    </div>
  </div>
</header>

<script>
  import { signOut } from '@/lib/auth-client';

  const menuBtn = document.getElementById('user-menu-button');
  const dropdown = document.getElementById('user-menu-dropdown');
  const signOutBtn = document.getElementById('sign-out-btn');

  if (menuBtn && dropdown) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  if (signOutBtn) {
    signOutBtn.addEventListener('click', async () => {
      signOutBtn.textContent = 'Signing out...';
      try {
        await signOut();
        window.location.href = '/';
      } catch {
        window.location.reload();
      }
    });
  }
</script>
