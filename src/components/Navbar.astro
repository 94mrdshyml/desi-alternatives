---
const user = Astro.locals.user;
const avatarUrl = user
  ? user.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(user.name || 'Desi')}`
  : null;
const firstName = user
  ? (user.firstName || user.name?.trim().split(/\s+/)[0] || 'User')
  : null;
---

<header class="sticky top-0 z-40 border-b border-border bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: Sovereign Brand Logo -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 text-lg sm:text-xl font-bold tracking-tight text-foreground group shrink-0">
      <span>Desi</span>
      <span class="font-serif-editorial italic text-primary transition group-hover:underline">Alternatives</span>
    </a>

    <!-- Center: Big Centered Search Field (Desktop Only) -->
    <div class="hidden md:flex flex-1 max-w-md lg:max-w-lg mx-6">
      <button
        type="button"
        data-open-search
        class="flex w-full items-center justify-between rounded-full border border-border/80 bg-slate-50/90 px-4 py-2 text-xs sm:text-sm text-muted-foreground shadow-2xs transition hover:border-primary/50 hover:bg-white hover:text-foreground hover:shadow-xs cursor-pointer group"
        aria-label="Search software alternatives"
      >
        <div class="flex items-center gap-2.5 truncate">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground group-hover:text-primary transition shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="truncate">Search Indian alternatives & global software...</span>
        </div>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 rounded-md bg-white border border-border/80 px-2 py-0.5 text-[11px] font-mono text-muted-foreground shadow-2xs">
          ⌘K
        </kbd>
      </button>
    </div>

    <!-- Right: Unified Hamburger Menu Trigger -->
    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        id="global-hamburger-toggle"
        class={`flex items-center rounded-xl border border-border bg-white shadow-2xs hover:border-primary/40 hover:bg-slate-50 transition cursor-pointer ${
          user ? 'gap-3 px-3.5 py-1.5 sm:py-2 text-xs sm:text-sm font-medium text-foreground' : 'p-2 sm:px-2.5 text-foreground'
        }`}
        aria-label="Open Navigation Menu"
      >
        {user ? (
          <>
            <span class="max-w-[110px] sm:max-w-[150px] truncate">{firstName}</span>
            <img
              src={avatarUrl}
              alt={user.name || 'User avatar'}
              class="h-5.5 w-5.5 rounded-full bg-amber-50 object-cover border border-border"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground shrink-0 ml-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </>
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        )}
      </button>
    </div>
  </div>
</header>

<!-- Global Hamburger Slide-out Drawer Backdrop -->
<div id="global-hamburger-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden transition-opacity"></div>

<!-- Global Hamburger Slide-out Drawer -->
<aside
  id="global-hamburger-drawer"
  class="fixed inset-y-0 right-0 z-50 w-[85vw] max-w-sm bg-white shadow-2xl border-l border-border transform translate-x-full transition-transform duration-200 ease-in-out flex flex-col justify-between"
>
  <!-- Drawer Header -->
  <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-slate-50/60">
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center gap-1.5 text-base font-bold tracking-tight text-foreground">
        <span>Desi</span>
        <span class="font-serif-editorial italic text-primary">Alternatives</span>
      </a>
      <span class="rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5">🇮🇳 Bharat</span>
    </div>
    <button
      type="button"
      id="global-hamburger-close"
      class="rounded-xl p-1.5 text-muted-foreground hover:text-foreground hover:bg-white transition cursor-pointer border border-transparent hover:border-border"
      aria-label="Close menu"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body Navigation Items -->
  <div class="p-4 sm:p-5 space-y-4 overflow-y-auto flex-1 text-xs">
    <!-- Quick Search on Mobile -->
    <div class="md:hidden">
      <button
        type="button"
        data-open-search
        class="flex w-full items-center justify-between rounded-xl border border-border/80 bg-slate-50 px-3.5 py-2.5 text-xs text-muted-foreground shadow-2xs hover:border-primary/50 hover:bg-white hover:text-foreground transition cursor-pointer"
      >
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search tools &amp; alternatives...</span>
        </div>
        <kbd class="rounded bg-white border border-border px-1.5 py-0.2 text-[10px] font-mono text-muted-foreground">⌘K</kbd>
      </button>
    </div>

    <!-- Auth / Profile Card -->
    {!user ? (
      <div class="grid grid-cols-2 gap-2 pb-2">
        <a
          href="/login"
          class="flex items-center justify-center rounded-xl border border-border py-2.5 text-xs font-semibold text-foreground hover:bg-slate-50 hover:border-border/80 transition text-center shadow-2xs"
        >
          Sign In
        </a>
        <a
          href="/register"
          class="flex items-center justify-center rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition text-center"
        >
          Register
        </a>
      </div>
    ) : (
      <div class="p-3 rounded-2xl bg-slate-50 border border-border/80">
        <div class="flex items-center gap-2.5">
          <img
            src={avatarUrl}
            alt={user.name || 'User'}
            class="h-9 w-9 rounded-full bg-amber-50 object-cover border border-border/80"
          />
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-foreground truncate text-xs">{user.name}</span>
              {(user.role === 'admin' || user.role === 'author') && (
                <span class={`rounded px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wider ${
                  user.role === 'admin' ? 'bg-amber-100 text-amber-800' : 'bg-indigo-100 text-indigo-800'
                }`}>
                  {user.role}
                </span>
              )}
            </div>
            <div class="text-[11px] text-muted-foreground truncate">{user.email}</div>
          </div>
        </div>

        <div class="mt-2.5 pt-2 border-t border-border/60 flex items-center justify-between text-[11px]">
          <a href="/profile" class="font-semibold text-primary hover:underline">
            Profile Settings →
          </a>
          <button
            type="button"
            id="drawer-sign-out-btn"
            class="font-semibold text-rose-600 hover:text-rose-700 transition cursor-pointer"
          >
            Sign Out
          </button>
        </div>
      </div>
    )}

    <!-- Section 1: Sovereign Stack & Directory -->
    <div class="space-y-1">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2 pt-1 pb-0.5">
        DIRECTORY &amp; TOOLS
      </div>
      <nav class="space-y-0.5">
        <a
          href="/compare"
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-amber-50/70 hover:text-amber-950 transition group"
        >
          <div class="flex items-center gap-2.5">
            <span class="text-sm">⚖️</span>
            <span>Comparison Engine</span>
          </div>
          <span class="rounded bg-amber-100/80 px-1.5 py-0.2 text-[10px] font-medium text-amber-900">Head-to-Head</span>
        </a>

        <a
          href="/"
          class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="text-sm">🗂️</span>
          <span>Sovereign Directory</span>
        </a>

        <a
          href="/alternatives"
          class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="text-sm">📊</span>
          <span>Alternatives Matrix</span>
        </a>

        <a
          href="/submit"
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-emerald-50/70 hover:text-emerald-950 transition"
        >
          <div class="flex items-center gap-2.5">
            <span class="text-sm">➕</span>
            <span>Submit a Tool</span>
          </div>
          <span class="rounded bg-emerald-100/70 px-1.5 py-0.2 text-[10px] font-semibold text-emerald-800">+ Add</span>
        </a>
      </nav>
    </div>

    <!-- Section 2: Editorial & Movement -->
    <div class="space-y-1 pt-2 border-t border-border/60">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2 pt-1 pb-0.5">
        EDITORIAL &amp; INSIGHTS
      </div>
      <nav class="space-y-0.5">
        <a
          href="/newsletter"
          class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-rose-50/70 hover:text-rose-950 transition"
        >
          <div class="flex items-center gap-2.5">
            <span class="text-sm">📬</span>
            <span>Weekly Dispatch</span>
          </div>
          <span class="rounded bg-rose-100/80 px-1.5 py-0.2 text-[10px] font-bold text-rose-800">Weekly</span>
        </a>

        <a
          href="/blog"
          class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="text-sm">📖</span>
          <span>Tech Journal</span>
        </a>

        <a
          href="/about"
          class="flex items-center gap-2.5 rounded-xl px-3 py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="text-sm">📜</span>
          <span>The Manifesto</span>
        </a>

        {(user && (user.role === 'admin' || user.role === 'author')) && (
          <a
            href={user.role === 'admin' ? '/admin' : '/admin/blog'}
            class="flex items-center justify-between rounded-xl px-3 py-2 text-xs font-bold text-amber-950 bg-amber-50/90 hover:bg-amber-100 transition border border-amber-200/80 mt-1.5"
          >
            <div class="flex items-center gap-2">
              <span>⚡</span>
              <span>{user.role === 'admin' ? 'Admin Control Center' : 'Writer Studio'}</span>
            </div>
            <span class="text-[10px] font-mono">→</span>
          </a>
        )}
      </nav>
    </div>
  </div>
</aside>

<script>
  import { signOut } from '@/lib/auth-client';

  // Hamburger Drawer Logic
  const hamburgerToggle = document.getElementById('global-hamburger-toggle');
  const hamburgerClose = document.getElementById('global-hamburger-close');
  const hamburgerDrawer = document.getElementById('global-hamburger-drawer');
  const hamburgerBackdrop = document.getElementById('global-hamburger-backdrop');
  const drawerSignOutBtn = document.getElementById('drawer-sign-out-btn');

  function openHamburger() {
    hamburgerBackdrop?.classList.remove('hidden');
    hamburgerDrawer?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeHamburger() {
    hamburgerDrawer?.classList.add('translate-x-full');
    hamburgerBackdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  hamburgerToggle?.addEventListener('click', openHamburger);
  hamburgerClose?.addEventListener('click', closeHamburger);
  hamburgerBackdrop?.addEventListener('click', closeHamburger);

  if (drawerSignOutBtn) {
    drawerSignOutBtn.addEventListener('click', async () => {
      drawerSignOutBtn.textContent = 'Signing out...';
      try {
        await signOut();
        window.location.href = '/';
      } catch {
        window.location.reload();
      }
    });
  }
</script>
