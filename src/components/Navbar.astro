---
const user = Astro.locals.user;
const avatarUrl = user
  ? user.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(user.name || 'Desi')}`
  : null;
---

<header class="sticky top-0 z-40 border-b border-border bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Left: Sovereign Brand Logo -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 text-lg sm:text-xl font-bold tracking-tight text-foreground group shrink-0">
      <span>Desi</span>
      <span class="font-serif-editorial italic text-primary transition group-hover:underline">Alternatives</span>
    </a>

    <!-- Center: Big Centered Search Field (Desktop Only) -->
    <div class="hidden md:flex flex-1 max-w-md lg:max-w-lg mx-6">
      <button
        type="button"
        data-open-search
        class="flex w-full items-center justify-between rounded-full border border-border/80 bg-slate-50/90 px-4 py-2 text-xs sm:text-sm text-muted-foreground shadow-2xs transition hover:border-primary/50 hover:bg-white hover:text-foreground hover:shadow-xs cursor-pointer group"
        aria-label="Search software alternatives"
      >
        <div class="flex items-center gap-2.5 truncate">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground group-hover:text-primary transition shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="truncate">Search Indian alternatives & global software...</span>
        </div>
        <kbd class="hidden sm:inline-flex items-center gap-0.5 rounded-md bg-white border border-border/80 px-2 py-0.5 text-[11px] font-mono text-muted-foreground shadow-2xs">
          ⌘K
        </kbd>
      </button>
    </div>

    <!-- Right: Unified Hamburger Menu Trigger -->
    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        id="global-hamburger-toggle"
        class="flex items-center gap-2 rounded-xl border border-border bg-white px-3 py-2 text-xs sm:text-sm font-semibold text-foreground shadow-2xs hover:border-primary/40 hover:bg-slate-50 transition cursor-pointer"
        aria-label="Open Navigation Menu"
      >
        {user ? (
          <img
            src={avatarUrl}
            alt={user.name || 'User avatar'}
            class="h-5 w-5 rounded-full bg-amber-50 object-cover"
          />
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        )}
        <span class="hidden sm:inline">Menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Global Hamburger Slide-out Drawer Backdrop -->
<div id="global-hamburger-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden transition-opacity"></div>

<!-- Global Hamburger Slide-out Drawer -->
<aside
  id="global-hamburger-drawer"
  class="fixed inset-y-0 right-0 z-50 w-[85vw] max-w-sm sm:w-96 bg-white shadow-2xl border-l border-border transform translate-x-full transition-transform duration-200 ease-in-out flex flex-col justify-between"
>
  <!-- Drawer Header -->
  <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-slate-50/50">
    <div class="flex items-center gap-2">
      <span class="text-sm font-bold text-foreground">Navigation Menu</span>
      <span class="rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5">🇮🇳 Sovereign</span>
    </div>
    <button
      type="button"
      id="global-hamburger-close"
      class="rounded-lg p-1.5 text-muted-foreground hover:text-foreground hover:bg-white transition cursor-pointer"
      aria-label="Close menu"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body Navigation Items -->
  <div class="p-4 sm:p-5 space-y-4 sm:space-y-5 overflow-y-auto flex-1 text-xs">
    <!-- Search Trigger in Mobile Drawer -->
    <div class="md:hidden pb-1">
      <button
        type="button"
        data-open-search
        class="flex w-full items-center justify-between rounded-xl border border-border bg-slate-50 px-3.5 py-2.5 text-xs text-muted-foreground shadow-2xs hover:border-primary/50 hover:bg-white transition cursor-pointer"
      >
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span>Search tools & alternatives...</span>
        </div>
        <kbd class="rounded bg-white border border-border px-1.5 py-0.2 text-[10px] font-mono text-muted-foreground">⌘K</kbd>
      </button>
    </div>

    <!-- Auth / User Card -->
    {!user ? (
      <div class="space-y-2 pb-3 border-b border-border/70">
        <div class="grid grid-cols-2 gap-2">
          <a
            href="/login"
            class="flex items-center justify-center rounded-xl border border-border py-2.5 text-xs font-semibold text-foreground hover:bg-slate-50 transition text-center"
          >
            Sign In
          </a>
          <a
            href="/register"
            class="flex items-center justify-center rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition text-center"
          >
            Register
          </a>
        </div>
      </div>
    ) : (
      <div class="p-3 rounded-2xl bg-slate-50 border border-border/70 mb-2">
        <div class="flex items-center gap-3">
          <img
            src={avatarUrl}
            alt={user.name || 'User'}
            class="h-10 w-10 rounded-full bg-amber-50 object-cover border border-border"
          />
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-1">
              <span class="font-bold text-foreground truncate text-xs sm:text-sm">{user.name}</span>
              {(user.role === 'admin' || user.role === 'author') && (
                <span class={`rounded px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wider ${
                  user.role === 'admin' ? 'bg-amber-100 text-amber-800' : 'bg-indigo-100 text-indigo-800'
                }`}>
                  {user.role}
                </span>
              )}
            </div>
            <div class="text-[11px] text-muted-foreground truncate">{user.email}</div>
          </div>
        </div>

        <div class="mt-3 pt-2.5 border-t border-border/60 flex items-center justify-between text-[11px]">
          <a href="/profile" class="font-semibold text-primary hover:underline">
            Profile Settings →
          </a>
          <button
            type="button"
            id="drawer-sign-out-btn"
            class="font-semibold text-rose-600 hover:text-rose-700 transition cursor-pointer"
          >
            Sign Out
          </button>
        </div>
      </div>
    )}

    <!-- Section: The Stack -->
    <div class="space-y-1.5">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">EXPLORE & COMPARE</div>
      <nav class="space-y-1">
        <a
          href="/compare"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-amber-50/80 hover:text-amber-900 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-800 border border-amber-200 shrink-0 font-mono text-sm">
            ⚖️
          </span>
          <div>
            <div class="font-bold">Comparison Engine</div>
            <div class="text-[11px] text-muted-foreground font-normal">Head-to-head teardowns, TCO math & DPDP matrix.</div>
          </div>
        </a>

        <a
          href="/"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-700 border border-blue-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" />
            </svg>
          </span>
          <div>
            <div class="font-bold">Sovereign Directory</div>
            <div class="text-[11px] text-muted-foreground font-normal">Find world-class homegrown tech by category.</div>
          </div>
        </a>

        <a
          href="/newsletter"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-rose-50/80 hover:text-rose-900 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-50 text-rose-700 border border-rose-100 shrink-0 text-sm">
            📬
          </span>
          <div>
            <div class="font-bold">The Dispatch Newsletter</div>
            <div class="text-[11px] text-muted-foreground font-normal">Weekly sovereign SaaS radar & intelligence.</div>
          </div>
        </a>

        <a
          href="/submit"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-emerald-50 hover:text-emerald-900 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </span>
          <div>
            <div class="font-bold">Submit a Tool</div>
            <div class="text-[11px] text-muted-foreground font-normal">Built something great? Add it to the sovereign stack.</div>
          </div>
        </a>
      </nav>
    </div>

    <!-- Section: The Movement -->
    <div class="space-y-1.5 pt-3 border-t border-border/70">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">INSIGHTS & MANIFESTO</div>
      <nav class="space-y-1">
        <a
          href="/about"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-amber-50 hover:text-amber-900 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-50 text-amber-800 border border-amber-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </span>
          <div>
            <div class="font-bold">The Sovereign Manifesto</div>
            <div class="text-[11px] text-muted-foreground font-normal">Why we are replacing foreign vendor lock-in.</div>
          </div>
        </a>

        <a
          href="/blog"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-purple-50 hover:text-purple-900 transition"
        >
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-50 text-purple-700 border border-purple-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </span>
          <div>
            <div class="font-bold">The Journal</div>
            <div class="text-[11px] text-muted-foreground font-normal">Engineering teardowns, migration stories & blueprints.</div>
          </div>
        </a>

        {(user && (user.role === 'admin' || user.role === 'author')) && (
          <a
            href={user.role === 'admin' ? '/admin' : '/admin/blog'}
            class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-amber-950 bg-amber-50/80 hover:bg-amber-100 transition border border-amber-200/60"
          >
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-200 text-amber-900 shrink-0 font-bold">⚡</span>
            <div>
              <div class="font-bold">{user.role === 'admin' ? 'Admin Control Center' : 'Writer Studio'}</div>
              <div class="text-[11px] text-amber-800 font-normal">Manage articles, catalog, and moderation</div>
            </div>
          </a>
        )}
      </nav>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div class="p-4 border-t border-border bg-slate-50/50 text-[11px] text-muted-foreground flex items-center justify-between">
    <span>🇮🇳 Sovereign SaaS for Bharat</span>
    <a href="https://github.com/94mrdshyml/desi-alternatives" target="_blank" class="hover:text-primary transition font-bold">GitHub</a>
  </div>
</aside>

<script>
  import { signOut } from '@/lib/auth-client';

  // Hamburger Drawer Logic
  const hamburgerToggle = document.getElementById('global-hamburger-toggle');
  const hamburgerClose = document.getElementById('global-hamburger-close');
  const hamburgerDrawer = document.getElementById('global-hamburger-drawer');
  const hamburgerBackdrop = document.getElementById('global-hamburger-backdrop');
  const drawerSignOutBtn = document.getElementById('drawer-sign-out-btn');

  function openHamburger() {
    hamburgerBackdrop?.classList.remove('hidden');
    hamburgerDrawer?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeHamburger() {
    hamburgerDrawer?.classList.add('translate-x-full');
    hamburgerBackdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  hamburgerToggle?.addEventListener('click', openHamburger);
  hamburgerClose?.addEventListener('click', closeHamburger);
  hamburgerBackdrop?.addEventListener('click', closeHamburger);

  if (drawerSignOutBtn) {
    drawerSignOutBtn.addEventListener('click', async () => {
      drawerSignOutBtn.textContent = 'Signing out...';
      try {
        await signOut();
        window.location.href = '/';
      } catch {
        window.location.reload();
      }
    });
  }
</script>
