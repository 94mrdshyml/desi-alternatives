---
const user = Astro.locals.user;
const avatarUrl = user
  ? user.image || `https://api.dicebear.com/9.x/identicon/svg?seed=${encodeURIComponent(user.name || 'Desi')}`
  : null;
---

<header class="sticky top-0 z-40 border-b border-border bg-white/95 backdrop-blur-md">
  <div class="mx-auto flex h-14 sm:h-16 max-w-6xl items-center justify-between px-3 sm:px-6 lg:px-8">
    <!-- Left: Sovereign Brand Logo -->
    <a href="/" class="flex items-center gap-1.5 sm:gap-2 text-lg sm:text-xl font-bold tracking-tight text-foreground group shrink-0">
      <span>Desi</span>
      <span class="font-serif-editorial italic text-primary transition group-hover:underline">Alternatives</span>
    </a>

    <!-- Right: Responsive Navigation Bar -->
    <div class="flex items-center gap-1.5 sm:gap-2.5">
      <!-- 1. Search Trigger (Icon on mobile, full pill on desktop) -->
      <button
        type="button"
        data-open-search
        class="flex h-8.5 w-8.5 sm:h-auto sm:w-auto items-center justify-center sm:justify-start gap-1.5 sm:gap-2 rounded-xl border border-border bg-slate-50/80 px-2 sm:px-3 py-1.5 text-xs text-muted-foreground shadow-2xs transition hover:border-primary/40 hover:text-foreground hover:bg-white cursor-pointer"
        aria-label="Search software alternatives"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden md:inline">Search</span>
        <kbd class="hidden md:inline-block rounded bg-secondary px-1.5 py-0.2 text-[10px] font-mono text-muted-foreground">⌘K</kbd>
      </button>

      <!-- 2. Manifesto Link (Visible on desktop/tablet md+) -->
      <a
        href="/about"
        class="hidden md:inline-flex items-center gap-1.5 rounded-xl px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-foreground/80 hover:text-primary hover:bg-slate-50 transition"
      >
        <span>Manifesto</span>
      </a>

      <!-- 3. Desktop Auth Buttons / User Avatar Dropdown -->
      {user ? (
        <div class="relative" id="user-menu-container">
          <button
            type="button"
            id="user-menu-button"
            class="flex items-center gap-1.5 rounded-full border border-border p-0.5 hover:border-primary/50 transition cursor-pointer"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="User Account Menu"
          >
            <img
              src={avatarUrl}
              alt={user.name || 'User avatar'}
              class="h-7 w-7 sm:h-8 sm:w-8 rounded-full bg-amber-50 object-cover"
            />
          </button>

          <!-- User Avatar Dropdown Menu -->
          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-60 rounded-2xl border border-border bg-white p-2 shadow-xl ring-1 ring-black/5 z-50 transition-all duration-150"
            role="menu"
          >
            <div class="px-3 py-2 border-b border-border mb-1">
              <div class="flex items-center justify-between">
                <p class="text-xs sm:text-sm font-bold text-foreground truncate">{user.name}</p>
                {(user.role === 'admin' || user.role === 'author') && (
                  <span class={`rounded px-1.5 py-0.2 text-[9px] font-bold uppercase tracking-wider ${
                    user.role === 'admin' ? 'bg-amber-100 text-amber-800' : 'bg-indigo-100 text-indigo-800'
                  }`}>
                    {user.role}
                  </span>
                )}
              </div>
              <p class="text-[11px] text-muted-foreground truncate">{user.email}</p>
            </div>

            {(user.role === 'admin' || user.role === 'author') && (
              <a
                href={user.role === 'admin' ? '/admin' : '/admin/blog'}
                class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-amber-950 bg-amber-50/80 hover:bg-amber-100 transition mb-1"
                role="menuitem"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-amber-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>{user.role === 'admin' ? 'Admin Dashboard' : 'Writer Studio'}</span>
              </a>
            )}

            <a
              href="/profile"
              class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-foreground hover:bg-slate-50 transition mb-0.5"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Profile Settings</span>
            </a>

            <a
              href="/submit"
              class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-foreground hover:bg-slate-50 transition mb-0.5"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Submit a Tool</span>
            </a>

            <button
              type="button"
              id="sign-out-btn"
              class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-xs font-semibold text-rose-600 hover:bg-rose-50 transition cursor-pointer"
              role="menuitem"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span>Sign Out</span>
            </button>
          </div>
        </div>
      ) : (
        <div class="hidden md:flex items-center gap-2">
          <a
            href="/login"
            class="inline-flex rounded-xl px-3 py-1.5 text-xs font-semibold text-foreground/80 hover:text-foreground hover:bg-slate-50 transition"
          >
            Sign In
          </a>

          <a
            href="/submit"
            class="rounded-xl bg-primary px-3.5 py-1.5 text-xs font-semibold text-primary-foreground shadow-xs hover:bg-primary-hover transition"
          >
            Submit a Tool
          </a>
        </div>
      )}

      <!-- 4. Mobile-only Hamburger Menu Button -->
      <button
        type="button"
        id="global-hamburger-toggle"
        class="flex md:hidden h-8.5 w-8.5 sm:h-9 sm:w-9 items-center justify-center rounded-xl border border-border bg-slate-50/80 text-muted-foreground hover:text-foreground hover:bg-white hover:border-primary/40 transition cursor-pointer"
        aria-label="Open Navigation Menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Global Hamburger Slide-out Drawer -->
<div id="global-hamburger-backdrop" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-50 hidden transition-opacity"></div>

<aside
  id="global-hamburger-drawer"
  class="fixed inset-y-0 right-0 z-50 w-[85vw] max-w-sm sm:w-96 bg-white shadow-2xl border-l border-border transform translate-x-full transition-transform duration-200 ease-in-out flex flex-col justify-between"
>
  <!-- Drawer Header -->
  <div class="p-4 sm:p-5 border-b border-border flex items-center justify-between bg-slate-50/50">
    <div class="flex items-center gap-2">
      <span class="text-sm font-bold text-foreground">Menu</span>
      <span class="rounded-full bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5">🇮🇳 Sovereign</span>
    </div>
    <button
      type="button"
      id="global-hamburger-close"
      class="rounded-lg p-1.5 text-muted-foreground hover:text-foreground hover:bg-white transition cursor-pointer"
      aria-label="Close menu"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Drawer Body Navigation Items -->
  <div class="p-4 sm:p-5 space-y-4 sm:space-y-5 overflow-y-auto flex-1 text-xs">
    <!-- Mobile Auth Links (Top of Drawer on Mobile) -->
    {!user ? (
      <div class="space-y-2 pb-3 border-b border-border/70 md:hidden">
        <div class="flex flex-col gap-2">
          <a
            href="/submit"
            class="flex items-center justify-center rounded-xl bg-primary py-2.5 text-xs font-bold text-primary-foreground shadow-xs hover:bg-primary-hover transition text-center"
          >
            Submit a Tool
          </a>
          <a
            href="/login"
            class="flex items-center justify-center rounded-xl border border-border py-2 text-xs font-semibold text-foreground hover:bg-slate-50 transition text-center"
          >
            Sign In
          </a>
        </div>
      </div>
    ) : (
      <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-50 border border-border/60 md:hidden mb-2">
        <img
          src={avatarUrl}
          alt={user.name || 'User'}
          class="h-9 w-9 rounded-full bg-amber-50 object-cover"
        />
        <div class="min-w-0 flex-1">
          <div class="font-bold text-foreground truncate text-xs">{user.name}</div>
          <div class="text-[11px] text-muted-foreground truncate">{user.email}</div>
        </div>
      </div>
    )}

    <!-- Section: The Stack -->
    <div class="space-y-1.5">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">THE STACK</div>
      <nav class="space-y-1">
        <a
          href="/#categories"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-slate-50 transition"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 text-blue-700 border border-blue-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" />
            </svg>
          </span>
          <div>
            <div class="font-bold">Explore the Directory</div>
            <div class="text-[11px] text-muted-foreground font-normal">Find world-class homegrown tech by category.</div>
          </div>
        </a>

        <a
          href="/alternatives"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-amber-50 hover:text-amber-900 transition"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 text-amber-800 border border-amber-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </span>
          <div>
            <div class="font-bold">Alternatives Matrix</div>
            <div class="text-[11px] text-muted-foreground font-normal">Head-to-head: Global monopolies vs. Indian innovators.</div>
          </div>
        </a>

        <a
          href="/submit"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-emerald-50 hover:text-emerald-900 transition"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </span>
          <div>
            <div class="font-bold">Submit Your Product</div>
            <div class="text-[11px] text-muted-foreground font-normal">Built something great? Add it to the sovereign stack.</div>
          </div>
        </a>
      </nav>
    </div>

    <!-- Section: The Movement -->
    <div class="space-y-1.5 pt-3 border-t border-border/70">
      <div class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground px-2">THE MOVEMENT</div>
      <nav class="space-y-1">
        <a
          href="/about"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-amber-50 hover:text-amber-900 transition"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-50 text-amber-800 border border-amber-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </span>
          <div>
            <div class="font-bold">The Manifesto</div>
            <div class="text-[11px] text-muted-foreground font-normal">Why we are replacing the global default.</div>
          </div>
        </a>

        <a
          href="/blog"
          class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-foreground hover:bg-purple-50 hover:text-purple-900 transition"
        >
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-purple-50 text-purple-700 border border-purple-100 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </span>
          <div>
            <div class="font-bold">The Journal</div>
            <div class="text-[11px] text-muted-foreground font-normal">Engineering teardowns, migration stories, and founder insights.</div>
          </div>
        </a>

        {(user && (user.role === 'admin' || user.role === 'author')) && (
          <a
            href={user.role === 'admin' ? '/admin' : '/admin/blog'}
            class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-xs font-semibold text-amber-950 bg-amber-50/80 hover:bg-amber-100 transition"
          >
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-amber-200 text-amber-900 shrink-0 font-bold">⚡</span>
            <div>
              <div class="font-bold">{user.role === 'admin' ? 'Admin Dashboard' : 'Writer Studio'}</div>
              <div class="text-[11px] text-amber-800 font-normal">Manage articles, catalog, and moderation</div>
            </div>
          </a>
        )}
      </nav>
    </div>
  </div>

  <!-- Drawer Footer -->
  <div class="p-4 border-t border-border bg-slate-50/50 text-[11px] text-muted-foreground flex items-center justify-between">
    <span>🇮🇳 Curated for Bharat's Builders</span>
    <a href="https://github.com/94mrdshyml/desi-alternatives" target="_blank" class="hover:text-primary transition font-bold">GitHub</a>
  </div>
</aside>

<script>
  import { signOut } from '@/lib/auth-client';

  // User Dropdown Logic
  const menuBtn = document.getElementById('user-menu-button');
  const dropdown = document.getElementById('user-menu-dropdown');
  const signOutBtn = document.getElementById('sign-out-btn');

  if (menuBtn && dropdown) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !menuBtn.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  if (signOutBtn) {
    signOutBtn.addEventListener('click', async () => {
      signOutBtn.textContent = 'Signing out...';
      try {
        await signOut();
        window.location.href = '/';
      } catch {
        window.location.reload();
      }
    });
  }

  // Hamburger Drawer Logic
  const hamburgerToggle = document.getElementById('global-hamburger-toggle');
  const hamburgerClose = document.getElementById('global-hamburger-close');
  const hamburgerDrawer = document.getElementById('global-hamburger-drawer');
  const hamburgerBackdrop = document.getElementById('global-hamburger-backdrop');

  function openHamburger() {
    hamburgerBackdrop?.classList.remove('hidden');
    hamburgerDrawer?.classList.remove('translate-x-full');
    document.body.style.overflow = 'hidden';
  }

  function closeHamburger() {
    hamburgerDrawer?.classList.add('translate-x-full');
    hamburgerBackdrop?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  hamburgerToggle?.addEventListener('click', openHamburger);
  hamburgerClose?.addEventListener('click', closeHamburger);
  hamburgerBackdrop?.addEventListener('click', closeHamburger);
</script>
