{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desi-alternatives",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat",
    "expose_global_message_channel"
  ],
  "account_id": "6022a3c94a3dbd24d983682f9f16b6e1",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "desi-db",
      "database_id": "d6ff8e4d-e561-460e-a132-58d508fbc2c9",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "desi-assets"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://desi-alternatives.mridu.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
